    <add name="archive" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.91;Initial Catalog=bodb02;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;"/>
    <!--ON_USER-->
    <add name="on_user" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.51;Initial Catalog=on_user;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;"/>
    <!--DB03 replicate-->
    <add name="replicate" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.51;Initial Catalog=bodb02;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;"/>
    <!--DB06-->
    <add name="warehouse" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.99;Initial Catalog=bodb02;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;"/>
    <!--New DB Affiliate-->
    <add name="affiliate_12bet" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.51;Initial Catalog=Affiliate_12Bet;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;"/>
    <!--DEPOSIT-->
    <add name="deposit" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.42;Initial Catalog=Deposit_DB;integrated security=false; user id=bodbAffiliateNet; password=a59O1jgHk05Mhd7nyySQdQ==;"/>
