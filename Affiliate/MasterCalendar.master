<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterCalendar.master.cs" Inherits="MasterCalendar" %>
<%@ Register Src="~/Controls/Header.ascx" TagName="CHeader" TagPrefix="mod" %>
<%@ Register Src="~/Controls/Footer.ascx" TagName="CFooter" TagPrefix="mod" %>
<%@ Register Src="~/Controls/LeftPanel.ascx" TagName="CLeft" TagPrefix="mod" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" >
<head id="Head1" runat="server">
    <title>12BET Affiliates Program</title>
    <script type="text/javascript">AC_FL_RunContent = 0;</script>
    <script src="../App_Js/AC_RunActiveContent.js" type="text/javascript"></script>    
    <style type="text/css">
        #container{
            width:800px;
            margin:0px auto;
            padding:2px;
        }
        .root-header{
            width:800px;
            padding-bottom:0px;
        }
        .root-left{
            width:200px;
            float:left;
            margin-top:5px
        }
        .root-right{
            width:595px;
            float:left;
            margin-top:5px;
        }
        .clear{
            clear:both;
        }
    </style>
        
</head>
<body>
    <div style="background-color:White;">  
          
        <script language="javascript" type="text/javascript" src="../App_Js/prototype.js"></script>
        <script language="javascript" type="text/javascript" src="../App_Js/Common.js?vers=<%Response.Write(AppSettings.JsVersion);%>"></script>
        <script language="javascript" type="text/javascript" src="../App_Js/login.js?vers=<%Response.Write(AppSettings.JsVersion);%>"></script>
                
        <script src="../App_Js/Calendar2/calendar.js?vers=<%Response.Write(AppSettings.JsVersion);%>" type="text/javascript"></script>
        <script src="../App_Js/Calendar2/date.js?vers=<%Response.Write(AppSettings.JsVersion);%>" type="text/javascript"></script>
        <script src="../App_Js/Calendar2/Lang/calendar_<%=AppSettings.Session.Language%>.js?vers=<%Response.Write(AppSettings.JsVersion);%>" type="text/javascript"></script>
        <script src="../App_Js/Calendar2/calendar-setup.js?vers=<%Response.Write(AppSettings.JsVersion);%>" type="text/javascript"></script>
        <link href="../App_Js/Calendar2/Skin/calendar-blue.css?vers=<%Response.Write(AppSettings.JsVersion);%>" media="all" rel="stylesheet" type="text/css" title="Blue" />
   
    </div>
    <div id="container" style="background-color:White;">
        <div class="root-header">
            <mod:CHeader runat="server" id="Header1" />
        </div>
        <div class="root-left" style="margin-top:3px;">
            <mod:CLeft runat="server" ID="Left1" />
            <br />
            <div style="text-align:center;">
            <script type="text/javascript">                
                if (AC_FL_RunContent == 0) {
                alert("This page requires AC_RunActiveContent.js");
                } else {
                AC_FL_RunContent(
                'codebase', 'https://download.macromedia.com/pub/shockwave/cabs/flash/swflash.cab#version=8,0,0,0',
                'width', '176',
                'height', '190',
                'src', 'yourswffile',
                'quality', 'high',
                'pluginspage', 'https://www.macromedia.com/go/getflashplayer',
                'align', 'middle',
                'play', 'true',
                'loop', 'false',
                'scale', 'noscale',
                'wmode', 'window',
                'devicefont', 'false',
                'id', 'flash-animations',
                'bgcolor', '#eeeeee',
                'name', 'yourswffile',
                'menu', 'false',
                'allowScriptAccess','sameDomain',
                'movie', '../<%=AppSettings.ThemeDir %>/images/176x190_<%=AppSettings.Session.Flag %>',
                'salign', ''
                );
                }
            </script>
            </div>
        </div>
        <div class="root-right">
            <asp:contentplaceholder id="MainContent" runat="server">
            </asp:contentplaceholder>
        </div>
        <div class="clear"></div>
        <div>
        <mod:CFooter runat="server" ID="Footer1" />
        </div>
    </div>
</body>
</html>
