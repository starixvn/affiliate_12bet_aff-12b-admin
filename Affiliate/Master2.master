<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Master2.master.cs" Inherits="Master2" %>
<%@ Register Src="~/Controls/Header.ascx" TagName="CHeader" TagPrefix="mod" %>
<%@ Register Src="~/Controls/Footer.ascx" TagName="CFooter" TagPrefix="mod" %>
<%@ Register Src="~/Controls/RightPanel.ascx" TagName="CRight" TagPrefix="mod" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <asp:ContentPlaceHolder ID="Title" runat="server"></asp:ContentPlaceHolder>

    <meta content="text/html;charset=UTF-8" http-equiv="Content-Type" />
    
    <style type="text/css">
         .root-header{
            width:800px;
            padding-bottom:0px;
        }
        .root-left{
            width:595px;         
            float:left;   
            margin-top:5px;         
        }
        .root-right{
            width:201px;           
            float:right;    
            margin-top:5px;        
        }
        .root-footer
        {
            width:800px;
        }
        .clear{
            clear:both;            
        }
        
    </style>
</head>
<body class="<%=langClass%>">
    <div style="background-color:White">
        <%=strScript.ToString()%>
    </div>
   <div id="container">        
        <mod:CHeader runat="server" ID="Header1" />        
        <div id="contents_page">
            <div id="contents_main">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
            <div id="right_pane">
                <mod:CRight runat="server" ID="Right1" />
            </div>
        </div>
        <div class="clear"></div>
        <div id="footer">
            <mod:CFooter runat="server" ID="Footer1" />
        </div>
        <div class="red_line"></div>
    </div>
    <% if (AppSettings.Environment.Equals("UAT", StringComparison.OrdinalIgnoreCase))
       { %>
    <!-- Piwik -->
    <script type="text/javascript">
        var _paq = _paq || [];
        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
        (function () {
            var u = "https://pw.detecas.com/";
            _paq.push(['setTrackerUrl', u + 'piwik.php']);
            _paq.push(['setSiteId', 27]);
            var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
            g.type = 'text/javascript'; g.async = true; g.defer = true; g.src = u + 'piwik.js'; s.parentNode.insertBefore(g, s);
        })();

    </script>
    <noscript><p><img src="https://pw.detecas.com/piwik.php?idsite=27" style="border:0;" alt="" /></p></noscript>
    <!-- End Piwik Code -->
    <% } %>
</body>    
</html>