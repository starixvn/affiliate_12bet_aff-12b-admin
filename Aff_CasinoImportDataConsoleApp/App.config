        <!--<add key="IADailyDataURL" value="https://admin.12betcasino.net/report_view.php?reportcode=56881&amp;action=exportcsv&amp;admin=12Izhar&amp;password=Paragon3!&amp;casino=1052&amp;startdate={date}&amp;enddate={date}" />-->

        <add key="pathSaveFile" value="D:/12BetAff/Aff_CasinoImportData/"/>
        <add key="fileExtension" value=".csv"/>
        <add key="sheetName" value="playerstats"/>
        <!--Column name in the sheet-->
        <add key="Date" value="Date"/>
        <add key="Username" value="Username"/>
        <add key="Turnover" value="Bets"/>
        <add key="Winlost" value="Game income"/>
        <add key="Deposit" value="Total deposits"/>
        <add key="Bonus" value="Bonus amount"/>
        <!--Column in IA-->
        <!--<add key="IADate" value="Statsdate" />-->
        <add key="IAWinlost" value="Game income"/>
        <!--<add key="IABonus" value="Bonuses" />
    <add key="IADeposit" value="purchases" />-->


        <add key="adminID" value="1881784"/>
        <!-- send mail -->
        <add key="app_mail_address" value="net.tcp://10.18.200.209:8787/MailService"/>
        <add key="app_mail_id" value="2"/>
        <add key="isSendMail" value="1"/>
        <add key="fromMail" value="affiliate-no-reply@12csd.com"/>
        <add key="toMail" value="alex.nguyen@nexcel.vn"/>
