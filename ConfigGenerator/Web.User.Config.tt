<#@ template debug="true" hostspecific="true" language="C#" #>
<#@ output extension=".txt" #>
<#@ assembly name="System.Xml" #>
<#@ assembly name="System.Xml.Linq" #>
<#@ assembly name="System.Data" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="Fanex.AffiliateAdmin.ConfigGenerator.ConfigModelReaders" #>
<#@ parameter name="Site" type="Fanex.AffiliateAdmin.ConfigGenerator.ConfigModelReaders.SiteInfo" #>
<# 
	var environment = Site == null ? "local" : Site.Environment;
	var xmlFile = Site == null ? @"ConfigModels\WebConfigModels\WebConfigModel.xml" : Site.WebConfigModel;
	var reader = new WebConfigModelReader 
				{
					Environment = environment,//Site.Environment
					XmlFile = Host.ResolvePath(xmlFile)
				};

	reader.LoadXml();

	var fanexSettings = reader.GetSettingsOfNode("Fanex.Logging");
	var appSettings = reader.GetSettingsOfNode("appSettings");
	var connectionStrings = reader.GetSettingsOfNode("connectionStrings");
	var compilations = reader.GetSettingsOfNode("compilation");
	var customErrors = reader.GetSettingsOfNode("customErrors");
	var loggingConfigurations = reader.GetSettingsOfNode("loggingConfiguration");
#>
<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="cachingConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Caching.Configuration.CacheManagerSettings, Microsoft.Practices.EnterpriseLibrary.Caching, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
    <section name="loggingConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.LoggingSettings, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
    <section name="exceptionHandling" type="Microsoft.Practices.EnterpriseLibrary.ExceptionHandling.Configuration.ExceptionHandlingSettings, Microsoft.Practices.EnterpriseLibrary.ExceptionHandling, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
	<section name="dataConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Data.Configuration.DatabaseSettings, Microsoft.Practices.EnterpriseLibrary.Data, Version=5.0.414.0, Culture=neutral"/>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data"/>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <sectionGroup name="modulesSection">
      <section name="rewriteModule" type="RewriteModule.RewriteModuleSectionHandler"/>
    </sectionGroup>
  </configSections>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="~/SpNames.xml" enableWatching="1"/>
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="<#= fanexSettings.GetValue("msmqPath") #>" defaultCategory="Affiliate_12Bet" />
  
  <appSettings>
    <add key="ServerID" value="400001"/>
    <add key="JsVersion" value="20110924"/>
    <add key="template_folder" value="App_Templates"/>
    <add key="Theme" value="Default"/>
    <add key="AffMaster" value="12BETAFF"/>
	<add key="PreferLang" value="en-GB"/>
    <add key="AffTypeList" value="<#= appSettings.GetValue("AffTypeList") #>"/>
    
    <add key="app_mail_address" value="<#= appSettings.GetValue("app_mail_address") #>" />
    <add key="app_mail_id" value="<#= appSettings.GetValue("app_mail_id") #>" />
    
    <add key="RegAlertMail" value="<#= appSettings.GetValue("RegAlertMail") #>"/>
    <add key="CCMail" value="<#= appSettings.GetValue("CCMail") #>"/>
    <add key="BCCMail" value="<#= appSettings.GetValue("BCCMail") #>"/>
    <add key="SubDomain" value=""/>
    <add key="MailContact" value="<#= appSettings.GetValue("MailContact") #>"/>
    <add key="PhoneContact" value="123456788765"/>
    <add key="MediaJS" value="http://banner.12biying.com/SwfVersDetection.js"/>
    <add key="MediaJS_CS" value="http://banner.12betscore.com/SwfVersDetection.js"/>
    <add key="MediaJS_TH" value="http://banner.12sheng.com/SwfVersDetection.js"/>
    <add key="MediaJS_VI" value="http://banner.12bet.com/SwfVersDetection.js"/>
    <add key="MediaJS_EU" value="http://banner.12bet.com/SwfVersDetection.js"/>

    <add key="MediaUrl" value="<#= appSettings.GetValue("MediaUrl") #>"/>
    <add key="MediaUrl_CS" value="<#= appSettings.GetValue("MediaUrl_CS") #>"/>
    <add key="MediaUrl_TH" value="<#= appSettings.GetValue("MediaUrl_TH") #>"/>
    <add key="MediaUrl_VI" value="<#= appSettings.GetValue("MediaUrl_VI") #>"/>
    <add key="MediaUrl_EU" value="<#= appSettings.GetValue("MediaUrl_EU") #>"/>
    
    <add key="12BetLink" value="http://{domain}/{custid}{/TrackingCode}/{target}{/lang}{/DeviceType}/index.html"/>
    <add key="12BetLink_CS" value="http://{domain}/{custid}{/TrackingCode}/{target}{/lang}{/DeviceType}/index.html"/>
    <add key="12BetLink_TH" value="http://{domain}/{custid}{/TrackingCode}/{target}{/lang}{/DeviceType}/index.html"/>
    <add key="12BetLink_EU" value="http://{domain}/{custid}{/TrackingCode}/{target}{/lang}{/DeviceType}/index.html"/>
    <add key="12BetLink_VI" value="http://{domain}/{custid}{/TrackingCode}/{target}{/lang}{/DeviceType}/index.html"/>

	<add key="RemoteRefURL" value="<#= appSettings.GetValue("RemoteRefURL") #>" />

    <add key="AsianAffDomain" value="<#= appSettings.GetValue("AsianAffDomain") #>"/>
    <add key="AsianAffPort" value="<#= appSettings.GetValue("AsianAffPort") #>"/>
    <add key="EuropeanAffDomain" value="<#= appSettings.GetValue("EuropeanAffDomain") #>"/>
    <add key="EuropeanAffPort" value="<#= appSettings.GetValue("EuropeanAffPort") #>"/>

    <add key="UrlAffSite" value="http://affiliate.12Score.com"/>
    <add key="ListAffUseEuLink" value=""/>
    <add key="LocalTest" value="<#= appSettings.GetValue("LocalTest") #>"/>
    <add key="StatementAvailableFrom" value="2009/01/01"/>
    <add key="PageSize" value="20"/>
    <add key="LBUrl" value="<#= appSettings.GetValue("LBUrl") #>"/>
    
    <add key="HasCheckUmTime" value="<#= appSettings.GetValue("HasCheckUmTime") #>"/>
    <add key="UM_StartTime" value="21 May 2010 4:43:00"/>
    <add key="UM_EndTime" value="21 Jun 2014 6:01:00"/>
    <add key="BannerUrl" value="http://banner.12betscore.com/handler/MediaScript.ashx?textid="/>
    <add key="ShowCasino" value="1"/>
    <add key="MemberInfoService.Service" value="http://test.12bet.com:13002/Service.asmx"/>
	<add key="SuffixSp" value="<#= appSettings.GetValue("SuffixSp") #>"/>
	<add key="AffBetlistService.AffiliateAPI" value="<#= appSettings.GetValue("AffBetlistService.AffiliateAPI") #>"/>
	<add key="BetListServiceTimeout" value="<#= appSettings.GetValue("BetListServiceTimeout") #>"/>
	<add key="StartYearOfSystem" value="2007"/>
  </appSettings>
  <connectionStrings>
    <remove name="main" />
	<add name="main" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("main") #>" />
    <remove name="affiliate_12bet" />
	<add name="affiliate_12bet" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("affiliate_12bet") #>" />
	<remove name="deposit" />
    <add name="deposit" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("deposit") #>" />

	<remove name="main_view" />
	<add name="main_view" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("main_view") #>" />
	<remove name="archive_view" />
    <add name="archive_view" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("archive_view") #>" />
	<remove name="affiliate_view" />
	<add name="affiliate_view" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("affiliate_view") #>" />
	<remove name="on_user_view" />
	<add name="on_user_view" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("on_user_view") #>" />
	<remove name="warehouse_view" />
	<add name="warehouse_view" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("warehouse_view") #>" />
	<remove name="deposit_view" />
    <add name="deposit_view" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("deposit_view") #>" />
	<remove name="affiliate_12bet_view" />
    <add name="affiliate_12bet_view" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("affiliate_12bet_view") #>" />

	<remove name="DBAGE.BODB02" />
    <add name="DBAGE.BODB02" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("DBAGE.BODB02") #>" />
	<remove name="DBAGE.bodb_AGE" />
    <add name="DBAGE.bodb_AGE" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("DBAGE.bodb_AGE") #>" />
	<remove name="DBARC.bodb_Archive" />
    <add name="DBARC.bodb_Archive" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("DBARC.bodb_Archive") #>" />
	<remove name="age_archive" />
    <add name="age_archive" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("age_archive") #>" />
	<remove name="archive06" />
    <add name="archive06" providerName="System.Data.SqlClient" connectionString="<#= connectionStrings.GetValue("archive06") #>"  />
	<remove name="CustomerLog" />
    <add name="CustomerLog" providerName="System.Data.SqlClient"  connectionString="<#= connectionStrings.GetValue("CustomerLog") #>" />
  </connectionStrings>
  <system.web>
    <compilation debug="<#= compilations.GetValue("debug") #>" targetFramework="4.0">
      <assemblies>
        <add assembly="System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Drawing, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Data, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Xml, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Data.OracleClient, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Management, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Configuration.Install, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Messaging, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.EnterpriseServices, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
      </assemblies>
    </compilation>
    <authentication mode="Forms">
      <forms loginUrl="~/Root.aspx" path="/" defaultUrl="~/Index.aspx" name="IBCAffLogin" protection="All"/>
    </authentication>
    <authorization>
      <allow users="*"/>
    </authorization>
    <customErrors mode="<#= customErrors.GetValue("mode") #>" defaultRedirect="Error/Error.htm">
      <error statusCode="404" redirect="Error/PageNotFound.htm"/>
    </customErrors>    
    <sessionState mode="StateServer"/>
    <pages enableViewState="false" theme="Default" controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID"/>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8"/>
    <httpHandlers>
      <add verb="*" path="*.html" type="BetterUrlRewriter" validate="false"/>
    </httpHandlers>
  </system.web>
  <cachingConfiguration defaultCacheManager="Cache Manager">
    <cacheManagers>
      <add name="Cache Manager" type="Microsoft.Practices.EnterpriseLibrary.Caching.CacheManager, Microsoft.Practices.EnterpriseLibrary.Caching, Version=5.0.414.0" expirationPollFrequencyInSeconds="1000" maximumElementsInCacheBeforeScavenging="500" numberToRemoveWhenScavenging="10" backingStoreName="Null Storage"/>
    </cacheManagers>
    <backingStores>
      <add encryptionProviderName="" type="Microsoft.Practices.EnterpriseLibrary.Caching.BackingStoreImplementations.NullBackingStore, Microsoft.Practices.EnterpriseLibrary.Caching, Version=5.0.414.0" name="Null Storage"/>
    </backingStores>
  </cachingConfiguration>
  <dataConfiguration defaultDatabase="CustomerLog" />
  <loggingConfiguration name="Logging Application Block" tracingEnabled="true" defaultCategory="Affiliate_12Bet" logWarningsWhenNoCategoriesMatch="true">
    <listeners>
      <add source="IBCAffiliate" formatter="Text Formatter" log="Application" machineName="" listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.FormattedEventLogTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" traceOutputOptions="None" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.FormattedEventLogTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="Formatted EventLog TraceListener"/>
      <add fileName="Logs/trace.log" rollSizeKB="1000" timeStampPattern="yyyy-MM-dd" rollFileExistsBehavior="Increment" rollInterval="Day" formatter="Text Formatter" header="" footer="----------------------------------------" listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" traceOutputOptions="None" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="IBCAffiliate"/>
	  <remove name="Database Trace Listener" />
      <add name="Database Trace Listener" type="Microsoft.Practices.EnterpriseLibrary.Logging.Database.FormattedDatabaseTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging.Database, Version=5.0.414.0, Culture=neutral"
		listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Database.Configuration.FormattedDatabaseTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging.Database, Version=5.0.414.0, Culture=neutral"
		databaseInstanceName="CustomerLog" writeLogStoredProcName="WriteLog_AppLog"
		addCategoryStoredProcName="Acc_AppLog_CategoryIns" formatter="Text Formatter"
		traceOutputOptions="LogicalOperationStack, DateTime, Timestamp, ProcessId, ThreadId, Callstack" />
	  <remove name="Affiliate Email Trace Listener" />
      <add name="Affiliate Email Trace Listener" <#= loggingConfigurations.GetValue("AffiliateEmailTraceListener") #> />
    </listeners>
    <formatters>
      <add template="{timestamp} -- {message} -- {category}" type="Microsoft.Practices.EnterpriseLibrary.Logging.Formatters.TextFormatter, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="Text Formatter"/>
    </formatters>
    <categorySources>
      <add switchValue="All" name="Affiliate_12Bet">
        <listeners>
          <add name="IBCAffiliate"/>
        </listeners>
      </add>
    </categorySources>
    <specialSources>
      <allEvents switchValue="All" name="All Events"/>
      <notProcessed switchValue="All" name="Unprocessed Category"/>
      <errors switchValue="All" name="Logging Errors &amp; Warnings">
        <listeners>
          <add name="IBCAffiliate"/>
        </listeners>
      </errors>
    </specialSources>
  </loggingConfiguration>
  <system.webServer>
    <handlers>
	  <remove name="*.html_*" />
      <add name="*.html_*" path="*.html" verb="*" type="BetterUrlRewriter" preCondition="integratedMode,runtimeVersionv2.0"/>
    </handlers>
  </system.webServer>
  <system.serviceModel>
    <bindings/>
    <client/>
  </system.serviceModel>
</configuration>