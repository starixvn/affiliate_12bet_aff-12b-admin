@helper RenderAppContactSignUp(string name, int order, string dependentProp)
{
    var index = order - 1;

    <div class="items validate-group">
        <label for="ContactAppList[@index].Value" class="custom-label">@(Fanex.Affiliate.User.Core.Resources.Lang.ResourceManager.GetString(name) ?? name)</label>
        <input type="text" name="ContactAppList[@index].Value" id="ContactAppList[@index].Value" class="form-input" value=""
               data-val="true" data-val-requiredifnullorempty-dependentprop="@dependentProp"
               data-val-requiredifnullorempty="@Fanex.Affiliate.User.Core.Resources.Error.RequireIMAccount" />
        <span class="field-validation-valid validate-input hide"
              data-valmsg-for="ContactAppList[@index].Value" data-valmsg-replace="true"></span>

        <input type="hidden" name="ContactAppList[@index].Name" value="@name" />
        <input type="hidden" name="ContactAppList[@index].Order" value="@order" />
    </div>
}

@helper RenderAlternateAndCanonicalLinks(string function, string language)
{
    if (Fanex.Affiliate.User.Core.Constants.SystemLanguage.SupportedAlternateLanguages.TryGetValue(language, out var alternateLanguages))
    {
        foreach (var al in alternateLanguages)
        {
            if (string.IsNullOrEmpty(al.Value))
            {
                <link rel="canonical" href="https://www.12betaffiliate.com/@(al.Key)/@(function)" />
            }
            else
            {
                <link rel="alternate" href="https://www.12betaffiliate.com/@(al.Key)/@(function)" hreflang="@al.Value" />
            }
        }
    }
}