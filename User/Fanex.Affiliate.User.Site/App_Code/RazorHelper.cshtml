@helper RenderDropdownForMarketing(string id, string label, IEnumerable<System.Web.Mvc.SelectListItem> dataList, bool hasAllOption = true, bool isVisible = true)
{
    <div class="form-group flex-sm-boostrap flex-center @(isVisible ? string.Empty : "hide")">
        <label class="col-sm-3 col-lg-2 control-label" for="@id">@label</label>
        <div class="col-sm-4 col-md-5 col-lg-3">
            <select class="form-control" id="@id">
                @if (hasAllOption)
                {
                    <option value="">@Fanex.Affiliate.User.Core.Resources.Lang.All</option>
                }

                @foreach (var item in dataList)
                {
                    <option value="@item.Value" @(item.Selected ? "selected" : string.Empty)>@item.Text</option>
                }
            </select>
        </div>
    </div>
}

@helper RenderDropdownForMarketingHasNoInfo(string id, string label, IEnumerable<System.Web.Mvc.SelectListItem> dataList, bool hasAnyDomain = false)
{
    <div class="form-group flex-sm-boostrap flex-center">
        <label class="col-sm-3 col-lg-2 control-label" for="@id">@label</label>
        <div class="col-sm-4 col-md-5 col-lg-3">
            <select class="form-control" id="@id">
                @if (hasAnyDomain)
                {
                    foreach (var item in dataList)
                    {
                        <option value="@item.Value" @(item.Selected ? "selected" : string.Empty)>@item.Text</option>
                    }
                }
                else
                {
                    <option value="">@Fanex.Affiliate.User.Core.Resources.Lang.NoInfo</option>
                }
            </select>
        </div>
    </div>
}

@helper RenderMultipleSelect(string id, string label, IEnumerable<System.Web.Mvc.SelectListItem> dataList, bool hasAllOption = true, System.Web.Mvc.SelectListItem itemDefaultOption = null, string className = null)
{
    var displayText = "Please select";
    var selectedValues = dataList.Where(d => d.Selected).Select(d => d.Value);
    var selectedItemCount = selectedValues.Count();
    var hasSelectedItem = selectedItemCount >= 1;

    if (hasSelectedItem)
    {
        displayText = $"{selectedItemCount} selected";
    }
    <div class="form-group @className" id="@($"{id}")">
        <label>@label</label>
        <div id="@($"{id}-multiple-select")" class="multiple-select-container @(hasSelectedItem ? "" : "multiple-select-wrapper is-invalid")">
            <button id="@($"{id}-multiple-select-label")" type="button" class="form-control multiple-select-default multiple-select-label">
                <span id="@($"{id}-multiple-select-text-display")" class="text-display">@displayText</span>
                <b class="caret @($"{id}-multiple-select-caret")"></b>
            </button>
            <div id="@($"{id}-multiple-select-options-container")" class="multiple-select-default multiple-select-options-container" style="display:none;">
                @RenderOptionAll(id, dataList, hasAllOption, itemDefaultOption)
                <ul class="multiple-select-options">
                    @foreach (var item in dataList)
                    {
                        @RenderOption(id, item);
                    }
                </ul>
            </div>
        </div>
    </div>
}

@helper RenderOptionAll(string id, IEnumerable<System.Web.Mvc.SelectListItem> dataList, bool hasAllOption = true, System.Web.Mvc.SelectListItem itemDefaultOption = null)
{
    if (hasAllOption)
    {
        <ul class="multiple-select-options multiple-select-option-all">
            @if (itemDefaultOption is null)
            {
                var checkedItemCount = dataList.Where(d => d.Selected).Count();
                var checkedAll = checkedItemCount == dataList.Count();

                <li class="multiple-select-item">
                    <input id="@(id)-multiple-select-option-all"
                           type="checkbox"
                           class="multiple-select-option-checkbox"
                           checked="@checkedAll" />
                    <label class="multiple-select-option-label" for="@(id)-multiple-select-option-all">
                        All
                    </label>
                </li>
            }
            else
            {
                <li class="multiple-select-item">
                    <input id="@(id)-multiple-select-option-all"
                           type="checkbox"
                           class="multiple-select-option-checkbox"
                           checked="@itemDefaultOption.Selected" />
                    <label class="multiple-select-option-label" for="@(id)-multiple-select-option-all">
                        @itemDefaultOption.Text
                    </label>
                </li>
            }
        </ul>
    }
}

@helper RenderOption(string id, System.Web.Mvc.SelectListItem item)
{
    <li class="multiple-select-item">
        <input id="@($"{id}-{item.Value}")"
               type="checkbox"
               class="multiple-select-option-checkbox @($"{id}-multiple-select-option-checkbox")"
               value="@item.Value"
               checked="@item.Selected" />
        <label class="multiple-select-option-label" for="@($"{id}-{item.Value}")">
            @item.Text
        </label>
    </li>
}

@helper RenderAppContact(string language)
{
    var firstAppName = Fanex.Affiliate.User.Core.Constants.AppContact.FirstAppContactName;
    var secondAppContactList = Fanex.Affiliate.User.Core.Constants.AppContact.SecondAppContactList;
    var thirdAppContactList = Fanex.Affiliate.User.Core.Constants.AppContact.ThirdAppContactList;

    var hasTwoContactApp = secondAppContactList.ContainsKey(language);
    var hasThirdContactApp = thirdAppContactList.ContainsKey(language);

    <div class="form-group validate-group">
        <label for="ContactAppList[0].Value" class="col-sm-3 control-label @(hasTwoContactApp ? string.Empty : "require")">@(Fanex.Affiliate.User.Core.Resources.Lang.ResourceManager.GetString(firstAppName) ?? firstAppName)</label>
        @if (hasTwoContactApp)
        {
            <div class="col-sm-4">
                <input type="text" name="ContactAppList[0].Value" id="ContactAppList[0].Value" class="form-control" value=""
                       data-val="true" data-val-requiredifnullorempty-dependentprop="ContactAppList[1].Value@(hasThirdContactApp ? ",ContactAppList[2].Value" : "" )"
                       data-val-requiredifnullorempty="@Fanex.Affiliate.User.Core.Resources.Error.RequireIMAccount" />
            </div>
        }
        else
        {
            <div class="col-sm-4">
                <input type="text" name="ContactAppList[0].Value" id="ContactAppList[0].Value" class="form-control" value=""
                       data-val="true" data-val-required="@Fanex.Affiliate.User.Core.Resources.Error.RequireIMAccount" />
            </div>
        }
        <div class="col-sm-offset-3 col-sm-9">
            <span class="field-validation-valid validate-input help-block hide"
                  data-valmsg-for="ContactAppList[0].Value" data-valmsg-replace="true"></span>
        </div>
        <input type="hidden" name="ContactAppList[0].Name" value="@firstAppName" />
        <input type="hidden" name="ContactAppList[0].Order" value="1" />
    </div>

    if (hasTwoContactApp)
    {
        var secondAppName = secondAppContactList[language];
        <div class="form-group validate-group">
            <label for="ContactAppList[1].Value" class="col-sm-3 control-label">@(Fanex.Affiliate.User.Core.Resources.Lang.ResourceManager.GetString(secondAppName) ?? secondAppName)</label>
            <div class="col-sm-4">
                <input type="text" name="ContactAppList[1].Value" id="ContactAppList[1].Value" class="form-control" value=""
                       data-val="true" data-val-requiredifnullorempty-dependentprop="ContactAppList[0].Value@(hasThirdContactApp ? ",ContactAppList[2].Value" : "" )"
                       data-val-requiredifnullorempty="@Fanex.Affiliate.User.Core.Resources.Error.RequireIMAccount" />
            </div>
            <div class="col-sm-offset-3 col-sm-9">
                <span class="field-validation-valid validate-input help-block hide"
                      data-valmsg-for="ContactAppList[1].Value" data-valmsg-replace="true"></span>
            </div>
            <input type="hidden" name="ContactAppList[1].Name" value="@secondAppName" />
            <input type="hidden" name="ContactAppList[1].Order" value="2" />
        </div>
        if (hasThirdContactApp)
        {
            var thirdAppName = thirdAppContactList[language];
            <div class="form-group validate-group">
                <label for="ContactAppList[2].Value" class="col-sm-3 control-label">@(Fanex.Affiliate.User.Core.Resources.Lang.ResourceManager.GetString(thirdAppName) ?? thirdAppName)</label>
                <div class="col-sm-4">
                    <input type="text" name="ContactAppList[2].Value" id="ContactAppList[2].Value" class="form-control" value=""
                           data-val="true" data-val-requiredifnullorempty-dependentprop="ContactAppList[0].Value,ContactAppList[1].Value"
                           data-val-requiredifnullorempty="@Fanex.Affiliate.User.Core.Resources.Error.RequireIMAccount" />
                </div>
                <div class="col-sm-offset-3 col-sm-9">
                    <span class="field-validation-valid validate-input help-block hide"
                          data-valmsg-for="ContactAppList[2].Value" data-valmsg-replace="true"></span>
                </div>
                <input type="hidden" name="ContactAppList[2].Name" value="@thirdAppName" />
                <input type="hidden" name="ContactAppList[2].Order" value="3" />
            </div>
        }
    }
}

