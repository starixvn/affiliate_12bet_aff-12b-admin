<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">  
  <system.web>
    <compilation xdt:Transform="Remove" />
    <customErrors mode="Off" xdt:Transform="SetAttributes(mode)" />

    <authentication mode="Forms">
      <forms loginUrl="~/Home/Index" timeout="20" cookieless="UseCookies" path="/" defaultUrl="~/UserPanel/Main/#AccountOverview" name="Fanex.AffAsiaUserForm" slidingExpiration="true" protection="All" xdt:Transform="Replace" />
    </authentication>

    <sessionState mode="StateServer" stateConnectionString="tcpip=ha.nexdev.net:42424"  cookieName="Fanex.AffAsisaUserSession" cookieless="false" timeout="20" xdt:Transform="Replace"/>
  </system.web>
</configuration>