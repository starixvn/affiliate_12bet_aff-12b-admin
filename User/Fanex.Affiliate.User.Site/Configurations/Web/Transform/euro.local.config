<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <compilation xdt:Transform="Remove" />
    <customErrors mode="Off" xdt:Transform="SetAttributes(mode)" />

    <authentication mode="Forms">
      <forms loginUrl="~/Home/Index" timeout="20" cookieless="UseCookies" path="/" defaultUrl="~/UserPanel/Main/#AccountOverview" name="Fanex.AffEuroUserForm" slidingExpiration="true" protection="All" xdt:Transform="Replace" />
    </authentication>
  </system.web>
</configuration>