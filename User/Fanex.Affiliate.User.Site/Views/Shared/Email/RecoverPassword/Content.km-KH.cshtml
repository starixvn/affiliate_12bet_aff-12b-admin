@model Fanex.Affiliate.User.Core.MetalModels.Email.RecoverPasswordEmailParam
@{
    var userInfo = Model.User;
    var recoverUrl = Model.RootDomain + "Password/RecoverPassword?uid=" + userInfo.AffId + "&vid=" + Model.Code;
}

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                សូមគោរព @userInfo.FirstName,<br /><br />

                អ្នកបានស្នើសុំការសង្គ្រោះឈ្មោះប្រើឬពាក្យសម្ងាត់របស់អ្នកមកវិញ ប្រសិនបើអ្នកមិនបានស្នើសុំទេ មិនចាំបាច់ខ្វល់ពីអ៊ីមែលនេះទេ។<br />
                បើមិនដូច្នេះទេ សូមចូលទៅកាន់តំណភ្ជាប់ខាងក្រោម នោះពាក្យសម្ងាត់ថ្មីរបស់អ្នកនឹងត្រូវបានផ្ញើមកអ្នកក្នុងពេលឆាប់ៗនេះ៖<br />
                <a href='@recoverUrl'>@recoverUrl</a><br /><br />

                សូម​ចំណាំ<br />
                * ឈ្មោះប្រើរបស់អ្នកគឺ: @userInfo.UserName <br />
                * ដោយសារហេតុផលសុវត្ថិភាព យើងត្រូវផ្តល់ឱ្យអ្នកនូវពាក្យសម្ងាត់ថ្មី (អ្នកអាចផ្លាស់ប្តូរវាបានគ្រប់ពេលវេលា)<br />
                * តំណខាងលើនឹងត្រូវផុតកំណត់ ហើយក្លាយជាគ្មានប្រយោជន៍ក្នុងរយៈពេល 24 ម៉ោង។<br /><br />

                សូមជួបតែសំណាងល្អ!<br /><br />

                ដោយក្តីគោរព,<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)
