@model Fanex.Affiliate.User.Core.MetalModels.Email.VerificationAccountEmailParam
@{
    var userInfo = Model.User;
    var forgotPasswordUrl = Model.RootDomain + "Password";
    var contacUsLink = Model.RootDomain + "ContactUs";
}
<div>
    <h3>សូមគោរព @userInfo.FirstName @userInfo.LastName,</h3><br />

    នេះគឺជាលេខកូដផ្ទៀងផ្ទាត់ដែលអ្នកត្រូវចូលទៅគណនី @userInfo.UserName:<br />

    <h3>@Model.Code</h3><br />

    ដោយសារតែអ៊ីមែល​មួយនេះ​​បាន​ចូល​បរាជ័យ​ជា​ច្រើននិង​ជាប់​ៗគ្នា​ពី​វេបសាយឬ​ពីទូរស័ព្ទ​ចល័ត​ដែល​មាន​ទីតាំង​នៅ  <a href="@string.Format("https://iplocation.com/?ip={0}", Model.Ip)">@Model.Ip។</a><br />
    លេខកូដផ្ទៀងផ្ទាត់ត្រូវបានទាមទារដើម្បីបញ្ចប់ការចូល លេខកូដនឹងផុតកំណត់បន្ទាប់ពី 15 នាទី។<br />
    ប្រសិនបើអ្នកចង់ចូលទៅគណនីរបស់អ្នកទេ សូមផ្លាស់ប្តូរពាក្យសម្ងាត់ ហើយពិចារណាផ្លាស់ប្តូរពាក្យសម្ងាត់អ៊ីមែលរបស់អ្នកដើម្បីធានាសុវត្ថិភាព។<br /><br />

    ប្រសិនបើអ្នកមិនអាចចូលប្រើគណនីរបស់អ្នកបានទេ នោះ <a href='@forgotPasswordUrl'>ប្រើតំណដែលភ្លេចពាក្យសម្ងាត់នេះ</a> ម្រាប់ជំនួយក្នុងការទទួលបានពាក្យសម្ងាត់ថ្មី។<br /><br />

    ក្រុមភ្នាក់ងារ 12BET<br />

    <a href="@contacUsLink">@contacUsLink</a>
</div>