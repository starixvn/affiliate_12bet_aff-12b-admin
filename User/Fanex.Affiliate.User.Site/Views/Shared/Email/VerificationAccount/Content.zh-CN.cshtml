@model Fanex.Affiliate.User.Core.MetalModels.Email.VerificationAccountEmailParam
@{
    var userInfo = Model.User;
    var forgotPasswordUrl = Model.RootDomain + "Password";
}

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                <h3>敬爱的@(userInfo.FirstName)：</h3><br />

                以下是登录账号@(userInfo.UserName) 所需的验证码：<br />

                <h3>@Model.Code</h3><br />

                这封邮件的发送，是由于从位于 <a href="@string.Format("https://iplocation.com/?ip={0}", Model.Ip)">@Model.Ip</a>，的网络或移动设备，连续输入错误密码所产生的。<br />
                完成登录需要输入此验证码，验证码将在15分钟后失效。<br />
                如果您没有尝试登录，建议更改账户及邮箱密码，已确保账户安全。<br /><br />

                如果无法登录自己的账户，请点击<a href='@forgotPasswordUrl'>忘记密码</a>，以获取新密码。<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)