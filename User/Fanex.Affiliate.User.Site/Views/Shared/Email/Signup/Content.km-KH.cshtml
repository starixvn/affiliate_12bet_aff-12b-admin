@model Fanex.Affiliate.User.Core.MetalModels.Email.EmailSignUpParam

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                សូមគោរព @Model.User.FirstName,<br /><br />

                យើងកំពុងផ្ញើលិខិតនេះទៅអ្នកដើម្បីឱ្យដឹងថាយើងបានទទួលពាក្យសុំរបស់អ្នកដើម្បីក្លាយជាភ្នាក់ងារ 12BET។ បច្ចុប្បន្នក្រុមរបស់យើងកំពុងពិនិត្យមើលពាក្យសុំរបស់អ្នក ហើយយើងអរគុណចំពោះការចាប់អារម្មណ៍របស់អ្នក។<br /><br />

                12BET យើងតែងតែស្វែងរកដៃគូដែលមានទេពកោសល្យ និងខិតខំប្រឹងប្រែងដើម្បីចូលរួមកម្មវិធីរបស់យើង។ យើងប្តេជ្ញាផ្តល់ជូនភ្នាក់ងាររបស់យើងនូវការគាំទ្រ និងធនធានដែលពួកគេត្រូវការដើម្បីទទួលបានជោគជ័យ ហើយយើងជឿជាក់ថាការធ្វើការរួមគ្នាគឺជាគន្លឹះសម្រាប់ភាពជាដៃគូដែលមានផលចំណេញ។<br /><br />

                វាអាចចំណាយពេលរហូតដល់ 3 ថ្ងៃធ្វើការដើម្បីពិនិត្យមើលពាក្យសុំរបស់អ្នក សូមប្រាកដថាយើងនឹងចំណាយពេលពិចារណាដោយប្រុងប្រយ័ត្ននូវព័ត៌មានទាំងអស់ដែលអ្នកបានផ្តល់។<br /><br />

                អ្នកគ្រប់គ្រងភ្នាក់ងាររបស់យើងនឹងទាក់ទងទៅអ្នកតាម <strong>@Model.IMName: @Model.IMValue</strong> ឬតាមលេខទំនាក់ទំនងដែលផ្តល់ដោយអ្នក៖ <strong>@Model.ContactNumber</strong> ខណៈពេលកំពុងពិនិត្យមើលពាក្យសុំរបស់អ្នក។ សូមឆ្លើយតបមកវិញ ហើយធ្វើបច្ចុប្បន្នភាពមកយើងនូវព័ត៌មានលម្អិតទំនាក់ទំនងរបស់អ្នក ប្រសិនបើព័ត៌មានលម្អិតដែលបានរៀបរាប់ខាងលើមិនត្រឹមត្រូវ។<br /><br />

                សូមអរគុណចំពោះការអត់ធ្មត់របស់អ្នក និងសម្រាប់ការពិចារណា 12BET ជាដៃគូសក្តានុពល។<br /><br />

                ដោយក្តីគោរពរាប់អាន<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)