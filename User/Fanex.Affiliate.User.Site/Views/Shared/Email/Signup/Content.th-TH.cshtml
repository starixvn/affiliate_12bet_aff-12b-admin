@model Fanex.Affiliate.User.Core.MetalModels.Email.EmailSignUpParam

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                เรียน คุณพันธมิตร @Model.User.FirstName,<br /><br />

                เราขอแจ้งให้คุณทราบว่าเราได้รับใบสมัครของคุณเพื่อเป็นพันธมิตร 12BET แล้ว ทีมงานของเรากําลังตรวจสอบใบสมัครของคุณและเราขอขอบคุณที่คุณสนใจที่จะร่วมงานกับเรา<br /><br />

                12BET เรากำลังมองหาพันธมิตรที่มีความสามารถและพร้อมที่จะทุ่มเทมาร่วมเป็นส่วนหนึ่งกับเรา เราพร้อมที่จะดูแลและสนับสนุนพันธมิตรของเราด้วยทรัพยากรที่จำเป็นต่อการประสบความสำเร็จ และเรามีความเชื่ออย่างยิ่งว่าการทำงานร่วมกันเป็นกุญแจสำคัญสำหรับการเป็นหุ้นส่วนที่ทำกำไรได้อย่างยั่งยืน<br /><br />

                อาจใช้เวลาถึง 3 วันทำการในการตรวจสอบใบสมัครของคุณ โปรดมั่นใจว่าเราจะใช้เวลาในการพิจารณาข้อมูลทั้งหมดที่คุณให้มาอย่างรอบคอบ<br /><br />

                ผู้จัดการพันธมิตรของเราอาจพยายามติดต่อคุณที่ <strong>@Model.IMName: @Model.IMValue</strong> หรือหมายเลขติดต่อที่คุณให้ไว้: <strong>@Model.ContactNumber</strong> ในขณะที่ตรวจสอบใบสมัครของคุณ โปรดตอบกลับและอัปเดตรายละเอียดการติดต่อของคุณให้เราทราบหากรายละเอียดดังกล่าวไม่ถูกต้อง<br /><br />

                ขอขอบคุณที่อดทนรอการพิจารณาจาก12BET<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)