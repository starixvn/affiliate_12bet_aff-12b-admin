@model Fanex.Affiliate.User.Core.MetalModels.Email.PaymentEmailParam

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                សូមគោរព @Model.User.FirstName,<br /><br />

                ស្នើសុំលេខយោងគឺ @Model.TransId, ចុះថ្ងៃទី @Model.RequestDate.ToString("MM/dd/yyyy")<br /><br />

                សំណើទឹកប្រាក់ទូទាត់របស់អ្នកចំនួន $@Model.Amount ត្រូវបានលុបចោល.<br /><br />

                នេះជាអ៊ីមែលដែលបង្កើតឡើងដោយប្រព័ន្ធស្វ័យប្រវត្តិ សូមកុំឆ្លើយតបអ៊ីមែលនេះ។<br />
                សូមកុំស្ទាក់ស្ទើរក្នុងការទាក់ទងមកយើងប្រសិនបើអ្នកមានសំណួរឬមតិយោបល់ជាមួយ <a href="mailto:@Model.MailContact">@Model.MailContact</a><br /><br />

                សូមជួបតែសំណាងល្អ!<br /><br />

                ដោយក្តីគោរព,<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)