@model Fanex.Affiliate.User.Core.MetalModels.Email.PaymentEmailParam

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                尊敬的 @Model.User.FirstName,<br /><br />

                您好，<br /><br />

                您交易代码@(Model.TransId)，日期@(Model.RequestDate.ToString("MM/dd/yyyy"))，金额为 $@(Model.Amount)的支付申请已被取消。<br /><br />

                此邮件为系统邮件，请不要直接回复。<br /><br />

                如有任何疑问，欢迎致信<a href="mailto:@Model.MailContact">@Model.MailContact</a>联系我们<br /><br />

                诚挚的<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)