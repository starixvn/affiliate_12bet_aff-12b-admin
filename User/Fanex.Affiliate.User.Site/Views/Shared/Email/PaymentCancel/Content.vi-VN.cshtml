@model Fanex.Affiliate.User.Core.MetalModels.Email.PaymentEmailParam

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                Thân gửi @Model.User.FirstName<br /><br />

                Bạn đã gửi cho chúng tôi yêu cầu thanh toán số @Model.TransId vào ngày @Model.RequestDate.ToString("MM/dd/yyyy")<br /><br />

                Chúng tôi xin thông báo yêu cầu thanh toán của bạn với số tiền $@Model.Amount đã bị hủy bỏ.<br /><br />

                Đây là lá thư tự động do hệ thống gửi, xin vui lòng không trả lời trực tiếp lá thư này. <br />
                Mọi thắc mắc xin liên hệ tới <a href="mailto:@Model.MailContact">@Model.MailContact</a>.<br /><br />

                Xin chân thành cảm ơn. <br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)