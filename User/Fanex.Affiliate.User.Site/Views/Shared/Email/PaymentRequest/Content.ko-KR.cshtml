@model Fanex.Affiliate.User.Core.MetalModels.Email.PaymentEmailParam

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                @(Model.User.FirstName) 제휴사님,<br /><br />

                제휴사님께서는 @(Model.RequestDate.ToString("MM/dd/yyyy"))에 @(Model.Amount)$의 지불을 요청하셨습니다.감사합니다.<br />
                요청 확인번호는  @(Model.TransId)입니다.<br /><br />

                제휴사님의 지불 요청은 7 영업일 안에 처리될 것입니다. 모든 요청은 접수된 순서에 따라 검토 되어집니다.<br /><br />

                본 메일은 시스템 자동발신 메일이므로 답신의 수신은 불가능합니다.<br />
                요청및 문의사항은 다음의 주소로 메일보내주시기 바랍니다. <a href="mailto:@Model.MailContact">@Model.MailContact</a>

                좋은 하루 되십시요!<br /><br />
                감사합니다.<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)