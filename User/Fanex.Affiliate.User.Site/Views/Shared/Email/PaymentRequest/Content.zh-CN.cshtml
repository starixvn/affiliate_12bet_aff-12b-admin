@model Fanex.Affiliate.User.Core.MetalModels.Email.PaymentEmailParam

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                尊敬的 @Model.User.FirstName,<br /><br />

                您好，<br /><br />

                我们已经收到了您日期为@(Model.RequestDate.ToString("MM/dd/yyyy"))，金额$@(Model.Amount), 交易单号为@(Model.TransId)的支付申请。<br /><br />

                我们会按照收到顺序依次审核所有支付申请，您的申请会在七个工作日内被审核完毕。<br /><br />

                此邮件为系统邮件，请不要直接回复。<br /><br />

                如有任何疑问，欢迎致信<a href="mailto:@Model.MailContact">@Model.MailContact</a>

                诚挚的<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)