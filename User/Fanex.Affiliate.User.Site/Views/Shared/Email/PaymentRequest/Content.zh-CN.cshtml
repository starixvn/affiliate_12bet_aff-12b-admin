@model Fanex.Affiliate.User.Core.MetalModels.Email.PaymentEmailParam

@{
    var requestDate = Model.RequestDate;

    var requestYear = requestDate.Year;
    var requestMonth = requestDate.Month;
    var requestDay = requestDate.Day;
}

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                尊敬的@(Model.User.FirstName)：<br /><br />

                您好，<br /><br />

                我们已经收到了您在@(requestYear)年@(requestMonth)月@(requestDay)日的付款申请，金额为$@(Model.Amount)。<br />
                申请单号：@Model.TransId。<br /><br />

                所有申请将按照收到的先后顺序进行审核，您的申请会在七个工作日内审核完毕。<br /><br />

                此邮件为系统邮件，请不要直接回复。<br /><br />

                如有任何疑问，请随时通过 <a href="mailto:@Model.MailContact">@Model.MailContact</a> 与我们联系。<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)