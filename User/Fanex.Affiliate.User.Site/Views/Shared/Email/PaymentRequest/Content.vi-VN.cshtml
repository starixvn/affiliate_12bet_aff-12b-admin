@model Fanex.Affiliate.User.Core.MetalModels.Email.PaymentEmailParam

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                Thân gửi @Model.User.FirstName<br /><br />

                Chúng tôi đã nhận được yêu cầu thanh toán của bạn vào ngày @Model.RequestDate.ToString("MM/dd/yyyy") với số tiền $@Model.Amount.<br />
                Yêu cầu thanh toán số @Model.TransId.<br /><br />

                Yêu cầu này sẽ được xử lý trong vòng 7 ngày làm việc kể từ khi chúng tôi nhận được.<br /><br />

                Đây là thông báo tự động do hệ thống gửi, xin vui lòng không trả lời trực tiếp thư này.<br />
                Mọi thắc mắc xin liên hệ tới <a href="mailto:@Model.MailContact">@Model.MailContact</a><br /><br />

                Xin chân thành cảm ơn.<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)