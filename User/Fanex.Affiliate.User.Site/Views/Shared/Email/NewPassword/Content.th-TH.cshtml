@model Fanex.Affiliate.User.Core.MetalModels.Email.NewPasswordEmailParam
@{
    var userInfo = Model.User;
}

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                เเรียน @userInfo.FirstName<br /><br />

                ตามที่คุณได้ทำการขอร้องขอ เราจะให้รหัสผ่านใหม่แก่คุณ ข้อมูลบัญชีใหม่ของคุณมีดังนี้:<br /><br />

                --------------------------------------------------------<br />
                ชื่อผู้ใช้: @userInfo.UserName<br />
                รหัสผ่าน: @Model.NewPassword<br />
                --------------------------------------------------------<br /><br />

                อย่างไรก็ตาม คุณสามารถไปที่ <a href="@Model.RootDomain">@Model.RootDomain</a> เพื่อเปลี่ยนรหัสผ่านได้ตลอดเวลา<br /><br />

                ขอให้คุณโชคดี<br /><br />

                ขอแสดงความนับถือ<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)