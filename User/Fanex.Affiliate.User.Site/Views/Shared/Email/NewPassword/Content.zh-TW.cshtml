@model Fanex.Affiliate.User.Core.MetalModels.Email.NewPasswordEmailParam
@{
    var userInfo = Model.User;
}
<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                尊敬的@userInfo.FirstName<br /><br />

                根据您的申请，我们已经为您重置密码。您的帐户信息如下：<br /><br />

                ---------------------------------------- <br />
                用户名：@userInfo.UserName <br />
                密碼：@Model.NewPassword <br />
                ------------------------------------------ <br /><br />

                您可以随时登录网站 <a href="@Model.RootDomain">@Model.RootDomain</a> 更改密码。<br /><br />

                祝您有个愉快的一天！<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)