@model Fanex.Affiliate.User.Core.MetalModels.Email.NewPasswordEmailParam
@{
    var userInfo = Model.User;
}

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                Kính gửi @userInfo.FirstName<br /><br />

                Theo yêu cầu của bạn,chúng tôi cung cấp cho bạn một mật mã mới. Thông tin tài khoản mới của bạn như sau:<br /><br />

                --------------------------------------<br />
                Tên tài khoản:@userInfo.UserName<br />
                Mật khẩu:@Model.NewPassword<br />
                --------------------------------------<br /><br />

                Tuy nhiên, bạn có thể truy cập <a href="@Model.RootDomain">@Model.RootDomain</a> để thay đổi mật khẩu bất cứ lúc nào<br /><br />

                Xin chân thành cám ơn.<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)