@model Fanex.Affiliate.User.Core.MetalModels.Email.NewPasswordEmailParam
@{
    var userInfo = Model.User;
}

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                @(userInfo.FirstName)제휴사님께,<br /><br />

                제휴사님의 요청에 따라 ,  새로운 비밀번호를 발급 해 드립니다.
                고객님의 새로운 계정 정보는 다음과 같습니다.<br /><br />

                --------------------------------------------------------<br />
                아이디: @userInfo.UserName<br />
                비밀번호: @Model.NewPassword<br />
                --------------------------------------------------------<br /><br />

                다음의 링크를 방문하시면 <a href="@Model.RootDomain">@Model.RootDomain</a>  언제든지 비밀번호를 변경하실 수있습니다.<br /><br />

                좋은 하루 되십시요!<br /><br />

                감사합니다.<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)