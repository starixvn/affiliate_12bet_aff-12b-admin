@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using Fanex.Affiliate.User.Core.Utilities


@{
    var settingService = DependencyResolver.Current.GetService<IAppSetting>();
}

@section styles{
    @RenderSection("styles", required: false)
}

@section classNav{page-container}

@section scripts{
    <script src="~/www/build/js/lib/jsencrypt-2.3.1.min.js"></script>
    <script>
        window.JSEncrypt || document.write('\x3Cscript src="https://cdnjs.cloudflare.com/ajax/libs/jsencrypt/2.3.1/jsencrypt.min.js">\x3C/script>')
    </script>

    @Html.InlineScripts("~/www/build/js/pagetracking.js")

    <script type="text/javascript">
        var validationMessage = {
            enterUserName: "@Lang.ErrmsgEntryUsername",
            enterPassword: '@Lang.ErrmsgEntryPassword',
            enterValidationCode: '@Lang.ErrmsgEntryValidCode'
        }
    </script>

    @Html.InlineScripts("~/www/build/js/pages/login.js")
    @RenderSection("scripts", required: false)
}

<div class="main">
    <h1 class="hidden">@(string.IsNullOrEmpty(ViewBag.HeaderTitle) ? Lang.HomeHeaderTitle : ViewBag.HeaderTitle)</h1>
    <div class="main-content">
        @RenderBody()
    </div>
</div>