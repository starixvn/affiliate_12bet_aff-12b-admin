@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using Fanex.Affiliate.User.Core.CoreService

@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
}

@section alternateAndCanonicalTags{
    @RenderSection("alternateAndCanonicalTags", required: false)
}

@section styles{
    @RenderSection("styles", required: false)
}

@section classNav{page-container}

@section scripts{
    <script src="~/www/build/js/lib/jsencrypt-2.3.1.min.js"></script>
    <script>
        window.JSEncrypt || document.write('\x3Cscript src="https://cdnjs.cloudflare.com/ajax/libs/jsencrypt/2.3.1/jsencrypt.min.js">\x3C/script>')
    </script>

    @Html.InlineScripts("~/www/build/js/pagetracking.js")

    <script type="text/javascript">
        var validationMessage = {
            enterUserName: "@Lang.ErrmsgEntryUsername",
            enterPassword: '@Lang.ErrmsgEntryPassword',
            enterValidationCode: '@Lang.ErrmsgEntryValidCode'
        }
    </script>

    @Html.InlineScripts("~/www/build/js/pages/login.js")
    @RenderSection("scripts", required: false)
}

<div class="main">
    <h1 class="hidden">@(string.IsNullOrEmpty(ViewBag.HeaderTitle) ? Lang.HomeHeaderTitle : ViewBag.HeaderTitle)</h1>
    <div class="main-content">
        @RenderBody()
    </div>
</div>

<div class="modal fade login-dialog" tabindex="-1" role="dialog" id="loginDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-main-content">
                <div class="modal-body">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <img src="~/www/build/styles/Images/close-line.svg" alt="close-line" class="show-pc" />
                        <img src="~/www/build/styles/Images/close-line-mobile.svg" alt="close-line" class="show-mobile" />
                    </button>
                    <div class="main-login">
                        <div class="item">
                            <div class="login-login">
                                <img src="~/www/build/styles/Images/logo/@(sessionService.CurrentLanguage).png?v=012" alt="logo" width="230" />
                            </div>

                            <h2 class="logo-text">@Lang.AffiliateProgram</h2>
                            <div class="group-text">
                                <h3 class="title-affmember">@Lang.NotAffiliateMemberYet</h3>
                                <p id="signUpToAffiliateProgram">@Lang.SignUpToAffiliateProgram</p>
                            </div>
                            <a href="@Url.RenderLanguageContent("~/Signup")" role="button" class="btn-join btn-submit btn-block text-uppercase">@Lang.JoinNow</a>
                        </div>

                        <div class="item">
                            <div class="heading-login spacing-bt">@Lang.AffiliateLogin</div>
                            <form class="form-login">
                                <h3 class="title spacing-bt">@Lang.WelcomeBack</h3>
                                <div class="spacing-bt">
                                    <div class="custom-input">
                                        <input type="text" id="dialogtxtUsername" class="form-control" placeholder="@Lang.Username" />
                                    </div>
                                    <div class="custom-input">
                                        <input type="password" id="dialogtxtPassword" class="form-control" autocomplete="off" placeholder="@Lang.Password" />
                                    </div>
                                    <div class="custom-input columns-2">
                                        <input type="text" id="dialogtxtValidation" class="form-control captcha-input" placeholder="@Lang.Validation" />
                                        <div class="validation-value" id="loginDialogcaptchaBtn">
                                            <img src="" alt="captcha" id="loginDialogcaptchaImg" />
                                        </div>
                                    </div>
                                </div>
                                <button type="button" id="btnDialogLogin" class="btn-submit btn-block text-uppercase spacing-bt">@Lang.Login</button>
                                <a href="@Url.RenderLanguageContent("~/Password")" class="link-login-popup">@Lang.ForgotLoginDetail</a>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>