@using Fanex.Affiliate.User.Core.CoreService
@using Fanex.Affiliate.User.Core.BusinessService
@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var settingService = DependencyResolver.Current.GetService<IAppSetting>();
    var systemService = DependencyResolver.Current.GetService<ISystemService>();
    var userSession = sessionService.UserSession;
    var languageList = systemService.GetSystemTargetLanguages().Where(l => !l.LanguageCode.Equals("en-GB"));
    var currentLanguage = languageList.FirstOrDefault(l => l.LanguageCode.Equals(sessionService.CurrentLanguage))?.NativeLanguage;
    var path = HttpContext.Current.Request.Path;
}

<!DOCTYPE html>
<html lang="@SystemLanguage.GetSEOHtmlTagLangAttribute()">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(string.IsNullOrEmpty(ViewBag.Title) ? Lang.MetaHomeTitle : ViewBag.Title)</title>
    <link rel="icon" href="~/favicon.ico?v=1">
    <meta name="google-site-verification" content="iFkj5nsimoERnX2jd-9krswREsacSaFCr3Q22CJtQe0" />
    <meta name="msvalidate.01" content="D40D4C0F9E67ABAAAFA183F5D313FEFD" />
    <meta name="description" content="@(string.IsNullOrEmpty(ViewBag.MetaDescription) ? Lang.MetaHomeDescription : ViewBag.MetaDescription)" />
    <meta name="keywords" content="@(string.IsNullOrEmpty(ViewBag.MetaKeywords) ? Lang.MetaHomeKeywords : ViewBag.MetaKeywords)" />
    <meta name="robots" content="index,follow,archive" />
    <meta name="title" content="@Lang.MetaTitle" />

    <link rel="canonical" href="@(string.IsNullOrEmpty(ViewBag.CanonicalLink) ? SiteDomainHelper.GenCanonialSeoLink(String.Empty) : ViewBag.CanonicalLink)" />

    <script src="~/www/build/js/lib/jquery-3.3.1.min.js"></script>
    <script>
        window.jQuery || document.write('\x3Cscript src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous">\x3C/script>')
    </script>
    <script src="~/www/build/js/lib/bootstrap.min.js"></script>
    <link href="~/www/build/styles/css/bootstrap-3.3.7.min.css" rel="stylesheet" />

    <link href="~/www/build/styles/css/materialdesignicons.min.css" rel="stylesheet" type="text/css" />

    @if (sessionService.CurrentLanguage == SystemLanguage.VietNamLanguageCode)
    {
        <link href="@Url.RenderLink("~/www/build/styles/fonts/tahoma/font.css")" rel="stylesheet" />
    }
    else
    {
        if (sessionService.CurrentLanguage == SystemLanguage.CambodianLanguageCode)
        {
            <link href="@Url.RenderLink("~/www/build/styles/fonts/nokora/font.css")" rel="stylesheet" />
        }
        else
        {
            <link href="@Url.RenderLink("~/www/build/styles/fonts/Montserrat/font.css")" rel="stylesheet" />
        }
    }
    <link href="~/www/build/styles/fonts/myriadPro/font.css" rel="stylesheet" />
    <link href="@Url.RenderLink("~/www/build/styles/css/main.css")" rel="stylesheet" />
    @RenderSection("styles", required: false)
</head>
<body>
    <div class="header-top">
        <div class="page-container">
            <div class="logo-lang">
                <div class="logo">
                    <a href="@Url.Content("~")">
                        <img src="~/www/build/styles/Images/logo.png" alt="logo" />
                        <span class="logo-text">@Lang.Affiliate</span>
                    </a>
                </div>
                <div class="login">
                    <div class="user-signup">
                        @if (!HttpContext.Current.User.Identity.IsAuthenticated || userSession == null)
                        {
                            <a class="btn-auth btn-login" id="mobileLogin">
                                @Lang.Login
                            </a>
                            <a href="@Url.Content("~/Signup/Index")" class="btn-auth btn-signup">Join Now</a>
                        }

                        <div class="language-container">
                            <div class="language-selection">
                                <button class="select-language" id="selectedLanguage">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="25" viewBox="0 0 24 25" fill="none">
                                        <path d="M12.0007 23.9395C5.93334 23.9395 1.00131 19.0114 1 12.9474C0.998691 6.86697 5.93006 1.93821 12.0111 1.94214C18.0771 1.94607 23.002 6.87744 23 12.9454C22.998 19.0121 18.0686 23.9395 12.0007 23.9395ZM20.4721 9.72614C20.2574 9.29206 20.0446 8.87238 19.8429 8.44747C19.7631 8.2792 19.6583 8.21766 19.4645 8.22028C18.5891 8.23272 17.7131 8.22879 16.8377 8.22159C16.7323 8.22093 16.6047 8.19082 16.5274 8.126C16.3402 7.96887 16.1673 7.79078 16.0082 7.60484C15.9558 7.54395 15.9172 7.38223 15.9513 7.35015C16.2694 7.05225 16.4691 6.5527 17.0394 6.65615C17.4663 6.73406 17.7445 6.50098 18.0248 6.20046C17.8257 6.03874 17.6339 5.88292 17.4414 5.72709C17.3412 5.81548 17.2686 5.8803 17.1946 5.94512C16.8537 6.24323 16.4997 6.26069 16.1326 5.99749C16.0004 5.90321 15.9499 5.80239 16.0318 5.64591C16.1372 5.44425 16.2295 5.23671 16.3356 5.0141C15.1597 4.37575 13.9242 4.01107 12.5735 3.92923C12.5938 4.06606 12.6095 4.17606 12.6272 4.29718C12.5519 4.34301 12.4779 4.39211 12.4007 4.43533C12.1375 4.58264 11.8763 4.83667 11.6085 4.84453C11.3413 4.85238 11.0598 4.62585 10.7973 4.47985C10.265 4.18391 9.70847 4.27361 9.15523 4.36265C8.74079 4.42943 8.46384 4.74763 8.14303 4.98006C8.0075 5.07826 8.0219 5.20528 8.14761 5.30873C8.31195 5.4436 8.492 5.56014 8.64651 5.70549C8.79972 5.85018 8.93852 5.83774 9.11005 5.74674C9.46295 5.55883 9.82697 5.39253 10.1792 5.20332C10.3508 5.111 10.4909 5.10969 10.6519 5.22819C10.8752 5.39319 11.1011 5.56145 11.3479 5.68519C11.7329 5.87833 11.5882 6.21486 11.6 6.5036C11.6098 6.73668 11.3813 6.7537 11.2307 6.79298C10.6762 6.93833 10.2696 7.23492 9.96447 7.73906C9.75757 8.08082 9.58407 8.39509 9.64234 8.80036C9.66591 8.96601 9.57884 9.05112 9.43872 9.12052C9.07273 9.30123 8.71526 9.49961 8.34796 9.67769C8.18886 9.75495 8.09327 9.85316 8.05137 10.0319C7.97345 10.3652 7.86673 10.6912 7.77573 11.0212C7.71026 11.2588 7.56229 11.3734 7.31218 11.3688C6.95209 11.3623 6.58806 11.3996 6.23255 11.359C5.82465 11.3119 5.53723 11.46