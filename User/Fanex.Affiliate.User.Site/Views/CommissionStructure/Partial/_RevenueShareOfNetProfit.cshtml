<div class="block block-process">
    <div class="page-container">
        <div class="group-page">
            <div class="main-process">
                <div class="items">
                    <div class="mask">
                        <div class="icon">
                            <img src="~/www/build/styles/Images/commission/customer-winloss.png" alt="Customer Win/Loss" />
                        </div>
                        <div class="heading">
                            @Html.Raw(Lang.CustomerWinLoss)
                        </div>
                        <span class="process-arrow arrow-1">
                            <img src="~/www/build/styles/Images/commission/arrow-1.png" alt="arrow-1" />
                        </span>
                        <span class="process-arrow arrow-2">
                            <img src="~/www/build/styles/Images/commission/arrow-2.png" alt="arrow-2" />
                        </span>
                        <span class="process-arrow arrow-3">
                            <img src="~/www/build/styles/Images/commission/arrow-3.png" alt="arrow-3" />
                        </span>
                        <span class="process-arrow arrow-4">
                            <img src="~/www/build/styles/Images/commission/arrow-4.png" alt="arrow-4" />
                        </span>
                    </div>
                </div>
                <div class="items">
                    <div class="mask">
                        <div class="icon">
                            <img src="~/www/build/styles/Images/commission/platform-fee.png" alt="Platform Fee" />
                        </div>
                        <div class="heading">
                            @Lang.PlatformFee
                        </div>
                        <span class="process-arrow arrow-1">
                            <img src="~/www/build/styles/Images/commission/arrow-1.png" alt="arrow-1" />
                        </span>
                        <span class="process-arrow arrow-2">
                            <img src="~/www/build/styles/Images/commission/arrow-2.png" alt="arrow-2" />
                        </span>
                        <span class="process-arrow arrow-3">
                            <img src="~/www/build/styles/Images/commission/arrow-3.png" alt="arrow-3" />
                        </span>
                        <span class="process-arrow arrow-4">
                            <img src="~/www/build/styles/Images/commission/arrow-4.png" alt="arrow-4" />
                        </span>
                    </div>
                </div>
                <div class="items">
                    <div class="mask">
                        <div class="icon">
                            <img src="~/www/build/styles/Images/commission/banking-fee.png" alt="Banking Fee" />
                        </div>
                        <div class="heading">
                            @Lang.BankingFee
                        </div>
                        <span class="process-arrow arrow-1">
                            <img src="~/www/build/styles/Images/commission/arrow-1.png" alt="arrow-1" />
                        </span>
                        <span class="process-arrow arrow-2">
                            <img src="~/www/build/styles/Images/commission/arrow-2.png" alt="arrow-2" />
                        </span>
                        <span class="process-arrow arrow-3">
                            <img src="~/www/build/styles/Images/commission/arrow-3.png" alt="arrow-3" />
                        </span>
                        <span class="process-arrow arrow-4">
                            <img src="~/www/build/styles/Images/commission/arrow-4.png" alt="arrow-4" />
                        </span>
                    </div>
                </div>
                <div class="items">
                    <div class="mask">
                        <div class="icon">
                            <img src="~/www/build/styles/Images/commission/bonus.png" alt="Bonus" />
                        </div>
                        <div class="heading">
                            @Lang.Bonus
                        </div>
                        <span class="process-arrow arrow-1">
                            <img src="~/www/build/styles/Images/commission/arrow-1.png" alt="arrow-1" />
                        </span>
                        <span class="process-arrow arrow-2">
                            <img src="~/www/build/styles/Images/commission/arrow-2.png" alt="arrow-2" />
                        </span>
                        <span class="process-arrow arrow-3">
                            <img src="~/www/build/styles/Images/commission/arrow-3.png" alt="arrow-3" />
                        </span>
                        <span class="process-arrow arrow-4">
                            <img src="~/www/build/styles/Images/commission/arrow-4.png" alt="arrow-4" />
                        </span>
                    </div>
                </div>
                <div class="items">
                    <div class="mask">
                        <div class="icon">
                            <img src="~/www/build/styles/Images/commission/net-profit.png" alt="Net Profit" />
                        </div>
                        <div class="heading">
                            @Lang.NetProfit
                        </div>
                        <span class="process-arrow arrow-1">
                            <img src="~/www/build/styles/Images/commission/arrow-1.png" alt="arrow-1" />
                        </span>
                        <span class="process-arrow arrow-2">
                            <img src="~/www/build/styles/Images/commission/arrow-2.png" alt="arrow-2" />
                        </span>
                        <span class="process-arrow arrow-3">
                            <img src="~/www/build/styles/Images/commission/arrow-3.png" alt="arrow-3" />
                        </span>
                        <span class="process-arrow arrow-4">
                            <img src="~/www/build/styles/Images/commission/arrow-4.png" alt="arrow-4" />
                        </span>
                    </div>
                </div>
            </div>
            <div class="bottom-text">
                Affiliate earns revenue share of Net profit based on Commission structure Table.
            </div>
        </div>
    </div>
</div>