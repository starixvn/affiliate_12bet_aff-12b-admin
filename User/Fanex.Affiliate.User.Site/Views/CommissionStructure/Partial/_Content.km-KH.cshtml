<div class="block block-revenue">
    <div class="page-container">
        <div class="group-page">
            <div class="top-title">
                ការបែងចែកប្រាក់ចំណូល
            </div>
            <div class="description">
                គំរូនៃការបែងចែកប្រាក់ចំណូលរបស់ 12BET ត្រូវបានបែងចែកទៅជាសមាសធាតុផលិតផលផ្សេងៗគ្នា ហើយការគណនាសម្រាប់ផលិតផលនីមួយៗមានដូចខាងក្រោម។ ចំនួននៃការបែងចែកប្រាក់ចំណូលសរុបដែលភ្នាក់ងារជាដៃគូ នឹងទទួលបានគឺជាផលបូកនៃផ្នែកទាំងអស់នៃគំរូចែករំលែកប្រាក់ចំណូលនេះ។
            </div>
            <div class="description">
                សំរាប់គំរូបែងចែកប្រាក់ចំណូលអាចរកបាននៅក្នុងផលិតផល 12BET ទាំងអស់។ នេះគឺជាគំរូប្រាក់បន្ថែមដែលផ្អែកលើចំនួនអ្នកលេងសកម្មក្នុងមួយខែនៃប្រតិទិនដែលទាក់ទងនឹងចំណូលរបស់​ផលិតផល​នីមួយៗ។
            </div>
            <div class="slogan">
                ទទួលបានប្រាក់កម្រៃប្រចាំខែដ៏គួរអោយចាប់អារម្មណ៍បំផុត
                រហូតដល់ទៅ <span>50%</span> សំរាប់ព័ត៌មានបន្ថែម <span><a href="@Url.Content("~/Promotion")">សូមចុចទីនេះ</a></span>
            </div>
        </div>
    </div>
</div>

@{ Html.RenderPartial("~/Views/CommissionStructure/Partial/_RegularCommissionStructureTable.cshtml"); }

<div class="block block-text">
    <div class="page-container">
        <div class="group-page">
            <span class="font-bold">"ប្រាក់ចំណូលសុទ្ធ"</span> នៅក្នុងតារាងខាងលើ សំដៅលើចំនួនភ្នាល់របស់សមាជិកក្នុងខែដែលពាក់ព័ន្ធ ដោយមិនរាប់បញ្ចូល៖ <span>(i)</span> ប្រាក់ចំណេញ <span>(ii)</span> ប្រាក់រង្វាន់ដែលទទួលបាន <span>(iii)</span> ការកាត់កង និង <span>(iv)</span> ត្រឡប់មកវិញផ្សេងទៀត, ឥណទាន, សំណង ឬការបង្វិលជូនវិលសំរាប់សមាជិក។
        </div>
    </div>
</div>

