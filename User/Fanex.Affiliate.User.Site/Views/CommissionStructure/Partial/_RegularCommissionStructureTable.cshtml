<div class="block block-commission">
    <div class="page-container">
        <div class="heading-table">
            @Lang.RegularCommissionStructure
        </div>
        <div class="table-custom table-responsive">
            <table>
                <thead>
                    <tr>
                        <th width="25%">@Lang.RevenueShare</th>
                        <th width="5%">@Lang.Tier</th>
                        <th width="20%">@Lang.CompanyNetWin</th>
                        <th width="18%">@Lang.QualifyingMem</th>
                        <th width="20%">@Lang.Comm</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td rowspan="6" class="text-center">
                            <p class="all-products">@Lang.AllProducts</p>
                            <p><a class="more-detail" href="@Url.RenderLanguageContent("~/Product")">&gt; @Lang.MoreDetailProduct</a></p>
                        </td>
                        <td class="text-center">1</td>
                        <td class="text-center">≤$3,000</td>
                        <td rowspan="5" class="text-center word">≥ 5 </td>
                        <td class="text-center">30%</td>
                    </tr>
                    <tr>
                        <td class="text-center">2</td>
                        <td class="text-center">$3,001 - $45,000</td>
                        <td class="text-center">35%</td>
                    </tr>
                    <tr>
                        <td class="text-center">3</td>
                        <td class="text-center">$45,001 - $200,000</td>
                        <td class="text-center">40%</td>
                    </tr>
                    <tr>
                        <td class="text-center">4</td>
                        <td class="text-center">$200,001 - $250,000</td>
                        <td class="text-center">45%</td>
                    </tr>
                    <tr>
                        <td class="text-center">5</td>
                        <td class="text-center">≥$250,001</td>
                        <td class="text-center">50%</td>
                    </tr>
                    <tr>
                        <td class="text-center">6</td>
                        <td class="text-center" colspan="2">@Lang.ByInvitationOnly</td>
                        <td class="text-center">@Lang.Flat50</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>