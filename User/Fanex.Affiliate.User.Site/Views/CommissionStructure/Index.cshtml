@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = Lang.MetaCommissionStructureTitle;
    ViewBag.MetaDescription = Lang.MetaCommissionStructureDescription;
    ViewBag.MetaKeywords = Lang.MetaCommissionStructureKeywords;
    ViewBag.CanonicalLink = SiteDomainHelper.GenCanonialSeoLink(ControllerName.CommissionStructure);
    ViewBag.HeaderTitle = Lang.CommissionStructureHeaderTitle;
}

@model string

@{
    var bannerSrc = Url.Content($"~/www/build/styles/Images/commission/top-banner/item1/desktop.{Model}");
    var mobileBannerSrc = Url.Content($"~/www/build/styles/Images/commission/top-banner/item1/mobile.{Model}");
}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/commission-structure.css")" rel="stylesheet" />
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/pages/commission-structure.js")
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.CommissionStructure</span>
    </div>

    <div class="swiper top-banner">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <a class="nounderline home-banner-tracking-flat show-pc" target="_self" href="@Url.Content("~/Promotion")">
                    <picture>
                        <source srcset="@(bannerSrc).webp" type="image/webp" />
                        <source srcset="@(bannerSrc).jpg" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(bannerSrc).jpg" alt="Actived Commission Structure Banner" />
                    </picture>
                </a>
                <a class="nounderline home-banner-tracking-flat show-mobile" target="_self" href="@Url.Content("~/Promotion")">
                    <picture>
                        <source srcset="@(mobileBannerSrc).webp" type="image/webp" />
                        <source srcset="@(mobileBannerSrc).jpg" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(mobileBannerSrc).jpg" alt="Actived Commission Structure Banner" />
                    </picture>
                </a>
            </div>
        </div>
        @*<div class="swiper-pagination"></div>*@
    </div>
    @Html.RenderPartialByLanguage("~/Views/CommissionStructure/Partial/_Content", Model)
    @RazorHelper.RenderMovingTopButton()
</div>