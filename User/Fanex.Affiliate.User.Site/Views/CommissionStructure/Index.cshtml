@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = Lang.MetaCommissionStructureTitle;
    ViewBag.MetaDescription = Lang.MetaCommissionStructureDescription;
    ViewBag.MetaKeywords = Lang.MetaCommissionStructureKeywords;
    ViewBag.HeaderTitle = Lang.CommissionStructureHeaderTitle;
}

@model string

@{
    var bannerSrc = Url.Content($"~/www/build/styles/Images/commission/top-banner/item1/desktop.{Model}");
    var mobileBannerSrc = Url.Content($"~/www/build/styles/Images/commission/top-banner/item1/mobile.{Model}");

    var banner2Src = Url.Content($"~/www/build/styles/Images/commission/top-banner/item2/desktop.{Model}");
    var mobileBanner2Src = Url.Content($"~/www/build/styles/Images/commission/top-banner/item2/mobile.{Model}");
}

@section alternateAndCanonicalTags{
    @RazorHelper.RenderAlternateAndCanonicalLinks("CommissionStructure", Model)
}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/commission-structure.css")" rel="stylesheet" />
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/pages/commission-structure.js")
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.CommissionStructure</span>
    </div>

    <div class="swiper top-banner">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <a class="nounderline commission-structure-banner-tracking show-pc" target="_self" href="@Url.RenderLanguageContent("~/Promotion")">
                    <picture>
                        <source srcset="@(bannerSrc).webp?v=0.01" type="image/webp" />
                        <source srcset="@(bannerSrc).jpg?v=0.01" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(bannerSrc).jpg?v=0.01" alt="12Bet Affiliate programs" />
                    </picture>
                </a>
                <a class="nounderline commission-structure-banner-tracking show-mobile" target="_self" href="@Url.RenderLanguageContent("~/Promotion")">
                    <picture>
                        <source srcset="@(mobileBannerSrc).webp?v=0.01" type="image/webp" />
                        <source srcset="@(mobileBannerSrc).jpg?v=0.01" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(mobileBannerSrc).jpg?v=0.01" alt="12Bet Affiliate programs" />
                    </picture>
                </a>
            </div>
            <div class="swiper-slide">
                <a class="nounderline commission-structure-banner-tracking show-pc" target="_self" href="@Url.RenderLanguageContent("~/Promotion")">
                    <picture>
                        <source srcset="@(banner2Src).webp?v=0.01" type="image/webp" />
                        <source srcset="@(banner2Src).jpg?v=0.01" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(banner2Src).jpg?v=0.01" alt="12Bet Affiliate programs" />
                    </picture>
                </a>
                <a class="nounderline commission-structure-banner-tracking show-mobile" target="_self" href="@Url.RenderLanguageContent("~/Promotion")">
                    <picture>
                        <source srcset="@(mobileBanner2Src).webp?v=0.01" type="image/webp" />
                        <source srcset="@(mobileBanner2Src).jpg?v=0.01" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(mobileBanner2Src).jpg?v=0.01" alt="12Bet Affiliate programs" />
                    </picture>
                </a>
            </div>
        </div>
        <div class="swiper-pagination"></div>
    </div>
    @Html.RenderPartialByLanguage("~/Views/CommissionStructure/Partial/_Content", Model)
    @RazorHelper.RenderMovingTopButton()
</div>