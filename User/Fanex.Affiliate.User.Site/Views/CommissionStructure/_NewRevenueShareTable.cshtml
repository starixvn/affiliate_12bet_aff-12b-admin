<div class="table table-responsive">
    <table>
        <thead>
            <tr>
                <th width="23%">@Lang.RevenueShare</th>
                <th width="27%">@Lang.NetWinLoss</th>
                <th width="25%">@Lang.QualifyingMem</th>
                <th width="25%">@Lang.Comm</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td rowspan="3" class="text-center">
                    <p>@Lang.AllProducts</p>
                    <p><a class="more-detail" href="@Url.Content("~/Product")">> @Lang.MoreDetailProduct</a></p>
                </td>
                <td class="text-center">@Lang.OneUsdAndAbove</td>
                <td rowspan="3" class="text-center word">@Html.Raw(Lang.QualifyingMembers)</td>
                <td class="text-center">50%</td>
            </tr>
        </tbody>
    </table>
</div>
