@{
    ViewBag.Title = Lang.MetaProductTitle;
    ViewBag.MetaDescription = Lang.MetaProductDescription;
    ViewBag.MetaKeywords = Lang.MetaProductKeywords;
    ViewBag.CanonicalLink = SiteDomainHelper.GenCanonialSeoLink(ControllerName.Product);
    ViewBag.HeaderTitle = Lang.ProductHeaderTitle;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@model Fanex.Affiliate.User.Core.ViewModels.ProPageViewModel

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/products.css")
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.Product</span>
    </div>

    @Html.RenderPartialByLanguage("~/Views/Product/_Content", Model.CurrentLanguage)
    @if (!Model.IsAuthenticated)
    {
        <div class="col-sm-offset-3 col-sm-6 signup-block">
            <a href="@Url.Content("~/SignUp")" class="btn btn-link btn-block nounderline">@Lang.SignUpAffiliateProgramNow</a>
        </div>
    }
</div>

