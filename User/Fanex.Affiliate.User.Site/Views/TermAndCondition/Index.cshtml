@{
    ViewBag.Title = Lang.MetaTermAndConditionTitle;
    ViewBag.MetaDescription = Lang.MetaTermAndConditionDescription;
    ViewBag.MetaKeywords = Lang.MetaTermAndConditionKeywords;
    ViewBag.CanonicalLink = SiteDomainHelper.GenCanonialSeoLink(ControllerName.TermAndCondition);
    ViewBag.HeaderTitle = Lang.TermAndConditionHeaderTitle;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@model string

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.TermAndCondition</span>
    </div>

    @Html.RenderPartialByLanguage("~/Views/TermAndCondition/_Content", Model)
    @RazorHelper.RenderMovingTopButton()
</div>
