@{
    Layout = null;
}

@using Fanex.Affiliate.User.Core.CoreService
@using Fanex.Affiliate.User.Core.Constants
@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var userSession = sessionService.UserSession;
}

@model string

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Lang.TermAndCondition</title>
    <script src="~/www/build/js/lib/jquery-3.3.1.min.js"></script>
    <script>
        window.jQuery || document.write('\x3Cscript src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous">\x3C/script>')
    </script>

    <link href="~/www/build/styles/css/bootstrap-3.3.7.min.css" rel="stylesheet" />
    @if (sessionService.CurrentLanguage == SystemLanguage.VietNamLanguageCode)
    {
        <link href="@Url.RenderLink("~/www/build/styles/fonts/tahoma/font.css")" rel="stylesheet" />
    }
    else
    {
        <link href="@Url.RenderLink("~/www/build/styles/fonts/montserrat/font.css")" rel="stylesheet" />
    }
    <link href="@Url.RenderLink("~/www/build/styles/css/main.css")" rel="stylesheet" />
    <link href="@Url.RenderLink("~/www/build/styles/css/terms-and-coditions.css")" rel="stylesheet" />
</head>
<body>
    <div class="main">
        <div class="main-content">
            <div class="page-title">
                <span class="text">@Lang.TermAndCondition</span>
            </div>
            <div class="content">
                @Html.RenderPartialByLanguage("~/Views/TermAndCondition/_Content", Model)
                @RazorHelper.RenderMovingTopButton()
            </div>
        </div>
    </div>

    @Html.InlineScripts("~/www/build/js/lib/modernizr-webp.js")
    @Html.InlineScripts("~/www/build/js/pages/terms-and-coditions.js")
    <script>
        window.onscroll = function () { scrollFunction() };

        function scrollFunction() {
            var $button = document.getElementById("moveToTop");
            if ($button) {
                var display = (document.body.scrollTop > 200 || document.documentElement.scrollTop > 200) ? 'block' : 'none';
                $button.style.display = display;
            }
        }
    </script>
</body>
</html>