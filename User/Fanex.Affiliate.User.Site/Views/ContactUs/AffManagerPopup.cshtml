@{
    Layout = null;
}

@model string

<div class="modal fade contact-manager-dialog" tabindex="-1" role="dialog" id="contactManagerDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-main-content">
                <div class="modal-body">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                    <a href="@SystemLanguage.GetAffManagerContactInfo(Model)" class="contact-manager-dialog-group">
                        <img class="contact-manager-dialog-img" src="~/www/build/styles/Images/contact-manager/@(Model).jpg" alt="@Lang.ContactAffManager" />
                        <div class="contact-manager-dialog-btn">
                            <span class="custom-button">@Lang.ContactAffManager</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>