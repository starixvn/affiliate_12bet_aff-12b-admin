                                </a>
                                <a class="contact-info" href="https://t.me/aff12bzhifeiji">
                                    <img class="im-icon" src="~/www/build/styles/Images/contact-us/telegram-icon.png" alt="Telegram icon" />
                                    <span>aff12bzhifeiji</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-6">
