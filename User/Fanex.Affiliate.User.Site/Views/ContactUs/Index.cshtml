    ViewBag.MetaDescription = Lang.MetaContactUsDescription;
    ViewBag.MetaKeywords = Lang.MetaContactUsKeywords;
    ViewBag.CanonicalLink = SiteDomainHelper.GenCanonialSeoLink(ControllerName.ContactUs);
    ViewBag.HeaderTitle = Lang.ContactUsHeaderTitle;
}

@using Fanex.Affiliate.User.Core.Utilities
@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.DTO.UserInfo
@{
    var hasAffPersonalInfoPermission = ClaimUtitlity.HasClaimOnlyInternalLogin(ClaimConstant.AffPersonalInfo);
    var name = Model != null ? $"{Model?.FirstName.ReplaceAHalfOfString(hasAffPersonalInfoPermission)} {Model?.LastName.ReplaceAHalfOfString(hasAffPersonalInfoPermission)}" : string.Empty;
    var affiliate = Model?.UserName;
    var email = Model?.Email;
    var appSetting = new AppSetting();
    var mailContact = appSetting.MailContact;
    var isMobile = Request.Browser.IsMobileDevice;
}

@section styles{
