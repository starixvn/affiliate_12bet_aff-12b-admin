                            </div>
                            <div class="info">
                                <p class="language">@Lang.ThailandSupport</p>
                                <a class="contact-info" href="skype:live:.cid.25dc2233359a053b?chat">
                                    <img class="im-icon" src="~/www/build/styles/Images/contact-us/skype_icon.png" alt="Skype icon" />
