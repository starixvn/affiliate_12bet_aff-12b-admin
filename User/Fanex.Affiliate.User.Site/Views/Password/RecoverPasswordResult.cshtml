@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@model Fanex.Affiliate.User.Core.DTO.ResultInfo

@section styles {
    @Html.InlineStyles("~/www/build/styles/css/forgot-password.css")
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.ForgetPassword</span>
    </div>

    <div class="block block-form">
        <div class="page-container">
            <div class="alert alert-@(Model.IsOk ? "success" : "danger")" role="alert">
                @Html.Raw(Model.Message)
            </div>
        </div>
    </div>
</div>
