@{
    ViewBag.Title = Lang.ForgetPassword;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@section styles {
    @Html.InlineStyles("~/www/build/styles/css/forgot-password.css")
}

@section scripts{
    <script src="@Url.RenderLink("~/www/build/js/validation.js")"></script>
    @Html.InlineScripts("~/www/build/js/forgotpassword.js")
}
<div class="content">
    <div class="page-title">
        <span class="text">@Lang.ForgetPassword</span>
    </div>

    <div class="alert" role="alert" id="messageResult" style="display: none"></div>
    <div id="mainContent">
        <form id="forgotPasswordForm" class="form">
            @Html.AntiForgeryToken()
            <div class="block block-form">
                <div class="page-container">
                    <div class="group-text-warn group-faq">
                        <p>@Html.Raw(Lang.TitelForgetPass.Replace("{0}", Url.Content("~/ContactUs")))</p>
                    </div>

                    <div class="group-faq">
                        <div class="group-form" id="emailInputGroup">
                            <div class="form-group form-columns form-columns-2">
                                <div class="items">
                                    <label class="custom-label">@Lang.YourEmail <span class="red-warn">*</span></label>
                                    <input class="form-input" name="Email" id="Email" type="text" autocomplete="off" placeholder="@Lang.Email1"
                                           data-val="true" data-val-email="@Lang.EmailAddressIsInvalid" data-val-required="@Lang.EmailAddressIsRequired" />
                                    <span class="field-validation-valid validation-input hide" data-valmsg-for="Email" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="group-faq">
                        <div class="group-form group-custom-width">
                            <div class="form-group group-button">
                                <button class="custom-button" id="btnSubmit" type="submit">@Lang.Submit</button>
                                <button class="custom-button" id="btnReset" type="button">@Lang.Reset</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </form>
    </div>
</div>