@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = Lang.MetaHomeTitle;
    ViewBag.MetaDescription = Lang.MetaHomeDescription;
    ViewBag.MetaKeywords = Lang.MetaHomeKeywords;
    ViewBag.CanonicalLink = SiteDomainHelper.GenCanonialSeoLink(String.Empty);
    ViewBag.HeaderTitle = Lang.HomeHeaderTitle;
}

@model Fanex.Affiliate.User.Core.ViewModels.HomeViewModel

@using Fanex.Affiliate.User.Core.Constants

@{
    var shortedLangCode = SystemLanguage.GetShortedCodeForTracking(Model.Language);
    var activedBanner = Url.Content("~/www/build/styles/Images/home-banners/active/Home-Banner." + Model.Language);
    var bannerPriority1 = Url.Content("~/www/build/styles/Images/home-banners/priority-1/Home-Banner." + Model.Language);
    var bannerPriority2 = Url.Content("~/www/build/styles/Images/home-banners/priority-2/Home-Banner." + Model.Language);
    var bannerPriority3 = Url.Content("~/www/build/styles/Images/home-banners/priority-3/Home-Banner." + Model.Language);
    var advFileName = Url.Content("~/www/build/styles/Images/apply12bet/3step." + Model.Language);
    var displayAlert = Model.IsShowAlert ? "block" : "none";
}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/home.css")" rel="stylesheet" />
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/pages/home.js")
}

<div class="content home-page">
    <div id="mainBanner" class="carousel slide banner-center" data-ride="carousel">
        <ol class="carousel-indicators">
            <li data-target="#mainBanner" data-slide-to="0" class="active"></li>
            <li data-target="#mainBanner" data-slide-to="1"></li>
            <li data-target="#mainBanner" data-slide-to="2"></li>
            <li data-target="#mainBanner" data-slide-to="3"></li>
        </ol>
        <div class="carousel-inner" role="listbox">
            <div class="item active">
                <a class="nounderline home-banner-tracking-flat" target="_blank" href="@Url.Content("~/Promotion")">
                    <picture>
                        <source srcset="@(activedBanner + ".webp?v=191214v01")" type="image/webp" />
                        <source srcset="@(activedBanner + ".jpg?v=191214v01")" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(activedBanner + ".jpg?v=191214v01")" alt="Actived Home Banner" />
                    </picture>
                </a>
            </div>
            <div class="item">
                <a class="nounderline home-banner-tracking-smart" target="_blank" href="@Url.Content("~/ContactUs")">
                    <picture>
                        <source srcset="@(bannerPriority1 + ".webp?v=191214v01")" type="image/webp" />
                        <source srcset="@(bannerPriority1 + ".jpg?v=191214v01")" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(bannerPriority1 + ".jpg?v=191214v01")" alt="Home Banner 1" />
                    </picture>
                </a>
            </div>
            <div class="item">
                <a class="nounderline home-banner-tracking" href="@(Model.IsAuthenticated ? Url.Content("~/UserPanel/Main/#AccountOverView") : Url.Content("~/Signup/Index"))">
                    <picture>
                        <source srcset="@(bannerPriority2 + ".webp?v=191214v01")" type="image/webp" />
                        <source srcset="@(bannerPriority2 + ".jpg?v=191214v01")" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(bannerPriority2 + ".jpg?v=191214v01")" alt="Home Banner 2" />
                    </picture>
                </a>
            </div>
            <div class="item">
                <a class="nounderline home-banner-tracking" href="@(Model.IsAuthenticated ? Url.Content("~/UserPanel/Main/#AccountOverView") : Url.Content("~/Signup/Index"))">
                    <picture>
                        <source srcset="@(bannerPriority3 + ".webp?v=191214v01")" type="image/webp" />
                        <source srcset="@(bannerPriority3 + ".jpg?v=191214v01")" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(bannerPriority3 + ".jpg?v=191214v01")" alt="Home Banner 3" />
                    </picture>
                </a>
            </div>
        </div>
