@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = Lang.MetaHomeTitle;
    ViewBag.MetaDescription = Lang.MetaHomeDescription;
    ViewBag.MetaKeywords = Lang.MetaHomeKeywords;
    ViewBag.CanonicalLink = SiteDomainHelper.GenCanonialSeoLink(String.Empty);
    ViewBag.HeaderTitle = Lang.HomeHeaderTitle;
}

@model Fanex.Affiliate.User.Core.ViewModels.HomeViewModel

@using Fanex.Affiliate.User.Core.Constants

@{
    var shortedLangCode = SystemLanguage.GetShortedCodeForTracking(Model.Language);
    var bannerSrc = Url.Content($"~/www/build/styles/Images/home/item1/desktop.{Model.Language}");
    var mobileBannerSrc = Url.Content($"~/www/build/styles/Images/home/item1/mobile.{Model.Language}");
}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/home.css")" rel="stylesheet" />
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/pages/home.js")
}

<div class="content home-page">
    <div class="swiper top-banner">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <a class="nounderline home-banner-tracking-flat show-pc" target="_blank" href="@Url.Content("~/CommissionStructure")">
                    <picture>
                        <source srcset="@(bannerSrc).webp" type="image/webp" />
                        <source srcset="@(bannerSrc).jpg" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(bannerSrc).jpg" alt="Actived Home Banner" />
                    </picture>
                </a>
                <a class="nounderline home-banner-tracking-flat show-mobile" target="_blank" href="@Url.Content("~/CommissionStructure")">
                    <picture>
                        <source srcset="@(mobileBannerSrc).webp" type="image/webp" />
                        <source srcset="@(mobileBannerSrc).jpg" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(mobileBannerSrc).jpg" alt="Actived Home Banner" />
                    </picture>
                </a>
            </div>
        </div>
        <div class="swiper-pagination"></div>
    </div>

    @Html.RenderPartialByLanguage("~/Views/Home/Partial/_Content", Model.Language)
</div>

<input type="hidden" id="shortedLangCode" value="@shortedLangCode" />
<input type="hidden" id="isCLickedBannerLink" value="0" />
