@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = Lang.MetaHomeTitle;
    ViewBag.MetaDescription = Lang.MetaHomeDescription;
    ViewBag.MetaKeywords = Lang.MetaHomeKeywords;
    ViewBag.HeaderTitle = Lang.HomeHeaderTitle;
}

@model Fanex.Affiliate.User.Core.ViewModels.HomeViewModel

@{
    var bannerSrc = Url.Content($"~/www/build/styles/Images/home/top-banner/item1/desktop.{Model.Language}");
    var mobileBannerSrc = Url.Content($"~/www/build/styles/Images/home/top-banner/item1/mobile.{Model.Language}");
}

@section alternateAndCanonicalTags{
    @RazorHelper.RenderAlternateAndCanonicalLinks("home", Model.Language)
}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/home.css")" rel="stylesheet" />
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/pages/home.js")
}

<div class="content home-page">
    <div class="swiper top-banner">
        <div class="page-container">
            <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <a class="nounderline home-banner-tracking show-pc" target="_self" href="@Url.Content("~/Promotion")">
                        <picture>
                            <source srcset="@(bannerSrc).webp" type="image/webp" />
                            <source srcset="@(bannerSrc).jpg" type="image/jpeg" />
                            <img class="img-item img-responsive" src="@(bannerSrc).jpg" alt="12bet Partner" />
                        </picture>
                    </a>
                    <a class="nounderline home-banner-tracking show-mobile" target="_self" href="@Url.Content("~/Promotion")">
                        <picture>
                            <source srcset="@(mobileBannerSrc).webp" type="image/webp" />
                            <source srcset="@(mobileBannerSrc).jpg" type="image/jpeg" />
                            <img class="img-item img-responsive" src="@(mobileBannerSrc).jpg" alt="12bet Partner" />
                        </picture>
                    </a>
                </div>
            </div>
        </div>
        @*<div class="swiper-pagination"></div>*@
    </div>

    @Html.RenderPartialByLanguage("~/Views/Home/Partial/_Content", Model.Language, Model)
    @RazorHelper.RenderMovingTopButton()
</div>

<input type="hidden" id="shortedLangCode" value="@Model.ShortedLanguageCode" />
<input type="hidden" id="isCLickedBannerLink" value="0" />
