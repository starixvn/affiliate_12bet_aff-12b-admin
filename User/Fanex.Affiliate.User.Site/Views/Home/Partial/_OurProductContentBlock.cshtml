@model string

@{
    var isSupportedP2P = Model.IsSupportedP2pProduct();
    var productList = new Dictionary<string, string>
    {
        ["asia-gaming"] = "12Bet provider Asia Gaming",
        ["sa-gaming"] = "12Bet provider SA Gaming",
        ["sexy"] = "12Bet provider Sexy",
        ["evolution"] = "12Bet provider Evolution",
        ["gameplay"] = "12Bet provider Gameplay Interactive",
        ["playtech"] = "12Bet provider Playtech",
        ["pragmatic-play"] = "12Bet provider Pragmatic Play",
        ["allbet"] = "12Bet provider Allbet",
        ["ebet"] = "12Bet provider Ebet",
        ["skywind"] = "12Bet provider Skywind Group",
        ["advantplay"] = "12Bet provider AdvantPlay",
        ["saba-sports"] = "12Bet provider Saba Sports",
        ["betsoft"] = "12Bet provider Betsoft",
        ["flow-gaming"] = "12Bet provider Flow Gaming",
        ["nentent"] = "12Bet provider Netent",
        ["bti"] = "12Bet provider Bti",
        ["br-sports"] = "12Bet provider BR Sports",
        ["betradar"] = "12Bet provider Betradar",
        ["saba-esports"] = "12Bet provider Saba Esports",
    };
}

<div class="block-content">
    <div class="wrapper-block">
        <div class="items">
            <a href="@Url.RenderLanguageContent("~/Product#Sports")" class="wrapper-item">
                <img src="~/www/build/styles/Images/home/our-product/sports.png" alt="12Bet product Sports" class="img-responsive" />
                <span class="name-item">@Lang.Sports</span>
            </a>
        </div>
        <div class="items">
            <a href="@Url.RenderLanguageContent("~/Product#Esports")" class="wrapper-item">
                <img src="~/www/build/styles/Images/home/our-product/esports.png" alt="12Bet product eSports" class="img-responsive" />
                <span class="name-item">@Lang.ESports</span>
            </a>
        </div>
        <div class="items">
            <a href="@Url.RenderLanguageContent("~/Product#Slot")" class="wrapper-item">
                <img src="~/www/build/styles/Images/home/our-product/casino.png" alt="12Bet product Casino" class="img-responsive" />
                <span class="name-item">@Lang.Casino</span>
            </a>
        </div>
        <div class="items">
            <a href="@Url.RenderLanguageContent("~/Product#LiveCasino")" class="wrapper-item">
                <img src="~/www/build/styles/Images/home/our-product/live-casino.png" alt="12Bet product Live Casino" class="img-responsive" />
                <span class="name-item">@Lang.LiveCasino</span>
            </a>
        </div>
        <div class="items">
            <a href="@Url.RenderLanguageContent(isSupportedP2P ? "~/Product#P2P" : "~/Product#NumberGame")" class="wrapper-item">
                <img src="~/www/build/styles/Images/home/our-product/p2p.png" alt="12Bet product P2P" class="img-responsive" />
                <span class="name-item">@Lang.P2P</span>
            </a>
        </div>
        <div class="items">
            <a href="@Url.RenderLanguageContent("~/Product#NumberGame")" class="wrapper-item">
                <img src="~/www/build/styles/Images/home/our-product/number-game.png" alt="12Bet product Number Game" class="img-responsive" />
                <span class="name-item">@Lang.NumberGame</span>
            </a>
        </div>
        <div class="items">
            <a href="@Url.RenderLanguageContent("~/Product#Keno")" class="wrapper-item">
                <img src="~/www/build/styles/Images/home/our-product/keno.png" alt="12Bet product Keno" class="img-responsive" />
                <span class="name-item">@Lang.Keno</span>
            </a>
        </div>
        <div class="items">
            <a href="@Url.RenderLanguageContent("~/Product#Lottery")" class="wrapper-item">
                <img src="~/www/build/styles/Images/home/our-product/lottery.png" alt="12Bet product Lottery" class="img-responsive" />
                <span class="name-item">@Lang.Lottery</span>
            </a>
        </div>
    </div>
    <span class="arrow-products arrow-1">
        <img src="~/www/build/styles/Images/arrow-1.svg" alt="arrow-1" />
    </span>
    <span class="arrow-products arrow-2">
        <img src="~/www/build/styles/Images/arrow-2.svg" alt="arrow-2" />
    </span>
    <span class="arrow-products arrow-3">
        <img src="~/www/build/styles/Images/arrow-3.svg" alt="arrow-3" />
    </span>
    <span class="arrow-products arrow-4">
        <img src="~/www/build/styles/Images/arrow-4.svg" alt="arrow-4" />
    </span>
</div>

<div class="mini-block">
    <div class="swiper mini-block-banner">
        <div class="swiper-wrapper" style="align-items:center;">
            @foreach (var product in productList)
            {
                <div class="swiper-slide">
                    <img src="~/www/build/styles/Images/home/our-product/provider/@(product.Key).png?v=002" alt="@(product.Value)" class="img-responsive" />
                </div>
            }
        </div>
        <div class="swiper-button-next">
            <svg width="30" height="31" viewBox="0 0 30 31" fill="none">
                <path d="M16.4648 15.8837L10.2773 9.69621L12.0448 7.92871L19.9998 15.8837L12.0448 23.8387L10.2773 22.0712L16.4648 15.8837Z" fill="#D90F0F" />
            </svg>
        </div>
        <div class="swiper-button-prev">
            <svg width="30" height="31" viewBox="0 0 30 31" fill="none">
                <path d="M13.535 15.8837L19.7225 22.0712L17.955 23.8387L10 15.8837L17.955 7.92871L19.7225 9.69621L13.535 15.8837Z" fill="#D90F0F" />
            </svg>
        </div>
        <div class="swiper-pagination"></div>
    </div>
</div>