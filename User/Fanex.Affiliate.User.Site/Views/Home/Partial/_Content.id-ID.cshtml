@model Fanex.Affiliate.User.Core.ViewModels.HomeViewModel

<div class="block block-why-become">
    <div class="page-container">
        <h2 class="block-title">
            <span class="why-become">MENGAPA MENJADI AFILIASI</span>
            <img src="~/www/build/styles/Images/home/why-become/title.svg" alt="title" />
            <span class="affiliate">?</span>
        </h2>
        <div class="block-content">
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/highest.png" alt="12Bet High Commision logo" class="img-responsive" />
                <div class="heading-items">
                    DAPATKAN KOMISI 50% UNTUK SEMUA PRODUK
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/lifetime.png" alt="12Bet Life Revenue logo" class="img-responsive" />
                <div class="heading-items">
                    PENDAPATAN SEUMUR HIDUP DARI PEMAIN YANG ANDA REFERENSI
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/advanced.png" alt="12Bet Marketing tools logo" class="img-responsive" />
                <div class="heading-items">
                    ALAT PEMASARAN DAN ANALISIS YANG CANGGIH
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/workat.png" alt="12Bet Work Anywhere logo" class="img-responsive" />
                <div class="heading-items">
                    ATUR WAKTU KERJA ANDA & JADILAH BOS BAGI DIRI SENDIRI
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/17years.png" alt="17 years-12Bet" class="img-responsive" />
                <div class="heading-items">
                    PENGALAMAN 17 TAHUN<br>
                    DI INDUSTRI GAMING
                </div>
            </div>
        </div>
    </div>
</div>

<div class="block block-about">
    <div class="page-container">
        <div class="group-block">
            <h2 class="block-title">
                TENTANG AFILIASI
                <img src="~/www/build/styles/Images/home/why-become/title-about.svg" alt="title-about" />
            </h2>
            <div class="block-content">
                <p>Sebagai sportsbook terkemuka di Asia, 12BET telah mendapatkan reputasi sebagai pemimpin pasar global, menawarkan odds yang kompetitif dan menduduki peringkat ke-17 sebagai Operator Permainan Online Terbaik di seluruh dunia.</p>
                <p>Kami sangat senang untuk memberikan sambutan hangat kepada semua potensial afiliasi untuk bergabung dengan program afiliasi kami, di mana Anda dapat memperoleh komisi yang besar dari mempromosikan semua produk 12BET.</p>
            </div>
        </div>
    </div>
</div>

<div class="block block-aff-testimonial">
    <div class="page-container">
        <h2 class="block-title fill-color">
            APA KATA MEREKA
        </h2>
        @{ Html.RenderPartial("~/Views/Home/Partial/_AffTestimonialContentBlock.cshtml", model: "id-ID"); }
    </div>
</div>

<div class="block block-partnership">
    <div class="page-container">
        <h2 class="block-title fill-color">
            <span class="block-mb">RIWAYAT PARTNERSHIP </span>AND SPONSORSHIP
        </h2>
        @{ Html.RenderPartial("~/Views/Home/Partial/_PartnershipContentBlock.cshtml"); }
    </div>
</div>

<div class="block block-get-started">
    <div class="page-container">
        <h2 class="block-title">
            MEMULAI
        </h2>
        <div class="wrapper-block">
            <div class="block-content">
                <div class="items">
                    <span class="number">1</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/sign-up.svg" alt="Free 12Bet registration" />
                    </div>
                    <div class="heading-items">
                        DAFTAR
                    </div>
                    <div class="description">
                        PENDAFTARAN INSTAN GRATIS
                    </div>
                </div>
                <div class="items">
                    <span class="number">2</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/approved.svg" alt="12Bet hassle free safe approval" />
                    </div>
                    <div class="heading-items">
                        DISETUJUI
                    </div>
                    <div class="description">
                        HASILKAN UANG DENGAN AMAN DAN MUDAH
                    </div>
                </div>
                <div class="items">
                    <span class="number">3</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/promote.svg" alt="Promote 12Bet game" />
                    </div>
                    <div class="heading-items">
                        PROMOSIKAN
                    </div>
                    <div class="description">
                        AMBIL LINK REFERENSI DAN MULAI PROMOSI
                    </div>
                </div>
                <div class="items">
                    <span class="number">4</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/earning.svg" alt="Earn from 12Bet" />
                    </div>
                    <div class="heading-items">
                        PENGHASILAN
                    </div>
                    <div class="description">
                        DAPAT UANG SEJAK HARI PERTAMA
                    </div>
                </div>
            </div>
            <div class="text-center">
                <a href="@Url.RenderLanguageContent(Model.SignUpLink)" class="custom-button">GABUNG SEKARANG</a>
            </div>
        </div>
    </div>
</div>

<div class="block block-our-product">
    <div class="page-container">
        <h2 class="block-title fill-color">
            PRODUK <span class="show-pc">DAN PROVIDER</span>
        </h2>
        @{ Html.RenderPartial("~/Views/Home/Partial/_OurProductContentBlock.cshtml", Model.Language); }
    </div>
</div>

<div class="block block-faq">
    <div class="page-container">
        <h2 class="block-title fill-color">
            faq
        </h2>
        <div class="block-content">
            <div class="group-faq">
                <div class="number">
                    01
                </div>
                <div class="question">
                    <div class="title">
                        <span>Umum</span>
                    </div>
                    <span class="button-toggle"></span>
                </div>
                <div class="anwser">
                    <div class="anwser-heading">Apakah Program Afiliasi 12BET itu?</div>
                    <div class="anwser-text">
                        Program Afiliasi 12BET adalah program kemitraan dimana Anda akan mendapatkan komisi berdasarkan aktivitas taruhan pemain yang Anda referensikan ke 12BET.com dari websiteAnda melalui online atau offline melalui link referal.
                    </div>
                    <div class="anwser-heading">Bagaimana cara mendaftar Program Afiliasi 12BET?</div>
                    <div class="anwser-text">
                        Anda dapat bergabung secara gratis di program Afiliasi 12BET. Cukup isi formulir pendaftaran dan Anda akan dihubungi dalam waktu 3 hari kerja sehubungan dengan pengajuan Anda. Apabila pengajuan berhasil, Anda akan menerima Affiliate ID, akses untuk banner promosi, link referensi, konten dan alat pemasaran lainnya untuk website Anda.
                    </div>
                    <div class="anwser-heading">Bagaimana kalau tidak punya Website, apakah masih bisa bergabung?</div>
                    <div class="anwser-text">
                        Ya, Anda masih bisa bergabung! Jika Anda memiliki relasi cukup banyak, Anda dapat memulai untuk mempromosikan dengan afiliasi dan gunakan banner yang tersedia dengan ide marketing seputar olahraga. Ajak teman Anda bergabung di taruhan olahraga dan klik link untuk mendaftar melalui afiliasi Anda. Untuk selengkapnya, Hubungi kami di affiliates@12csd.com.
                    </div>
                    <div class="text-center">
                        <a href="@Url.RenderLanguageContent("~/FAQ")" class="custom-button">FAQ LAINNYA</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>