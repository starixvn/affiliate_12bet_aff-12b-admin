@model Fanex.Affiliate.User.Core.ViewModels.HomeViewModel

<div class="block block-why-become">
    <div class="page-container">
        <h2 class="block-title">
            <span class="why-become">왜</span>
            <img src="~/www/build/styles/Images/home/why-become/title.svg" alt="title" />
            <span class="affiliate">제휴사일까요?</span>
        </h2>
        <div class="block-content">
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/highest.png" alt="highest" class="img-responsive" />
                <div class="heading-items">
                    모든 제품에 최고 수수료
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/lifetime.png" alt="lifetime" class="img-responsive" />
                <div class="heading-items">
                    추천된 모든 플레이어를 통해 평생 수익
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/advanced.png" alt="advanced" class="img-responsive" />
                <div class="heading-items">
                    고급 마케팅 및 분석 도구
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/workat.png" alt="workat" class="img-responsive" />
                <div class="heading-items">
                    자유로운 시간과 자신의 사업 시작
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/15year.png" alt="15year" class="img-responsive" />
                <div class="heading-items">
                    설립 15주년 게임업체
                </div>
            </div>
        </div>
    </div>
</div>

<div class="block block-about">
    <div class="page-container">
        <div class="group-block">
            <h2 class="block-title">
                <img src="~/www/build/styles/Images/home/why-become/title-about.svg" alt="title-about" />
                제휴사 소개
            </h2>
            <div class="block-content">
                <p>12BET은 아시아의 저명한 스포츠북으로서 경쟁력 있는 배당률을 제공하고 전 세계 17위의 최고의 온라인 게임 운영업체로 선정되어 글로벌 시장 리더로서의 명성을 얻었습니다.</p>
                <p>당사는 잠재능력을 가진 제휴사가 12BET 제품을 홍보하며 넉넉한 커미션을 받을 수 있는 제휴 프로그램에 참여하는 것을 진심으로 환영합니다.</p>
            </div>
        </div>
    </div>
</div>


<div class="block block-partnership">
    <div class="page-container">
        <h2 class="block-title fill-color">
            <span class="block-mb">파트너십 및 </span>후원
        </h2>
        @{ Html.RenderPartial("~/Views/Home/Partial/_PartnershipContentBlock.cshtml"); }
    </div>
</div>

<div class="block block-get-started">
    <div class="page-container">
        <h2 class="block-title">
            시작하세요
        </h2>
        <div class="wrapper-block">
            <div class="block-content">
                <div class="items">
                    <span class="number">1</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/sign-up.svg" alt="signup" />
                    </div>
                    <div class="heading-items">
                        제휴사 등록
                    </div>
                    <div class="description">
                        오늘 신청서를 제출합니다.
                    </div>
                </div>
                <div class="items">
                    <span class="number">2</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/approved.svg" alt="approved" />
                    </div>
                    <div class="heading-items">
                        승인
                    </div>
                    <div class="description">
                        안전하게 수익을 창출하세요
                    </div>
                </div>
                <div class="items">
                    <span class="number">3</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/promote.svg" alt="promote" />
                    </div>
                    <div class="heading-items">
                        홍보
                    </div>
                    <div class="description">
                        홍보 시작하기 트래커를 챙기세요
                    </div>
                </div>
                <div class="items">
                    <span class="number">4</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/earning.svg" alt="earning" />
                    </div>
                    <div class="heading-items">
                        수익
                    </div>
                    <div class="description">
                        첫날부터 즐기며 수익을 얻으세요
                    </div>
                </div>
            </div>
            <div class="text-center">
                <a href="@Url.Content(Model.SignUpLink)" class="custom-button">지금 시작!</a>
            </div>
        </div>
    </div>
</div>

<div class="block block-our-product">
    <div class="page-container">
        <h2 class="block-title fill-color">
            게임 <span class="show-pc">및 제공업체</span>
        </h2>
        @{ Html.RenderPartial("~/Views/Home/Partial/_OurProductContentBlock.cshtml", Model.Language); }
    </div>
</div>

<div class="block block-faq">
    <div class="page-container">
        <h2 class="block-title fill-color">
            faq
        </h2>
        <div class="block-content">
            <div class="group-faq">
                <div class="number">
                    01
                </div>
                <div class="question">
                    <div class="title">
                        <span>일반</span>
                    </div>
                    <span class="button-toggle"></span>
                </div>
                <div class="anwser">
                    <div class="anwser-heading">12BET의 ”제휴 프로그램”이란 무엇입니까?</div>
                    <div class="anwser-text">
                        12BET 제휴 프로그램은 온라인 또는 오프라인 추천을 통해 귀하의 웹사이트에서 12BET.com을 추천한 플레이어의 베팅 활동을 기반으로 커미션을 받을 수 있는 파트너십 프로그램입니다.
                    </div>
                    <div class="anwser-heading">12BET 제휴프로그램은 어떻게 가입하나요?</div>
                    <div class="anwser-text">
                        12BET 제휴 프로그램은 무료로 가입하실 수 있습니다. 신청서를 작성하시면 영업일 기준 3일 이내에 프로그램 승인 여부에 관해 연락을 드립니다. 귀하의 신청서가 승인되면 귀하의 웹사이트에 추가할 배너, 텍스트 링크, 기타 콘텐츠 및 마케팅 도구에 액세스할 수 있는 고유한 제휴 ID가 포함된 이메일을 받게 됩니다.
                    </div>
                    <div class="anwser-heading">만약 웹사이트가 없어도 가입할 수 있나요?</div>
                    <div class="anwser-text">
                        예, 이제 가능합니다! 연락처가 있다고 생각되면 특별 제휴 섹션에서 나만의 개인 페이지를 쉽게 만들고 승인된 마케팅 아이디어나 스포츠 메시지를 업로드할 수 있습니다. 완료되면 스포츠나 스포츠 베팅에 관심이 있는 친구나 지인에게 즉시 페이지 링크를 보낼 수 있으며, 링크를 클릭하면 추천 회원이 됩니다! 더 자세한 내용을 알고 싶으시면affiliates@12csd.com으로 메일을 보내주세요.
                    </div>
                    <div class="text-center">
                        <a href="@Url.Content("~/FAQ")" class="custom-button">FAQS 더 보기</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>