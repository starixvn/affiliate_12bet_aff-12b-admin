@model string

@{
    var affTestimonialList = new Dictionary<string, Dictionary<string, string>>
    {
        ["12BETAFF**274"] = new Dictionary<string, string>
        {
            ["Flag"] = "id",
            ["Class"] = "aff274",
            ["Title"] = Lang.Aff274TestimonialTitle,
            ["Content"] = Lang.Aff274TestimonialContent
        },
        ["12BETAFF**131"] = new Dictionary<string, string>
        {
            ["Flag"] = "vn",
            ["Class"] = "aff131",
            ["Title"] = Lang.Aff131TestimonialTitle,
            ["Content"] = Lang.Aff131TestimonialContent
        },
        ["12BETAFF**504"] = new Dictionary<string, string>
        {
            ["Flag"] = "th",
            ["Class"] = "aff504",
            ["Title"] = Lang.Aff504TestimonialTitle,
            ["Content"] = Lang.Aff504TestimonialContent
        },
        ["12BETAFF**014"] = new Dictionary<string, string>
        {
            ["Flag"] = "ko",
            ["Class"] = "aff014",
            ["Title"] = Lang.Aff014TestimonialTitle,
            ["Content"] = Lang.Aff014TestimonialContent
        },
        ["12BETAFF**801"] = new Dictionary<string, string>
        {
            ["Flag"] = "id",
            ["Class"] = "aff801",
            ["Title"] = Lang.Aff801TestimonialTitle,
            ["Content"] = Lang.Aff801TestimonialContent
        },
        ["12BETAFF**846"] = new Dictionary<string, string>
        {
            ["Flag"] = "bn",
            ["Class"] = "aff846",
            ["Title"] = Lang.Aff846TestimonialTitle,
            ["Content"] = Lang.Aff846TestimonialContent
        },
        ["12BETAFF**242"] = new Dictionary<string, string>
        {
            ["Flag"] = "kh",
            ["Class"] = "aff242",
            ["Title"] = Lang.Aff242TestimonialTitle,
            ["Content"] = Lang.Aff242TestimonialContent
        },
        ["12BETAFF**429"] = new Dictionary<string, string>
        {
            ["Flag"] = "ms",
            ["Class"] = "aff429",
            ["Title"] = Lang.Aff429TestimonialTitle,
            ["Content"] = Lang.Aff429TestimonialContent
        },
        ["12BETAFF**286"] = new Dictionary<string, string>
        {
            ["Flag"] = "cs",
            ["Class"] = "aff286",
            ["Title"] = Lang.Aff286TestimonialTitle,
            ["Content"] = Lang.Aff286TestimonialContent
        },
    };
}

<div class="mini-block">
    <div class="swiper mini-block-testimonial">
        <div class="swiper-wrapper" style="align-items:center;">
            @foreach (var afftestimonial in affTestimonialList)
            {
                var testimonial = afftestimonial.Value;

                <div class="swiper-slide">
                    <div class="items">
                        <div class="aff-name">
                            <span>@afftestimonial.Key</span>
                            <img src="~/www/build/styles/Images/langs/@(testimonial["Flag"]).svg" alt="Flag" class="img-responsive flag" />
                        </div>

                        <div class="aff-testimonial @Model">
                            <div class="title @testimonial["Class"]">
                                <span>@Html.Raw(testimonial["Title"])</span>
                            </div>
                            <div class="content @testimonial["Class"]">
                                <span>@Html.Raw(testimonial["Content"])</span>
                            </div>
                        </div>
                        <div class="aff-vote">
                            <img src="~/www/build/styles/Images/home/5-stars.svg" alt="5 Stars" class="img-responsive 5-stars" />
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="swiper-button-next">
            <svg width="30" height="31" viewBox="0 0 30 31" fill="none">
                <path d="M16.4648 15.8837L10.2773 9.69621L12.0448 7.92871L19.9998 15.8837L12.0448 23.8387L10.2773 22.0712L16.4648 15.8837Z" fill="#D90F0F" />
            </svg>
        </div>
        <div class="swiper-button-prev">
            <svg width="30" height="31" viewBox="0 0 30 31" fill="none">
                <path d="M13.535 15.8837L19.7225 22.0712L17.955 23.8387L10 15.8837L17.955 7.92871L19.7225 9.69621L13.535 15.8837Z" fill="#D90F0F" />
            </svg>
        </div>
        <div class="swiper-pagination"></div>
    </div>
</div>