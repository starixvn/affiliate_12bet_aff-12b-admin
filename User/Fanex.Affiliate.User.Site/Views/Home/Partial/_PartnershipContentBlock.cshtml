@{ 
    var altList = new Dictionary<string, string>
    {
        ["Partnership1"] = "12Bet Partner Leincester City FC",
        ["Partnership2"] = "12Bet Partner Wolves",
        ["Partnership3"] = "12Bet Partner Arsenal",
        ["Partnership4"] = "12Bet partner Yonex All England",
        ["Partnership5"] = "12Bet partner Asia Fighting Champion",
        ["Partnership6"] = "12Bet partner BWF",
        ["Partnership7"] = "12Bet Partner Birmingham City FC",
        ["Partnership8"] = "12Bet Partner Coventry City FC",
        ["Partnership9"] = "12Bet Partner Crystal Palace FC",
        ["Partnership10"] = "12Bet Partner Hull City",
        ["Partnership11"] = "Leeds United Partner Hull City",
        ["Partnership12"] = "12Bet partner Newcastle United FC",
        ["Partnership13"] = "12Bet partner Sevilla FC",
        ["Partnership14"] = "12Bet Partner WST",
        ["Partnership15"] = "12Bet UK Championship",
        ["Partnership16"] = "12Bet Partner Swansea City AFC",
        ["Partnership17"] = "12Bet Partner ITTF World Cup",
        ["Partnership18"] = "12Bet partner World Taekwondo GP",
        ["Partnership19"] = "12Bet partner Triton Poker",
        ["Partnership20"] = "12Bet partner West Bromwich Albion FC",
        ["Partnership21"] = "12Bet partner Wigan Athletic FC",
        ["Partnership22"] = "12Bet partner World Cup of Pool",
    };
}
<div class="block-content">
    <div class="swiper partnership-banner">
        <div class="swiper-wrapper">
            @for (var i = 1; i <= 22; i++)
            {
                var key = $"Partnership{i}";

                <div class="swiper-slide">
                    <img src="~/www/build/styles/Images/home/partnership/item@(i).png" alt="@(altList.ContainsKey(key) ? altList[key] : key)" class="img-responsive" />
                    <span class="partnership-products arrow-1">
                        <img src="~/www/build/styles/Images/arrow-1.svg" alt="arrow-1" />
                    </span>
                    <span class="partnership-products arrow-2">
                        <img src="~/www/build/styles/Images/arrow-2.svg" alt="arrow-2" />
                    </span>
                    <span class="partnership-products arrow-3">
                        <img src="~/www/build/styles/Images/arrow-3.svg" alt="arrow-3" />
                    </span>
                    <span class="partnership-products arrow-4">
                        <img src="~/www/build/styles/Images/arrow-4.svg" alt="arrow-4" />
                    </span>
                </div>
            }
        </div>
        <div class="swiper-button-next">
            <svg width="30" height="31" viewBox="0 0 30 31" fill="none">
                <path d="M16.4648 15.8837L10.2773 9.69621L12.0448 7.92871L19.9998 15.8837L12.0448 23.8387L10.2773 22.0712L16.4648 15.8837Z" fill="#D90F0F" />
            </svg>
        </div>
        <div class="swiper-button-prev">
            <svg width="30" height="31" viewBox="0 0 30 31" fill="none">
                <path d="M13.535 15.8837L19.7225 22.0712L17.955 23.8387L10 15.8837L17.955 7.92871L19.7225 9.69621L13.535 15.8837Z" fill="#D90F0F" />
            </svg>
        </div>
        <div class="swiper-pagination"></div>
    </div>
</div>