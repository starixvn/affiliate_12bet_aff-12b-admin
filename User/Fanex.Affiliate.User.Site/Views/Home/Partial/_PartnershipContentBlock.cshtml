@{ 
    var altList = new Dictionary<string, string>
    {
        ["Partnership1"] = "Leincester City Partner - 12bet",
        ["Partnership2"] = "Wolves Partner - 12bet",
        ["Partnership3"] = "Arsenal Partner- 12bet",
        ["Partnership4"] = "Yonex All England Partner- 12bet",
        ["Partnership5"] = "Asia Fighting Champion Partner- 12bet",
        ["Partnership22"] = "World Pool Partner - 12bet",
    };
}
<div class="block-content">
    <div class="swiper partnership-banner">
        <div class="swiper-wrapper">
            @for (var i = 1; i <= 22; i++)
            {
                var key = $"Partnership{i}";

                <div class="swiper-slide">
                    <img src="~/www/build/styles/Images/home/partnership/item@(i).png" alt="@(altList.ContainsKey(key) ? altList[$"Partnership{i}"] : key)" class="img-responsive" />
                    <span class="partnership-products arrow-1">
                        <img src="~/www/build/styles/Images/arrow-1.svg" alt="arrow-1" />
                    </span>
                    <span class="partnership-products arrow-2">
                        <img src="~/www/build/styles/Images/arrow-2.svg" alt="arrow-2" />
                    </span>
                    <span class="partnership-products arrow-3">
                        <img src="~/www/build/styles/Images/arrow-3.svg" alt="arrow-3" />
                    </span>
                    <span class="partnership-products arrow-4">
                        <img src="~/www/build/styles/Images/arrow-4.svg" alt="arrow-4" />
                    </span>
                </div>
            }
        </div>
        <div class="swiper-button-next">
            <svg width="30" height="31" viewBox="0 0 30 31" fill="none">
                <path d="M16.4648 15.8837L10.2773 9.69621L12.0448 7.92871L19.9998 15.8837L12.0448 23.8387L10.2773 22.0712L16.4648 15.8837Z" fill="#D90F0F" />
            </svg>
        </div>
        <div class="swiper-button-prev">
            <svg width="30" height="31" viewBox="0 0 30 31" fill="none">
                <path d="M13.535 15.8837L19.7225 22.0712L17.955 23.8387L10 15.8837L17.955 7.92871L19.7225 9.69621L13.535 15.8837Z" fill="#D90F0F" />
            </svg>
        </div>
        <div class="swiper-pagination"></div>
    </div>
</div>