@model Fanex.Affiliate.User.Core.ViewModels.HomeViewModel

<div class="block block-why-become">
    <div class="page-container">
        <h2 class="block-title">
            <span class="why-become">TẠI SAO NÊN TRỞ THÀNH ĐẠI LÝ CỦA</span>
            <img src="~/www/build/styles/Images/home/why-become/title.svg" alt="title" />
            <span class="affiliate">?</span>
        </h2>
        <div class="block-content">
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/highest.png" alt="High Commision logo" class="img-responsive" />
                <div class="heading-items">
                    % hoa hồng cao nhất cho tất cả các sản phẩm
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/lifetime.png" alt="Life Revenue logo" class="img-responsive" />
                <div class="heading-items">
                    Doanh thu trọn đời từ tất cả người chơi được giới thiệu
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/advanced.png" alt="Marketing tools logo" class="img-responsive" />
                <div class="heading-items">
                    Công cụ tiếp thị và phân tích tiên tiến
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/workat.png" alt="Work Anywhere logo" class="img-responsive" />
                <div class="heading-items">
                    Thời gian làm việc thoải mái và bạn tự quản lý hệ thống của bạn
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/15year.png" alt="15 years-12Bet" class="img-responsive" />
                <div class="heading-items">
                    15 năm kinh nghiệm trong ngành công nghiệp game & cá cược
                </div>
            </div>
        </div>
    </div>
</div>

<div class="block block-about">
    <div class="page-container">
        <div class="group-block">
            <h2 class="block-title">
                VỀ ĐẠI LÝ CỦA
                <img src="~/www/build/styles/Images/home/why-become/title-about.svg" alt="title-about" />
            </h2>
            <div class="block-content">
                <p>Là nhà cái uy tín tại châu Á, 12BET đã xây dựng được danh tiếng là một trong những nhà lãnh đạo thị trường toàn cầu, cung cấp tỷ lệ cược cạnh tranh và được xếp hạng là Nhà Cái Trực Tuyến tốt thứ 17 trên toàn cầu</p>
                <p>Chúng tôi rất vui mừng chào đón tất cả các đối tác đại lý tiềm năng tham gia chương trình đại lý của chúng tôi, nơi bạn có thể kiếm được hoa hồng hậu hĩnh thông qua việc quảng cáo tất cả các sản phẩm của 12BET</p>
            </div>
        </div>
    </div>
</div>


<div class="block block-partnership">
    <div class="page-container">
        <h2 class="block-title fill-color">
            <span class="block-mb">LỊCH SỬ ĐỐI TÁC VÀ</span> NHÀ TÀI TRỢ
        </h2>
        @{ Html.RenderPartial("~/Views/Home/Partial/_PartnershipContentBlock.cshtml"); }
    </div>
</div>

<div class="block block-get-started">
    <div class="page-container">
        <h2 class="block-title">
            Bắt đầu
        </h2>
        <div class="wrapper-block">
            <div class="block-content">
                <div class="items">
                    <span class="number">1</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/sign-up.svg" alt="signup" />
                    </div>
                    <div class="heading-items">
                        Đăng ký
                    </div>
                    <div class="description">
                        Đăng ký ngay hôm nay
                    </div>
                </div>
                <div class="items">
                    <span class="number">2</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/approved.svg" alt="approved" />
                    </div>
                    <div class="heading-items">
                        Phê duyệt
                    </div>
                    <div class="description">
                        Một nơi an toàn và thuận tiện để kiếm tiền
                    </div>
                </div>
                <div class="items">
                    <span class="number">3</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/promote.svg" alt="promote" />
                    </div>
                    <div class="heading-items">
                        Quảng cáo
                    </div>
                    <div class="description">
                        Bắt đầu quảng cáo và sử dụng các công cụ theo dõi của bạn
                    </div>
                </div>
                <div class="items">
                    <span class="number">4</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/earning.svg" alt="earning" />
                    </div>
                    <div class="heading-items">
                        Kiếm tiền
                    </div>
                    <div class="description">
                        Kiếm tiền và tận hưởng thu nhập từ ngày đầu
                    </div>
                </div>
            </div>
            <div class="text-center">
                <a href="@Url.Content(Model.SignUpLink)" class="custom-button">THAM GIA NGAY</a>
            </div>
        </div>
    </div>
</div>

<div class="block block-our-product">
    <div class="page-container">
        <h2 class="block-title fill-color">
            SẢN PHẨM <span class="show-pc">VÀ NHÀ CUNG ỨNG CỦA CHÚNG TÔI</span>
        </h2>
        @{ Html.RenderPartial("~/Views/Home/Partial/_OurProductContentBlock.cshtml", Model.Language); }
    </div>
</div>

<div class="block block-faq">
    <div class="page-container">
        <h2 class="block-title fill-color">
            CÂU HỎI THƯỜNG GẶP (FAQ)
        </h2>
        <div class="block-content">
            <div class="group-faq">
                <div class="number">
                    01
                </div>
                <div class="question">
                    <div class="title">
                        <span>TỔNG QUÁT</span>
                    </div>
                    <span class="button-toggle"></span>
                </div>
                <div class="anwser">
                    <div class="anwser-heading">Chương trình Đại lý 12BET là gì?</div>
                    <div class="anwser-text">
                        Chương trình Đại lý 12BET là một chương trình cộng tác nơi bạn có thể kiếm được hoa hồng dựa trên hoạt động cá cược của người chơi mà bạn giới thiệu tới 12Bet.com từ trang web của bạn thông qua hình thức giới thiệu trực tuyến hoặc ngoại tuyến.
                    </div>
                    <div class="anwser-heading">Tôi làm cách nào để đăng ký chương trình Đại lý 12BET?</div>
                    <div class="anwser-text">
                        Miễn phí khi tham gia chương trình đại lý 12BET. Chỉ cần điền vào mẫu đơn của chúng tôi bạn sẽ được liên hệ để chấp nhận tham gia chương trình trong vòng 3 ngày làm việc. Nếu đơn của bạn được chấp nhận, bạn sẽ nhận được một email có chứa ID hội viên duy nhất cho phép bạn truy cập vào các biểu ngữ, liên kết văn bản và nội dung khác cũng như công cụ tiếp thị để thêm vào trang web của bạn.
                    </div>
                    <div class="anwser-heading">Nếu tôi không có trang web, tôi có thể tham gia không?</div>
                    <div class="anwser-text">
                        Vâng bạn có thể tham gia, nếu bạn nghĩ rằng bạn có khách hàng, bạn có thể dễ dàng tạo ra trang web cá nhân ở trang đại lý đặc biệt của chúng tôi và tải lên bất cứ ý tưởng tiếp thị hoặc tin tức thể thao. Sau khi thực hiện, bạn ngay lập tức có thể gửi đường dẫn trang web này cho bạn bè, người quen của bạn mà họ quan tâm đến lĩnh vực thể thao hoặc cá cược thể thao và khi họ nhấp vào đường link liên kết, họ sẽ trở thành thành viên của bạn! Hãy gửi email tới affiliates@12csd.com để biết thêm chi tiết khác.
                    </div>
                    <div class="text-center">
                        <a href="@Url.Content("~/FAQ")" class="custom-button">CÂU HỎI THƯỜNG GẶP</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>