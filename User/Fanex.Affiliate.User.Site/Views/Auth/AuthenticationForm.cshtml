@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.AuthenticationFormViewModel

@if (Model.IsAuthenticated)
{
    <div class="group-auth-login" id="groupAuth">
        <a class="btn-auth btn-login login-after" id="btnLogout">
            @Lang.Logout
        </a>
        <a href="@Url.RenderLanguageContent("~/UserPanel/Main/#AccountOverview")" class="btn-auth btn-signup">@Lang.MyAcc @Model.UserName</a>
    </div>
}
else
{
    <div class="group-auth-login">
        <div id="userLogin">
            @Html.AntiForgeryToken()
            @if (!string.IsNullOrEmpty(Model.PublicKey))
            {
                @Html.Hidden("PublicKey", Model.PublicKey)
            }
        </div>
        <a class="btn-auth btn-login" id="mobileLogin">
            @Lang.Login
        </a>
        <a href="@Url.RenderLanguageContent("~/Signup")" class="btn-auth btn-signup">@Lang.JoinNowHeader</a>
    </div>
}

