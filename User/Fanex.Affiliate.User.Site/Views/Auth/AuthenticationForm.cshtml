@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.AuthenticationFormViewModel

<link href="@Url.RenderLink("~/www/build/styles/css/feedback.css")" rel="stylesheet" />

@if (Model.IsAuthenticated)
{
    <a class="btn-auth btn-login login-after" id="btnLogout">
        @Lang.Logout
    </a>
    <a href="@Url.Content("~/UserPanel/Main/#AccountOverview")" class="btn-auth btn-signup">@Lang.MyAcc @Model.UserName</a>
}
else
{
    <a class="btn-auth btn-login" id="mobileLogin">
        @Lang.Login
    </a>
    <a href="@Url.Content("~/Signup")" class="btn-auth btn-signup">@Lang.JoinNowHeader</a>
    <div class="modal fade login-dialog" tabindex="-1" role="dialog" id="loginDialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                @*<div class="modal-banner">
                    <img src="~/www/build/styles/Images/logo.png" alt="logo" />
                    <h2 class="logo-text">@Lang.AffiliateProgram</h2>
                </div>*@

                <div class="modal-main-content">
                    <div class="modal-body">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <img src="~/www/build/styles/Images/close-line.png" alt="close-line" class="show-pc"/>
                            <img src="~/www/build/styles/Images/close-line-mobile.png" alt="close-line" class="show-mobile"/>
                        </button>
                        <div class="main-login">
                            <div class="item">
                                <div class="login-login">
                                    <img src="~/www/build/styles/Images/logo.png" alt="logo"/>
                                </div>
                                
                                <h2 class="logo-text">@Lang.AffiliateProgram</h2>
                                <div class="group-text">
                                    <h3 class="title-affmember">@Lang.NotAffiliateMemberYet</h3>
                                    <p id="signUpToAffiliateProgram">@Lang.SignUpToAffiliateProgram</p>
                                </div>
                                <a href="@Url.Content("~/Signup")" role="button" class="btn-join btn-submit btn-block text-uppercase">@Lang.JoinNow</a>
                            </div>

                            <div class="item">
                                <div class="heading-login spacing-bt">@Lang.AffiliateLogin</div>
                                <form class="form-login">
                                    <h3 class="title spacing-bt">@Lang.WelcomeBack</h3>
                                    <div class="spacing-bt">
                                        <div class="custom-input">
                                            <input type="text" id="dialogtxtUsername" class="form-control" placeholder="@Lang.Username" />
                                        </div>
                                        <div class="custom-input">
                                            <input type="password" id="dialogtxtPassword" class="form-control" autocomplete="off" placeholder="@Lang.Password" />
                                        </div>
                                        <div class="custom-input columns-2">
                                            <input type="text" id="dialogtxtValidation" class="form-control captcha-input" placeholder="@Lang.Validation" />
                                            <div class="validation-value" id="loginDialogcaptchaBtn">
                                                @*<span>1832</span>*@
                                                <img src="" alt="captcha" id="loginDialogcaptchaImg" />
                                            </div>
                                        </div>
                                    </div>

                                    @Html.AntiForgeryToken()
                                    @if (!string.IsNullOrEmpty(Model.PublicKey))
                                    {
                                        @Html.Hidden("PublicKey", Model.PublicKey)
                                    }
                                    <button type="button" id="btnDialogLogin" class="btn-submit btn-block text-uppercase spacing-bt">@Lang.Login</button>
                                    <a href="@Url.Content("~/Password")" class="link-login-popup">@Lang.ForgotLoginDetail</a>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

