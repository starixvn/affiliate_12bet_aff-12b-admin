@model bool
@{
    var orgBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/existing/promotion.ko-KR.jpg");
    var mobileBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/existing/promotion-mobile.ko-KR.jpg");
    var laptopBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/existing/promotion-laptop.ko-KR.jpg");
}
<div class="banner-promotion">
    <picture>
        <source media="(max-width:600px)" srcset="@(mobileBannerSrc)" type="image/jpeg" />
        <source media="(max-width:1120px)" srcset="@(laptopBannerSrc)" type="image/jpeg" />
        <source srcset="@(orgBannerSrc)" type="image/jpeg" />
        <img class="img-item img-responsive" src="@orgBannerSrc" alt="@Lang.ExistingPromotion" />
    </picture>
</div>

<div class="promotion-content-text">
    <div class="info-group text-center">
        @if (Model)
        {
            <p>
                이번 독점 프로모션에 대한 자세한 내용은 "나를 위한 제안" 탭하여 확인하세요.
            </p>
        }
        else
        {
            <p>
                자세한 이벤트 내용을 보시려면 <a class="promotion-login-link" href="javascript:;">로그인</a>하시고 "나를 위한 제안"을 탭하세요.
            </p>
        }
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/existing-promotion.js")"></script>