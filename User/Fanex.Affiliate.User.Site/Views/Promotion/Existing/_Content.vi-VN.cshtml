@model bool
@{
    var promotionBannerUrl = Url.Content("~/www/build/styles/Images/promotion/existing/promotion.vi-VN");
}
<div class="banner-promotion">
    <picture>
        <source srcset="@(promotionBannerUrl + ".webp?v=178482v01")" type="image/webp" />
        <source srcset="@(promotionBannerUrl + ".jpg?v=178482v01")" type="image/jpeg" />
        <img class="img-item img-responsive" src="@(promotionBannerUrl + ".jpg?v=178482v01")" alt="@Lang.ExistingPromotion" />
    </picture>
</div>

<div class="info-group">
    @if (Model)
    {
        <p>
            Vui lòng kiểm tra phần "Ưu đãi cho tôi" để biết thêm về chương trình khuyến mãi độc quyền này.
        </p>
    }
    else
    {
        <p>
            Vui lòng <a class="promotion-login-link" href="javascript:;">đăng nhập</a> và kiểm tra tại "Ưu đãi cho tôi" để biết thêm về chương trình khuyến mãi độc quyền này.
        </p>
    }
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/existing-promotion.js")"></script>