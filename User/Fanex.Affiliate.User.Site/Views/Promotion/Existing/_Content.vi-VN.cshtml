@model bool
@{
    var orgBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/existing/promotion.vi-VN.jpg");
    var mobileBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/existing/promotion-mobile.vi-VN.jpg");
    var laptopBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/existing/promotion-laptop.vi-VN.jpg");
}
<div class="banner-promotion">
    <picture>
        <source media="(max-width:600px)" srcset="@(mobileBannerSrc)" type="image/jpeg" />
        <source media="(max-width:1120px)" srcset="@(laptopBannerSrc)" type="image/jpeg" />
        <source srcset="@(orgBannerSrc)" type="image/jpeg" />
        <img class="img-item img-responsive" src="@orgBannerSrc" alt="@Lang.ExistingPromotion" />
    </picture>
</div>

<div class="promotion-content-text">
    <div class="info-group text-center">
        @if (Model)
        {
            <p>
                Vui lòng kiểm tra phần "Ưu đãi cho tôi" để biết thêm về chương trình khuyến mãi độc quyền này.
            </p>
        }
        else
        {
            <p>
                Vui lòng <a class="promotion-login-link" href="javascript:;">đăng nhập</a> và kiểm tra tại "Ưu đãi cho tôi" để biết thêm về chương trình khuyến mãi độc quyền này.
            </p>
        }
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/existing-promotion.js")"></script>