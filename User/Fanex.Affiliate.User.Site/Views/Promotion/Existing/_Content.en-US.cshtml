@model bool
@{
    var promotionBannerUrl = Url.Content("~/www/build/styles/Images/promotion/existing/promotion.en-US");
}
<div class="banner-promotion">
    <picture>
        <source srcset="@(promotionBannerUrl + ".webp?v=178482v01")" type="image/webp" />
        <source srcset="@(promotionBannerUrl + ".jpg?v=178482v01")" type="image/jpeg" />
        <img class="img-item img-responsive" src="@(promotionBannerUrl + ".jpg?v=178482v01")" alt="@Lang.ExistingPromotion" />
    </picture>
</div>

<div class="info-group">
    @if (Model)
    {
        <p class="text-center">
            Kindly check "Offer for me" tab to know more about this exclusive promotion.
        </p>
    }
    else
    {
        <p class="text-center">
            Kindly <a class="text-red promotion-login-link" href="javascript:;">login</a> and check "Offer for me" tab to know more about this exclusive promotion.
        </p>
    }
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/existing-promotion.js")"></script>