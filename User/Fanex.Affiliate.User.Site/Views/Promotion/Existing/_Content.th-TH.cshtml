@model bool
@{
    var orgBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/existing/promotion.th-TH.jpg");
    var mobileBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/existing/promotion-mobile.th-TH.jpg");
    var laptopBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/existing/promotion-laptop.th-TH.jpg");
}
<div class="banner-promotion">
    <picture>
        <source media="(max-width:600px)" srcset="@(mobileBannerSrc)" type="image/jpeg" />
        <source media="(max-width:1120px)" srcset="@(laptopBannerSrc)" type="image/jpeg" />
        <source srcset="@(orgBannerSrc)" type="image/jpeg" />
        <img class="img-item img-responsive" src="@orgBannerSrc" alt="@Lang.ExistingPromotion" />
    </picture>
</div>

<div class="promotion-content-text">
    <div class="info-group text-center">
        @if (Model)
        {
            <p>
                กรุณาตรวจสอบแท็บ "ข้อเสนอสำหรับฉัน" เพื่อทราบข้อมูลเพิ่มเติมเกี่ยวกับโปรโมชั่นสุดพิเศษนี้
            </p>
        }
        else
        {
            <p>
                กรุณา<a class="promotion-login-link" href="javascript:;">เข้าสู่ระบบ</a>และเลือกเมนู "ข้อเสนอสำหรับฉัน" เพื่อทราบข้อมูลเพิ่มเติมเกี่ยวกับโปรโมชั่นพิเศษนี้
            </p>
        }
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/existing-promotion.js")"></script>