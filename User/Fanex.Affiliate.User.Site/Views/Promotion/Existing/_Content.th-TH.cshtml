@model bool
@{
    var promotionBannerUrl = Url.Content("~/www/build/styles/Images/promotion/existing/promotion.th-TH");
}
<div class="banner-promotion">
    <picture>
        <source srcset="@(promotionBannerUrl + ".webp?v=178482v01")" type="image/webp" />
        <source srcset="@(promotionBannerUrl + ".jpg?v=178482v01")" type="image/jpeg" />
        <img class="img-item img-responsive" src="@(promotionBannerUrl + ".jpg?v=178482v01")" alt="@Lang.ExistingPromotion" />
    </picture>
</div>

<div class="info-group">
    @if (Model)
    {
        <p class="text-center">
            กรุณาตรวจสอบแท็บ "ข้อเสนอสำหรับฉัน" เพื่อทราบข้อมูลเพิ่มเติมเกี่ยวกับโปรโมชั่นสุดพิเศษนี้
        </p>
    }
    else
    {
        <p class="text-center">
            กรุณา<a class="text-red promotion-login-link" href="javascript:;">เข้าสู่ระบบ</a>และเลือกเมนู "ข้อเสนอสำหรับฉัน" เพื่อทราบข้อมูลเพิ่มเติมเกี่ยวกับโปรโมชั่นพิเศษนี้
        </p>
    }
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/existing-promotion.js")"></script>