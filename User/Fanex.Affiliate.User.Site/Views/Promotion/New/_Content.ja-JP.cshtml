@model bool
@{
    var promotionBannerUrl = Url.Content("~/www/build/styles/Images/promotion/new/promotion.ja-JP");
}
<div class="banner-promotion">
    <picture>
        <source srcset="@(promotionBannerUrl + ".webp?v=178482v01")" type="image/webp" />
        <source srcset="@(promotionBannerUrl + ".jpg?v=178482v01")" type="image/jpeg" />
        <img class="img-item img-responsive" src="@(promotionBannerUrl + ".jpg?v=178482v01")" alt="@Lang.NewPromotion" />
    </picture>
</div>

<div class="info-group">
    <p class="text-bold">CLAIM 50% COMMISSION IN 3 SIMPLE STEPS:</p>
    <ol>
        <li class="text">Simply click "BE AFFILIATE NOW!" button and join the 12BET affiliate program.</li>
        <li class="text">Invite your players as much as you can and hit the target requirement as table below.</li>
        <li class="text">Take home 50% of company's net winloss without any limit.</li>
    </ol>
</div>

@{ Html.RenderPartial("~/Views/CommissionStructure/_NewRevenueShareTable.cshtml"); }
@if (!Model)
{
    <div class="text-center"><a class='btn-danger btn-join-affiliate' href='@Url.Content("~/Signup")'>BE AFFILIATE NOW!</a></div>
}
<div class="info-group">
    <p class="text">
        Have questions? <a class="text-red" href="@Url.Content("~/ContactUs")">Contact</a> 12BET AFFILIATE team now!
    </p>
</div>

<h2 class="header-underline text-red">TERMS AND CONDITIONS</h2>
<div class="info-group">
    <p class="text">
        <ol>
            <li>
                This offer applies to all Affiliates who join 12BET Affiliate program between 1st Oct – 31st  Dec 2022.
            </li>
            <li>Affiliates will be eligible to get 50% commission as per criteria indicated in the table above.</li>
            <li>Affiliates can get 50% commission for a maximum of 3 times between 1st Oct – 31st  Dec 2022.</li>
            <li>All commissions will be credited within 08th - 15th of the following month.</li>
            <li>Once Offer Period is over all affiliate partners will be eligible for our <a class="text-red" href="@Url.Content("~/CommissionStructure")">Standard commission structure.</a></li>
            <li>12BET Affiliate Team reserves the right to cancel this offer at any time, either for all affiliates or an individual affiliate and its subjected to <a href="@Url.Content("~/TermAndCondition")" class="text-red">12BET Affiliates Program Terms and Conditions.</a></li>
        </ol>
    </p>
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/new-promotion.js")"></script>