@model bool
@{
    var promotionBannerUrl = Url.Content("~/www/build/styles/Images/promotion/new/promotion.th-TH");
}
<div class="banner-promotion">
    <picture>
        <source srcset="@(promotionBannerUrl + ".webp?v=178482v01")" type="image/webp" />
        <source srcset="@(promotionBannerUrl + ".jpg?v=178482v01")" type="image/jpeg" />
        <img class="img-item img-responsive" src="@(promotionBannerUrl + ".jpg?v=178482v01")" alt="@Lang.NewPromotion" />
    </picture>
</div>

<div class="info-group">
    <p class="text-bold">ទាមទារកំរៃជើងសារ 50% ជាមួយនិង 3 ជំហានងាយៗ៖</p>
    <ol>
        <li class="text">គ្រាន់តែចុច "ក្លាយជាភ្នាក់ងារឥឡូវនេះ!" ចុចប៊ូតុងចូលរួមកម្មវិធីភ្នាក់ងារ 12BET</li>
        <li class="text">អញ្ជើញអ្នកអតិថិជនដែលជាអ្នកលេងរបស់អ្នកអោយបានច្រើនតាមដែលអាចធ្វើបាន ដើម្បីឈានដល់គោលដៅដូចតារាងខាងក្រោម៖</li>
        <li class="text">ទទួលបាន 50%​ ដោយគ្មានដែនកំណត់</li>
    </ol>
</div>

@{ Html.RenderPartial("~/Views/CommissionStructure/_NewRevenueShareTable.cshtml"); }
@if (!Model)
{
    <div class="text-center"><a class='btn-danger btn-join-affiliate' href='@Url.Content("~/Signup")'>ជា​ភ្នាក់ងារឥឡូវនេះ!</a></div>
}
<div class="info-group">
    <p class="text">
        តើមានសំណួរដែលឬទេ? អាច<a class="text-red" href="@Url.Content("~/ContactUs")">ទំនាក់ទំនង</a>មកកាន់ក្រុមការងារ 12BET ឥឡូវនេះ!
    </p>
</div>

<h2 class="header-underline text-red">លក្ខខណ្ឌ</h2>
<div class="info-group">
    <p class="text">
        <ol>
            <li>
                ការផ្តល់ជូនពិសេសនេះអនុវត្តចំពោះភ្នាក់ងារទាំងអស់ដែលចុះឈ្មោះពីថ្ងៃទី 1 ខែតុលា រហូតដល់ថ្ងៃទី 31 ខែធ្នូ ឆ្នាំ 2022
            </li>
            <li>ភ្នាក់ងារនឹងមានសិទ្ធិទទួលបានកំរៃជើងសារ 50% ប្រសិនបើពួកគេអាចបំពេញតម្រូវការដូចដែលបានបង្ហាញក្នុងតារាងខាងលើ</li>
            <li>ភ្នាក់ងារនិងទទួលបានកំរៃជើងសារ 50% សម្រាប់រយៈពេល 3 ដងពី: ថ្ងៃទី 01​ ខែតុលា–ថ្ងៃទី 31 ខែវិច្ឆិកា 2022</li>
            <li>រាល់កំរៃជើងសារនឹងត្រូវបានផ្តល់ជូនក្នុងកំឡុងថ្ងៃទី 08 ដល់ថ្ងៃទី 15 នៃខែ</li>
            <li>បន្ទាប់ពីប្រូម៉ូសិននេះត្រូវបានបញ្ចប់ ភ្នាក់ងារនឹងមានសិទ្ធិទទួលបាននូវ<a class="text-red" href="@Url.Content("~/CommissionStructure")">រចនាសម្ព័ន្ធកំរៃជើងសារស្តង់ដារមួយ</a></li>
            <li>ក្រុមការងារភ្នាក់ងារ12BET សូមរក្សាសិទ្ធិក្នុងការលុបចោលការផ្តល់ជូនពិសេសនេះគ្រប់ពេលវេលារួមទាំងភ្នាក់ងារទាំងអស់ ឬភ្នាក់ងារលក្ខណះបុគ្គល ដែលស្ថិតនៅក្រោម<a href="@Url.Content("~/TermAndCondition")" class="text-red">លក្ខខណ្ឌរបស់ភ្នាក់ងារ12BET។</a></li>
        </ol>
    </p>
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/new-promotion.js")"></script>