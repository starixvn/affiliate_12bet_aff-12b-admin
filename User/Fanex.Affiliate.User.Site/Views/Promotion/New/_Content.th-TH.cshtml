@model bool
@{
    var orgBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/new/promotion.th-TH.jpg");
    var mobileBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/new/promotion-mobile.th-TH.jpg");
    var laptopBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/new/promotion-laptop.th-TH.jpg");
}
<div class="banner-promotion">
    <picture>
        <source media="(max-width:600px)" srcset="@(mobileBannerSrc)" type="image/jpeg" />
        <source media="(max-width:1120px)" srcset="@(laptopBannerSrc)" type="image/jpeg" />
        <source srcset="@(orgBannerSrc)" type="image/jpeg" />
        <img class="img-item img-responsive" src="@orgBannerSrc" alt="@Lang.NewPromotion" />
    </picture>
</div>

<div class="promotion-content-text">
    <div class="info-group">
        <p class="text-bold">รับข้อเสนอคอมมิชชั่น 50% ด้วย 3 วิธีง่ายๆ : </p>
        <ol>
            <li class="text">เพียงคลิก "สมัครพันธมิตรตอนนี้!" และเข้าร่วมโปรแกรมพันธมิตร 12BET</li>
            <li class="text">เชิญสมาชิกมาเดิมพันให้มากที่สุดเท่าที่จะทำได้และทำยอดเล่นสะสมให้ถึงเป้าตามตารางด้านล่าง</li>
            <li class="text">รับคอมมิชชั่น 50% ของกำไรสุทธิไม่จำกัด</li>
        </ol>
    </div>

    @{ Html.RenderPartial("~/Views/CommissionStructure/_NewRevenueShareTable.cshtml"); }
    @if (!Model)
    {
        <div class="text-center"><a class='btn-danger btn-join-affiliate' href='@Url.Content("~/Signup")'>สมัครพันธมิตรตอนนี้!</a></div>
    }
    <div class="info-group">
        <p class="text">
            หากมีข้อสงสัย? <a href="@Url.Content("~/ContactUs")">ติดต่อ</a>ทีมงานพันธมิตร12BET ตอนนี้!
        </p>
    </div>

    <h2 class="header-underline text-danger">กติกาและเงื่อนไขโปรโมชั่น</h2>
    <div class="info-group">
        <p class="text">
            <ol>
                <li>
                    โปรโมชั่นนี้สำหรับสมาชิกพันธมิตรใหม่ทั้งหมดที่ลงทะเบียนตั้งแต่วันที่ 1 ตุลาคม - 31 ธันวาคม 2565 เท่านั้น
                </li>
                <li>พันธมิตรจะมีสิทธิ์ได้รับค่าคอมมิชชั่น 50% หากสามารถทำตามข้อกำหนดตามที่ระบุไว้ในตารางด้านบน</li>
                <li>พันธมิตรใหม่สามารถรับค่าคอมมิชชั่น 50% ได้ถึง 3 ครั้ง ตั้งแต้วันที่ 1 ตุลาคม - 31 ธันวาคม 2565</li>
                <li>ค่าคอมมิชชั่นทั้งหมด จะเครดิตพร้อมกับค่าคอมมิชชั่นเดือนล่าสุดภายในวันที่ 8 - 15 ของเดือน</li>
                <li>หลังจากสิ้นสุดช่วงโปรโมชั่นดังกล่าว พันธมิตรจะมีสิทธิ์ได้รับ<a href="@Url.Content("~/CommissionStructure")">โครงสร้างคอมมิชชั่นปกติ</a></li>
                <li>ทีมงานพันธมิตร12BET ขอสงวนสิทธิ์ในการยกเลิกโปรโมชั่นนี้ได้ตลอดเวลาไม่ว่าจะเป็นพันธมิตรทั้งหมดหรือพันธมิตรบางท่าน ให้ยึดหลัก <a href="@Url.Content("~/TermAndCondition")">ข้อกำหนดเงื่อนไขและกติกามาตรฐานของพันธมิตร 12BET เป็นหลักในการตัดสินและบังคับใช้.</a></li>
            </ol>
        </p>
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/new-promotion.js")"></script>
