@model bool
@{
    var promotionBannerUrl = Url.Content("~/www/build/styles/Images/promotion/new/promotion.id-ID");
}
<div class="banner-promotion">
    <picture>
        <source srcset="@(promotionBannerUrl + ".webp?v=178482v01")" type="image/webp" />
        <source srcset="@(promotionBannerUrl + ".jpg?v=178482v01")" type="image/jpeg" />
        <img class="img-item img-responsive" src="@(promotionBannerUrl + ".jpg?v=178482v01")" alt="@Lang.NewPromotion" />
    </picture>
</div>

<div class="info-group">
    <p class="text-bold">KLAIM 50% KOMISI DENGAN 3 CARA MUDAH:</p>
    <ol>
        <li class="text">Klik "JADI AFILIASI SEKARANG" dan gabung di program afliliasi 12BET.</li>
        <li class="text">Ajak pemain sebanyak mungkin dan capai target yang ditentukan sesuai tabel dibawah ini.</li>
        <li class="text">Dapatkan 50% dari keuntungan bersih tanpa batas.</li>
    </ol>
</div>

@{ Html.RenderPartial("~/Views/CommissionStructure/_NewRevenueShareTable.cshtml"); }
@if (!Model)
{
    <div class="text-center"><a class='btn-danger btn-join-affiliate' href='@Url.Content("~/Signup")'>JADI AFILIASI SEKARANG!</a></div>
}
<div class="info-group">
    <p class="text">
        Ada pertanyaan? <a class="text-red" href="@Url.Content("~/ContactUs")">Hubungi</a> tim Afiliasi 12BET sekarang!
    </p>
</div>

<h2 class="header-underline text-red">SYARAT DAN KETENTUAN</h2>
<div class="info-group">
    <p class="text">
        <ol>
            <li>
                Promosi ini berlaku untuk semua Afiliasi baru yang baru bergabung di Program Afiliasi 12BET pada 01 Okt - 31 Des 2022.
            </li>
            <li>Afiliasi yang berhak mendapatkan komisi 50% jika dapat memenuhi kriteria yang ditunjukkan pada tabel di atas.</li>
            <li>Afiliasi baru akan mendapatkan komisi 50% maksimal 3 kali selama 01 Okt - 31 Des 2022.</li>
            <li>Komisi 50% akan dikreditkan setiap tanggal 08 - 15 di setiap bulan berikutnya.</li>
            <li>Setelah periode promosi berakhir, Afiliasi akan mendapatkan komisi sesuai <a class="text-red" href="@Url.Content("~/CommissionStructure")">struktur perhitungan standar.</a></li>
            <li>Tim Afiliasi 12BET berhak mengubah atau membatalkan promosi kapan saja, baik untuk semua afiliasi atau afiliasi individual dan mengacu kepada <a href="@Url.Content("~/TermAndCondition")" class="text-red">Syarat dan Ketentuan umum Afiliasi 12BET.</a></li>
        </ol>
    </p>
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/new-promotion.js")"></script>