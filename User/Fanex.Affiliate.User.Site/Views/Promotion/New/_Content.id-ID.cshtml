@model bool
@{
    var orgBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/new/promotion.id-ID.jpg");
    var mobileBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/new/promotion-mobile.id-ID.jpg");
    var laptopBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/new/promotion-laptop.id-ID.jpg");
}
<div class="banner-promotion">
    <picture>
        <source media="(max-width:600px)" srcset="@(mobileBannerSrc)" type="image/jpeg" />
        <source media="(max-width:1120px)" srcset="@(laptopBannerSrc)" type="image/jpeg" />
        <source srcset="@(orgBannerSrc)" type="image/jpeg" />
        <img class="img-item img-responsive" src="@orgBannerSrc" alt="@Lang.NewPromotion" />
    </picture>
</div>

<div class="promotion-content-text">
    <div class="info-group">
        <p class="text-bold">KLAIM 50% KOMISI DENGAN 3 CARA MUDAH:</p>
        <ol>
            <li class="text">Klik "JADI AFILIASI SEKARANG" dan gabung di program afliliasi 12BET.</li>
            <li class="text">Ajak pemain sebanyak mungkin dan capai target yang ditentukan sesuai tabel dibawah ini.</li>
            <li class="text">Dapatkan 50% dari keuntungan bersih tanpa batas.</li>
        </ol>
    </div>

    @{ Html.RenderPartial("~/Views/CommissionStructure/_NewRevenueShareTable.cshtml"); }
    @if (!Model)
    {
        <div class="text-center"><a class='btn-danger btn-join-affiliate' href='@Url.Content("~/Signup")'>JADI AFILIASI SEKARANG!</a></div>
    }
    <div class="info-group">
        <p class="text">
            Ada pertanyaan? <a href="@Url.Content("~/ContactUs")">Hubungi</a> tim Afiliasi 12BET sekarang!
        </p>
    </div>

    <h2 class="header-underline text-danger">SYARAT DAN KETENTUAN</h2>
    <div class="info-group">
        <p class="text">
            <ol>
                <li>
                    Promosi ini berlaku untuk semua Afiliasi baru yang baru bergabung di Program Afiliasi 12BET pada 01 Okt - 31 Des 2022.
                </li>
                <li>Afiliasi yang berhak mendapatkan komisi 50% jika dapat memenuhi kriteria yang ditunjukkan pada tabel di atas.</li>
                <li>Afiliasi baru akan mendapatkan komisi 50% maksimal 3 kali selama 01 Okt - 31 Des 2022.</li>
                <li>Komisi 50% akan dikreditkan setiap tanggal 08 - 15 di setiap bulan berikutnya.</li>
                <li>Setelah periode promosi berakhir, Afiliasi akan mendapatkan komisi sesuai <a href="@Url.Content("~/CommissionStructure")">struktur perhitungan standar.</a></li>
                <li>Tim Afiliasi 12BET berhak mengubah atau membatalkan promosi kapan saja, baik untuk semua afiliasi atau afiliasi individual dan mengacu kepada <a href="@Url.Content("~/TermAndCondition")">Syarat dan Ketentuan umum Afiliasi 12BET.</a></li>
            </ol>
        </p>
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/new-promotion.js")"></script>
