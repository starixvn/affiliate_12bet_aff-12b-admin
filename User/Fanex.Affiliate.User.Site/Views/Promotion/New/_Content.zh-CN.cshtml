@model bool
@{
    var orgBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/new/promotion.zh-CN.jpg");
    var mobileBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/new/promotion-mobile.zh-CN.jpg");
    var laptopBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/new/promotion-laptop.zh-CN.jpg");
}
<div class="banner-promotion">
    <picture>
        <source media="(max-width:600px)" srcset="@(mobileBannerSrc)" type="image/jpeg" />
        <source media="(max-width:1120px)" srcset="@(laptopBannerSrc)" type="image/jpeg" />
        <source srcset="@(orgBannerSrc)" type="image/jpeg" />
        <img class="img-item img-responsive" src="@orgBannerSrc" alt="@Lang.NewPromotion" />
    </picture>
</div>

<div class="promotion-content-text">
    <div class="info-group">
        <p class="text-bold">3步骤轻松赚取50%佣金：</p>
        <ol>
            <li class="text">点击【立即注册】加入12BET合作伙伴计划。</li>
            <li class="text">尽量招募会员，以达成下表目标。</li>
            <li class="text">不受地域限制，在家轻松赚取50%公司净盈利。</li>
        </ol>
    </div>

    @{ Html.RenderPartial("~/Views/CommissionStructure/_NewRevenueShareTable.cshtml"); }
    @if (!Model)
    {
        <div class="text-center"><a class='btn-danger btn-join-affiliate' href='@Url.Content("~/Signup")'>立即成为合作伙伴！</a></div>
    }
    <div class="info-group">
        <p class="text">
            如有任何问题，请<a href="@Url.Content("~/ContactUs")">询问</a>12BET合作伙伴团队。
        </p>
    </div>

    <h2 class="header-underline text-danger">条款与规则</h2>
    <div class="info-group">
        <p class="text">
            <ol>
                <li>
                    此优惠活动适用于所有在2022年10月1日至12月31日期间，加入12BET合作伙伴计划的会员。
                </li>
                <li>达成上表所示业绩标准，将有资格获得50%的佣金。</li>
                <li>在2022年10月1日至12月31日期间，符合资格的合作伙伴成员，最多可以获得3次50%的佣金。</li>
                <li>佣金将于下个月的8～15日内入账。</li>
                <li>优惠活动结束后，将恢复为<a href="@Url.Content("~/CommissionStructure")">常规佣金结构。</a></li>
                <li>12BET保留在任何时候对全部或部分合作伙伴，取消该优惠活动的所有权利。本优惠活动同时遵守<a href="@Url.Content("~/TermAndCondition")"> 12BET合作伙伴条款及规则。</a></li>
            </ol>
        </p>
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/new-promotion.js")"></script>
