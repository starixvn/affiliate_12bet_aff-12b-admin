@model bool
@{
    var promotionBannerUrl = Url.Content("~/www/build/styles/Images/promotion/new/promotion.vi-VN");
}
<div class="banner-promotion">
    <picture>
        <source srcset="@(promotionBannerUrl + ".webp?v=178482v01")" type="image/webp" />
        <source srcset="@(promotionBannerUrl + ".jpg?v=178482v01")" type="image/jpeg" />
        <img class="img-item img-responsive" src="@(promotionBannerUrl + ".jpg?v=178482v01")" alt="@Lang.NewPromotion" />
    </picture>
</div>

<div class="info-group">
    <p>NHẬN 50% HOA HỒNG CHỈ VỚI 3 BƯỚC:</p>
    <ol>
        <li class="text">Chỉ cần nhấp vào nút "TRỞ THÀNH ĐẠI LÝ" và tận hưởng Chương trình đại lý 12BET.</li>
        <li class="text">Thúc đẩy thành viên của bạn tham gia chơi và đạt yêu cầu nhiều nhất có thể như bảng dưới. </li>
        <li class="text">Mang về nhà 50% hoa hồng không giới hạn số lượng.</li>
    </ol>
</div>

@{ Html.RenderPartial("~/Views/CommissionStructure/_NewRevenueShareTable.cshtml"); }
@if (!Model)
{
    <a class='btn-danger btn-join-affiliate' href='@Url.Content("~/Signup")'>TRỞ THÀNH ĐẠI LÝ!</a>
}
<div class="info-group">
    <p class="text">
        Bạn có câu hỏi? Vui lòng <a href="@Url.Content("~/ContactUs")">liên hệ</a> đội ngũ chúng tôi!
    </p>
</div>

<h2 class="header-underline text-danger">ĐIỀU KHOẢN & ĐIỀU KIỆN</h2>
<div class="info-group">
    <p class="text">
        <ol>
            <li>
                Khuyến mãi này chỉ áp dụng cho Quý đại lý mới đăng ký từ ngày 1/10 - 31/12/2022.
            </li>
            <li>Các Đại lý sẽ đủ điều kiện nhận 50% hoa hồng theo tiêu chí yêu cầu được chỉ định trong bảng trên.</li>
            <li>Các Đại lý mới có thể nhận được 50% hoa hồng 3 lần trong khoảng thời gian từ 1/10 - 31/12/2022.</li>
            <li>Toàn bộ tiền hoa hồng sẽ được cập nhật trong khoảng từ ngày 08 - 15 của tháng tiếp theo.</li>
            <li>Sau thời gian khuyến mãi, quý đại lý sẽ được hưởng <a href="@Url.Content("~/CommissionStructure")">cơ cấu hoa hồng tiêu chuẩn.</a></li>
            <li>12BET có quyền hủy chương trình khuyến mãi này bất kỳ lúc nào, đối với tất cả các đại lý hoặc đơn vị liên kết riêng lẻ và nó phải tuân theo <a href="@Url.Content("~/TermAndCondition")">Điều khoản và Điều kiện dành cho Đại lý của 12BET.</a></li>
        </ol>
    </p>
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/new-promotion.js")"></script>