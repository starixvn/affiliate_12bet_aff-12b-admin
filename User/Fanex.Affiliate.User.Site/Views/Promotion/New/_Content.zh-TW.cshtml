@model bool
@{
    var promotionBannerUrl = Url.Content("~/www/build/styles/Images/promotion/new/promotion.zh-TW");
}
<div class="banner-promotion">
    <picture>
        <source srcset="@(promotionBannerUrl + ".webp?v=178482v01")" type="image/webp" />
        <source srcset="@(promotionBannerUrl + ".jpg?v=178482v01")" type="image/jpeg" />
        <img class="img-item img-responsive" src="@(promotionBannerUrl + ".jpg?v=178482v01")" alt="@Lang.NewPromotion" />
    </picture>
</div>

<div class="info-group">
    <p>3步驟輕鬆賺取50%佣金：</p>
    <ol>
        <li class="text">點選【立即註冊】加入12BET合作夥伴計劃。</li>
        <li class="text">盡量招募會員，以達成下表目標。</li>
        <li class="text">不受地域限制，在家輕鬆賺取50%公司淨盈利。</li>
    </ol>
</div>

@{ Html.RenderPartial("~/Views/CommissionStructure/_NewRevenueShareTable.cshtml"); }
@if (!Model)
{
    <a class='btn-danger btn-join-affiliate' href='@Url.Content("~/Signup")'>立即成為合作夥伴！</a>
}
<div class="info-group">
    <p class="text">
        如有任何問題，請<a href="@Url.Content("~/ContactUs")">詢問</a>12BET合作夥伴團隊。
    </p>
</div>

<h2 class="header-underline text-danger">條款與規則</h2>
<div class="info-group">
    <p class="text">
        <ol>
            <li>
                此優惠活動適用於所有在2022年10月1日至12月31日期間，加入12BET合作夥伴計劃的會員。
            </li>
            <li>達成上表所示業績標準，將有資格獲得50%的佣金。</li>
            <li>在2022年10月1日至12月31日期間，符合資格的合作夥伴成員，最多可以獲得3次50%的佣金。</li>
            <li>佣金將於下個月的8～15日內入帳。</li>
            <li>優惠活動結束後，將恢復為<a href="@Url.Content("~/CommissionStructure")">常规佣金結構。</a></li>
            <li>12BET保留在任何時候對全部或部分合作夥伴，取消該優惠活動的所有權利。本優惠活動同時遵守 <a href="@Url.Content("~/TermAndCondition")">2BET合作夥伴條款及規則。</a></li>
        </ol>
    </p>
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/new-promotion.js")"></script>