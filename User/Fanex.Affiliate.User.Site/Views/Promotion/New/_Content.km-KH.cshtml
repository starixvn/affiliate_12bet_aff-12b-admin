@model bool
@{
    var orgBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/new/promotion.km-KH.jpg");
    var mobileBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/new/promotion-mobile.km-KH.jpg");
    var laptopBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/new/promotion-laptop.km-KH.jpg");
}
<div class="banner-promotion">
    <picture>
        <source media="(max-width:600px)" srcset="@(mobileBannerSrc)" type="image/jpeg" />
        <source media="(max-width:1120px)" srcset="@(laptopBannerSrc)" type="image/jpeg" />
        <source srcset="@(orgBannerSrc)" type="image/jpeg" />
        <img class="img-item img-responsive" src="@orgBannerSrc" alt="@Lang.NewPromotion" />
    </picture>
</div>

<div class="promotion-content-text">
    <div class="info-group">
        <p class="text-bold">ទាមទារកំរៃជើងសារ 50% ត្រឹមតែ 3 ជំហានងាយៗតែប៉ុណ្ណោះ៖</p>
        <ol>
            <li class="text">គ្រាន់តែចុចប៊ូតុង "ក្លាយជាភ្នាក់ងារឥឡូវនេះ!"  ហើយចូលរួមកម្មវិធីភ្នាក់ងារ 12BET</li>
            <li class="text">អញ្ជើញអ្នកលេងរបស់អ្នកអោយបានច្រើនតាមដែលអ្នកអាចធ្វើបានហើយអាចឈានដល់គោលដៅដូចតារាងខាងក្រោម</li>
            <li class="text">ទទួលបានកំរៃជើងសារ 50% ​​នៃប្រាក់ចំណេញសុទ្ធគ្មានដែនកំណត់</li>
        </ol>
    </div>

    @{ Html.RenderPartial("~/Views/CommissionStructure/_NewRevenueShareTable.cshtml"); }
    @if (!Model)
    {
        <div class="text-center"><a class='btn-danger btn-join-affiliate' href='@Url.Content("~/Signup")'>ក្លាយជាភ្នាក់ងារឥឡូវនេះ!</a></div>
    }
    <div class="info-group">
        <p class="text">
            មានសំណួរ? <a href="@Url.Content("~/ContactUs")">សូមទំនាក់ទំនង</a>ក្រុមការងារ 12BET ឥឡូវនេះ!
        </p>
    </div>

    <h2 class="header-underline text-danger">ល័ក្ខខ័ណ្ឌនៃការផ្តល់ជូនពិសេស</h2>
    <div class="info-group">
        <p class="text">
            <ol>
                <li>
                    ការផ្តល់ជូននេះអនុវត្តចំពោះភ្នាក់ងារទាំងអស់ដែលចូលរួមកម្មវិធីភ្នាក់ងារ 12BET ពីថ្ងៃទី 1 ខែតុលា ដល់ថ្ងៃទី 31 ខែធ្នូ ឆ្នាំ 2022
                </li>
                <li>ភ្នាក់ងារនឹងមានសិទ្ធិទទួលបានកំរៃជើងសារ 50% តាមលក្ខណៈវិនិច្ឆ័យដែលមានបង្ហាញក្នុងតារាងខាងលើ</li>
                <li>ភ្នាក់ងារអាចទទួលបានកំរៃជើងសារ 50% សម្រាប់អតិបរមា 3 ដងចន្លោះពីថ្ងៃទី 1 ខែតុលា ដល់ថ្ងៃទី 31 ខែធ្នូ ឆ្នាំ 2022</li>
                <li>កំរៃជើងសារទាំងអស់នឹងត្រូវបានបញ្ចូលក្នុងកំឡុងថ្ងៃទី 08 - 15 នៃខែបន្ទាប់</li>
                <li>បន្ទាប់ពីការផ្តល់ជូនត្រូវបានបញ្ចប់ ភ្នាក់ងារជាដៃគូនិងទទួលបាន<a href="@Url.Content("~/CommissionStructure")">រចនាសម្ព័ន្ធនៃកំរៃជើងសារតាមធម្មតា</a></li>
                <li>ក្រុមភ្នាក់ងាររបស់ 12BET សូមរក្សាសិទ្ធិក្នុងការលុបចោលការផ្តល់ជូននេះគ្រប់ពេលវេលា មិនថាគ្រប់ភ្នាក់ងារទាំងអស់ ឬភ្នាក់ងារឯកជននោះទេ <a href="@Url.Content("~/TermAndCondition")">លក្ខខណ្ឌភ្នាក់ងារ 12BET</a>នឹងក្លាយជាមូលដ្ឋានសម្រាប់ការសម្រេចចិត្តក្នុងការអនុវត្ត</li>
            </ol>
        </p>
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/promotion/new-promotion.js")"></script>