@{
    var bannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/promotion.vi-VN.jpg");
    var mobileBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/promotion-mobile.vi-VN.jpg");
}
<div class="banner-promotion">
    <picture>
        <source media="(max-width:400px)" srcset="@(mobileBannerSrc)" type="image/jpeg" />
        <source srcset="@(bannerSrc)" type="image/jpeg" />
        <img class="img-item img-responsive" src="@bannerSrc" alt="@Lang.Promotion" />
    </picture>
</div>
<br />
<div class="info-group">
    <h3 class="header-underline text-red">12BET GIA TĂNG HOA HỒNG</h3>
    <p><strong>Nhận hoa hồng khủng lên đến 50%!</strong></p>
    <p>Nhận hoa hồng mỗi tháng cao hơn một cách dễ dàng - chỉ cần đáp ứng các yêu cầu bên dưới!</p>
</div>
@{ Html.RenderPartial("~/Views/Promotion/_RevenueShareTable.cshtml"); }
<div class="info-group">
    <p class="text-header"><strong>Lưu ý -</strong></p>
    <p class="text">
        <ol>
            <li>Nếu đại lý đạt được các yêu cầu khác nhau cho [tổng lợi nhuận ròng mỗi tháng] và [thành viên đủ điều kiện trong một tháng] thì khoản thanh toán hoa hồng sẽ dựa trên cấp thấp hơn. Chẳng hạn, nếu tổng Khoản lỗ ròng của các thành viên dưới Đại lý một tháng hiện tại là 46,000$ và số thành viên Đủ điều kiện là 7, thì hoa hồng trong thời gian này sẽ là 35%.</li>
            <li>Chỉ cần giới thiệu - Nếu bạn tin rằng mình có một đề xuất hấp dẫn để gia tăng lợi nhuận ròng của mình (chẳng hạn như cách thu hút thành viên VIP), bạn có thể liên hệ với người quản lý Đại lý để đánh giá đề xuất và kiểm tra xem để xuất có đủ điều kiện hay không.</li>
        </ol>
    </p>
</div>
<div class="info-group">
    <h3 class="header-underline text-red">THƯỞNG THÀNH VIÊN NẠP MỚI ĐỘC QUYỀN</h3>
    <p>Tại 12BET, các phần thưởng phụ luôn được đảm bảo. Tất cả những gì bạn cần làm là đáp ứng các yêu cầu Nạp Tiền Lần Đầu của các thành viên mới và nhận thêm hoa hồng của bạn.</p>
</div>
@{ Html.RenderPartial("~/Views/Promotion/_FdmTable.cshtml"); }
<div class="info-group">
    <p class="text-header"><strong>Lưu ý - </strong>Mỗi đại lý sẽ nhận được một tỷ lệ phần trăm bổ sung bên cạnh hoa hồng họ kiếm được, bất kể đó là Hoa hồng Cố định mỗi tháng hay từ khuyến mãi Tăng hoa hồng của 12BET.</p>
</div>
<div class="info-group">
    <p class="text-header"><strong>Ví dụ Cách tính hoa hồng:</strong></p>
    <p>Đại lý XYZ' đạt mức lợi nhuận ròng là 35,000$ và có 25 thành viên đủ điều kiện và 12 thành viên nạp mới. Tổng số tiền gửi do Thành viên nạp mới là 3,000$. Đại lý đó đủ điều kiện cho cả hai chương trình khuyến mãi, đó là Hoa hồng khủng và Thưởng nạp mới độc quyền tại 12BET.</p>
    <p>Để tính hoa hồng, trước tiên áp dụng vào bảng Hoa hồng mỗi tháng là 35% của 35,000$ = 12,250$.</p>
    <p>Tiếp theo, áp dụng vào bảng Thưởng thành viên nạp mới là 3%. Do đó, tiền thưởng là 367.5$, nhưng vì tiền thưởng tối đa là 250$ nên tiền hoa hồng sẽ là 12,250$ + 250$  = 12,500$.</p>
    <p>Do đó, tổng hoa hồng mà Đại lý XYZ nhận được là 12,500$ .</p>
</div>
<h3 class="header-underline text-red">ĐIỀU KHOẢN & ĐIỀU KIỆN</h3>
<div class="info-group">
    <p class="text-header"><strong>Thưởng Hoa hồng khủng mỗi tháng</strong></p>
    <p class="text">
        <ol>
            <li>Khuyến mãi này áp dụng cho tất cả các Đại Lý của 12BET.</li>
            <li>Nếu Đại lý liên kết đạt được các cấp độ khác nhau cho [tổng lợi nhuận ròng mỗi tháng] và [thành viên đủ điều kiện trong một tháng] thì khoản thanh toán hoa hồng sẽ dựa trên cấp độ thấp hơn.</li>
            <li>Những Đại lý không đủ tiêu chuẩn của chương trình khuyến mãi này sẽ vẫn tiếp tục nhận tiền hoa hồng dựa trên <a href="@Url.Content("~/CommissionStructure")">cấu trúc hoa hồng thông thường</a> hiện có.</li>
            <li>Chỉ cần giới thiệu - Nếu bạn tin rằng mình có một đề xuất để gia tăng lợi nhuận ròng (chẳng hạn như thu hút các thành viên VIP), bạn có thể liên hệ với đội quản lý Đại lý để đánh giá đề xuất và xác định tính đủ điều kiện của đề xuất.</li>
            <li>Các Đại lý đủ điều kiện nhận thêm hoa hồng nếu họ có thể đạt được các yêu cầu như được nêu trong bảng trên.</li>
            <li>Hoa hồng thêm sẽ được tính từ hoa hồng tổng kết của tháng trước đó.</li>
            <li>Hoa hồng bổ sung sẽ được cộng vào khoản hoa hồng cuối cùng trong khoảng ngày 08 - 15 mỗi tháng.</li>
            <li>12BET có quyền hủy khuyến mãi này bất cứ lúc nào, đối với tất cả các Đại lý hoặc các chi nhánh riêng lẻ và tuân theo <a href="@Url.Content("~/TermAndCondition")">Điều khoản và Điều kiện Đại lý của 12BET.</a></li>
        </ol>
    </p>
</div>
<div class="info-group">
    <p class="text-header"><strong>THÀNH VIÊN NẠP MỚI ĐỘC QUYỀN</strong></p>
    <p class="text">
        <ol>
            <li>Khuyến mãi này áp dụng cho tất cả các Đại Lý của 12BET.</li>
            <li>Nếu [TỔNG SỐ THÀNH VIÊN NẠP MỚI] và [Tổng số tiền gửi của THÀNH VIÊN NẠP MỚI] ở 2 cấp độ khác nhau, thì cấp độ thấp hơn sẽ được sử dụng để tính hoa hồng tương ứng.</li>
            <li>Các Đại lý đủ điều kiện nhận thêm hoa hồng nếu họ có thể đạt được các yêu cầu như được nêu trong bảng trên.</li>
            <li>Hoa hồng thêm sẽ được tính từ hoa hồng tổng kết của tháng trước đó.</li>
            <li>Hoa hồng bổ sung sẽ được cộng vào khoản hoa hồng cuối cùng trong khoảng ngày 08 - 15 mỗi tháng.</li>
            <li>12BET có quyền hủy khuyến mãi này bất cứ lúc nào, đối với tất cả các Đại lý hoặc các chi nhánh riêng lẻ và tuân theo <a href="@Url.Content("~/TermAndCondition")">Điều khoản và Điều kiện Đại lý của 12BET.</a></li>
        </ol>
    </p>
</div>