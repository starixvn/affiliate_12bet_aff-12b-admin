@{
    ViewBag.Title = Lang.MetaPromotionTitle;
    ViewBag.MetaDescription = Lang.MetaPromotionDescription;
    ViewBag.MetaKeywords = Lang.MetaPromotionKeywords;
    ViewBag.HeaderTitle = Lang.PromotionHeaderTitle;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}
@model Fanex.Affiliate.User.Core.ViewModels.ProPageViewModel

@{
    var bannerSrc = Url.Content($"~/www/build/styles/Images/commission/top-banner/item1/desktop.{Model.CurrentLanguage}");
    var mobileBannerSrc = Url.Content($"~/www/build/styles/Images/commission/top-banner/item1/mobile.{Model.CurrentLanguage}");

    var banner2Src = Url.Content($"~/www/build/styles/Images/commission/top-banner/item2/desktop.{Model.CurrentLanguage}");
    var mobileBanner2Src = Url.Content($"~/www/build/styles/Images/commission/top-banner/item2/mobile.{Model.CurrentLanguage}");
}

@section alternateAndCanonicalTags{
    @RazorHelper.RenderAlternateAndCanonicalLinks("promotion", Model.CurrentLanguage)
}

@section styles{
    <link rel="stylesheet" href="@Url.Content("~/www/build/styles/css/promotion.css")" />
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/pages/promotion.js")
}

<div class="content">
    <div class="page-title">
        <span class="text">
            @Lang.BecomeA12BetAff
        </span>
    </div>
    <div class="swiper top-banner">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <a class="nounderline promotion-banner-tracking show-pc" target="_self" href="javascript:void(0)">
                    <picture>
                        <source srcset="@(bannerSrc).webp?v=212311" type="image/webp" />
                        <source srcset="@(bannerSrc).jpg?v=212311" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(bannerSrc).jpg?v=212311" alt="12Bet commission boost promo" />
                    </picture>
                </a>
                <a class="nounderline promotion-banner-tracking show-mobile" target="_self" href="javascript:void(0)">
                    <picture>
                        <source srcset="@(mobileBannerSrc).webp?v=211856" type="image/webp" />
                        <source srcset="@(mobileBannerSrc).jpg?v=211856" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(mobileBannerSrc).jpg?v=211856" alt="12Bet commission boost promo" />
                    </picture>
                </a>
            </div>
            <div class="swiper-slide">
                <a class="nounderline promotion-banner-tracking show-pc" target="_self" href="javascript:void(0)">
                    <picture>
                        <source srcset="@(banner2Src).webp?v=211856" type="image/webp" />
                        <source srcset="@(banner2Src).jpg?v=211856" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(banner2Src).jpg?v=211856" alt="12Bet commission boost promo" />
                    </picture>
                </a>
                <a class="nounderline promotion-banner-tracking show-mobile" target="_self" href="javascript:void(0)">
                    <picture>
                        <source srcset="@(mobileBanner2Src).webp?v=211856" type="image/webp" />
                        <source srcset="@(mobileBanner2Src).jpg?v=211856" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(mobileBanner2Src).jpg?v=211856" alt="12Bet commission boost promo" />
                    </picture>
                </a>
            </div>
        </div>
        <div class="swiper-pagination"></div>
    </div>

    @Html.RenderPartialByLanguage("~/Views/Promotion/Partial/_Content", Model.CurrentLanguage, Model.CurrentLanguage)
    @RazorHelper.RenderMovingTopButton()
</div>