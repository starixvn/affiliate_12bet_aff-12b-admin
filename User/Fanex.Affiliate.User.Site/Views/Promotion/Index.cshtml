@{
    ViewBag.Title = Lang.MetaPromotionTitle;
    ViewBag.MetaDescription = Lang.MetaPromotionDescription;
    ViewBag.MetaKeywords = Lang.MetaPromotionKeywords;
    ViewBag.CanonicalLink = SiteDomainHelper.GenCanonialSeoLink(ControllerName.Promotion);
    ViewBag.HeaderTitle = Lang.PromotionHeaderTitle;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}
@model Fanex.Affiliate.User.Core.ViewModels.ProPageViewModel

@{
    var bannerSrc = Url.Content($"~/www/build/styles/Images/home/top-banner/item1/desktop.{Model.CurrentLanguage}");
    var mobileBannerSrc = Url.Content($"~/www/build/styles/Images/home/top-banner/item1/mobile.{Model.CurrentLanguage}");
}

@section styles{
    <link rel="stylesheet" href="@Url.Content("~/www/build/styles/css/promotion.css")" />
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/pages/promotion.js")
}

<div class="content">
    <div class="swiper top-banner">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <a class="nounderline home-banner-tracking-flat show-pc" target="_self" href="@Url.Content("~/Promotion")">
                    <picture>
                        <source srcset="@(bannerSrc).webp" type="image/webp" />
                        <source srcset="@(bannerSrc).jpg" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(bannerSrc).jpg" alt="Actived Home Banner" />
                    </picture>
                </a>
                <a class="nounderline home-banner-tracking-flat show-mobile" target="_self" href="@Url.Content("~/Promotion")">
                    <picture>
                        <source srcset="@(mobileBannerSrc).webp" type="image/webp" />
                        <source srcset="@(mobileBannerSrc).jpg" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(mobileBannerSrc).jpg" alt="Actived Home Banner" />
                    </picture>
                </a>
            </div>
        </div>
        <div class="swiper-pagination"></div>
    </div>

    @Html.RenderPartialByLanguage("~/Views/Promotion/Partial/_Content", Model.CurrentLanguage, Model.IsAuthenticated)
    @RazorHelper.RenderMovingTopButton()
</div>