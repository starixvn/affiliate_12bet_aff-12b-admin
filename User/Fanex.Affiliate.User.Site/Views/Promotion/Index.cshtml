@{
    ViewBag.Title = Lang.MetaPromotionTitle;
    ViewBag.MetaDescription = Lang.MetaPromotionDescription;
    ViewBag.MetaKeywords = Lang.MetaPromotionKeywords;
    ViewBag.CanonicalLink = SiteDomainHelper.GenCanonialSeoLink(ControllerName.Promotion);
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}
@model Fanex.Affiliate.User.Core.ViewModels.ProPageViewModel
@{
    var viewName = "~/Views/Promotion/_Content." + Model.CurrentLanguage + ".cshtml";
}
@section styles{
    <link rel="stylesheet" href="@Url.Content("~/www/build/styles/css/promotion.css")" />
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.Promotion</span>
    </div>

    @{ Html.RenderPartial(viewName, Model.IsAuthenticated); }
    @RazorHelper.RenderMovingTopButton()
</div>