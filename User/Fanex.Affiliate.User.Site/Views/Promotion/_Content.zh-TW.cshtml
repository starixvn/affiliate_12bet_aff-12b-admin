@{
    var bannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/promotion.zh-TW.jpg");
    var mobileBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/promotion-mobile.zh-TW.jpg");
}
<div class="banner-promotion">
    <picture>
        <source media="(max-width:400px)" srcset="@(mobileBannerSrc)" type="image/jpeg" />
        <source srcset="@(bannerSrc)" type="image/jpeg" />
        <img class="img-item img-responsive" src="@bannerSrc" alt="@Lang.Promotion" />
    </picture>
</div>
<br />
<div class="info-group">
    <h3 class="header-underline text-red">12BET 佣金提升</h3>
    <p><strong>賺取高達50%的佣金！</strong></p>
    <p>輕鬆賺取更高的每月佣金比例—只需滿足以下要求，即可自動擁有資格。</p>
</div>
@{ Html.RenderPartial("~/Views/Promotion/_RevenueShareTable.cshtml"); }
<div class="info-group">
    <p class="text-header"><strong>備註：</strong></p>
    <p class="text">
        <ol>
            <li>如果合作夥伴在【每月公司利潤】和【每月符合資格活躍會員】達到了不同的門檻，佣金支付將根據較低的門檻。例如，如果合作夥伴成員當月的盈虧總額為$46,000，而符合資格活躍會員為7人，則該月的佣金將為35%。</li>
            <li>僅限邀請 —如果您有獨具特色的提議，可以帶來巨大的獲利（例如：吸引VIP會員），您可以與合作夥伴經理聯繫，評估該提議並確定資格。</li>
        </ol>
    </p>
</div>
<div class="info-group">
    <h3 class="header-underline text-red">首次存款新會員影響力</h3>
    <p>在12BET，額外的獎勵總是有保證的。所需要做的就是滿足規定【每月符合資格的活躍會員】要求，並在佣金之外賺取額外的佣金。</p>
</div>
@{ Html.RenderPartial("~/Views/Promotion/_FdmTable.cshtml"); }
<div class="info-group">
    <p class="text-header"><strong>注意—</strong>每位合作夥伴成員，都會在他們賺取的佣金之外，還有額外佣金比例，無論是常規佣金還是12BET佣金提升優惠。</p>
</div>
<div class="info-group">
    <p class="text-header"><strong>佣金計算實例：</strong></p>
    <p>舉例：“合作夥伴—王先生”的盈虧總額為$35,000，有25名符合資格的活躍會員，和12名首次存款新會員。首次存款新會員的總存款為$3,000。這個人有資格參加兩個優惠活動，即12BET佣金提升和首次存款新會員影響力。</p>
    <p>為了計算佣金，首先採用佣金提升方案，即$35,000的35%，佣金是$12,250</p>
    <p>接下來，我們將首次存款新會員影響力使用於佣金提升額度，即3%。因此，首次存款新會員影響力獎金是367.5美元，但由於最高獎金是250美元，所以佣金將是$12,250+$250=$12,500。</p>
    <p>因此，“合作夥伴—王先生”賺取的總佣金為$12,500。</p>
</div>
<h3 class="header-underline text-red">條款與規則</h3>
<div class="info-group">
    <p class="text-header"><strong>每月佣金提升</strong></p>
    <p class="text">
        <ol>
            <li>本促銷活動適用於所有12BET會員。</li>
            <li>如果合作夥伴在【每月公司利潤】和【每月符合資格活躍會員】達到了不同的門檻，佣金支付將根據較低的門檻。</li>
            <li>不符資格這個優惠活動的合作夥伴，將按照現有的常規<a href="@Url.Content("~/CommissionStructure")">佣金結構結算佣金。</a></li>
            <li>僅限邀請 —如果您有獨具特色的提議，可以帶來巨大的獲利（例如：吸引VIP會員），您可以與合作夥伴經理聯繫，評估該提議並確定資格。</li>
            <li>如果合作夥伴會員能夠達到上表所示的要求，他們將有資格獲得額外的佣金。</li>
            <li>額外的佣金將使用上個月的最終佣金計算。</li>
            <li>額外的佣金將在當月的第8-15日內，加入最終佣金。</li>
            <li>12BET保留在任何時候對全部或部分合作夥伴，取消該優惠活動的所有權利。本優惠活動同時遵守 <a href="@Url.Content("~/TermAndCondition")">12BET 合作夥伴條款及規則準則。</a></li>
        </ol>
    </p>
</div>
<div class="info-group">
    <p class="text-header"><strong>首次存款新會員影響力</strong></p>
    <p class="text">
        <ol>
            <li>本促銷活動適用於所有12BET會員。</li>
            <li>如果合作夥伴在【每月公司利潤】和【每月符合資格活躍會員】達到了不同的門檻，佣金支付將根據較低的門檻。</li>
            <li>如果合作夥伴會員能夠達到上表所示的要求，他們將有資格獲得額外的佣金。</li>
            <li>額外的佣金將使用上個月的最終佣金計算。</li>
            <li>額外的佣金將在當月的第8-15日內，加入最終佣金。</li>
            <li>12BET保留在任何時候對全部或部分合作夥伴，取消該優惠活動的所有權利。本優惠活動同時遵守 <a href="@Url.Content("~/TermAndCondition")">12BET 合作夥伴條款及規則準則。</a></li>
        </ol>
    </p>
</div>