@{
    var bannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/promotion.th-TH.jpg");
    var mobileBannerSrc = Url.RenderLinkByJsVersion("~/www/build/styles/Images/promotion/promotion-mobile.th-TH.jpg");
}
<div class="banner-promotion">
    <picture>
        <source media="(max-width:400px)" srcset="@(mobileBannerSrc)" type="image/jpeg" />
        <source srcset="@(bannerSrc)" type="image/jpeg" />
        <img class="img-item img-responsive" src="@bannerSrc" alt="@Lang.Promotion" />
    </picture>
</div>
<br />
<div class="info-group">
    <h3 class="header-underline text-red">เพิ่มค่าคอมมิชชั่นที่ 12BET</h3>
    <p><strong>รับค่าคอมมิชชั่นสูงถึง 50%!</strong></p>
    <p>รับอัตราค่าคอมมิชชั่นรายเดือนที่สูงขึ้นอย่างง่ายดาย - เพียงทำตามข้อกำหนดด้านล่างเพื่อรับสิทธิ์โดยอัตโนมัติ!</p>
</div>
@{ Html.RenderPartial("~/Views/Promotion/_RevenueShareTable.cshtml"); }
<div class="info-group">
    <p class="text-header"><strong>ข้อมูลเพิ่มเติม</strong></p>
    <p class="text">
        <ol>
            <li>หากพันธมิตรบรรลุเกณฑ์ที่แตกต่างกันสำหรับ [กำไรรวมต่อเดือน] และ [ผู้เล่นที่มีคุณสมบัติเหมาะสมสำหรับเดือน] การคิดคำนวณค่าคอมมิชชันจะขึ้นอยู่กับเกณฑ์ที่ต่ำกว่า ตัวอย่างเช่น หากยอดเล่นเสียสุทธิ/เดือน (ดอลล่าร์ฯ) ของสมาชิกพันธมิตรในเดือนปัจจุบันคือ 46,000 ดอลลาร์ และผู้เล่นที่เข้าเกณฑ์คือ 7 คน  ค่าคอมมิชชันสำหรับช่วงเวลาดังกล่าวจะเท่ากับ 35%</li>
            <li>ได้รับคำเชิญเท่านั้น - หากคุณเชื่อว่าคุณมีข้อเสนอพิเศษที่อาจส่งผลให้เกิดยอดเล่นเสียสุทธิ/เดือน (ดอลล่าร์ฯ) ที่มาก (เช่น การดึงดูดสมาชิก VIP) คุณสามารถติดต่อผู้จัดการพันธมิตรเพื่อประเมินข้อเสนอและพิจารณาคุณสมบัติ</li>
        </ol>
    </p>
</div>
<div class="info-group">
    <h3 class="header-underline text-red">โบนัสสมาชิกฝากแรกพิเศษ</h3>
    <p>ใน 12BET พร้อมที่จะมอบรางวัลพิเศษให้กับคุณ สิ่งที่คุณต้องทำคือปฏิบัติตามข้อกำหนดของตารางฝากแรกที่ระบุไว้และรับค่าคอมมิชชั่นเพิ่มเติมนอกเหนือจากค่าคอมมิชชั่นของคุณ</p>
</div>
@{ Html.RenderPartial("~/Views/Promotion/_FdmTable.cshtml"); }
<div class="info-group">
    <p class="text-header"><strong>หมายเหตุ - </strong>พันธมิตรจะได้รับเปอร์เซ็นต์พิเศษเพิ่มเติมจากค่าคอมมิชชั่นที่ได้รับ ไม่ว่าจะเป็นค่าคอมมิชชั่นปกติหรือโปรโมชั่นคอมมิชชั่นบูส 12BET</p>
</div>
<div class="info-group">
    <p class="text-header"><strong>ตัวอย่างการคำนวณค่าคอมมิชชั่น:</strong></p>
    <p>ตัวอย่าง 'พันธมิตร XYZ' มียอดเล่น รายได้/เสียสุทธิ เดือน $35,000 สมาชิกที่ใช้งานอยู่ 25 คน และมีฝากแรก 12 คน จำนวนเงินฝากทั้งหมดที่ทำโดยฝากแรก คือ $3,000 พันธมิตรนั้นๆจะมีคุณสมบัติเข้าเกณฑ์สำหรับทั้งสองโปรโมชั่น ซึ่งก็คือ 12BET โปรโมชั่นคอมมิชชั่นบูส และโบนัสสมาชิกฝากแรกพิเศษ</p>
    <p>ในการคำนวณค่าคอมมิชชัน การคำนวณเริ่มต้นค่าคอมมิชชันอยู่ที่ 35% ของ $35,000 นั้นคือ $12,250</p>
    <p>ในขั้นตอนต่อไป ใช้ยอดฝากครั้งแรกของสมาชิกเพื่อเพิ่มค่าคอมมิชชัน อยู่ที่ 3% ดังนั้น โบนัส ยอดฝากครั้งแรกของสมาชิก เป็น  $367.5  แต่เนื่องจากโบนัสสูงสุด คือ $250 ค่าคอมมิชชันจะเท่ากับ $12,250 + $250 = $12,500</p>
    <p>ดังนั้น ค่าคอมมิชชั่นทั้งหมดที่พันธมิตร XYZ ได้รับคือ $12,500</p>
</div>
<h3 class="header-underline text-red">กติกาและเงื่อนไข</h3>
<div class="info-group">
