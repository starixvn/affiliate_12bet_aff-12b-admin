@{ 
    var contactUrl = "https://line.me/R/ti/p/@124asbwp?oat_content=url";
}
<div class="block block-england-calling">
    <div class="page-container">
        <div class="group-page">
            <div class="block-child-title">
                อังกฤษกำลังรอคุณ!
            </div>
            <div class="block-child-description">
                สโมสรฟุตบอลเลสเตอร์ซิตี้ขอเชิญพันธมิตรที่ดีที่สุดของ 12BET มาสัมผัสประสบการณ์ความตื่นเต้นในการเป็นส่วนหนึ่งของ Blue Army จากแท่นกลางของสนาม King Power อันโด่งดัง สัมผัสถึงวันแข่งขันเหมือนเป็นวีไอพีในที่นั่งระดับพรีเมียมและเพลิดเพลินไปกับสิทธิประโยชน์อื่นๆ อีกมากมาย! เพิ่มสมาชิกและกิจกรรมของคุณวันนี้! เข้าร่วมการดำเนินการและรับข้อเสนอสุดพิเศษสำหรับพันธมิตร 12BET เท่านั้น ระยะเวลาโปรโมชั่น: 1 ตุลาคม - 31 ธันวาคม 2567
            </div>
        </div>
        @{ Html.RenderPartial("~/Views/Promotion/Partial/_EnglandsCallingTable.cshtml"); }
        <div class="group-contact-btn">
            <a href="@contactUrl" class="custom-button">@Lang.ContactAffManager</a>
        </div>
    </div>
</div>

<div class="block block-faq">
    <div class="block-content">
        <div class="page-container">
            <div class="group-faq">
                <div class="question">
                    <div class="title">
                        <span>ข้อกำหนดและเงื่อนไข</span>
                    </div>
                    <span class="button-toggle"></span>
                </div>
                <div class="anwser">
                    <div class="anwser-text">
                        <span class="list-number">1</span> โปรโมชั่นนี้ใช้กับพันธมิตรทั้งหมด
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">2</span> โปรโมชั่นเริ่มเวลา 00:00:00 น. (GMT+8) วันที่ 1 ตุลาคม 2567 จนถึงเวลา 23:59:59 น. (GMT+8) วันที่ 31 ธันวาคม 2567
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">3</span> พันธมิตรจะต้องมีคุณสมบัติการสมัครสมาชิก, เงินฝากครั้งแรก และ ผลแพ้ชนะสะสมในช่วงระยะเวลาโปรโมชั่นเพื่อรับรางวัล
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">4</span> พันธมิตรแต่ละรายสามารถมีสิทธิ์รับรางวัลเพียง 1 รางวัลในโปรโมชั่นนี้
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">5</span> รางวัลทั้งหมดไม่สามารถแปลงเป็นรางวัลอื่นได้
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">6</span> รางวัลใหญ่คือชมการถ่ายทอดสดฟุตบอลเลสเตอร์ ซิตี้ พบ นิวคาสเซิ่ล ยูไนเต็ด ที่สนามคิง เพาเวอร์ สเตเดี้ยม ในวันที่ 5 เมษายน 2568 และผู้ชนะจะต้องแบ่งปันข้อมูลส่วนบุคคลที่ถูกต้องเพื่อจัดเตรียมที่พักในอังกฤษ
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">7</span> เสื้อแข่งฟุตบอล และอุปกรณ์พร้อมลายเซ็นจะดำเนินการหลังจากติดต่อพันธมิตรเรียบร้อยแล้วเพื่อขอที่อยู่จัดส่งและข้อมูลติดต่อที่ถูกต้อง
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">8</span> สมาชิกมีหน้าที่รับผิดชอบในการจัดหาวีซ่าท่องเที่ยวด้วยตนเอง ประกันการเดินทาง และอาหารไม่รวมอยู่ในแพ็คเกจการเดินทาง
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">9</span> ภาพถ่ายและวิดีโอที่ถูกถ่ายระหว่างการเดินทาง หรือการถ่ายโอนภาพถ่ายเหล่านั้น 12BET อาจนำไปใช้เพื่อวัตถุประสงค์ในการส่งเสริมการขายใดๆ โดยการอ้างสิทธิ์ตามแพคเกจ ซึ่งสมาชิกของเรายินยอมที่จะอนุญาตให้ 12BET ใช้รูปภาพและวิดีโอเหล่านี้ และจะไม่มีข้อพิพาทใด ๆ เกิดขึ้นไม่ว่าในกรณีใด ๆ
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">10</span> ภาษี ค่าธรรมเนียม และค่าธรรมเนียมเพิ่มเติมในการจัดส่งของรางวัลถือเป็นความรับผิดชอบของผู้ชนะแต่เพียงผู้เดียว 12BET จะไม่รับผิดชอบต่อความสูญเสียหรือความเสียหายใด ๆ ในการส่งมอบรางวัลอันเนื่องมาจากข้อมูลที่สมาชิกผู้ชนะให้ไว้ไม่ครบถ้วนหรือไม่ถูกต้อง
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">11</span> ในกรณีที่ปฏิเสธหรือไม่สามารถติดต่อได้ภายใน 10 วันหลังจากประกาศผู้ชนะ รางวัลจะมอบให้กับผู้ชนะคนต่อไปโดยอัตโนมัติ
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">12</span> เงินรางวัลจะมอบให้นอกเหนือจากการจ่ายค่าคอมมิชชั่น
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">13</span> เที่ยวบิน ตั๋วการแข่งขัน และที่พัก 12BET จะจัดเตรียมและคุ้มครองอย่างเต็มที่
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">14</span> 12BET ขอสงวนสิทธิ์ในการยกเลิกโปรโมชั่นนี้ได้ตลอดเวลา สำหรับผู้เล่นทุกคนหรือผู้เล่นรายบุคคล และอยู่ภายใต้<a href="@Url.RenderLanguageContent("~/TermAndCondition")"><span class="red-bold">ข้อกำหนดและเงื่อนไขโปรโมชั่นมาตรฐานของ 12BET</span></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="block block-power">
    <div class="page-container">
        <div class="group-page">
            <div class="block-child-title">
                โบนัสสมาชิกฝากแรกพิเศษ
            </div>
            <div class="block-child-description">
                ใน 12BET รับประกันรางวัลพิเศษเสมอ สิ่งที่คุณต้องทำคือปฏิบัติตามข้อกำหนดของจำนวนฝากแรกใหม่ ที่ระบุไว้ และรับค่าคอมมิชชั่นเพิ่มเติมนอกเหนือจากค่าคอมมิชชั่นของคุณ
            </div>
        </div>
        @{ Html.RenderPartial("~/Views/Promotion/Partial/_FDMsPowerTable.cshtml"); }
    </div>
</div>

<div class="block block-note">
    <div class="page-container">
        <div class="group-page">
            <div class="block-child-title title-spcing">
                โปรดทราบว่า
            </div>
            <div class="main-content">
                <div class="items">
                    <div class="items-description">
                        FDM คือสมาชิกใหม่ที่ทำการฝากเงินครั้งแรกสำเร็จ พันธมิตรทุกรายจะได้รับเปอร์เซ็นต์พิเศษจากโปรโมชั่นการฝากเงินครั้งแรกของสมาชิกใหม่ นอกเหนือจากค่าคอมมิชชันปกติที่ได้รับ
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="block block-example">
    <div class="page-container">
        <div class="group-page">
            <div class="block-child-title title-spcing">
                ตัวอย่างการคำนวณค่าคอมมิชชั่น:
            </div>
            <div class="description">
                ในกรณีที่ “พันธมิตร XYZ” มี<span class="red-bold">กำไร/ขาดทุนสุทธิ $35,000</span> และ <span class="red-bold">12 FDMs</span> พร้อม<span class="red-bold">เงินฝากรวม $3,000</span> บุคคลดังกล่าวมีคุณสมบัติในการส่งเสริมการขาย โปรโมชั่นการฝากเงินครั้งแรกของสมาชิกใหม่
            </div>
            <div class="description">
                ในการคำนวณค่าคอมมิชชั่น ขั้นแรกเราจะใช้ค่าคอมมิชชั่นปกติซึ่งเท่ากับ 35% ของ $35,000 ส่งผลให้ได้ $12,250
            </div>
            <div class="description">
                ต่อไป เราใช้การคำนวณจากการฝากครั้งแรกของสมาชิกใหม่กับจำนวนค่าคอมมิชชันปกติซึ่งก็คือ 3%  ดังนั้น โบนัส FDM Power คือ $367.5 แต่เนื่องจากโบนัสสูงสุดคือ $250 ค่าคอมมิชชั่นจะเท่ากับ $12,250 + $250 = $12,500
            </div>
            <div class="description">
                ดังนั้น ค่าคอมมิชชั่นทั้งหมดที่ได้รับจาก พันธมิตร XYZ คือ $12,500
            </div>
        </div>
    </div>
</div>

<div class="block block-faq">
    <div class="block-content">
        <div class="page-container">
            <div class="group-faq">
                <div class="question">
                    <div class="title">
                        <span>ข้อกำหนดและเงื่อนไข</span>
                    </div>
                    <span class="button-toggle"></span>
                </div>
                <div class="anwser">
                    <div class="anwser-heading">สมาชิกฝากแรก</div>
                    <div class="anwser-text">
                        <span class="list-number">1</span> โปรโมชั่นนี้ใช้กับพันธมิตร 12BET ทั้งหมด
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">2</span> ในกรณี [สมาชิกฝากแรก ใหม่] และ [ยอดเงินฝากทั้งหมดของ สมาชิกฝากแรก] อยู่ในระดับที่แตกต่างกัน ระดับที่ต่ำกว่าจะถูกใช้สำหรับการคำนวณค่าคอมมิชชัน
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">3</span> พันธมิตรจะมีสิทธิ์ได้รับค่าคอมมิชชั่นพิเศษ ในกรณี พันธมิตรสามารถทำได้ตามข้อกำหนดที่ระบุไว้ในตารางด้านบน
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">4</span> ค่าคอมมิชชั่นพิเศษจะคำนวณจากค่าคอมมิชชั่นล่าสุดของเดือนก่อนหน้า
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">5</span> ค่าคอมมิชชั่นพิเศษจะมอบให้ พร้อมกับค่าคอมมิชชั่นที่ผ่านการอนุมัติ ภายในวันที่ 8 - 15 ของเดือน
                    </div>
                    <div class="anwser-text">
                        <span class="list-number">6</span> 12BET ขอสงวนสิทธิ์ในการยกเลิกโปรโมชั่นนี้ได้ตลอดเวลา ไม่ว่าจะเป็นสำหรับพันธมิตรทั้งหมด หรือพันธมิตรรายบุคคล และอยู่ภายใต้<a href="@Url.RenderLanguageContent("~/TermAndCondition")"><span class="red-bold">ข้อกำหนดและเงื่อนไขของ 12BET พันธมิตร</span></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>