@{
    Layout = null;
}

@using Fanex.Affiliate.User.Core.CoreService
@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.MyAccountViewModel

@{ 
    var shouldShowInfo = !Model.IsInternal;
}

@Html.InlineStyles("~/www/build/styles/css/my-account.css")

<div class="account-information">
    <div class="page-title">
        <span class="text">@Lang.MyAccount</span>
    </div>

    <div class="alert" role="alert" id="messageResult" style="display: none"></div>

    <form id="accountForm">
        @Html.AntiForgeryToken()
        <div class="info-group">
            <div class="title">
                <span class="text">@Lang.AccInfo</span>
            </div>

            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-sm-3 control-label">@Lang.Username</label>
                    <div class="col-sm-4">
                        <p class="form-control-static">@Model.AccountInformation.UserName</p>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">@Lang.Password</label>
                    <div class="col-sm-4">
                        <p class="form-control-static"><a href="@Url.RenderLanguageContent("~/Password/Update")">@Lang.Change</a></p>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">@Lang.AffiliateID</label>
                    <div class="col-sm-4">
                        <p class="form-control-static">@Model.AccountInformation.AffCode</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="info-group">
            <div class="title">
                <span class="text">@Lang.ContactInfo</span>
            </div>

            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-sm-3 control-label">@Lang.Gender</label>
                    <div class="col-sm-4">
                        <label class="radio-inline">
                            <input type="radio" name="Gender" id="male" value="True" @(Model.AccountInformation.Gender ? "checked" : string.Empty) disabled /> @Lang.Male
                        </label>
                        <label class="radio-inline">
                            <input type="radio" name="Gender" id="female" value="False" @(!Model.AccountInformation.Gender ? "checked" : string.Empty) disabled /> @Lang.Female
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">@Lang.Address</label>
                    <div class="col-sm-4">
                        <p class="form-control-static">@Model.AccountInformation.Address</p>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">@Lang.City</label>
                    <div class="col-sm-4">
                        <p class="form-control-static">@Model.AccountInformation.City</p>
                    </div>
                </div>

                @if (Model.AccountInformation.IsRenderState)
                {
                    <div class="form-group">
                        <label class="col-sm-3 control-label">@Lang.State</label>
                        <div class="col-sm-4">
                            <p class="form-control-static">@Model.AccountInformation.State</p>
                        </div>
                    </div>
                }

                <div class="form-group">
                    <label class="col-sm-3 control-label">@Lang.PostCode</label>
                    <div class="col-sm-4">
                        <p class="form-control-static">@Model.AccountInformation.Postal</p>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">@Lang.Country</label>
                    <div class="col-sm-4">
                        <p class="form-control-static">@Model.AccountInformation.Country</p>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">@Lang.Email</label>
                    <div class="col-sm-4">
                        <p class="form-control-static">@(shouldShowInfo ? Model.AccountInformation.Email : EmailHelper.HideEmailPart(Model.AccountInformation.Email))</p>
                    </div>
                </div>
                <div class="form-group validate-group">
                    <label class="col-sm-3 require control-label">@Lang.ContactNumber</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(p => p.AccountInformation.Phone, new { @id = "Phone", @Name = "Phone", @class = "form-control", @Value = @Model.AccountInformation.Phone.ReplaceAHalfOfString(shouldShowInfo) })
                    </div>
                    <div class="col-sm-offset-3 col-sm-9">
                        @Html.ValidationMessage("Phone", new { @class = "validate-input hide" })
                    </div>
                </div>

                @if (Model.AccountInformation.ContactAppList != null && Model.AccountInformation.ContactAppList.Any())
                {
                    var contactAppCount = Model.AccountInformation.ContactAppList.Count();
                    var index = 0;

                    foreach (var item in Model.AccountInformation.ContactAppList)
                    {
                        var firstApp = index == 0;
                        var appContactName = item.Name.MatchWith("Skype") ? "Teams" : item.Name;
                        var appPlaceHolder = Fanex.Affiliate.User.Core.Constants.AppContact.GetPlaceHolderByAppAndLanguage(item.Name);
                        var appRegex = Fanex.Affiliate.User.Core.Constants.AppContact.GetRegexByAppAndLanguage(item.Name);

                        <div class="form-group validate-group">
                            @if (firstApp)
                            {
                                <label for="ContactAppList[@index].Value" class="col-sm-3 control-label require">@appContactName</label>
                                <div class="col-sm-4">
                                    <input type="text" placeholder="@appPlaceHolder" name="ContactAppList[@index].Value" id="ContactAppList[@index].Value" class="form-control"
                                           value="@Html.Raw(item.Value)"
                                           data-val="true"
                                           data-val-required="@(appContactName)@Fanex.Affiliate.User.Core.Resources.Error.IsRequired"
                                           data-val-length="@(appContactName)@Fanex.Affiliate.User.Core.Resources.Error.InvalidLength"
                                           data-val-length-max="50"
                                           data-val-regex="@(appContactName)@Fanex.Affiliate.User.Core.Resources.Error.IsInvalid"
                                           data-val-regex-pattern="@appRegex" />
                                </div>
                            }
                            else
                            {
                                <label for="ContactAppList[@index].Value" class="col-sm-3 control-label">@appContactName</label>
                                <div class="col-sm-4">
                                    <input type="text" placeholder="@appPlaceHolder" name="ContactAppList[@index].Value" id="ContactAppList[@index].Value" class="form-control"
                                           value="@Html.Raw(item.Value)"
                                           data-val="true"
                                           data-val-length="@(appContactName)@Fanex.Affiliate.User.Core.Resources.Error.InvalidLength"
                                           data-val-length-max="50"
                                           data-val-regex="@(appContactName)@Fanex.Affiliate.User.Core.Resources.Error.IsInvalid"
                                           data-val-regex-pattern="@appRegex" />
                                </div>
                            }
                            <div class="col-sm-offset-3 col-sm-9">
                                <span class="field-validation-error validate-input hide"
                                      data-valmsg-for="ContactAppList[@index].Value"
                                      data-valmsg-replace="true"></span>
                            </div>
                            <input type="hidden" name="ContactAppList[@index].Name" value="@item.Name" />
                            <input type="hidden" name="ContactAppList[@index].Order" value="@item.Order" />
                        </div>

                        index++;
                    }
                }
                else
                {
                    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
                    @RazorHelper.RenderAppContact(sessionService.CurrentLanguage, "control-label")
                }
            </div>
        </div>
        <div class="info-group website-info">
            <div class="title">
                <span class="text">@Lang.WebsiteInfor</span>
            </div>

            <div class="form-horizontal">
                <div class="form-group validate-group">
                    <div class="col-sm-4">
                        <label class="radio-inline">
                            <input type="radio" name="HasWebSite" id="hasWebSite" value="True" @(string.IsNullOrEmpty(Model.AccountInformation.SiteUrl) ? string.Empty : "checked") /> @Lang.OwnWebsite
                        </label>
                    </div>
                </div>

                <div id="websiteInfo">
                    <div class="form-group validate-group">
                        <label for="SiteUrl" class="col-sm-3 control-label require">@Lang.WebsiteURL</label>
                        <div class="col-sm-4">
                            @{
                                var attributes = new Dictionary<string, object>
                                {
                                    ["id"] = "SiteUrl",
                                    ["Name"] = "SiteUrl",
                                    ["class"] = "form-control"
                                };

                                if (string.IsNullOrEmpty(Model.AccountInformation.SiteUrl))
                                {
                                    attributes.Add("disabled", "disabled");
                                }
                            }
                            @Html.TextBoxFor(p => p.AccountInformation.SiteUrl, attributes)
                        </div>
                        <div class="col-sm-1">
                            <button type="button" class="btn btn-submit" id="btnAddUrl" title="@Lang.AddUrl" @(string.IsNullOrEmpty(Model.AccountInformation.SiteUrl) ? "disabled=\"disabled\"" : string.Empty)>
                                <span class="glyphicon glyphicon-plus" aria-hidden="true"></span>
                            </button>
                        </div>

                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(p => p.AccountInformation.SiteUrl, string.Empty, new { @class = "validate-input hide" })
                        </div>
                    </div>

                    <input type="hidden" name="MoreSiteUrls" id="MoreSiteUrls" />

                    @if (Model.AccountInformation.MoreWebsiteUrlList.Any())
                    {
                        var index = 2;
                        foreach (var item in Model.AccountInformation.MoreWebsiteUrlList)
                        {
                            var name = $"MoreUrlInput{index}";
                            <div class="form-group validate-group websiteInput" style="display: @(string.IsNullOrEmpty(Model.AccountInformation.SiteUrl) ? "none" : "block")">
                                <label for="@name" class="col-sm-3 control-label require moreWebsiteLabel">@Lang.WebsiteURL @(index)</label>
                                <div class="col-sm-4">
                                    <input class="form-control urlInput" name="@name" id="@name"
                                           data-val="true" data-val-required="@Lang.WebsiteUrli.Replace("{i}", index.ToString())"
                                           type="text" value="@item" />
                                </div>
                                <div class="col-sm-1">
                                    <button type="button" class="btn btn-submit btnDeleteUrl" title="@Lang.Del">
                                        <span class="glyphicon glyphicon-minus" aria-hidden="true"></span>
                                    </button>
                                </div>
                                <div class="col-sm-offset-3 col-sm-9">
                                    <span class="field-validation-error validate-input hide" data-valmsg-for="@name" data-valmsg-replace="true"></span>
                                </div>
                            </div>

                            index++;
                        }
                    }
                </div>

                <div class="form-group validate-group">
                    <div class="col-sm-4">
                        <label class="radio-inline">
                            <input type="radio" name="HasWebSite" id="hasNoWebSite" value="False" @(string.IsNullOrEmpty(Model.AccountInformation.SiteUrl) ? "checked" : string.Empty)> @Lang.NoWebsite
                        </label>
                    </div>
                </div>

                <div class="form-group validate-group">
                    <label class="col-sm-3 control-label require">@Lang.DescWebsite</label>
                    <div class="col-sm-4">
                        @{
                            var textareaAttributes = new Dictionary<string, object>
                            {
                                ["id"] = "NoSiteDesc",
                                ["Name"] = "NoSiteDesc",
                                ["class"] = "form-control",
                                ["rows"] = 5
                            };

                            if (!string.IsNullOrEmpty(Model.AccountInformation.SiteUrl))
                            {
                                textareaAttributes.Add("disabled", "disabled");
                            }
                        }
                        @Html.TextAreaFor(p => p.AccountInformation.NoSiteDesc, textareaAttributes)
                    </div>
                    <div class="col-sm-offset-3 col-sm-9">
                        @Html.ValidationMessageFor(p => p.AccountInformation.NoSiteDesc, string.Empty, new { @class = "validate-input hide" })
                    </div>
                </div>
            </div>
        </div>

        <div class="info-group">
            <div class="title">
                <span class="text">@Lang.Preference</span>
            </div>
            <div class="form-horizontal">
                <div class="form-group validate-group">
                    <label class="col-sm-3 require control-label">@Lang.TargetCountry</label>
                    <div class="col-sm-4">
                        <select class="form-control" name="TargetCountryCode" id="AccountInformation.TargetCountryCode" data-val="true" data-val-required="@Lang.TargetCountryErr">
                            <option value="">@Lang.SelectOne</option>
                            @foreach (var item in Model.TargetCountryList)
                            {
                                <option value="@item.TargetCountryCode" @(item.TargetCountryCode == Model.AccountInformation.TargetCountryCode ? "selected" : string.Empty)>@SystemHelper.GetTargetCountryText(item.TargetCountryName)</option>
                            }
                        </select>
                        @Html.ValidationMessageFor(x => x.AccountInformation.TargetCountryCode, string.Empty, new { @class = "validate-input hide" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">@Lang.Language</label>
                    <div class="col-sm-4">
                        <p class="form-control-static">@Model.AccountInformation.LanguageName</p>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">@Lang.AffiliateCurrency</label>
                    <div class="col-sm-4">
                        <p class="form-control-static">@Model.AccountInformation.AffCurrency</p>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">@Lang.DefaultBaseCurrency</label>
                    <div class="col-sm-4">
                        @Html.DropDownListFor(p => p.AccountInformation.DefaultBaseCurrency, Model.BaseCurrencyList, new { @id = "DefaultBaseCurrency", @Name = "DefaultBaseCurrency", @class = "form-control" })
                    </div>
                    <div class="info-container col-sm-1">
                        <span title="@Lang.DefaultBaseCurrencyDetail" class="glyphicon glyphicon-info-sign"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="info-group">
            <div class="title">
                <span class="text">@Lang.PaymentInfor</span>
            </div>
            <div class="form-horizontal">
                <div class="form-group validate-group">
                    <label class="col-sm-3 control-label">@Lang.PaymentMethod</label>
                    <div class="col-sm-4">
                        <label class="radio-inline">
                            <input type="radio" checked /> @Lang._12BETPlayerAcc
                        </label>
                    </div>
                </div>

                <div class="form-group validate-group">
                    <label for="PlayerUsername" class="col-sm-3 control-label @(string.IsNullOrEmpty(Model.AccountInformation.PlayerUsername) ? "require" : string.Empty)">@Lang.Username</label>
                    <div class="col-sm-4">
                        @if (string.IsNullOrEmpty(Model.AccountInformation.PlayerUsername))
                        {
                            <input id="PlayerUsername" name="PlayerUsername" class="form-control" type="text" value="" data-val="true" data-val-required="@Lang.BETUserNameIsRequired" />
                        }
                        else
                        {
                            <p class="form-control-static" id="PlayerUsername">@Model.AccountInformation.PlayerUsername</p>
                        }
                    </div>
                    <div class="col-sm-offset-3 col-sm-9">
                        <span class="field-validation-error validate-input hide" data-valmsg-for="PlayerUsername" data-valmsg-replace="true"></span>
                    </div>
                </div>
            </div>
            <div class="col-sm-offset-3 button-block">
                <button disabled="@Model.IsMarketingAccount" id="btnMyAccountSubmit" class="btn btn-submit" type="button">@Lang.Submit</button>
                <button id="btnCancel" class="btn btn-submit" type="button">@Lang.Cancel</button>
            </div>
        </div>
    </form>

</div>

<script>
    var resourceLanguage = {
        webSiteUrl: '@Lang.WebsiteURL',
        deleteLabel: '@Lang.Del',
        requiredMoreWebSiteUrl: '@Lang.WebsiteUrli',
        updateSuccessfully: '@Lang.UpdateAccSuccess'
    }
</script>

<script src="@Url.RenderLink("~/www/build/js/validation.js")"></script>
@Html.InlineScripts("~/www/build/js/myaccount.js")