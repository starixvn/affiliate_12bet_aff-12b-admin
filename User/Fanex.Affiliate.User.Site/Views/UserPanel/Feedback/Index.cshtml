
@{
    Layout = null;
    var iconFileName = Url.Content("~/www/build/styles/Images/feedback/icon.png?v=162411");
}

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.FeedbackViewModel

<link href="@Url.RenderLink("~/www/build/styles/css/feedback.css")" rel="stylesheet" />

<div class="aff-feedback">
    <div class="aff-feedback-container" id="affFeedbackContainer">
        <div class="aff-feedback-remove">
            <div class="alert-glyphicon-remove" id="affFeedbackRemove">
                <i class="glyphicon glyphicon-remove"></i>
            </div>
        </div>
        <div class="aff-feedback-header">
            <picture>
                @*<source srcset="@(sportBannerFileName + ".webp?v=162411")" type="image/webp" />*@
                <source srcset="@iconFileName" type="image/png" />
                <img class="letter-icon" src="@iconFileName" alt="icon" />
            </picture>
        </div>
        <div class="aff-feedback-content" id="affFeedbackContent">
            <div class="feedback-title">
                <p class="title-text">@Lang.AffFeedback</p>
                <p class="text-bold">@Lang.WeWouldLove</p>
                <input class="aff-name" type="text" value="12BetAff226" disabled />
            </div>
            <div class="feedback-rate">
                <p class="text-bold">@Lang.WhatIsYourOpinion</p>
                <div class="group-icons">
                    <label class="flex dissatisfaction-icon">
                        <input type="checkbox" value="dissatisfaction" class="feedback-checkbox">
                        <span class="checkmark"></span>
                    </label>
                    <label class="flex unsatisfied-icon">
                        <input type="checkbox" value="unsatisfied" class="feedback-checkbox">
                        <span class="checkmark"></span>
                    </label>
                    <label class="flex neutral-icon">
                        <input type="checkbox" value="neutral" class="feedback-checkbox">
                        <span class="checkmark"></span>
                    </label>
                    <label class="flex satisfied-icon">
                        <input type="checkbox" value="satisfied" class="feedback-checkbox">
                        <span class="checkmark"></span>
                    </label>
                    <label class="flex very-please-icon">
                        <input type="checkbox" value="veryPlease" class="feedback-checkbox">
                        <span class="checkmark"></span>
                    </label>
                </div>
            </div>
            <div class="feedback-message">
                <span class="text-bold">@Lang.PleaseLeaveYourFeedback</span>
                <textarea class="message" id="feedbackMessage" rows="5"></textarea>
                <div class="submit-feedback">
                    <button class="btn btn-submit" id="submitFeedbackBtn">@Lang.Submit</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    window.feedback = {
        thankYou: '@Lang.ThankYou',
        isClickLogout: false //'@Model.IsClickLogout'.toLowerCase() === 'true',
    }
</script>
<script src="@Url.RenderLink("~/www/build/js/pages/feedback.js")"></script>
