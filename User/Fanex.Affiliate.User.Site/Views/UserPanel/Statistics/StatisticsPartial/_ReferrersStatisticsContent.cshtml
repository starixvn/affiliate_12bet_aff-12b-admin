@using Fanex.Affiliate.User.Core.Extensions
@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Statistics.ReferrerStatisticsViewModel

<table style="table-layout: fixed; width: 100%">
    <thead>
        <tr>
            <th width="@(Model.IsDetail ? 52 : 37 )%">@Lang.WebsiteURL</th>
            @if (!Model.IsDetail)
            {
                <th width="15%">@Lang.Country</th>
            }
            <th width="12%">@Lang.TotalClick</th>
            <th width="12%">@Lang.UniqueClick</th>
            <th width="12%">@Lang.SignUp</th>
            <th width="12%">@Lang.FDM</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.DataList)
        {
            <tr>
                <td>
                    @if (Model.IsDetail || item.SiteUrls.MatchWith("none") || item.SiteUrls.MatchWith("old url"))
                    {
                        @item.SiteUrls
                    }
                    else
                    {
                        <a href="javascript:;" class="statisticsItem" data-domain="@item.SiteUrls" data-country-code="@item.CountryCode">@item.SiteUrls</a>
                    }                  
                </td>
                @if(!Model.IsDetail)
                {
                    <td class="text-right">@item.Country</td>
                }    
                <td class="text-right">@item.TotalClick</td>
                <td class="text-right">@item.UniqueClick</td>
                <td class="text-right">@item.SignUps</td>
                <td class="text-right">@item.Fdm</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.IsDetail)
{
    <input id="TotalItem" type="hidden" value="@Model.RowNumber" />
}
