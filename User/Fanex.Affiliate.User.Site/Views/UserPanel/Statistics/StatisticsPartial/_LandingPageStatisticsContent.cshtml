@using Fanex.Affiliate.User.Core.Extensions
@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Statistics.LandingPageStatisticsViewModel

@{ 
    var isReportByCountry = string.Equals(Statistics.ReportByCountry, Model.ReportBy, StringComparison.InvariantCultureIgnoreCase);
}

<table>
    <thead>
        <tr>
            @if (isReportByCountry)
            {
                <th width="26%">@Lang.Country</th>
                <th width="26%">@Lang.Page</th>
            }
            else
            {
                <th width="26%">@Lang.Page</th>
                <th width="26%">@Lang.Language</th>
            }
            <th width="12%">@Lang.TotalClick</th>
            <th width="12%">@Lang.UniqueClick</th>
            <th width="12%">@Lang.SignUp</th>
            <th width="12%">@Lang.FDM</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.DataList)
        {
        <tr>
            @if (isReportByCountry)
            {
                <td>
                    <a href="javascript:;" class="statisticsItem" data-page="@item.Page" data-isreportbycountry="@isReportByCountry" data-reportbyvalue="@(isReportByCountry ? item.CountryCode : item.LanguageCode)">
                        @item.Country
                    </a>
                </td>
                <td>@item.Page</td>
            }
            else
            {
                <td>
                    @if (Model.IsDetail || item.Page.MatchWith("none") || item.Page.MatchWith("old url"))
                    {
                        @item.Page
                    }
                    else
                    {
                        <a href="javascript:;" class="statisticsItem" data-page="@item.Page" data-isreportbycountry="@isReportByCountry" data-reportbyvalue="@(isReportByCountry ? item.CountryCode : item.LanguageCode)">
                            @item.Page
                        </a>
                    }
                </td>
                <td>@item.Language</td>
            }
            <td class="text-right">@item.TotalClick</td>
            <td class="text-right">@item.UniqueClick</td>
            <td class="text-right">@item.SignUps</td>
            <td class="text-right">@item.Fdm</td>
        </tr>
        }
    </tbody>
</table>

@if (Model.IsDetail)
{
    <input id="TotalItem" type="hidden" value="@Model.RowNumber" />
}
