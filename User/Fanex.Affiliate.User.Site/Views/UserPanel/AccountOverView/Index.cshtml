@using Fanex.Affiliate.User.Core.Extensions

@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.AccountOverviewViewModel
@{
    var selectedMonth = Model.SelectedMonth;
    var statistics = Model.Statistics;
    var commissionSettings = Model.CommissionSettingList;
    var hasCommissionData = commissionSettings != null && commissionSettings.Any();
}

@Html.InlineStyles("~/www/build/styles/css/account-overview.min.css")

<div class="account-overview">
    <div class="account-overview-filter">
        <div class="form-group">
            <div id="monthPicker" class="form-wrapper d-inline-block">
                <input readonly id="MonthDate" data-original-date="@selectedMonth.ToString("MM/dd/yyyy")" class="form-control d-inline-block" type="text" value="@selectedMonth.ToString("MMM-yyyy")" />
                <span class="glyphicon glyphicon-calendar" id="monthPickerTrigger"></span>
            </div>
            <div class="d-inline-block">
                <button class="btn btn-submit" id="statisticsSubmit" type="button">@Lang.Submit</button>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="account-overview-content">
        <div class="summary-section">
            <div class="tab-menu">
                <ul class="menu list-unstyled">
                    <li><span class="menu-item active">Summary</span></li>
                </ul>
            </div>

            <div class="summary-content">
                <div class="bg-red">
                    <span class="text"><strong>Last Login:</strong> @selectedMonth.ToString("dd-MMM-yyyy hh:mm tt")</span>
                    <span class="text"><strong>Last Login IP Address:</strong> 192.50.23.299</span>
                </div>
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-1"></div>
                        <div class="col-sm-4">
                            <p class="my-account">My Account</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-1">
                            <div class="img-icon">
                                <img class="img-responsive" src="~/www/build/styles/Images/contact-us/vietnam_lang.png" />
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="info-panel info-panel-green">
                                <p class="info-panel-title"><strong>New Signups / Deposited</strong></p>
                                <p class="info-panel-content"><strong>43/25</strong></p>
                            </div>
                        </div>

                        <div class="col-sm-2">
                            <div class="info-panel info-panel-green">
                                <p class="info-panel-title"><strong>Active Players / Qualified</strong></p>
                                <p class="info-panel-content"><strong>125/85</strong></p>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-1">
                            <div class="img-icon">
                                <img class="img-responsive" src="~/www/build/styles/Images/contact-us/vietnam_lang.png" />
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="info-panel info-panel-blue">
                                <p class="info-panel-title"><strong>Commission</strong></p>
                                <p class="info-panel-content"><strong>$3,000.00</strong></p>
                            </div>
                        </div>

                        <div class="col-sm-2">
                            <div class="info-panel info-panel-blue">
                                <p class="info-panel-title"><strong>Balance Brought Forward</strong></p>
                                <p class="info-panel-content"><strong>$255.00</strong></p>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-1">
                            <div class="img-icon">
                                <img class="img-responsive" src="~/www/build/styles/Images/contact-us/vietnam_lang.png" />
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="info-panel info-panel-orange">
                                <p class="info-panel-title"><strong>Total Deposits</strong></p>
                                <p class="info-panel-content"><strong>$38,489.75</strong></p>
                            </div>
                        </div>

                        <div class="col-sm-2">
                            <div class="info-panel info-panel-orange">
                                <p class="info-panel-title"><strong>Total Turnover</strong></p>
                                <p class="info-panel-content"><strong>$1,254,665.00</strong></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="overview-section">
            <div class="tab-menu">
                <ul class="menu list-unstyled">
                    <li><span class="menu-item active">Overview</span></li>
                    <li><span class="menu-item">Players Details</span></li>
                </ul>
            </div>
            <div class="table table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th width="20%">@Lang.Product</th>
                            <th width="5%">@Lang.Tier</th>
                            <th width="25%">@Lang.NetWinLoss</th>
                            <th width="20%">@Lang.QualifyingMem</th>
                            <th width="20%">@Lang.Comm</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (hasCommissionData)
                        {
                            var totalRow = commissionSettings.Count();
                            var isFirstRow = true;
                            for (var i = 0; i < totalRow; i++)
                            {
                                var item = commissionSettings.ElementAt(i);
                                var isLastRow = i == totalRow - 1;
                                var maxAmount = isLastRow ? "+" : " - " + item.MaxAmount.ToStringMoneyWithSymbol();
                                var maxQm = isLastRow ? "+" : " - " + item.MaxQm.FormatNumber();
                                <tr>
                                    @if (isFirstRow)
                                    {
                                        <td class="bg-sportsbook text-center" rowspan="@totalRow">@Lang.AllProducts</td>
                                    }

                                    <td class="text-center">@item.TierId</td>
                                    <td class="text-right">@(item.MinAmount.ToStringMoneyWithSymbol())@maxAmount</td>
                                    @if (isFirstRow)
                                    {
                                        <td class="text-center" rowspan="@totalRow">@Html.Raw(Lang.QualifyingMembers)</td>
                                    }
                                    <td class="text-right">@(Convert.ToDouble(item.Commission * 100).ToString())%</td>
                                </tr>

                                isFirstRow = false;
                            }
                        }
                    </tbody>
                </table>

                @if (!hasCommissionData)
                {
                    <p class="text-center">@Lang.NoInfo</p>
                }
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="ToDay" value="@DateTime.Now.ToString("MM/dd/yyyy")" />
@Html.InlineScripts("~/www/build/js/account-overview.js")
