
<div class="summary">
    <div class="bg-red">
        <span class="text"><strong>Last Login:</strong> @DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt")</span>
        <span class="text"><strong>Last Login IP Address:</strong> 192.50.23.299</span>
    </div>
    <div class="form-group">
        <div id="monthPicker" class="form-wrapper d-inline-block">
            <input readonly id="MonthDate" data-original-date="@DateTime.Now.ToString("MM/dd/yyyy")" class="form-control d-inline-block" type="text" value="@DateTime.Now.ToString("MMM-yyyy")" />
            <span class="glyphicon glyphicon-calendar" id="monthPickerTrigger"></span>
        </div>
        <div class="d-inline-block">
            <button class="btn btn-submit" id="statisticsSubmit" type="button">@Lang.Submit</button>
        </div>
    </div>
    <div class="summary-content">
        <div class="container-fluid dashboard-section">
            <span class="my-account">My Account</span>
            <div class="group group-one">
                <div class="img-icon">
                    <img class="img-responsive" src="~/www/build/styles/Images/account-overview/new-sign-up.png" />
                </div>
                <div class="info-panel">
                    <span class="info-panel-title">New Signups / Deposited</span>
                    <span class="info-panel-content">43/25</span>
                </div>

                <div class="info-panel">
                    <span class="info-panel-title">Active Players / Qualified</span>
                    <span class="info-panel-content">125/85</span>
                </div>
            </div>
            <div class="group group-two">
                <div class="img-icon">
                    <img class="img-responsive" src="~/www/build/styles/Images/account-overview/commission.png" />
                </div>
                <div class="info-panel">
                    <span class="info-panel-title">Commission</span>
                    <span class="info-panel-content">$3,000.00</span>
                </div>
                <div class="info-panel">
                    <span class="info-panel-title">Balance Brought Forward</span>
                    <span class="info-panel-content">$255.00</span>
                </div>
            </div>
            <div class="group group-three">
                <div class="img-icon">
                    <img class="img-responsive" src="~/www/build/styles/Images/account-overview/total-deposit.png" />
                </div>
                <div class="info-panel">
                    <span class="info-panel-title">Total Deposits</span>
                    <span class="info-panel-content">$38,489.75</span>
                </div>
                <div class="info-panel">
                    <span class="info-panel-title">Total Turnover</span>
                    <span class="info-panel-content">$1,254,665.00</span>
                </div>
            </div>
        </div>
        <div class="details-section" id="details-section">
            <div class="tab-menu">
                <ul class="menu list-unstyled">
                    <li><a href="javascript:;" data-name="Overview" class="menu-item details-section-menu" id="menuOverview">Overview</a></li>
                    <li><a href="javascript:;" data-name="PlayersDetails" class="menu-item details-section-menu" id="menuPlayersDetails">Players Details</a></li>
                </ul>
            </div>
            <div id="details-section-content"></div>
        </div>
    </div>
</div>

