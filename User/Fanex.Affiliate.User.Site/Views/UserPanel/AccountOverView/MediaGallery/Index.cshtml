@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.MediaGalleryViewModel

@Html.InlineStyles("~/www/build/styles/css/marketing.min.css")

<div class="container-fluid">
    @{ Html.RenderPartial("~/Views/UserPanel/AccountOverview/Partial/_SearchForm.cshtml", Model.SearchForm); }

    <div id="dataContainerList">
        <div class="info-group link-group">
            <div class="title">
                <span class="text">@Lang.Banner</span>
            </div>
            <div class="alert-media" id="alertMediaBlock" style="display: none;">
                <div class="alert-media-block">
                    <div class="alert-media-block-remove">
                        <div class="alert-glyphicon-remove" id="alertMediaBlockRemove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </div>
                    </div>
                    <div class="alert-media-block-group">
                        <div class="alert-media-block-group-circle">
                            <i class="glyphicon glyphicon-ok"></i>
                        </div>
                        <strong>@Lang.Copied</strong>
                    </div>
                </div>
            </div>
            <div id="marketingDataList">
                @{ Html.RenderPartial("~/Views/UserPanel/AccountOverview/Partial/_BannerList.cshtml", Model.MarketingDataList); }
            </div>

            <div id="marketingPager"></div>
        </div>
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/mediagallery.js")"></script>