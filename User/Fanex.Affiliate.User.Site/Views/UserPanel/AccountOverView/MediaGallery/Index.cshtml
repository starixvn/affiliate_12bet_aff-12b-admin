@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.MarketingViewModel

@Html.InlineStyles("~/www/build/styles/css/marketing.css")

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-3">
            <div id="searchForm">
                @{ Html.RenderPartial("~/Views/UserPanel/AccountOverview/Partial/_SearchForm.cshtml", Model.SearchForm); }
            </div>
        </div>
        <div class="col-sm-9">
            <div id="linkForm">
                @{ Html.RenderPartial("~/Views/UserPanel/AccountOverview/Partial/_LinkForm.cshtml", Model.LinkForm); }
            </div>

            <div id="textLinkList">
                @{ Html.RenderPartial("~/Views/UserPanel/AccountOverview/Partial/_TextLink.cshtml", Model.TextLinkList); }
            </div>
        </div>
    </div>
</div>

<div id="dataContainerList">
    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.Banner</span>
        </div>

        <div id="marketingDataList">
            @{ Html.RenderPartial("~/Views/UserPanel/AccountOverview/Partial/_BannerList.cshtml", Model.MarketingDataList); }
        </div>

        <div id="marketingPager"></div>
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/mediagallery.js")"></script>