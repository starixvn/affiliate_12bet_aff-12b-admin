@model Fanex.Affiliate.User.Core.DTO.UserPanel.AccountOverview.OverviewSummary

<div class="dashboard-section-col">
    <span class="my-account">@Lang.MyAccount</span>
    <div class="group group-one">
        <div class="img-icon">
            <img class="img-responsive" src="~/www/build/styles/Images/account-overview/new-sign-up.svg" alt="New Signup icon" />
        </div>
        <div class="info-panel">
            <span class="info-panel-title">@Lang.NewSignupAndDeposited</span>
            <span class="info-panel-content">@($"{Model.Signups}/{Model.DepositedMembers}")</span>
        </div>

        <div class="info-panel">
            <span class="info-panel-title">@Lang.ActivePlayers (@Lang.MinRequired)</span>
            <span class="info-panel-content">@($"{Model.ActivePlayers}")</span>
        </div>
    </div>
    <div class="group group-two">
        <div class="img-icon">
            <img class="img-responsive" src="~/www/build/styles/Images/account-overview/commission.svg" alt="Commission icon" />
        </div>
        <div class="info-panel">
            <span class="info-panel-title">@Lang.TotalCommission</span>
            <span class="info-panel-content">@Model.Commission.ToStringMoneyWithSymbol("$")</span>
        </div>
        <div class="info-panel">
            <span class="info-panel-title">@Lang.BalForward</span>
            <span class="info-panel-content">@Model.BalanceBroughtForward.ToStringMoneyWithSymbol("$")</span>
        </div>
    </div>
    <div class="group group-three">
        <div class="img-icon">
            <img class="img-responsive" src="~/www/build/styles/Images/account-overview/total-deposit.svg" alt="Total Deposit icon" />
        </div>
        <div class="info-panel">
            <span class="info-panel-title">@Lang.TotalDeposit/@Lang.FdmDeposit</span>
            <span class="info-panel-content">@Model.Deposit.ToStringMoneyWithSymbol("$")/@Model.FdmDeposit.ToStringMoneyWithSymbol("$")</span>
        </div>

        <div class="info-panel">
            <span class="info-panel-title">@Lang.TotalTurnover</span>
            <span class="info-panel-content">@Model.Turnover.ToStringMoneyWithSymbol("$")</span>
        </div>
    </div>
</div>

@if (!Model.IsMaxSubLevel)
{
    <div class="dashboard-section-col">
        <span class="my-account">@Lang.SubAffiliate</span>
        <div class="group group-four">
            <div class="img-icon">
                <img class="img-responsive" src="~/www/build/styles/Images/account-overview/icon-subaff.png" alt="sub-aff icon" />
            </div>
            <div class="info-panel">
                <span class="info-panel-title">@Lang.SubAffDownline</span>
                <span class="info-panel-content">@Model.NoOfSubAff</span>
            </div>

            <div class="info-panel">
                <span class="info-panel-title">@Lang.SubAffEarning </span>
                <span class="info-panel-content">@Model.SubAffCommission.ToStringMoneyWithSymbol("$")</span>
            </div>
        </div>
    </div>
}