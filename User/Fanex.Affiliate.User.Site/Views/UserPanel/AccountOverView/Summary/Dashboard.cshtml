@using Fanex.Affiliate.User.Core.Utilities
@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.DTO.UserPanel.OverviewSummary

@{
    var hasTurnOverPermission = ClaimUtitlity.HasClaim(ClaimConstant.TurnOverType);
    var hasActivePlayerDetailPermission = ClaimUtitlity.HasClaimOnlyInternalLogin(ClaimConstant.ActivePlayerDetailType);
}

<span class="my-account">@Lang.MyAccount</span>
<div class="group group-one">
    <div class="img-icon">
        <img class="img-responsive" src="~/www/build/styles/Images/account-overview/new-sign-up.png" alt="New Signup icon" />
    </div>
    <div class="info-panel @(hasActivePlayerDetailPermission ? "" : "w-100")">
        <span class="info-panel-title">@Lang.NewSignupAndDeposited</span>
        <span class="info-panel-content">@($"{Model.Signups}/{Model.DepositedMembers}")</span>
    </div>

    @if (hasActivePlayerDetailPermission)
    {
        <div class="info-panel">
            <span class="info-panel-title">@Lang.ActivePlayersAndQualified</span>
            <span class="info-panel-content">@($"{Model.ActivePlayers}/{Model.QualifiedActivePlayers}")</span>
        </div>
    }
</div>
<div class="group group-two">
    <div class="img-icon">
        <img class="img-responsive" src="~/www/build/styles/Images/account-overview/commission.png" alt="Commission icon" />
    </div>
    <div class="info-panel">
        <span class="info-panel-title">@Lang.Comm</span>
        <span class="info-panel-content">@Model.Commission.ToStringMoneyWithSymbol()</span>
    </div>
    <div class="info-panel">
        <span class="info-panel-title">@Lang.BalForward</span>
        <span class="info-panel-content">@Model.BalanceBroughtForward.ToStringMoneyWithSymbol()</span>
    </div>
</div>
<div class="group group-three">
    <div class="img-icon">
        <img class="img-responsive" src="~/www/build/styles/Images/account-overview/total-deposit.png" alt="Total Deposit icon" />
    </div>
    <div class="info-panel @(hasTurnOverPermission ? "" : "w-100")">
        <span class="info-panel-title">@Lang.TotalDeposit</span>
        <span class="info-panel-content">@Model.Deposit.ToStringMoneyWithSymbol()</span>
    </div>

    @if (hasTurnOverPermission)
    {
        <div class="info-panel">
            <span class="info-panel-title">@Lang.TotalTurnover</span>
            <span class="info-panel-content">@Model.Turnover.ToStringMoneyWithSymbol()</span>
        </div>
    }

</div>