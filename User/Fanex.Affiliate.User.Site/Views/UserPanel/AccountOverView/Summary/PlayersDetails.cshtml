@using Fanex.Affiliate.User.Core.Utilities
@using Fanex.Affiliate.User.Core.Constants
@using Fanex.Affiliate.User.Core.CoreService
@model List<Fanex.Affiliate.User.Core.DTO.UserPanel.AccountOverview.PlayerDetail>

@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var isIndiaAffiliate = string.Equals(SystemLanguage.IndiaLanguageCode, sessionService.UserSession.PreferredLanguage, StringComparison.OrdinalIgnoreCase) && !sessionService.IsInternal;
}

<div class="table player-detail-table">
    <table id="player-detail-table">
        <thead>
            <tr class="player-detail-table-header">
                <th width="8%">@Lang.No</th>
                <th width="16%" class="th" data-name="Username">
                    <div class="th-wrapper">
                        <span>Username</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span id="Username" class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="16%" class="th" data-name="RegisteredDate">
                    <div class="th-wrapper">
                        <span>@Lang.RegisteredDate</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                @if (ClaimUtitlity.HasClaim(ClaimConstant.TurnOverType))
                {
                    <th width="10%" class="th" data-name="Turnover">
                        <div class="th-wrapper">
                            <span>@Lang.Turnover</span>
                            <div class="icon-container">
                                <span class="caret asc"></span>
                                <span id="Turnover" class="caret desc"></span>
                            </div>
                        </div>
                    </th>
                }
                @if (!isIndiaAffiliate)
                {
                    <th width="10%" class="th" data-name="Winloss">
                        <div class="th-wrapper">
                            <span>@Lang.WinAndLoss</span>
                            <div class="icon-container">
                                <span class="caret asc"></span>
                                <span id="Winloss" class="caret desc"></span>
                            </div>
                        </div>
                    </th>
                }
                <th width="10%" class="th" data-name="Deposit">
                    <div class="th-wrapper">
                        <span>@Lang.Deposit</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="10%" class="th" data-name="Withdrawal">
                    <div class="th-wrapper">
                        <span>@Lang.Withdrawal</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="10%" class="th" data-name="Bonus">
                    <div class="th-wrapper">
                        <span>@Lang.Bonus</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="10%" class="th" data-name="BankingFee">
                    <div class="th-wrapper">
                        <span>@Lang.BankingFee</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
            </tr>
        </thead>
        <tbody id="player-detail-content">
            @{ Html.RenderPartial("~/Views/UserPanel/AccountOverView/Summary/PlayersDetailsContent.cshtml", Model); }
        </tbody>
    </table>
</div>
<div class="player-detail-pager" id="player-detail-pager"></div>

<script src="@Url.RenderLink("~/www/build/js/player-detail.js")"></script>