@model IEnumerable<Fanex.Affiliate.User.Core.DTO.UserPanel.OverviewDetail>

@{
    var rowNum = Model.Count();
    var itemTotal = Model.FirstOrDefault();
    var hasData = Model.Any();
    var hasScroll = rowNum > 4;
}

<div class="table table-responsive">
    <table class="@(hasScroll ? "has-scroll" : string.Empty) has-total">
        <thead>
            <tr>
                <th width="10%">Date</th>
                <th width="10%">New Sign Up</th>
                <th width="12%">Deposited members</th>
                <th width="12%">Active members</th>
                <th width="16%">Qualified Active members</th>
                <th width="10%">Deposits</th>
                <th width="10%">Turnover</th>
                <th width="10%">Withdrawal</th>
                <th width="10%">Win/Loss</th>
            </tr>
            @{
                if (hasData)
                {
                    <tr class="total">
                        <td class="text-center">Total</td>
                        <td class="text-center">@itemTotal.Signups</td>
                        <td class="text-center">@itemTotal.DepositMembers</td>
                        <td class="text-center">@itemTotal.ActivePlayers</td>
                        <td class="text-center">@itemTotal.QualifiedActivePlayers</td>
                        <td class="text-center">@itemTotal.Deposit</td>
                        <td class="text-center">@itemTotal.Turnover</td>
                        <td class="text-center">@itemTotal.Withdrawal</td>
                        <td class="text-center">@itemTotal.Winloss</td>
                    </tr>
                }
            }
        </thead>
        <tbody>
            @{
                if (hasData)
                {
                    for (var i = 1; i < rowNum; i++)
                    {
                        var item = Model.ElementAt(i);
                        <tr>
                            <td class="text-center">@item.Date.ToString("MM/dd/yyyy")</td>
                            <td class="text-center">@item.Signups</td>
                            <td class="text-center">@item.DepositMembers</td>
                            <td class="text-center">@item.ActivePlayers</td>
                            <td class="text-center">@item.QualifiedActivePlayers</td>
                            <td class="text-center">@item.Deposit</td>
                            <td class="text-center">@item.Turnover</td>
                            <td class="text-center">@item.Withdrawal</td>
                            <td class="text-center">@item.Winloss</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center" colspan="9">@Lang.NoInfo</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>