
@model IEnumerable<Fanex.Affiliate.User.Core.DTO.UserPanel.SubAffDetail>

<div class="table">
    <table id="sub-aff-detail-table">
        <thead>
            <tr>
                <th width="8%">No.</th>
                <th width="16%">@Lang.Username</th>
                <th width="16%">@Lang.FName</th>
                <th width="10%">@Lang.LName</th>
                <th width="10%">@Lang.ApprovalDate</th>
                <th width="10%" hidden>@Lang.SuspensionSatus</th>
                <th width="10%" hidden>@Lang.SuspensionDate</th>
                <th width="10%">@Lang.TotalTurnover <br /> (@Lang.CurrencyLabel)</th>
                <th width="10%">@Lang.TotalGGR <br /> (@Lang.CurrencyLabel)</th>
                <th width="10%">@Lang.TotalCommission <br /> (@Lang.CurrencyLabel)</th>
                <th width="10%">@Lang.NumberOfActivePlayers</th>
                <th width="10%" hidden>@Lang.Remove</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null && Model.Any())
                {
                    var startRowNumber = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@startRowNumber</td>
                            <td class="text-center break-all">@item.UserName</td>
                            <td class="text-center">@Html.Raw(item.FirstName)</td>
                            <td class="text-center">@Html.Raw(item.LastName)</td>
                            <td class="text-center">@item.ApprovedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td class="text-center">@item.Turnover.FormatDecimal()</td>
                            <td class="text-center">@item.GGR.FormatDecimal()</td>
                            <td class="text-center">@item.Commission.FormatDecimal()</td>
                            <td class="text-center">@item.ActivePlayer</td>
                        </tr>

                        startRowNumber++;
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center" colspan="9">@Lang.NoInfo</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>