@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.SearchFormViewModel

@{
    var hasAnyDomain = Model.DomainList != null && Model.DomainList.Any();
    var hasAnyMemberSitePage = Model.MemberSitePageList != null && Model.MemberSitePageList.Any();
}

<div class="info-group link-group">
    <div class="title">
        <span class="text">@Lang.GetBannerForYourTargetMarket</span>
    </div>

    <div class="form-horizontal">
        @RazorHelper.RenderDropdownForMarketing("TargetCountry", Lang.TargetCountry, Model.TargetCountryList, false)

        @RazorHelper.RenderDropdownForMarketing("Language", Lang.Language, Model.LanguageList, Model.LanguageList.Count() > 1)

        @RazorHelper.RenderDropdownForMarketing("TargetProduct", Lang.TargetProduct, Model.TargetProductList)

        @RazorHelper.RenderDropdownForMarketingHasNoInfo("Domain", Lang.AvailableDomains, Model.DomainList, hasAnyDomain)

        @RazorHelper.RenderDropdownForMarketingHasNoInfo("MemberSitePage", Lang.LinkTo, Model.MemberSitePageList, hasAnyMemberSitePage)

        @RazorHelper.RenderDropdownForMarketing("Size", Lang.Size, Model.SizeList)

        <div class="form-group">
            <div class="col-sm-offset-3 col-lg-offset-2 col-sm-1">
                <button type="button" class="btn btn-submit" id="btnMarketingSubmit" disabled="@(!(hasAnyDomain && hasAnyMemberSitePage))">@Lang.Search</button>
            </div>
        </div>
    </div>
</div>