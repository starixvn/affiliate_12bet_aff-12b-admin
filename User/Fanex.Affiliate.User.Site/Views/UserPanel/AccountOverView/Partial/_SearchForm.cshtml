@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.SearchFormViewModel

@{
    var hasAnyDomain = Model.DomainList != null && Model.DomainList.Any();
}

<div class="info-group link-group">
    <div class="title">
        <span class="text">@Lang.GetBannerForYourTargetMarket</span>
    </div>

    <div class="form-horizontal">
        @RazorHelper.RenderDropdownForMarketing("TargetCountry", Lang.TargetCountry, Model.TargetCountryList)

        @RazorHelper.RenderDropdownForMarketing("Language", Lang.Language, Model.LanguageList)

        @RazorHelper.RenderDropdownForMarketing("TargetProduct", Lang.TargetProduct, Model.TargetProductList)

        @RazorHelper.RenderDropdownForAvailableDomain(Model.DomainList, hasAnyDomain)

        @RazorHelper.RenderDropdownForMarketing("MemberSitePage", Lang.LinkTo, Model.MemberSitePageList, false)

        @RazorHelper.RenderDropdownForMarketing("Size", Lang.Size, Model.SizeList)

        @if (hasAnyDomain)
        {
            <div class="form-group">
                <div class="col-sm-offset-3 col-lg-offset-2 col-sm-1">
                    <button type="button" class="btn btn-submit" id="btnMarketingSearch">@Lang.Search</button>
                </div>
            </div>
        }
    </div>
</div>