@{
    Layout = null;
}

@model IDictionary<string, Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.QrCodeLinkModel><div class="form-horizontal">
    @foreach (var key in Model.Keys)
    {
        <div class="form-group col-lg-6">
            <label class="col-sm-3 control-label">@Model[key].Language</label>
            <div class="control-group">
                <button class="btn-copy-link" data-clipboard-text="@Model[key].Link">Copy Link</button>
                <button class="btn-copy-qr">Copy QR Code</button>
                <button class="btn-save-img">Save QR Code</button>
                <img class="qr-code" src="@Model[key].QrCode"/>
            </div>
        </div>
    }
</div>