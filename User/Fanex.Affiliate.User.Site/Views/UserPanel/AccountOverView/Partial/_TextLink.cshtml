@{
    Layout = null;
}
@model IDictionary<string, Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.QrCodeLinkModel>
<div class="form-horizontal marketing-qrcode">
    @foreach (var key in Model.Keys)
    {
    <div class="form-group">
        <label class="col-sm-3 col-lg-2 control-label">@Model[key].Language</label>
        <div class="col-lg-6 col-sm-7 col-md-9">
            <input type="text" title="@Model[key].Link" disabled class="text-link" value="@Model[key].Link" />
        </div>
        <div class="col-sm-offset-3 col-sm-9 col-lg-offset-0 col-lg-4 group-copy-btns">
            <button class="btn-copy-link" data-clipboard-text="@Model[key].Link">@Lang.CopyLink</button>
            <button class="btn-copy-qr">@Lang.CopyQR</button>
            @{
                var downloadName = Model[key].Language + "_qrcode";
            }
            <button class="btn-save-img" data-image-name="@downloadName">@Lang.SaveQR</button>
            <img class="qr-code" src="@Model[key].QrCode" alt="QR Code icon" />
        </div>
    </div>
    }
</div>