@{
    Layout = null;
}

@model IDictionary<string, string>

<div class="form-horizontal">
    @foreach (var item in Model)
    {
        <div class="form-group">
            <label class="col-sm-3 control-label">@item.Key</label>
            <div class="control-group">
                <a href="javascript:;" class="copy-link" data-url="@item.Value" id="copy-link">Copy Link</a>
                <a href="javascript:;" class="copy-qr-code" id="copy-qr-code">Copy QR Code</a>
                <a href="javascript:;" class="save-qr-code" id="save-qr-code">Save QR Code</a>
            </div>
        </div>
    }
</div>