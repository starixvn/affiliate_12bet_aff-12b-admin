@{
    Layout = null;
    var currentYear = DateTime.Now.Year;
}
@using Fanex.Affiliate.User.Core.Utilities
@using Fanex.Affiliate.User.Core.Constants
@Html.InlineStyles("~/www/build/styles/css/pages/commissionreport.css")

<div class="page-title">
    <span class="text">@Lang.CommissionReport</span>
</div>

<div class="info-group">
    <div class="panel custom-panel">
        <div class="panel-body">
            <form class="form-inline form-filter">
                <div class="form-group">
                    <label>@Lang.Year</label>
                    <select class="form-control" id="year">

                        @for (var i = currentYear; i >= 2018; i--)
                        {
                            var temp = i == currentYear ? "selected='selected'" : string.Empty;
                            <option @temp value="@i">@i</option>
                        }
                    </select>
                    <button type="button" style="margin-left:3px;" class="btn btn-submit" id="btnSubmit">@Lang.Submit</button>
                </div>
            </form>
        </div>
    </div>

    <div class="report-container">
        <div class="table commission-report">
            <table id="dataTable">
                <thead>
                    <tr>
                        <th width="5%" class="th">#</th>
                        <th width="15%" class="th" data-name="Month">
                            <div class="th-wrapper">
                                <span>@Lang.Month</span>
                                <div class="icon-container">
                                    <span class="caret asc"></span>
                                    <span id="defaultSorting" class="caret desc"></span>
                                </div>
                            </div>
                        </th>
                        @if (ClaimUtitlity.HasClaim(ClaimConstant.TurnOverType))
                        {
                            <th width="10%" class="th" data-name="TurnOver" data-type="decimal">
                                <div class="th-wrapper">
                                    <span>@Lang.Turnover</span>
                                    <div class="icon-container">
                                        <span class="caret asc"></span>
                                        <span class="caret desc"></span>
                                    </div>
                                </div>
                            </th>
                        }
                        <th width="10%" class="th" data-name="WinLoss" data-type="decimal">
                            <div class="th-wrapper">
                                <span>@Lang.GrossWinLoss</span>
                                <div class="icon-container">
                                    <span class="caret asc"></span>
                                    <span class="caret desc"></span>
                                </div>
                            </div>
                        </th>
                        <th width="10%" class="th" data-name="PlatformFee" data-type="decimal">
                            <div class="th-wrapper">
                                <span>@Lang.PlatformFee</span>
                                <div class="icon-container">
                                    <span class="caret asc"></span>
                                    <span class="caret desc"></span>
                                </div>
                            </div>
                        </th>
                        <th width="10%" class="th" data-name="OperationalFee" data-type="decimal">
                            <div class="th-wrapper">
                                <span>@Lang.OperationalFee</span>
                                <div class="icon-container">
                                    <span class="caret asc"></span>
                                    <span class="caret desc"></span>
                                </div>
                            </div>
                        </th>
                        <th width="10%" class="th" data-name="BankingFee" data-type="decimal">
                            <div class="th-wrapper">
                                <span>@Lang.BankingFees</span>
                                <div class="icon-container">
                                    <span class="caret asc"></span>
                                    <span class="caret desc"></span>
                                </div>
                            </div>
                        </th>
                        <th width="10%" class="th" data-name="Bonus" data-type="decimal">
                            <div class="th-wrapper">
                                <span>@Lang.Bonus</span>
                                <div class="icon-container">
                                    <span class="caret asc"></span>
                                    <span class="caret desc"></span>
                                </div>
                            </div>
                        </th>
                        <th width="10%" class="th" data-name="CommissionRate">
                            <div class="th-wrapper">
                                <span>@Lang.CommRate</span>
                                <div class="icon-container">
                                    <span class="caret asc"></span>
                                    <span class="caret desc"></span>
                                </div>
                            </div>
                        </th>
                        <th width="10%" class="th" data-name="Commission" data-type="decimal">
                            <div class="th-wrapper col-comm">
                                <span>@(Lang.CommShorted).</span>
                                <div class="info-container">
                                    <span title="@Lang.NoteCommissionCalculation" class="glyphicon glyphicon-info-sign"></span>
                                </div>
                                <div class="icon-container">
                                    <span class="caret asc"></span>
                                    <span class="caret desc"></span>
                                </div>
                            </div>
                        </th>
                        <th width="10%" class="th" data-name="FdmExtraComm">
                            <div class="th-wrapper">
                                <span>@Lang.FdmExtraComm</span>
                                <div class="icon-container">
                                    <span class="caret asc"></span>
                                    <span class="caret desc"></span>
                                </div>
                            </div>
                        </th>
                        <th width="10%" class="th" data-name="TotalCommission">
                            <div class="th-wrapper">
                                <span>@Lang.TotalCommission</span>
                                <div class="icon-container">
                                    <span class="caret asc"></span>
                                    <span class="caret desc"></span>
                                </div>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody id="reportData"></tbody>
            </table>
        </div>
    </div>
</div>

<script>
    var langResource = {
        noInfo: '@Lang.NoInfo'
    }
</script>

<script src="@Url.RenderLink("~/www/build/js/pages/commission-report.js")"></script>