                    <div class="form-group">
                        <label class="col-sm-3 control-label require">@Lang.Address</label>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(p => p.Address, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(x => x.Address, string.Empty, new { @class = "help-block hide" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label require">@Lang.City</label>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(p => p.City, new { @class = "form-control" })
                        </div>
