                        <div class="col-sm-4">
                            @Html.TextBoxFor(p => p.Postal, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(x => x.Postal, string.Empty, new { @class = "help-block hide" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label require">@Lang.Country</label>
                        <div class="col-sm-4">
                            <select class="form-control" name="Country" id="Country" data-val="true" data-val-required="@Lang.CountryErr">
                                @{ Html.RenderPartial("~/Views/Signup/_CountryOption.cshtml"); }
                            </select>
                        </div>
                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(x => x.Country, string.Empty, new { @class = "help-block hide" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="info-group">
                <div class="title">
                    <span class="text">@Lang.WebsiteInfor</span>
                </div>

                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-sm-4">
                            <label class="radio-inline">
                                <input type="radio" name="HasWebSite" value="True" checked="checked" id="hasWebSite" /> @Lang.OwnWebsite
                            </label>
                        </div>
                    </div>

                    <div id="websiteInfo">
                        <div class="form-group">
                            <label class="col-sm-3 control-label require">@Lang.WebsiteURL</label>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(p => p.SiteUrl, new { @class = "form-control" })
                            </div>
                            <div class="col-sm-1">
                                <button type="button" class="btn btn-submit" id="btnAddUrl" title="@Lang.AddUrl"><span class="glyphicon glyphicon-plus" aria-hidden="true"></span></button>
                            </div>
                            <div class="col-sm-offset-3 col-sm-9">
                                @Html.ValidationMessageFor(p => p.SiteUrl, string.Empty, new { @class = "help-block hide" })
                            </div>
                        </div>

                        <input type="hidden" name="MoreSiteUrls" id="MoreSiteUrls" />
                    </div>

                    <div class="form-group">
                        <div class="col-sm-4">
                            <label class="radio-inline">
                                <input type="radio" name="HasWebSite" value="False" /> @Lang.NoWebsite
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label require">@Lang.DescWebsite</label>
                        <div class="col-sm-4">
                            @Html.TextAreaFor(p => p.NoSiteDesc, new { @class = "form-control", @rows = 5, @disabled = "disabled" })
                        </div>
                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(p => p.NoSiteDesc, string.Empty, new { @class = "help-block hide" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="info-group">
                <div class="title">
                    <span class="text">@Lang.Preference</span>
                </div>
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-sm-3 control-label require">@Lang.TargetCountry</label>
                        <div class="col-sm-4">
                            <select class="form-control" name="TargetCountryCode" id="TargetCountryCode" data-val="true" data-val-required="@Lang.TargetCountryErr">
                                <option value="">@Lang.SelectOne</option>
                                @foreach (var item in systemService.GetSystemTargetCountries())
                                {
                                    <option value="@item.TargetCountryCode" data-language="@item.DefaultLanguageCode">@item.TargetCountryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(x => x.TargetCountryCode, string.Empty, new { @class = "help-block hide" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label require">@Lang.AffCountLanguage</label>
                        <div class="col-sm-4">
                            <select class="form-control" name="PreferredLanguage" id="PreferredLanguage" data-val="true" data-val-required="@Lang.AffAccountLanguageErr">
                                <option value="">@Lang.SelectOne</option>
                                @foreach (var item in systemService.GetSystemTargetLanguages())
                                {
                                    <option value="@item.LanguageCode">@item.NativeLanguage</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(x => x.PreferredLanguage, string.Empty, new { @class = "help-block hide" })
                        </div>
                    </div>

                    <div class="form-group">
                        @{Html.RenderAction("SecurityQuestion", "Signup");}
                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(x => x.QuestionId, string.Empty, new { @class = "help-block hide" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label require">@Lang.lblYourAnswer</label>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(p => p.Answer, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(x => x.Answer, string.Empty, new { @class = "help-block hide" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label require">@Lang.Validation</label>
                        <div class="col-sm-4 preference-validation">
                            @Html.TextBoxFor(p => p.Captcha, new { @class = "form-control", @autocomplete = "off" })
                            <div class="captcha">
                                <div class="validation-value"><img id="signupCaptcha" src="" alt="captcha" /></div>
                            </div>
                        </div>
                        <div class="col-sm-offset-3 col-sm-9">
                            @Html.ValidationMessageFor(x => x.Captcha, string.Empty, new { @class = "help-block hide" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="info-group">
                <div class="title">
                    <span class="text">@Lang.PaymentInfor</span>
                </div>
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-sm-3 control-label">@Lang.PaymentMethod</label>
                        <div class="col-sm-4">
                            <label class="radio-inline">
                                <input type="radio" name="Method" checked /> @Lang._12BETPlayerAcc
                            </label>
                            <div class="form-group col-sm-12">
                                <label class="control-label require">@Lang.UsernameSignUp</label>
                                <label class="text-red">(@Lang.NonDeposited)</label>
                                <div class="">
