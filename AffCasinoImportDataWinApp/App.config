<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    </configSections>
  
  <appSettings>
    <add key="DailyDataURL" value="C:/sample.csv" />

    <add key="pathSaveFile" value="C:/Aff_CasinoImportData/" />
    <add key="fileExtension" value=".csv" />
    <!--Column name in the sheet-->
    <add key="Date" value="Date" />
    <add key="Username" value="Username" />
    <add key="Turnover" value="Bets" />
    <add key="Winlost" value="Game income" />
    <add key="Deposit" value="Total deposits" />
    <add key="Bonus" value="Bonus amount" />
    <!--Column in IA-->
    <!--<add key="IADate" value="Statsdate" />-->
    <add key="IAWinlost" value="Game income" />
    <!--<add key="IABonus" value="Bonuses" />
    <add key="IADeposit" value="purchases" />-->


    <add key="adminID" value="1881784" />
    <!-- send mail -->
    <add key="app_mail_address" value="net.tcp://10.18.200.209:8787/MailService" />
    <add key="app_mail_id" value="2" />
    <add key="isSendMail" value="1" />
    <add key="fromMail" value="affiliate-no-reply@12csd.com" />
    <add key="toMail" value="alex.nguyen@nexcel.vn" />
    <add key="CCMail" value="" />
    <add key="BCCMail" value="" />
    <add key="subjectMailError" value="Error - There is error when Import Casino Data" />
    <!--maintenance team-->
    <!-- /send mail-->
    <!--0: all system; 1: Casino Aff 12Bet; 2: Casino IA-->
    <add key="forSystem" value="1" />

    <add key="forTest" value="1" />
  </appSettings>
  <connectionStrings>
    <add name="Affiliate" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.18.200.231;Initial Catalog=Affiliate_12Bet;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;" />
    <add name="IA" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.18.200.215;Initial Catalog=bodb02;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;" />
  </connectionStrings>
  
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="SpNames.xml" enableWatching="1" />
    <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="$resourcePath_Value" enableWatching="1" /></providers>
  </Fanex.Data.DbSettingProvider>
</configuration>
