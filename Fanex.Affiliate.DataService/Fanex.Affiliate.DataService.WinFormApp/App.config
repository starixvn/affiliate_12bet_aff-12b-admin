<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.35.35.253\private$\entlib" defaultCategory="Affiliate-12Bet-LOCAL" />
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="../../App_Data/SpName.xml" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>

  <appSettings>
    <add key="IsLocalTest" value="1" />


    <!--Import Settings-->
    <add key="FileExtension" value=".csv" />
    <!--0: all system; 1: Casino Aff 12Bet; 2: Casino IA-->
    <add key="SystemType" value="1" />
    <add key="AdminId" value="1881784" />

    <add key="PathSaveFile" value="D:/tmp/AffCommImportDataManual/" />
    <add key="ImportCheckingTime1" value="0" />
    <add key="ImportCheckingTime2" value="23" />
    <add key="DailyDataURL" value="http://ha.nexdev.net:7643/12betLocalAPI/api/home/Download?fileName=Casino_{date}.csv" />
    <add key="FileExtension" value=".csv" />
  </appSettings>

  <connectionStrings>
    <add name="Affiliate" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.18.200.215;Initial Catalog=Affiliate_12Bet;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;" />
    <add name="IncomeAccess" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.18.200.215;Initial Catalog=bodb02;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;" />
