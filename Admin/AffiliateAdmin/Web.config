        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Content-Security-Policy" value="default-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' https://cdn.ravenjs.com 'unsafe-inline' 'unsafe-eval'; img-src * data:; connect-src 'self' https://sentry.nexdev.net; object-src *" />
