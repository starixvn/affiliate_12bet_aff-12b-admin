@{
    Layout = "~/Areas/Portal/Views/Shared/_Layout.cshtml";
}

@{
    var queryString = Request.QueryString.ToString();
    var defaultRelativeUrl = Url.Content("~/Portal/Customer/Main") + queryString;
}

<div class="mainFrameWrapper">
    <iframe frameborder="0" name="mainFrame" id="mainFrame" src="@Url.Content(defaultRelativeUrl)"></iframe>
</div>