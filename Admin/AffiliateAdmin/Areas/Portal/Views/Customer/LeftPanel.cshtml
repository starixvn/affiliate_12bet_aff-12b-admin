@{
    Layout = "~/Areas/Portal/Views/Shared/_SinglePageLayout.cshtml";
}

@model Fanex.Affiliate.Admin.Core.ViewModels.Customer.CustomerViewModel
@section styles{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/customer/leftpanel.css")" rel="stylesheet" />
}

@section scripts{
    <script type="text/javascript">
        window.initialState = {
            monthDate: '@DateTime.Now.ToString("MM/dd/yyyy")',
            affName: '@Model.AffName',
            languageList: @Html.Raw(Json.Encode(Model.LanguageList)),
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/customer/leftpanel.js")"></script>
}
<div id="root">
</div>
