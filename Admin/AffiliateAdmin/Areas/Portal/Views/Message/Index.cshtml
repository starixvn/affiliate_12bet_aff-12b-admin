@model IEnumerable<Fanex.Affiliate.Admin.Core.DTO.Language>

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/message/message.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            today: '@DateTimeOffset.Now.ToOffset(new TimeSpan(8, 0, 0)).ToString("MM/dd/yyyy")',
            languageList: @Html.Raw(Json.Encode(Model.Where(
                l => !(l.LanguageCode == "en-GB"
                || l.LanguageCode == "en-IN"
                || l.LanguageCode == "ja-JP"
                || l.LanguageCode == "ko-KR"
                || l.LanguageCode == "te-IN"
                || l.LanguageCode == "zh-TW"))))
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/message/message.js")"></script>
}