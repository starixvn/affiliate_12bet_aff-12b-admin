@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                សូមគោរព @Model.FirstName,<br /><br />

                សូមអរគុណចំពោះការដាក់សំណើរបស់អ្នកដើម្បីចូលរួមកម្មវិធីភ្នាក់ងារ 12BET។ បន្ទាប់ពីការត្រួតពិនិត្យយ៉ាងយកចិត្តទុកដាក់ យើងមានការសោកស្តាយក្នុងការជូនដំណឹងដល់អ្នកថាការដាក់សំណើរបស់អ្នកត្រូវបានបដិសេធ។<br /><br />

                យើងសូមអរគុណចំពោះចំណាប់អារម្មណ៍របស់អ្នកក្នុងការធ្វើជាដៃគូជាមួយ 12BET ប៉ុន្តែជាអកុសល យើងមិនអាចអនុម័តសំណើរបស់អ្នកបានទេនៅពេលនេះ។ យើងមានការណែនាំដ៏តឹងរឹងសម្រាប់ភ្នាក់ងាររបស់យើង ហើយជាអកុសល ពាក្យស្នើរបស់អ្នកមិនបំពេញតាមស្តង់ដារដែល 12BET បានកំណត់ក្នុងប៉ុន្មានឆ្នាំមកនេះ។<br /><br />

                យើងសូមអភ័យទោសចំពោះភាពរអាក់រអួលណាមួយដែលវាអាចបណ្តាលឱ្យ និងលើកទឹកចិត្តអ្នកឱ្យដាក់ពាក្យម្តងទៀតនៅពេលអនាគត ដោយសារយើងទាំងអស់គ្នាដឹងថាទីផ្សារអនឡាញកំពុងរីកចម្រើនជានិច្ច។<br /><br />

                ក្រុមការងារយើងខ្ញុំ សូមជូនពរលោកអ្នក ជួបតែសេចក្តីសុខ សេចក្តីចម្រើន ក្នុងការប្រឹងប្រែងនាពេលខាងមុខ។<br /><br />
                
                ដោយក្តីគោរពរាប់អាន<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)