@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                Yang terhormat @Model.FirstName,<br /><br />

                Terimakasih telah mengajukan permintaan untuk bergabung dengan Program Afiliasi 12BET. Setelah peninjauan, kami informasikan bahwa pengajuan Anda ditolak.<br /><br />

