@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                Thân gửi @Model.FirstName,<br /><br />

                Cảm ơn bạn đã gửi yêu cầu tham gia Chương trình Đại lý 12BET. Sau khi xem xét, chúng tôi rất tiếc phải thông báo với bạn rằng đơn đăng ký của bạn đã bị từ chối.<br /><br />

                Chúng tôi đánh giá cao sự quan tâm của bạn trong việc hợp tác với 12BET, nhưng rất tiếc, chúng tôi không thể chấp thuận yêu cầu của bạn vào lúc này. Chúng tôi có các nguyên tắc và yêu cầu riêng dành cho các đại lý của mình và thật không may, đơn đăng ký của bạn không đáp ứng các tiêu chuẩn mà 12BET đã đặt ra trong nhiều năm.<br /><br />

                Chúng tôi xin lỗi vì bất kỳ sự bất tiện nào mà điều này có thể gây ra và khuyến khích bạn đăng ký lại trong tương lai vì tất cả chúng ta đều biết tiếp thị trực tuyến ngày càng phát triển.<br /><br />
                Nhóm của chúng tôi chúc bạn những điều tốt đẹp nhất trong những nỗ lực trong tương lai của bạn.<br /><br />
                Trân trọng,<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)