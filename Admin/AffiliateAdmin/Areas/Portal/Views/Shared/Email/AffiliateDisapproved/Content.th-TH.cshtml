@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                เรียนคุณ @Model.FirstName<br /><br />

                ขอขอบคุณที่ส่งคำขอเข้าร่วมโปรแกรมพันธมิตร 12BET หลังจากตรวจสอบอย่างถี่ถ้วนแล้ว เราเสียใจที่ต้องแจ้งให้คุณทราบว่าใบสมัครของคุณถูกปฏิเสธ<br /><br />

                เราขอขอบคุณที่ให้ความสนใจในการเป็นพันธมิตรกับ 12BET แต่น่าเสียดายที่เราไม่สามารถอนุมัติคำขอของคุณได้ในขณะนี้ เรามีหลักเกณฑ์ที่เข้มงวดสำหรับพันธมิตรของเรา และน่าเสียดายที่การสมัครของคุณไม่เป็นไปตามมาตรฐานที่ 12BET กำหนดไว้ในช่วงหลายปีที่ผ่านมา<br /><br />

                เราขออภัยในความไม่สะดวกที่อาจเกิดขึ้น และขอแนะนำให้คุณสมัครใหม่ในอนาคต เนื่องจากเราทุกคนทราบดีว่าการตลาดออนไลน์มีการพัฒนาอยู่ตลอดเวลา<br /><br />

                ทีมงานของเราขออวยพรให้คุณประสบความสำเร็จในความพยายามในอนาคตของคุณ<br /><br />

                ขอแสดงความนับถืออย่างยิ่ง<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)