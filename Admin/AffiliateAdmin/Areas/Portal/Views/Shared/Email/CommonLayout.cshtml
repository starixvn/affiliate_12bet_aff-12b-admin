﻿@using Fanex.Affiliate.Admin.Core.Resources
@model Fanex.Affiliate.Admin.Core.ViewModels.EmailTemplateViewModel

<table style="font-size: 13px; font-family: Verdana,Arial,Helvetica,sans-serif;" width="100%">
    <tr>
        <td valign="top" align="center">
            <table align="center"
                   border="0"
                   cellpadding="0"
                   cellspacing="0"
                   style="border-collapse: collapse"
                   width="600">
                <tbody>
                    <tr>
                        <td align="center"
                            valign="bottom"
                            style="
                            font-size: 9.5px;
                            color: #666666;
                            text-align: center;
                            padding-bottom: 10px;
                        ">
                            This is the 12BET Affiliate Newsletter. Please add
                            <a href="mailto:affiliates@snr33.com"
                               name="mailto_affiliates_snr33_com"
                               onmouseover="this.style.textDecoration='underline';"
                               style="color: #c00000; outline: none; text-decoration: none"
                               xt="SPCLICK">12Affiliates &lt; affiliates@snr33.com &gt;</a>
                            to your email address list in order to receive all mails from
                            12Affiliates in the future.
                        </td>
                    </tr>
                </tbody>
            </table>
            <table align="center"
                   border="0"
                   cellpadding="0"
                   cellspacing="0"
                   style="border-collapse: collapse; background-repeat: no-repeat"
                   width="600"
                   background="@Model.ImageRootUrl/bg-header.jpg">
                <tbody>
                    <tr>
                        <td width="600" height="207"></td>
                    </tr>
                    <tr>
                        <td width="600" height="150" style="padding: 0 80px 15px 50px">
                            @Raw(Model.Content)
                        </td>
                    </tr>
                    <tr>
                        <td height="116"
                            style="background-repeat: no-repeat;"
                            background="@Model.ImageRootUrl/bg-footer.jpg"></td>
                    </tr>
                </tbody>
            </table>
            <table width="600" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td align="center" height="25" bgcolor="#b6b6b6">
                        <font style="font-size: 11px; color: #333333;">
                            &copy;&nbsp;Copyright 2018. All Rights Reserved. Designed and Powered by 12BET.com
                        </font>
                    </td>
                </tr>
                <tr>
                    <td align="center" height="40" bgcolor="#4a4a4a">
                        <font style="font-size: 11px; color: #ffffff">
                            @Lang.EmailAutoNotification
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>