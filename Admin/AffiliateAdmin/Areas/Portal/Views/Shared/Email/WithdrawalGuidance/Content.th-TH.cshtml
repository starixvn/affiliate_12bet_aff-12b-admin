@model Fanex.Affiliate.Admin.Core.DTO.Email.WithdrawalEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                เรียน @Model.FirstName,<br /><br />

                ขอแสดงความยินดีที่ท่านได้เป็นพันธมิตรกับ 12BET กับเรา!<br /><br />

                เพื่อให้แน่ใจว่าการจ่ายเงินเป็นไปอย่างรวดเร็วขึ้นสําหรับพันธมิตรของคุณ โปรดสละเวลาอ่านขั้นตอนการถอนเงินต่อไปนี้<br /><br />

                1. กรุณาอย่าฝากเงินในบัญชีผู้เล่น 12BET ที่เชื่อมโยงกับบัญชีพันธมิตร 12BET<br /><br />
                2. ในกรณีที่คุณใช้บัญชีที่ฝากเงินและบัญชีพันธมิตร 12BET ของคุณได้รับการอนุมัติ โปรดติดต่อผู้จัดการพันธมิตรของคุณหรืออีเมลไปยัง <a href="mailto:@Model.MailContact">@Model.MailContact</a> เพื่อทำการแก้ไข<br /><br />
                3. เราจะทำการจ่ายเงินค่าคอมมิชชั่นให้สมาชิกเดือนละครั้ง (วันที่ 8 ถึง 15 ของเดือน) กรุณาล๊อคอินเข้าไปที่บัญชีพันธมิตรและคลิ๊กไปที่การขอถอนเงิน จากนั้นกรอกจำนวนเงินที่คุณต้องการจะถอน<br /><br />
                4. ถ้าการขอถอนเงินของคุณได้รับการอนุมัติ ระบบจะโอนเงินเข้าไปยังบัญชี 12BET ของคุณโดยอัตโนมัติ<br /><br />
                5. คุณสามารถถอนเงินออกจากบัญชี 12BET ได้ตลอดเวลาและจะไม่เสียค่าธรรมเนียมใดใดเพิ่มเติม<br /><br />

                ข้อควรระวัง :<br /><br />
                1. บัญชี 12BET ของคุณใช้เพื่อวัตถุประสงค์ในการรับคอมมิชชั่นจากโปรแกรมพันธมิตรเท่านั้น กรุณาอย่าทำการฝากเงินหรือวางเดิมพันเป็นอันขาด<br /><br />
                2. ชื่อที่ใช้ในการสมัครบัญชี 12BET จะต้องเป็นชื่อเดียวกับที่ใช้สมัครเป็นสมาชิกพันธมิตรเท่านั้นและต้องเป็นชื่อจริง<br /><br />

                กรุณาอย่างลังเลที่จะติดต่อเรา หากคุณมีคำถามเพิ่มเติม<br /><br />

                ขอแสดงความนับถือ<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)