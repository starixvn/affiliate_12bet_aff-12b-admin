@model Fanex.Affiliate.Admin.Core.DTO.Email.WithdrawalEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                សូមគោរព @Model.FirstName,<br /><br />

                សូមអបអរសាទរសំរាប់ក្លាយជាភ្នាក់ងារ 12Bet របស់យើង!<br /><br />

                ដើម្បីធានាថាការទូទាត់កាន់តែលឿនសម្រាប់ភ្នាក់ងាររបស់អ្នក សូមចំណាយពេលខ្លះដើម្បីអាននីតិវិធីខាងក្រោមសម្រាប់ការដកប្រាក់៖<br /><br />

                1. សូមចុះឈ្មោះគណនីភ្នាល់ 12Bet ថ្មី (កុំដាក់ប្រាក់)<br /><br />
                2. ផ្ញើអ៊ីមែលទៅ <a href="mailto:@Model.MailContact">@Model.MailContact</a> ហើយបញ្ជាក់ឈ្មោះប្រើប្រាស់ 12Bet របស់អ្នករួមជាមួយនឹងឈ្មោះអ្នកប្រើប្រាស់ភ្នាក់ងាររបស់អ្នកផងដែរ។<br /><br />
                3. បន្ទាប់ពីផ្ញើអ៊ីមែលមកយើងអំពីគណនី 12Bet របស់អ្នករួចហើយ សូមចូលទៅកាន់គណនីភ្នាក់ងាររបស់អ្នក ហើយចុចលើ "គណនីរបស់ខ្ញុំ" នៅជួរព័ត៌មានទូទាត់ប្រាក់ សូមប្តូរវិធីទូទាត់ប្រាក់របស់អ្នកទៅជាគណនី12Betវិញ ដោយបំពេញឈ្មោះប្រើប្រាស់ 12Bet របស់អ្នក ហើយចុចបញ្ជូន។<br /><br />
                4. យើងនឹងទូទាត់ប្រាក់កម្រៃជើងសាររបស់សមាជិកម្តងក្នុងមួយខែ សូមចូលទៅកាន់គណនីភ្នាក់ងាររបស់អ្នក ហើយចុចលើសំណើទូទាត់ បញ្ចូលចំនួនទឹកប្រាក់ និងស្នើសុំ។<br /><br />
                5. ប្រសិនបើសំណើដកប្រាក់របស់អ្នកត្រូវបានយល់ព្រម ប្រាក់របស់អ្នកនឹងត្រូវបានផ្ទេរដោយស្វ័យប្រវត្តិទៅកាន់គណនីភ្នាល់ 12bet របស់អ្នក។<br /><br />
                6. អ្នកអាចស្នើសុំដកប្រាក់ពីគណនីភ្នាល់ 12Bet របស់អ្នកបានគ្រប់ពេល ដោយមិនគិតថ្លៃបន្ថែមនោះទេ។<br /><br />

                សូមចំណាំ៖<br /><br />
                1. គណនីភ្នាល់ 12Bet របស់អ្នកគឺសម្រាប់គោលបំណងចូលរួមជាភ្នាក់ងារតែប៉ុណ្ណោះ សូមកុំដាក់ប្រាក់ ឬដាក់ភ្នាល់។<br /><br />
                2. សំរាប់គណនីភ្នាល់ 12Betដែលអ្នកបានចុះឈ្មោះត្រូវតែមានឈ្មោះដូចគ្នាជាមួយគណនីភ្នាក់ងារ ហើយវាត្រូវតែជាឈ្មោះពិតប្រាកដរបស់អ្នក។<br /><br />
                3. នីតិវិធីខាងលើគឺសម្រាប់សមាជិកភ្នាក់ងារដែលដកប្រាក់លើកដំបូងតែប៉ុណ្ណោះ ប្រសិនបើស្នើសុំការដកលើកទី 2 ឬទី 3 សូមយោងទៅជំហានទី 4, 5 និង 6 ។<br /><br />

                សូមកុំស្ទាក់ស្ទើរក្នុងការទាក់ទងមកយើងខ្ញុំ ប្រសិនបើអ្នកមានសំណួរបន្ថែម។<br /><br />

                ដោយក្តីគោរព,<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)