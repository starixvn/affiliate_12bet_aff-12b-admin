@model Fanex.Affiliate.Admin.Core.DTO.Email.PaymentRequestUpdateEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                尊敬的 @Model.FirstName,  <br /><br />

                提款单号 @(Model.TransId)，日期 @(Model.TransDate)。<br /><br />

                很高兴的通知您，您金额为$@(Model.Amount) 的提款申请已被核准，相应的款项已成功转入您用于佣金提取的玩家帐户 。<br /><br />

                这是一封系统邮件，请不要在此邮件基础上直接回复。<br />
                如有任何疑问，请随时联系我们 <a href="mailto:@Model.MailContact">@Model.MailContact</a><br /> <br />

                诚挚的,<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)