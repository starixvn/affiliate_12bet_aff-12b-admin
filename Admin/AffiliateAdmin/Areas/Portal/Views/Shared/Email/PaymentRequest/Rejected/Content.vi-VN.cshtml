@model Fanex.Affiliate.Admin.Core.DTO.Email.PaymentRequestUpdateEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                Thân gửi @Model.FirstName,<br /><br />

                Bạn đã gửi cho chúng tôi yêu cầu thanh toán số @Model.TransId vào ngày @Model.TransDate.<br /><br />

                Chúng tôi xin thông báo yêu cầu thanh toán của bạn với số tiền $@Model.Amount đã bị từ chối.<br /><br />
                Mọi thắc mắc và ý kiến đóng góp xin vui lòng liên hệ <a href="mailto:@Model.MailContact">@Model.MailContact</a><br />

                Đây là thư tự động do hệ thống gửi, xin vui lòng không trả lời trực tiếp thư này.<br /><br />

                Xin chân thành cảm ơn.<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)