@model Fanex.Affiliate.Admin.Core.DTO.Email.PaymentRequestUpdateEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                尊敬的@(Model.FirstName)：<br /><br />

                申請單號：@(Model.TransId)<br />
                申請日期：@(Model.TransDate)<br /><br />

                很高興通知您，您的$@(Model.Amount)提款申請已核准，相應的款項已成功轉入您用於佣金提取的會員帳戶 。<br /><br />

                此郵件為系統郵件，請不要直接回覆。<br />
                如有任何疑問，請隨時透過 <a href="mailto:@Model.MailContact">@Model.MailContact</a> 與我們聯繫。<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)