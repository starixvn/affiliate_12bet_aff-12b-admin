@model Fanex.Affiliate.Admin.Core.DTO.Email.PaymentRequestUpdateEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                Yang terhormat @Model.FirstName,<br /><br />

                Permintaan nomor referensi adalah @Model.TransId, tanggal @Model.TransDate.<br /><br />

                Pihak kami memberitahu pihak tuan bahwa permintaan pembayaran sebesar $@Model.Amount telah selesai dengan sukses dan wang sudah dikirim ke prosesor pembayaran Anda.<br /><br />

                Ini adalah sistem yang dihasilkan otomatis email, harap jangan balas email ini secara langsung.<br />
                Jangan ragu untuk menghubungi kami jika Anda memiliki pertanyaan di <a href="mailto:@Model.MailContact">@Model.MailContact</a><br /> <br />

                Hormat kami,<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)