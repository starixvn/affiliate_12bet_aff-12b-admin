@model Fanex.Affiliate.Admin.Core.DTO.Email.PaymentRequestUpdateEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                @(Model.FirstName) 제휴사님,<br /><br />

                요청 확인 번호는 @(Model.TransId)이며 , @(Model.TransDate)에 요청하셨습니다.<br /><br />

                제휴사님께서 요청하신 @Model.Amount $이 승인되어 처리가 완료되었음을 알려드립니다 상기의 금액은 제휴사님의 지불처리 기관으로 이체 되었습니다.<br /><br />

                본 메일은 시스템 자동 발신메일이므로, 답신의 수신이 불가능합니다.<br />
                의문이나 불편사항은 언제든지 저희에게 연락주시기 바랍니다.<a href="mailto:@Model.MailContact">@Model.MailContact</a><br /> <br />

                감사합니다.<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)