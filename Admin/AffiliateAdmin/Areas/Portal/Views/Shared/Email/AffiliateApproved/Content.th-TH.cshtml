@model Fanex.Affiliate.Admin.Core.DTO.Email.AffApprovedEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                เรียน @Model.FirstName<br /><br />

                ขอแสดงความยินดี ตอนนี้คุณได้เป็นสมาชิกพันธมิตรกับ 12BET เรียบร้อยแล้ว<br /><br />

                เพื่อที่จะได้ช่วยเหลือคุณได้ดีขึ้น กรุณาเข้าไปแจ้งข้อมูลส่วนตัวปัจจุบันของท่าน ร่วมถึงเวปไซค์อื่นอื่นของคุณ (ถ้ามี)<br /><br />

                ในส่วนของบัญชีของฉัน กรุณาแจ้งกับเราทางอีเมลล์ได้ที่ <a href="mailto:@Model.MailContact">@Model.MailContact</a> ถึงเวบไซค์ที่คุณกำลังจะเอาแบนเนอร์เราไปวาง ถ้ามาความจำเป็นต้องการขอแบนเนอร์ในขนาดอื่นอื่น กรุณาแจ้งให้เราทราบเราจะจัดเตรียมให้คุณโดยเร็วที่สุด กรุณารับทราบว่า บัญชีของท่านจะถูกปิด หากแบนเนอร์ของ 12BET ไม่ได้ถูกนำไปวางในเวบไซค์ที่คุณสมัครสมาชิกเข้ามาภายในเวลา 7 วันหลังจากใบสมัครของคุณได้รับการอนุมัติ นอกเสียจากว่าคุณได้แจ้งไว้เป็นลายลักษณ์อักษรกับทางเรา<br /><br />

                เราหวังเป็นอย่างยิ่งว่าคุณจะทำกำไรในการร่วมธุรกิจนี้ได้อย่างมาก <br /><br />

                ขอบคุณ<br /><br />

                ขอแสดงความนับถือ<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)