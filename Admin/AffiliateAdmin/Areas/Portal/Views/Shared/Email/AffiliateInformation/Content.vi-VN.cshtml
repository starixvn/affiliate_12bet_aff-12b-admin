@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                Thân gửi @Model.FirstName,<br /><br />

                Xin chúc mừng! Đơn xét duyệt làm đại lý của bạn hiện đã được phê duyệt. Chúng tôi rất vui mừng được chính thức chào đón bạn với tư cách là Đối tác của 12BET.<br /><br />

                Là Đối tác của chúng tôi, bạn sẽ có quyền truy cập vào nhiều tài liệu và công cụ quảng cáo để giúp bạn thành công. Vui lòng sử dụng thông tin đăng nhập sau để truy cập Tài khoản Đại lý 12BET của bạn:<br /><br />

                Đường link: <a href="@(Model.UserSiteUrl + "/vn")">@Model.UserSiteUrl</a><br />
                Tên người dùng: @Model.UserName<br />
                Mật khẩu: @Model.Password<br /><br />

                Xin lưu ý rằng mật khẩu này là tạm thời và nên được thay đổi sau khi đăng nhập vào tài khoản của bạn lần đầu tiên.<br /><br />

                Có thể yêu cầu hình ảnh có kích thước tùy chỉnh hoặc liên kết có địa chỉ cụ thể, vui lòng liên hệ bộ phận quản lý đại lý để được hỗ trợ. Chúng tôi ở đây để hỗ trợ bạn trong từng bước và đảm bảo rằng bạn có một mối quan hệ hợp tác thành công và xứng đáng với 12BET.<br /><br />

                Trân trọng,<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)