@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                សូមគោរពលោក @(Model.FirstName)!<br /><br />

                អបអរសាទរ! ពាក្យស្នើសុំជាភ្នាក់ងាររបស់អ្នកត្រូវបានអនុម័ត។ យើងមានសេចក្តីរំភើបរីករាយក្នុងការស្វាគមន៍អ្នកក្នុងនាមជាភ្នាក់ងារ 12BET ផ្លូវការ។<br /><br />

                ជាដៃគូរបស់យើង អ្នក​នឹង​មាន​សិទ្ធិ​ប្រើប្រាស់​ការផ្សព្វ​ផ្សាយ​ដោយ​ទូលំទូលាយ​ដើម្បី​ជួយ​អ្នក​ឱ្យ​ជោគជ័យ។ សូមប្រើព័ត៌មានខាងក្រោម ដើម្បីចូលទៅកាន់គណនីភ្នាក់ងារ 12BET របស់អ្នក៖<br /><br />

                តំណភ្ជាប់គេហទំព័រ៖ <a href="@Model.UserSiteUrl">@Model.UserSiteUrl</a><br />
                ឈ្មោះអ្នកប្រើប្រាស់៖ @Model.UserName<br />
                ពាក្យសម្ងាត់៖ @Model.Password<br /><br />

                សូមចំណាំថាពាក្យសម្ងាត់នេះគឺបណ្តោះអាសន្ន ហើយគួរតែត្រូវបានផ្លាស់ប្តូរបន្ទាប់ពីចូលទៅក្នុងគណនីរបស់អ្នកជាលើកដំបូង។<br /><br />

                មិនថាជារូបភាព ទំហំ ឬតំណភ្ជាប់ជាក់លាក់ សូមកុំស្ទាក់ស្ទើរក្នុងការទាក់ទងសម្រាប់ជំនួយណាមួយ។ យើងនៅទីនេះដើម្បីជួយអ្នកគ្រប់ជំហាននៃមធ្យោបាយ និងធានាថាអ្នកក្លាយជាដៃគូដ៏ជោគជ័យ និងជាដៃគូរបស់ 12BET។<br /><br />

                ដោយក្តីគោរពរាប់អាន<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)