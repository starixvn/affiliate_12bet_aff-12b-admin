@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                Dear @Model.FirstName,<br /><br />

                Congratulations! Your Affiliate applcation is now approved. We are thrilled to welcome you offically as a 12BET Affiliate Partner.<br /><br />

                As our Partner you will have access to a variety of marketing resources and tools to help you succeed. Please use the following login information to access your 12BET Affiliate Account:<br /><br />

                Site link: <a href="@(Model.UserSiteUrl + "/jp")">@Model.UserSiteUrl</a><br />
                Username: @Model.UserName<br />
                Password: @Model.Password<br /><br />

                Please note that this password is temporary and should be changed after logging in to your account for the first time.<br /><br />

                Be it a custom sized image or a geo-specific link, do not hesitate to reach out for any assistance. We are here to support you in every step of the way and ensure that you have a successful and rewarding partnership with 12BET.<br /><br />

                Best regards,<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)