@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                เรียนคุณ @Model.FirstName,<br /><br />

                ยินดีด้วย! การสมัครพันธมิตรของคุณได้รับการอนุมัติแล้ว เราตื่นเต้นที่จะได้ต้อนรับคุณอย่างเป็นทางการในฐานะ12BETพันธมิตร<br /><br />

                ในฐานะพันธมิตรของเรา คุณจะสามารถเข้าถึงทรัพยากรและเครื่องมือทางการตลาดที่หลากหลายเพื่อช่วยให้คุณประสบความสำเร็จ โปรดใช้ข้อมูลเข้าสู่ระบบต่อไปนี้เพื่อเข้าถึงบัญชีพันธมิตร12BET ของคุณ:<br /><br />

                ลิงค์เว็บไซต์: <a href="@(Model.UserSiteUrl + "/th")">@Model.UserSiteUrl</a><br />
                Username: @Model.UserName<br />
                Password: @Model.Password<br /><br />

                โปรดทราบว่ารหัสผ่านนี้เป็นรหัสผ่านชั่วคราวและควรเปลี่ยนหลังจากลงชื่อเข้าใช้บัญชีของคุณเป็นครั้งแรก<br /><br />

                ไม่ว่าจะเป็นรูปภาพขนาดกำหนดเองหรือลิงก์เฉพาะทางภูมิศาสตร์ อย่าลังเลที่จะติดต่อขอความช่วยเหลือใดๆ เราพร้อมสนับสนุนคุณในทุกขั้นตอนและรับรองว่าคุณจะประสบความสำเร็จและเป็นหุ้นส่วนที่คุ้มค่ากับ 12BET<br /><br />

                ขอขอบคุณพันธมิตร<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)