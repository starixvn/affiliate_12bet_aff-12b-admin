@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                เรียน @Model.FirstName<br /><br />

                ขอแสดงความยินดี! ใบสมัครพันธมิตรของคุณได้รับการอนุมัติแล้ว เรารู้สึกตื่นเต้นที่ได้ต้อนรับคุณอย่างเป็นทางการในฐานะพันธมิตร 12BET<br /><br />

                ในฐานะพันธมิตรของเรา คุณจะสามารถเข้าถึงแหล่งข้อมูลและเครื่องมือทางการตลาดที่หลากหลายเพื่อช่วยให้คุณประสบความสําเร็จ โปรดใช้รายละเอียดการเข้าสู่ระบบต่อไปนี้เพื่อเข้าสู่บัญชีพันธมิตร 12BET ของท่าน<br /><br />

                🔗 ลิงค์เว็บไซต์: <a href="@(Model.UserSiteUrl + "/th")">@Model.UserSiteUrl</a><br />
                👤 ชื่อผู้ใช้: @Model.UserName<br />
                🔑 รหัสผ่าน: @Model.Password<br />
                (หมายเหตุ: นี่เป็นรหัสผ่านชั่วคราว โปรดเปลี่ยนเมื่อเข้าสู่ระบบครั้งแรกด้วยเหตุผลด้านความปลอดภัย)<br /><br />

                หากคุณต้องการแบนเนอร์ขนาดที่กําหนดเอง ลิงก์เฉพาะ หรือความช่วยเหลืออื่นๆ อย่าลังเลที่จะติดต่อ เราอยู่ที่นี่เพื่อสนับสนุนคุณในทุกขั้นตอนและทําให้แน่ใจว่าคุณมีพันธมิตรที่ประสบความสําเร็จและคุ้มค่ากับ 12BET<br /><br />

                🚀 ติดตามโปรโมชั่นล่าสุด! 🚀<br />
                สําหรับการอัปเดตใหม่และโปรโมชั่นพิเศษสําหรับพันธมิตร 12BET สมัครสมาชิกช่องทาง Telegram ของเรา<br />
                เราหวังว่าจะประสบความสําเร็จในการทํางานร่วมกัน!<br /><br />

                ขอแสดงความนับถือ<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)