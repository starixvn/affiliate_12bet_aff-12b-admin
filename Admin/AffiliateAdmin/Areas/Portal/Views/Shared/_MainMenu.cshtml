@using Fanex.Affiliate.Admin.Core.Constants;
@using Fanex.Affiliate.Admin.Core.Services.Common;
@using System.Collections.Generic;
@using Fanex.Affiliate.Admin.Core.Constants;

@{
    var controllerName = ViewContext.RouteData.Values["Controller"].ToString();
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var permissions = sessionService.ClaimIdentities.SelectMany(i => i.Claims);
    var menus = new Dictionary<string, string>
    {
        {"Home", Function.HomeMenu },
        {"Customer", Function.CustomerMenu },
        {"Affiliate", Function.AffiliateMenu },
        {"Member",Function.MemberMenu },
        {"Report",Function.ReportMenu },
        {"MediaGallery", Function.MediaGalleryMenu },
        {"Message",Function.MessageMenu },
        {"ExchangeRate",Function.ExchangeRateMenu },
        {"AdminRole",Function.AdminRoleMenu },
        {"Domain",Function.DomainMenu }
    };
    var displayMenus = menus.Where(m => {
        if(string.Equals("Affiliate", m.Key, StringComparison.OrdinalIgnoreCase))
        {
            return permissions.Any(p => p.Type == m.Value || p.Type == Function.AffAdjustment || p.Type == Function.ViewLog);
        }

        if(string.IsNullOrEmpty(m.Value) || permissions.Any(p => p.Type == m.Value))
        {
            return true;
        }

        return false;

    }).Select(m => m.Key);
}

@functions{
    public string GetMenuName(string menuKey)
    {
        if (menuKey == "MediaGallery")
        {
            return "Media Gallery";
        }

        if (menuKey == "ExchangeRate")
        {
            return "Exchange Rate";
        }

        if (menuKey == "AdminRole")
        {
            return "Admin Role";
        }

        return menuKey;
    }
}
<ul class="nav menu-list">

    @foreach (var item in displayMenus)
    {
        var active = "nav-link " + (controllerName == item ? "active" : string.Empty);
        <li class="nav-item">
            <a class="@active" id="@item" href="@Url.Content("~/Portal/"+item)">
                @GetMenuName(item)
            </a>
        </li>
    }
</ul>

<script type="text/javascript">
    window.globalVariables = {
        claims: @Html.Raw(permissions.ToJson())
    };
    window.virtualUrl = '@Url.Content("~")';

    let element;

    switch('@controllerName') {
        case 'PaymentRequest':
        case 'CommissionGroup':
        case 'EmailHistory':
        case 'Adjustment':
        case 'ViewLog':
        case 'ProcessingRequest':
            element = document.getElementById('Affiliate');
            break;
        case 'ActiveMember':
        case 'Registered':
            element = document.getElementById('Member');
            break;
        case 'TextList':
        case 'LandingPageList':
        case 'NewsLetter':
            element = document.getElementById('MediaGallery');
            break;
        case 'Department':
            element = document.getElementById('Administrator');
            break;
        case 'Domain':
        case 'DomainControl':
            element = document.getElementById('Domain');
            break;
        case 'AdminRole':
        case 'RolePermission':
            element = document.getElementById('AdminRole');
            break;
    }

    element && element.classList.add("active");
</script>