
@{
    Layout = "~/Areas/Portal/Views/Shared/_ReactPageLayout.cshtml";
}

@model Fanex.Affiliate.Admin.Core.ViewModels.Affiliate.AffiliateFilterViewModel

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/affiliate.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            today: '@DateTime.Now.ToString("MM/dd/yyyy")',
            groupId: @Model.SelectedGroupId,
            param: @Html.Raw(Json.Encode(Model.Param)),
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/affiliate/affiliate.js")"></script>
}