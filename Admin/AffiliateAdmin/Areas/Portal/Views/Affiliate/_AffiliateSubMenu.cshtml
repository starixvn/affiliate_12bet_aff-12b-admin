
@model IEnumerable<Fanex.Affiliate.Admin.Core.DTO.SubMenu>

<div class="sub-menu-container">
    <div class="d-inline-block">
        <img src="~/Areas/Portal/www/dist/imgs/i_affiliateslist.png" />
    </div>
    <div class="d-inline-block">
        <ul class="nav">
            @foreach (var item in Model)
            {
                <li class="nav-item">
                    <a class="nav-link @(item.IsActive? "active" : string.Empty)" href="@item.Url" target="_self">@item.Name</a>
                </li>
            }
        </ul>
    </div>
</div>

