@model Fanex.Affiliate.Admin.Core.ViewModels.MediaGallery.ModuleManagementViewModel

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/media-gallery/module-management.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            moduleTypes: @Html.Raw(Json.Encode(Model.ModuleTypes)),
            navigationTargets: @Html.Raw(Json.Encode(Model.NavigationTargets)),
            existingModules: @Html.Raw(Json.Encode(Model.ExistingModules ?? new List<object>())),
            permissions: {
                canCreate: @Html.Raw(Json.Encode(Model.CanCreate)),
                canEdit: @Html.Raw(Json.Encode(Model.CanEdit)),
                canDelete: @Html.Raw(Json.Encode(Model.CanDelete))
            },
            totalModules: @Model.TotalModules
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/media-gallery/module-management.js")"></script>
}

<div id="module-management-root">
    <!-- React component will be rendered here -->
    <div class="loading-container">
        <div class="loading-spinner"></div>
        <p>Loading Module Management...</p>
    </div>
</div>
