
@{
    Layout = "~/Areas/Portal/Views/Shared/_ReactPageLayout.cshtml";
}

@model Fanex.Affiliate.Admin.Core.ViewModels.AdminRole.AdminInfoViewModel

@{
    Html.RenderPartial("~/Areas/Portal/Views/AdminRole/_AdminRoleSubMenu.cshtml", Model.SubMenuList);
}

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/admin-role/admin-info.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            userId: @Model.UserId,
            userName: '@Model.UserName',
            roleList: @Html.Raw(Json.Encode(Model.RoleList)),
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/admin-role/admin-info.js")"></script>
}