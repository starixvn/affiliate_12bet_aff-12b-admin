@{
    Layout = "~/Areas/Portal/Views/Shared/_ReactPageLayout.cshtml";
}

@model Fanex.Affiliate.Admin.Core.ViewModels.Member.MemberListViewModel

@{
    Html.RenderPartial("~/Areas/Portal/Views/Member/_MemberSubMenu.cshtml", Model.SubMenuList);
}

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/member/member-list.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            param: {
                affName: @Model.AffName,
                isFromOtherPages: @Model.IsFromOtherPages
            }
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/member/member-list.js")"></script>
}