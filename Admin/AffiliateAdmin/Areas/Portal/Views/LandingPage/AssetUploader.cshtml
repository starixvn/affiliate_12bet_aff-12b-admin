@model Fanex.Affiliate.Admin.Core.ViewModels.LandingPage.AssetUploaderViewModel

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/landing-page.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            moduleList: @Html.Raw(Json.Encode(Model.ModuleList)),
            languageList: @Html.Raw(Json.Encode(Model.LanguageList)),
            allLanguagesInSystem: @Html.Raw(Json.Encode(Model.AllLanguagesInSystem)),
            targetCountryList: @Html.Raw(Json.Encode(Model.TargetCountryList)),
            statusList: @Html.Raw(Json.Encode(Model.StatusList)),
            bannerRootUrl:"@Model.BannerRootUrl",
            maximumFiles: @Model.MaximumFiles,
            maxFileSize: @Model.MaxFileSize,
            allowedExtensions: @Html.Raw(Json.Encode(Model.AllowedExtensions)),
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/landing-page.js")"></script>
}