@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/landing-page.css")" rel="stylesheet" />
}

@model Fanex.Affiliate.Admin.Core.ViewModels.LandingPage.FormManagementViewModel

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            formNameList: @Html.Raw(Json.Encode(Model.FormNameList)),
            targetCountryList: @Html.Raw(Json.Encode(Model.TargetCountryList)),
            languageList: @Html.Raw(Json.Encode(Model.LanguageList)),
            statusList: @Html.Raw(Json.Encode(Model.StatusList)),
            bannerRootUrl: "@Model.BannerRootUrl",
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/landing-page.js")"></script>
}