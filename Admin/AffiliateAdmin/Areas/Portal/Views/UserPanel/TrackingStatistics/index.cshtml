
@{
    Layout = "~/Areas/Portal/Views/Shared/_UserPanelLayout.cshtml";
}

@using Fanex.Affiliate.Admin.Core.Constants
@using Fanex.Affiliate.Admin.Core.ViewModels.UserPanel
@model Fanex.Affiliate.Admin.Core.ViewModels.UserPanel.TrackingStatisticsViewModel

@section styles{
}

@section scripts{
    <script type="text/javascript">
        window.initialState = {
            trackingCodeList: @Html.Raw(Json.Encode(Model.TrackingCodeList)),
            param: { AffId: @Model.AffiliateLinkParam.AffId, TrackingCode: '' }
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/userpanel/tracking-statistics.js")"></script>
}

@section menu{
    @{
        var usePanelMenu = new UserPanelMenuViewModel
        {
            SubMenuList = UserPanelConstant.UserPanelMenuList,
            AffiliateLinkParam = Model.AffiliateLinkParam
        };
        usePanelMenu.SubMenuList.ElementAt(5).IsActive = true;
        Html.RenderPartial("~/Areas/Portal/Views/Shared/_UserPanelMenu.cshtml", usePanelMenu);
    }
}

<div id="root"></div>

