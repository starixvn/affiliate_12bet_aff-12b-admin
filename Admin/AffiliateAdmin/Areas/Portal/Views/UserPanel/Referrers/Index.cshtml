
@{
    Layout = "~/Areas/Portal/Views/Shared/_UserPanelLayout.cshtml";
}

@using Fanex.Affiliate.Admin.Core.Constants
@using Fanex.Affiliate.Admin.Core.ViewModels.UserPanel
@using Fanex.Affiliate.Admin.Core.MetaModels.UserPanel
@model Fanex.Affiliate.Admin.Core.ViewModels.UserPanel.ReferrersViewModel

@section styles{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/user-panel/referrers.css")" rel="stylesheet" />
}

@section scripts{
    <script type="text/javascript">
        window.initialState = {
            today: '@DateTime.Now.ToString("MM/dd/yyyy")',
            param: {
                AffId: @Model.ReferrersParam.AffId,
                DeviceType: @Model.ReferrersParam.DeviceType,
                FromDate: '@(Model.ReferrersParam.FromDate.HasValue ? Model.ReferrersParam.FromDate.Value.ToString("MM/01/yyyy") : DateTime.Now.ToString("MM/01/yyyy"))',
                ToDate: '@(Model.ReferrersParam.ToDate.HasValue ? (DateTime.Parse(Model.ReferrersParam.ToDate.Value.ToString("MM/dd/yyyy")) > DateTime.Now ? DateTime.Now.ToString("MM/dd/yyyy") : Model.ReferrersParam.ToDate.Value.ToString("MM/dd/yyyy"))
                            : DateTime.Now.ToString("MM/dd/yyyy"))'
            }
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/userpanel/referrers.js")"></script>
}

@section menu{
    @{
        var affiliateLinkParam = new AffiliateLinkParam
        {
            AffId = Model.ReferrersParam.AffId,
            AffName = Model.ReferrersParam.AffName
        };
        var usePanelMenu = new UserPanelMenuViewModel
        {
            SubMenuList = UserPanelConstant.UserPanelMenuList,
            AffiliateLinkParam = affiliateLinkParam
        };
        usePanelMenu.SubMenuList.ElementAt(8).IsActive = true;
        Html.RenderPartial("~/Areas/Portal/Views/Shared/_UserPanelMenu.cshtml", usePanelMenu);
    }
}

<div class="sub-menu-container">
    <div class="d-inline-block">
        @{
            Html.RenderPartial("~/Areas/Portal/Views/Shared/_SubUserPanelMenu.cshtml", Model.SubMenuList);
        }
    </div>
</div>

<div id="root"></div>

