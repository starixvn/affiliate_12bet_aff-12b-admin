@model Fanex.Affiliate.Admin.Core.ViewModels.Domain.DomainViewModel

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/domain.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            targetCountryList: @Html.Raw(Json.Encode(Model.TargetCountryList)),
            isAffDomain: '@Model.IsAffDomain'.toLowerCase() === 'true',
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/domain.js")"></script>
}