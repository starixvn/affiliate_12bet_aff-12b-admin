@model Fanex.Affiliate.Admin.Core.ViewModels.Operation.OperationViewModel

@using Fanex.Affiliate.Admin.Core.Utilities

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/operation/deal.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            dealTypes: @Html.Raw(Json.Encode(Model.DealTypes)),
            paymentFrequencies:  @Html.Raw(Json.Encode(Model.PaymentFrequencies)),
            deductions: @Html.Raw(Json.Encode(Model.Deductions)),
            targetCountries: @Html.Raw(Json.Encode(Model.TargetCountries)),
            products: @Html.Raw(Json.Encode(Model.Products)),
            defaultCurrency: '@(AppSetting.Instance.DefaultCurrency)',
            tomorrow: '@DateTimeHelper.Gmt8Now.AddDays(1).ToString("MM/dd/yyyy")',
        };
    </script>

    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/operation/deal.js")"></script>
}