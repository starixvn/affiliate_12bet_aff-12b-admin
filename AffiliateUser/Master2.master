<%@ Master Language="C#" AutoEventWireup="true" Inherits="Master2" CodeBehind="Master2.master.cs" %>

<%@ Register Src="~/Controls/Header.ascx" TagName="CHeader" TagPrefix="mod" %>
<%@ Register Src="~/Controls/Footer.ascx" TagName="CFooter" TagPrefix="mod" %>
<%@ Register Src="~/Controls/RightPanel.ascx" TagName="CRight" TagPrefix="mod" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <asp:ContentPlaceHolder ID="Title" runat="server"></asp:ContentPlaceHolder>

    <meta content="text/html;charset=UTF-8" http-equiv="Content-Type" />
    <meta content="width=device-width,initial-scale=1" name="viewport" />

    <style type="text/css">
        .root-header {
            width: 800px;
            padding-bottom: 0px;
        }

        .root-left {
            width: 595px;
            float: left;
            margin-top: 5px;
        }

        .root-right {
            width: 201px;
            float: right;
            margin-top: 5px;
        }

        .root-footer {
            width: 800px;
        }

        .clear {
            clear: both;
        }
    </style>
    <script type="text/javascript">
        var Site = Site || {};
        function init() {
            Site.rootUrl = document.getElementById("rootUrl").value;
        }

        if (window.addEventListener)
            window.addEventListener("load", init, true);
        else
            window.onload = init;
    </script>
</head>
<body class="<%=langClass%>">
    <input type="hidden" id="rootUrl" value="<%=rootUrl%>" />
    <div style="background-color: White">
        <%=strScript.ToString()%>
    </div>
    <div id="container">
        <mod:CHeader runat="server" ID="Header1" />
        <div id="contents_page">
            <div id="contents_main">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
            <div id="right_pane">
                <mod:CRight runat="server" ID="Right1" />
            </div>
        </div>
        <div class="clear"></div>
        <div id="footer">
            <mod:CFooter runat="server" ID="Footer1" />
        </div>
        <div class="red_line"></div>
    </div>

    <% if (AppSettings.Environment.Equals("UAT", StringComparison.OrdinalIgnoreCase) || AppSettings.Environment.Equals("PRODUCTION", StringComparison.OrdinalIgnoreCase))
        { %>
    <!-- Google Analytics -->
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-5160706-44"></script>
    <script type="text/javascript">
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'UA-5160706-44');

        var bannerSignup = document.getElementById("bannerSignup");
        bannerSignup.addEventListener("click", function (event) {
            event.preventDefault();
            gtag('event', 'AffJoinJuly40Com-<%=Common.ConvertSpecialLanguageCode().ToUpper() %>', {
                'event_category': 'AFFiliatePage',
                'event_label': 'AFFBigBanner'
            });

            setTimeout(function () {
                window.location.href = '<%=ResolveUrl("Signup.aspx")%>';
            }, 10);
        });

        var bannerMedia = document.getElementById("bannerMedia");
        bannerMedia.addEventListener("click", function (event) {
            event.preventDefault();

            gtag('event', 'AffNewSeasonMedia-<%=Common.ConvertSpecialLanguageCode().ToUpper() %>', {
                'event_category': 'AFFiliatePage',
                'event_label': 'AFFBigBanner'
            });

            setTimeout(function () {
                window.location.href = '<%=ResolveUrl("UserInfo/MediaGalleryNew.aspx")%>';
            }, 10);
        });
    </script>
    <!-- End Google Analytics -->
    <% } %>
</body>
</html>