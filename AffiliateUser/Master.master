<%@ Master Language="C#" AutoEventWireup="true" Inherits="Master" Codebehind="Master.master.cs" ClientIDMode="Static" %>
<%@ Register Src="~/Controls/Header.ascx" TagName="CHeader" TagPrefix="mod" %>
<%@ Register Src="~/Controls/Footer.ascx" TagName="CFooter" TagPrefix="mod" %>
<%@ Register Src="~/Controls/RightPanel.ascx" TagName="CRight" TagPrefix="mod" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>12BET Affiliate Program</title>
    <meta content="text/html;charset=UTF-8" http-equiv="Content-Type" />
    <style type="text/css">
         .root-header{
            width:800px;
            padding-bottom:0px;
        }
        .root-left{
            width:595px;         
            float:left;   
            margin-top:5px;         
        }
        .root-right{
            width:201px;           
            float:right;    
            margin-top:5px;        
        }
        .root-footer
        {
            width:800px;
        }
        .clear{
            clear:both;            
        }

        .icon-collapse{
            float: right;
            margin-right: 5px;
        }
        
    </style>
   <script type="text/javascript">
    var a = "bgwhite", b = "bgcgy", c = "bghover";
    var Site = Site || {};    
    function init() {
        Site.rootUrl = document.getElementById("rootUrl").value;
    }

    if (window.addEventListener) 
        window.addEventListener("load", init, true);
    else 
        window.onload = init;

    </script>
</head>
<body class="<%=langClass%>">
    <input type="hidden" id="rootUrl" value="<%=rootUrl%>"/>

    <div style="background-color:White">
        <%=strScript.ToString()%>
    </div>
   <div id="container">        
        <mod:CHeader runat="server" ID="Header1" />        
        <div id="contents_page" style="float: left;">
            <div id="contents_main">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
                <div id="dv_collapse_expand" class="icon-collapse">
                    <a href="#" style="width:5px;height:220px;" onclick="OnExpandView();">
                       <img runat="server" src="~/App_Themes/Default/Images/expand-ico.png" id="imgRightPanel" /> 
                    </a> 
                </div>
            </div>
            <div id="right_pane" style="display:block;float: right;">
                <mod:CRight runat="server" ID="Right1" />
            </div>
        </div>
        <div class="clear"></div>
        <div id="footer">
            <mod:CFooter runat="server" ID="Footer1" />
        </div>
        <div class="red_line"></div>
    </div>
    <script type="text/javascript">
        var contentDivHeight = document.getElementById("right_pane").offsetHeight;
        document.getElementById("dv_collapse_expand").setAttribute("style", "margin-top:" + (contentDivHeight/2 - 13) + "px");
        function OnExpandView() {
            if (document.getElementById("right_pane")) {
                if (document.getElementById("right_pane").style.display == 'none') {
                    document.getElementById("right_pane").style.display = 'block';
                    document.getElementById("contents_main").setAttribute("style", "width:644px");
                    document.getElementById("contents").setAttribute("style", "width:627px");
                    document.getElementById("imgRightPanel").src = Site.rootUrl + '/App_Themes/Default/Images/expand-ico.png';
                }
                else {
                    document.getElementById("right_pane").style.display = 'none';                    
                    document.getElementById("contents_main").setAttribute("style", "width:918px");
                    document.getElementById("contents").setAttribute("style", "width:901px");
                    document.getElementById("imgRightPanel").src = Site.rootUrl + '/App_Themes/Default/Images/collapse-ico.png';
                }
            }
        }
    </script>
    <% if (AppSettings.Environment.Equals("PRODUCTION", StringComparison.OrdinalIgnoreCase))
       { %>
    <!-- Piwik -->
    <script type="text/javascript">
        var _paq = _paq || [];
        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
        (function () {
            var u = "https://pw.detecas.com/";
            _paq.push(['setTrackerUrl', u + 'piwik.php']);
            _paq.push(['setSiteId', 27]);
            var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
            g.type = 'text/javascript'; g.async = true; g.defer = true; g.src = u + 'piwik.js'; s.parentNode.insertBefore(g, s);
        })();
    </script>
    <noscript><p><img src="https://pw.detecas.com/piwik.php?idsite=27" style="border:0;" alt="" /></p></noscript>
    <!-- End Piwik Code -->
    <% } %>
</body>
</html>
