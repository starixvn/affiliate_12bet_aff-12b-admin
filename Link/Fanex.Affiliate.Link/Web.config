<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="PreserveLoginUrl" value="true" />
    <add key="RemovePortFromUrl" value="0" />
    <add key="Redirect_home_pattern" value="/#language#" />
    <!--Sentry-->
    <add key="SentryBackEndDsn" value="http://3124a8c9c1cb47deb80da635d7337340@sentry.nexdev.net/25" />
    <add key="IsRegisterSentry" value="true" />
    <add key="LoggingCategory" value="Aff-12B-Link-DEV" />
    <add key="Environment" value="LOCAL" />
    <!--UM-->
    <add key="ONEbook.UM:ServiceUri" value="https://onebookum-dev.nexdev.net/api" />
    <add key="ONEbook.UM:EnableCheckUM" value="true" />
    <add key="ONEbook.UM:SiteId" value="2000003" />
    <add key="ONEbook.UM:EnableUnscheduledUM" value="false" />
    <add key="ONEbook.UM:UMFrom" value="1:00" />
    <add key="ONEbook.UM:UMTo" value="23:00" />
    <add key="ONEbook.UM:UMPageUrl" value="~/UnderMaintenance" />
    <add key="ONEbook.UM:ResultCacheDuration" value="60" />
    <add key="ONEbook.UM:UMLoggingCategory" value="ONEbook-12B-Link-UM" />
    <add key="ONEbook.UM:ErrorUMPageUrl" value="" />
    <!--Campaign Marketing-->
    <add key="MarketingForCommGroups" value="NoCommission,NoCommission-Marketing group" />
    <add key="MarketingPageCodeRegexPatterns" value="[a-z]{3}-12join\w*" />
	<add key="MarketingForCPACommGroups" value="NoCommission-CPA" />
    <!--Config Vault-->
    <add key="StoredProcedurePath" value="App_Data\SpNames.xml" />
    <add key="FanexDataServiceApi" value="http://fanexdataservices.nexdev.net" />
    <add key="VaultOptions:Address" value="https://vault.nexdev.net" />
    <add key="VaultOptions:Role" value="23416adb-5e11-25dd-2b39-4c226ef1361b" />
    <add key="VaultOptions:SecretId" value="ec68db9d-38fc-568c-6852-8868f18eb50b" />
    <add key="VaultOptions:MountPath" value="pontus" />
    <add key="VaultOptions:Enable" value="true" />
    <add key="VaultOptions:MinutesPolling" value="1" />
  </appSettings>
  <connectionStrings>
    <add name="DBAFF12B.Affiliate_12B.wsv_afinet" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.18.200.58;Initial Catalog=Affiliate_12B;integrated security=false; user id=; password=; trustservercertificate=true;" />
    <add name="DBAFF12B.Affiliate_12B.wsv_afinetv" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.18.200.58;Initial Catalog=Affiliate_12B;integrated security=false; user id=; password=; trustservercertificate=true;" />
  </connectionStrings>
