<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.2.98.3\private$\entlib" defaultCategory="Affiliate-12Bet" xdt:Transform="Replace" />
  
  <system.web>
    <authentication mode="Forms">
      <forms loginUrl="~/Home/Index" timeout="20" cookieless="UseCookies" path="/" defaultUrl="~/UserPanel/Main/#AccountOverview" name="Fanex.AffEuroUserForm" slidingExpiration="true" protection="All" xdt:Transform="Replace"/>
    </authentication>
    <sessionState mode="StateServer" stateConnectionString="tcpip=10.2.98.3:42424" cookieName="Fanex.AffEuroUserSession" cookieless="UseCookies" timeout="20" xdt:Transform="Replace" />
  </system.web>

  <ONEbook.UM ServiceUris="http://10.2.98.3:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="2:00" UMTo="3:00" SiteId="32" UMPageUrl="~/Notify/UnderMaintenance" xdt:Transform="Replace">
    <AllowedIPs AllowAll="true">
    </AllowedIPs>
  </ONEbook.UM>
</configuration>