<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.35.35.253\private$\entlib" defaultCategory="Affiliate-12Bet-LOCAL" xdt:Transform="Replace" />
  
  <system.web>
    <compilation xdt:Transform="Remove" />
    <customErrors mode="Off" xdt:Transform="SetAttributes(mode)" />

    <authentication mode="Forms">
      <forms loginUrl="~/Home/Index" timeout="60" cookieless="UseCookies" path="/" defaultUrl="~/UserPanel/#AccountOverview" name="Fanex.AffAsiaUserForm" slidingExpiration="true" protection="All" xdt:Transform="Replace" />
    </authentication>
  </system.web>
</configuration>