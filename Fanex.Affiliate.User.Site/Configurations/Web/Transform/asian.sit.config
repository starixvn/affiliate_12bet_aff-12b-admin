<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:172.16.4.106\private$\entlib" defaultCategory="Affiliate-12Bet-SIT" xdt:Transform="Replace" />
  
  <system.web>
    <compilation xdt:Transform="Remove" />
    <customErrors mode="Off" xdt:Transform="SetAttributes(mode)" />

    <authentication mode="Forms">
      <forms loginUrl="~/Home/Index" timeout="60" cookieless="UseCookies" path="/" defaultUrl="~/UserPanel/#AccountOverview" name="Fanex.AffAsiaUserForm" slidingExpiration="true" protection="All" xdt:Transform="Replace"/>
    </authentication>
  </system.web>

  <ONEbook.UM ServiceUris="http://10.18.200.124:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="2:00" UMTo="3:00" SiteId="32" UMPageUrl="~/UnderMaintenance.aspx" xdt:Transform="Replace">
    <AllowedIPs AllowAll="true">
    </AllowedIPs>
  </ONEbook.UM>

  <sessionState mode="StateServer" stateConnectionString="tcpip=172.16.4.106:42424" cookieless="false" timeout="60" xdt:Transform="Replace"/>
</configuration>