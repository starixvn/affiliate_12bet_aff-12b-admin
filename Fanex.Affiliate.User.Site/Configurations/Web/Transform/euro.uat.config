<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <Fanex.Logging msmqPath="FormatName:DIRECT=http://10.40.40.22/msmq/Private$/entlib" defaultCategory="Affiliate-12Bet-UAT" xdt:Transform="Replace" />

  <system.web>
    <customErrors mode="RemoteOnly" xdt:Transform="SetAttributes(mode)" />

    <authentication mode="Forms">
      <forms loginUrl="~/Home/Index" timeout="60" cookieless="UseCookies" path="/" defaultUrl="~/UserPanel/#AccountOverview" name="Fanex.AffEuroUserForm" slidingExpiration="true" protection="All" xdt:Transform="Replace" />
    </authentication>
  </system.web>

  <ONEbook.UM ServiceUris="http://10.40.40.22:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="01:00" UMTo="23:00" SiteId="32" UMPageUrl="~/Notify/UnderMaintenance" xdt:Transform="Replace">
    <AllowedIPs AllowAll="true">
    </AllowedIPs>
  </ONEbook.UM>

  <sessionState mode="StateServer" stateConnectionString="tcpip=10.2.106.12:42424" cookieless="false" timeout="60" xdt:Transform="Replace" />

  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="AffiliateAPISoap" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://10.2.106.12:8008/AffiliateAPI.asmx"
        binding="basicHttpBinding" bindingConfiguration="AffiliateAPISoap"
        contract="BetListWebService.AffiliateAPISoap" name="AffiliateAPISoap" xdt:Transform="Replace" />
    </client>
  </system.serviceModel>
</configuration>