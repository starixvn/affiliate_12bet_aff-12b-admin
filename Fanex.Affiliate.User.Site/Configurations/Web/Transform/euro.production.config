<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <Fanex.Logging msmqPath="FormatName:DIRECT=http://10.40.40.22/msmq/Private$/entlib" defaultCategory="Affiliate-12Bet" xdt:Transform="Replace" />

  <system.web>
    <compilation debug="false" xdt:Transform="SetAttributes(debug)" />
    <customErrors mode="RemoteOnly" xdt:Transform="SetAttributes(mode)" />

    <authentication mode="Forms">
      <forms loginUrl="~/Home/Index" timeout="60" cookieless="UseCookies" path="/" defaultUrl="~/UserPanel/#AccountOverview" name="Fanex.AffEuroUserForm" slidingExpiration="true" protection="All" xdt:Transform="Replace" />
    </authentication>

    <sessionState mode="StateServer" stateConnectionString="tcpip=10.2.106.76:42424" cookieless="UseCookies" timeout="60" xdt:Transform="Replace" />
  </system.web>

  <ONEbook.UM ServiceUris="http://10.40.40.22:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="2:00" UMTo="3:00" SiteId="32" UMPageUrl="~/Notify/UnderMaintenance" xdt:Transform="Replace">
    <AllowedIPs AllowAll="true">
    </AllowedIPs>
  </ONEbook.UM>

  <machineKey validationKey="64D21FCA5269EFEB37837FC99120D3E401A713A8403986012BCA553B83C65C9DE97F16D209BA63D18CD4F185339FD48DAA6D1BACEEB343EB30B119C53A6AF007" decryptionKey="80AA51D581B35058D5D3E0CB10D91501F8453BCF8D4ECE85076A7ED844228713" validation="SHA1" decryption="AES" xdt:Transform="InsertAfter(/configuration/system.web/sessionState)" />

  <applicationSettings>
    <AffiliateUser.Properties.Settings>
      <setting name="AffiliateUser_MemberInfoService_Service" serializeAs="String">
        <value xdt:Transform="Replace">http://kraf.86812868.com:8010/service.asmx</value>
      </setting>
    </AffiliateUser.Properties.Settings>
  </applicationSettings>

  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="AffiliateAPISoap" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://10.2.106.76:8084/AffiliateAPI.asmx"
        binding="basicHttpBinding" bindingConfiguration="AffiliateAPISoap"
        contract="BetListWebService.AffiliateAPISoap" name="AffiliateAPISoap" xdt:Transform="Replace" />
    </client>
  </system.serviceModel>
</configuration>