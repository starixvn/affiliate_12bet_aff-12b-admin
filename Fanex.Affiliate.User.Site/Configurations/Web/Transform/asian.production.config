  <ONEbook.UM ServiceUris="http://10.40.40.22:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="2:00" UMTo="3:00" SiteId="32" UMPageUrl="~/UnderMaintenance.aspx" xdt:Transform="Replace">
    <AllowedIPs AllowAll="true">
    </AllowedIPs>
  </ONEbook.UM>

  <machineKey validationKey="7E779348FAFD2288D5451AD5C8B4F55A52E9113B680ECBC9388A8CB4D972F77BB0DA05EA083C61D31B99F19D087C9289ED1F7F1866A8C3A73B998F07B453BA9F" decryptionKey="4A31304B1041D93931FB6DEDE4C9910C1600EDFE5859D5788755A6A319B45408" validation="SHA1" decryption="AES" xdt:Transform="InsertAfter(/configuration/system.web/sessionState)" />
  <sessionState mode="StateServer" stateConnectionString="tcpip=10.2.106.76:42424" cookieless="UseCookies" timeout="60" xdt:Transform="Replace"/>

  <applicationSettings>
    <AffiliateUser.Properties.Settings>
      <setting name="AffiliateUser_MemberInfoService_Service" serializeAs="String">
