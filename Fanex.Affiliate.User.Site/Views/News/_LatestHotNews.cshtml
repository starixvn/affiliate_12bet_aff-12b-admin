@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.LatestHotNewViewModel

@{
    var selectedHotNews = Model.SelectedHotNews;
    if (!string.IsNullOrEmpty(selectedHotNews))
    {
        if (Model.IsImportant)
        {
            var url = Model.IsAuthenticated ? Url.Action("MessageHistory", "News") : "javascript:;";
            <a href="@url" style="color: #ff0000">@HttpUtility.HtmlDecode(selectedHotNews)</a>
        }
        else
        {
            @HttpUtility.HtmlDecode(selectedHotNews)
        }
    }
}