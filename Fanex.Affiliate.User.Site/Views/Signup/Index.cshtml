@{
    ViewBag.Title = Lang.SignUp;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.RegisForm</span>
    </div>

    <div>
        <p>Please complete this form to register for your 12BET affiliate account.</p>
        <p>Fields marked * must be completed</p>
    </div>

    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.ContactInfo</span>
        </div>

        <div class="form-horizontal">
            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.FName</label>
                <div class="col-sm-4">
                    <input class="form-control" type="text" value="First Name" />
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.LName</label>
                <div class="col-sm-4">
                    <input class="form-control" type="text" value="Last Name" />
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.Gender</label>
                <div class="col-sm-4">
                    <label class="radio-inline">
                        <input type="radio" name="Gender" id="male" value="male" checked /> @Lang.Male
                    </label>
                    <label class="radio-inline">
                        <input type="radio" name="Gender" id="female" value="female" /> @Lang.Female
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.Email</label>
                <div class="col-sm-4">
                    <input class="form-control" type="text" value="Email" />
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.ReEmail</label>
                <div class="col-sm-4">
                    <input class="form-control" type="text" value="Verify Email" />
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.ContactNumber</label>
                <div class="col-sm-4">
                    <input class="form-control" type="text" value="Contact Number" />
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.Mobile</label>
                <div class="col-sm-4">
                    <input class="form-control" type="text" value="MSN" />
                </div>
            </div>
        </div>
    </div>

    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.MailingInfor</span>
        </div>

        <div class="form-horizontal">
            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.Address</label>
                <div class="col-sm-4">
                    <input class="form-control" type="text" value="Address" />
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.City</label>
                <div class="col-sm-4">
                    <input class="form-control" type="text" value="City" />
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.PostCode</label>
                <div class="col-sm-4">
                    <input class="form-control" type="text" value="Post code" />
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.Country</label>
                <div class="col-sm-4">
                    <select class="form-control">
                        <option>English</option>
                        <option>Albania</option>
                        <option>Tiếng Việt</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.WebsiteInformat</span>
        </div>

        <div class="form-horizontal">
            <div class="form-group">
                <div class="col-sm-4">
                    <label class="radio-inline">
                        <input type="radio" name="HasWebSite" id="hasWebSite" checked /> @Lang.OwnWebsite
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.WebsiteURL</label>
                <div class="col-sm-4">
                    <input class="form-control" type="text" value="http://10.19.10.46:5005/xook.html" />
                </div>
                <div class="col-sm-1">
                    <button type="button" class="btn btn-submit">@Lang.AddUrl</button>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.WebsiteURL 2</label>
                <div class="col-sm-4">
                    <input class="form-control" type="text" value="http://10.19.10.46:5005/xook.html0W45pz4p" />
                </div>
                <div class="col-sm-1">
                    <button type="button" class="btn btn-submit">@Lang.Del</button>
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-4">
                    <label class="radio-inline">
                        <input type="radio" name="HasWebSite" id="hasNoWebSite" /> @Lang.NoWebsite
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.DescWebsite</label>
                <div class="col-sm-4">
                    <textarea class="form-control" rows="5"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.Preference</span>
        </div>
        <div class="form-horizontal">
            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.Language</label>
                <div class="col-sm-4">
                    <select class="form-control">
                        <option>English</option>
                        <option>Indonesia</option>
                        <option>Tiếng Việt</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.lblSecureQuestion</label>
                <div class="col-sm-4">
                    <select class="form-control">
                        <option>A</option>
                        <option>B</option>
                        <option>C</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.lblYourAnswer</label>
                <div class="col-sm-4">
                    <input class="form-control" type="text" value="Answer" />
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.Validation</label>
                <div class="col-sm-4">
                    <input class="form-control" type="text" value="Validation" />
                </div>

                <div class="col-sm-2 captcha">
                    <span class="captcha-value">4074</span>
                </div>
            </div>
        </div>
    </div>

    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.PaymentInfor</span>
        </div>
        <div class="form-horizontal">
            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.PaymentMethod</label>
                <div class="col-sm-3">
                    <label class="radio-inline">
                        <input type="radio" checked /> @Lang._12BETPlayerAcc
                    </label>
                </div>

                <label class="col-sm-2 control-label require">@Lang.Username</label>
                <div class="col-sm-3">
                    <input class="form-control" type="text" value="UserName" />
                </div>
            </div>

            <div class="form-group">
                <div class="checkbox col-lg-offset-3">
                    <label>
                        <input type="checkbox" /> @Lang.IagreetotheTerm
                    </label>
                </div>
            </div>

            <div class="col-sm-offset-3">
                <button class="btn btn-submit" type="button">Submit</button>
                <button class="btn btn-submit" type="button">Cancel</button>
            </div>
        </div>
    </div>
</div>
