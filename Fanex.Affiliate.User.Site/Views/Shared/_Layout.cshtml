@using Fanex.Affiliate.User.Core.CoreService
@using Fanex.Affiliate.User.Core.Constants
@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var userSession = sessionService.UserSession;
    var languageDictionary = SystemLanguage.LanguageNameByCode;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(string.IsNullOrEmpty(ViewBag.Title) ? Lang._12BET + " " + Lang.Affiliate : ViewBag.Title)</title>

    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,500,600" rel="stylesheet">
    <link rel="stylesheet" href="http://cdn.materialdesignicons.com/2.1.19/css/materialdesignicons.min.css">
    <link href="~/www/build/styles/css/bootstrap.css" rel="stylesheet" />
    <link href="~/www/build/styles/css/main.css" rel="stylesheet" />
    @RenderSection("styles", required: false)
</head>
<body>
    <div class="header-top">
        <div class="container-fluid">
            <div class="row">
                <div class="col-xs-12 col-md-5 logo">
                    <a href="~/"><img src="@Url.Content("~/www/build/styles/Images/logo.png")" /><span class="logo-text">@Lang.Affiliate</span></a>
                </div>
                <div class="col-sm-12 col-md-7">
                    <div class="user-signup">
                        <div class="sign-up">
                            <a href="@Url.Action("Index", "Signup")" class="btn btn-signup"><span class="icon mdi mdi-pencil"></span>@Lang.SignUp</a>
                        </div>

                        <div class="language-container">
                            <div class="language-selection">
                                <p id="selectedLanguage">
                                    <span><i class="flag flag-@sessionService.CurrentLanguage"></i>@(languageDictionary[sessionService.CurrentLanguage])</span>
                                    <i class="caret"></i>
                                </p>
                            </div>
                            <div class="language-list-wrapper" id="languageList" style="display: none;">
                                <ul class="list-unstyled language-list">
                                    @foreach (var language in languageDictionary)
                                    {
                                        <li>
                                            <a href="javascript:;" class="language-item" data-option="@language.Key"><i class="flag flag-@language.Key"></i>@language.Value</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="user-login" id="userLogin">
                        @if (userSession != null)
                        {
                            <a href="@(Url.Action("Index", "UserPanel") + "/#MyAccount")" class="btn btn-signup"><span class="icon mdi mdi-account-circle"></span>@Lang.MyAcc @userSession.UserName</a>
                            <a href="@Url.Action("SignOut", "Auth")" class="btn btn-login">@Lang.Logout</a>
                        }
                        else
                        {
                            <input class="text-field" id="txtUsername" type="text" placeholder="@Lang.Username" />
                            <input class="text-field" id="txtPassword" type="password" placeholder="@Lang.Password" />
                            <input class="text-field validation" id="txtValidation" type="text" placeholder="Validation" />
                            <div class="validation-value"><img src="" alt="captcha" id="captchaImg" /></div>
                            <a class="btn btn-forgot" title="@Lang.ForgetPassword" href="@Url.Action("Index", "ForgetPass")">
                                <span class="mdi mdi-account-key"></span>
                            </a>
                            @Html.AntiForgeryToken()
                            if (ViewBag.KeyString != null && ViewBag.IVString != null)
                            {
                                @Html.Hidden("KeyString", ViewBag.KeyString as string)
                                @Html.Hidden("IVString", ViewBag.IVString as string)
                            }
                            <button class="btn btn-login" id="btnLogin" type="button">@Lang.Login</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="header-bottom">
        <div class="navbar">
            <!-- Brand and toggle get grouped for better mobile display -->
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1" aria-expanded="false">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
            </div>
            <div class="collapse navbar-collapse menu" id="bs-example-navbar-collapse-1">
                <ul class="nav navbar-nav list-unstyled">
                    <li><a class="menu-item active" href="@Url.Action("Index", "Home")">@Lang.Home</a></li>
                    <li><a class="menu-item" href="@Url.Action("Index", "CommissionStructure")">@Lang.CommissionStructure</a></li>
                    <li><a class="menu-item" href="@Url.Action("Index", "Product")">@Lang.Product</a></li>
                    <li><a class="menu-item" href="@Url.Action("Index", "Promotion")">@Lang.Promotion</a></li>
                    <li><a class="menu-item" href="@Url.Action("Index", "FAQ")">@Lang.Faqs</a></li>
                    <li><a class="menu-item" href="@Url.Action("Index", "ContactUs")">@Lang.ContactUs</a></li>
                </ul>
            </div>
        </div>
        <div class="hot-news">
            <div class="title">@Lang.HotNews</div>
            <div class="message">Enter your content</div>
        </div>
    </div>

    <div class="main-container">
        @RenderBody()
    </div>

    <div class="footer">
        <div class="container">
            <div class="row">
                <div class="col-sm-12 footer-img">
                    <div class="img-top">
                        <a class="item" href="#">
                            <img src="@Url.Content("~/www/build/styles/Images/footer/cr-rank-sponsors.png")" alt="cr-rank-sponsors-logo" />
                        </a>
                    </div>
                    <div class="img-bottom">
                        <a class="item" href="#">
                            <img src="@Url.Content("~/www/build/styles/Images/footer/cr-18.png")" alt="cr-18-logo" />
                        </a>
                        <a class="item" href="#">
                            <img src="@Url.Content("~/www/build/styles/Images/footer/cr-gamleaware.png")" alt="cr-gamleaware-logo" />
                        </a>
                        <a class="item" href="#">
                            <img src="@Url.Content("~/www/build/styles/Images/footer/cr-cagayan.png")" alt="cr-cagayan-logo" />
                        </a>
                        <a class="item" href="#">
                            <img src="@Url.Content("~/www/build/styles/Images/footer/cr-tst.png")" alt="cr-tst-logo" />
                        </a>
                        <a class="item" href="#">
                            <img src="@Url.Content("~/www/build/styles/Images/footer/cr-thawte.png")" alt="cr-thawte-logo" />
                        </a>
                        <a class="item" href="#">
                            <img src="@Url.Content("~/www/build/styles/Images/footer/cr-playtech.png")" alt="cr-playtech-logo" />
                        </a>
                        <a class="item" href="#">
                            <img src="@Url.Content("~/www/build/styles/Images/footer/cr-safe&secure.png")" alt="cr-safe&secure-logo" />
                        </a>
                    </div>
                </div>
                <div class="col-sm-12 footer-text">
                    © Copyright 2018. All Rights Reserved. Designed and Powered by <span class="text-red">12BET.com</span>
                </div>
            </div>
        </div>
    </div>

    <input type="hidden" id="RootUrl" value="@Url.Content("~")" />

    <script src="~/www/build/js/lib/jquery-3.3.1.min.js"></script>
    <script src="~/www/build/js/lib/bootstrap.min.js"></script>
    <script src="~/www/build/js/layout.min.js"></script>
    <script src="~/www/build/js/site.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>