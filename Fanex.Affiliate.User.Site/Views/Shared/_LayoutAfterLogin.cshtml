@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    @RenderSection("styles", required: false)
}

@section scripts{
    @RenderSection("scripts", required: false)
}

<div class="main after-login">
    <div class="content-menu">
        <ul class="menu list-unstyled" id="mainMenu">
            <li><a class="menu-item" id="menuAccountOverView" href="@(Url.Action("Index", "UserPanel") + "/#AccountOverView")">@Lang.AccOverview</a></li>
            <li><a class="menu-item" id="menuStatementHistory" href="@(Url.Action("Index", "UserPanel") + "/#StatementHistory")">@Lang.StatementHistory</a></li>
            <li><a class="menu-item" id="menuMyAccount" href="@(Url.Action("Index", "UserPanel") + "/#MyAccount")">@Lang.MyAcc</a></li>
            <li><a class="menu-item" id="menuPaymentRequest" href="@(Url.Action("Index", "UserPanel") + "/#PaymentRequest")">@Lang.PaymentRequest</a></li>
            <li>
                <a class="menu-item parent" href="javascript:;">Marketing Tools <i class="caret"></i></a>
                <ul class="menu submenu-container list-unstyled">
                    <li><a class="menu-item" id="menuMediaGallery" href="@(Url.Action("Index", "UserPanel") + "/#MediaGallery")">@Lang.Media</a></li>
                    <li><a class="menu-item" id="menuTextBox" href="@(Url.Action("Index", "UserPanel") + "/#TextBox")">@Lang.Text</a></li>
                </ul>
            </li>
            <li>
                <a class="menu-item parent" href="javascript:;">Statistics <i class="caret"></i></a>
                <ul class="menu submenu-container list-unstyled">
                    <li><a class="menu-item" id="menuTrackingStatistics" href="@(Url.Action("Index", "UserPanel") + "/#TrackingStatistics")">@Lang.TrackingStatistics</a></li>
                    <li><a class="menu-item" id="menuReferrersStatistics" href="@(Url.Action("Index", "UserPanel") + "/#ReferrersStatistics")">@Lang.Referrals</a></li>
                    <li><a class="menu-item" id="menuLandingPageStatistics" href="@(Url.Action("Index", "UserPanel") + "/#LandingPageStatistics")">@Lang.LandingPages</a></li>
                </ul>
            </li>
        </ul>
    </div>

    <div class="main-content">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </div>
</div>