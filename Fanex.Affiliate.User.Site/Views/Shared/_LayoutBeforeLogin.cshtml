@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    @RenderSection("styles", required: false)
}

@section classNav{page-container}

@section scripts{
    <script>
        var validationMessage = {
            enterUserName: '@Lang.ErrmsgEntryUsername',
            enterPassword: '@Lang.ErrmsgEntryPassword',
            enterValidationCode: '@Lang.ErrmsgEntryValidCode'
        }
    </script>

    @Html.InlineScripts("~/www/build/js/login.js")
    @RenderSection("scripts", required: false)
}

<div class="main">
    <div class="banner-side banner-left">
        <picture>
            <source srcset="~/www/build/styles/Images/bgLeft.webp" type="image/webp" />
            <source srcset="~/www/build/styles/Images/bgLeft.jpg" type="image/jpeg" />
            <img src="~/www/build/styles/Images/bgLeft.jpg" alt="banner-left" />
        </picture>
    </div>

    <div class="page-container">
        @RazorHelper.RenderHotNews()
        @RenderBody()
    </div>

    <div class="banner-side banner-right">
        <picture>
            <source srcset="~/www/build/styles/Images/bgRight.webp" type="image/webp" />
            <source srcset="~/www/build/styles/Images/bgRight.jpg" type="image/jpeg" />
            <img src="~/www/build/styles/Images/bgRight.jpg" alt="banner-right" />
        </picture>
    </div>
</div>

<div class="modal fade login-dialog" tabindex="-1" role="dialog" id="loginDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-banner">
                <img src="~/www/build/styles/Images/logo.png" alt="logo" />
                <h2 class="logo-text">AFFILIATE PROGRAM</h2>
            </div>

            <div class="modal-main-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h3 class="modal-title">AFFILIATE LOGIN</h3>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h3 class="title-left">Not Affiliate Member Yet?</h3>
                            <p>Sign up to affiliate program and earn up to 40% monthly commission!</p>
                            <a href="@Url.Content("~/Signup/Index")" role="button" class="btn btn-submit btn-block text-uppercase">JOIN NOW!</a>
                        </div>

                        <div class="col-md-6 login-side" id="dialogUserInput">
                            <h3 class="title-right">Welcome back!</h3>
                            <div class="form-group">
                                <input type="text" id="dialogtxtUsername" class="form-control" placeholder="@Lang.Username" />
                            </div>
                            <div class="form-group">
                                <input type="password" id="dialogtxtPassword" class="form-control" placeholder="@Lang.Password" />
                            </div>
                            <div class="form-group">
                                <input type="text" id="dialogtxtValidation" class="form-control captcha-input" placeholder="Validation" />
                                <div class="validation-value">
                                <img src="" alt="captcha" id="loginDialogcaptchaImg" /></div>
                            </div>

                            <button type="button" id="btnDialogLogin" class="btn btn-submit btn-block text-uppercase">@Lang.Login</button>
                            <a href="@Url.Content("~/Password/Index")" class="link-login-popup">> Forgot Login Details ?</a>
                        </div>
                    </div>
                </div>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->