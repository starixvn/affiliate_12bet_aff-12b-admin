@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    @RenderSection("styles", required: false)
}

@section scripts{
    <script>
        var validationMessage = {
            enterUserName: '@Lang.ErrmsgEntryUsername',
            enterPassword: '@Lang.ErrmsgEntryPassword',
            enterValidationCode: '@Lang.ErrmsgEntryValidCode'
        }
    </script>

    @Html.InlineScripts("~/www/build/js/login.js")
    @RenderSection("scripts", required: false)
}

<div class="main">
    <div class="banner-left">
        <img src="@Url.Content("~/www/build/styles/Images/banner-red.png")">
    </div>

    @RenderBody()

    <div class="banner-right">
        <img src="@Url.Content("~/www/build/styles/Images/banner-blue.png")">
    </div>
</div>