@{
    var imageFolderUrl = Model.RootUrl + @"/www/source/styles/Images/email";
}
<table width="100%">
    <tr>
        <td valign="top" align="center" background="@imageFolderUrl/bgMain.jpg">
            <table width="599" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="88" background="@imageFolderUrl/banner_@(Model.Language).jpg"></td>
                </tr>
                <tr height="3">
                    <td height="3" bgcolor="#ff0000"></td>
                </tr>
                <tr>
                    <td>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="482" height="31" background="@imageFolderUrl/header.png">
                                    &nbsp;&nbsp;
                                    <strong style="color: rgb(255, 255, 255);">
                                        <font style="font-size: 9px; font-family: Verdana,Arial,Helvetica,sans-serif; text-transform: uppercase;">
                                            支付申請通知&nbsp;
                                        </font>
                                    </strong>
                                </td>
                                <td bgcolor="#f9f9f9" width="117">&nbsp;</td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td bgcolor="#ffffff">
                        <br />
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="15">&nbsp;</td>
                                <td>
                                    <font style="font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>尊敬的 @Model.FirstName,</strong><br /><br />

                                        您好，<br /><br />

                                        您交易代碼@(Model.TransId)，日期@(Model.Date)，金額為$@(Model.Amount)的支付申請已被取消。<br /><br />

                                        此郵件為系統郵件，請不要直接回复。<br /><br />

                                        如有任何疑問，歡迎致信<a href="mailto:@Model.MailContact">@Model.MailContact</a>聯繫我們<br /><br />

                                        誠摯的<br />
                                        12BET合作夥伴團隊
                                    </font>
                                </td>
                                <td width="15">&nbsp;</td>
                            </tr>
                        </table>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="400">&nbsp;</td>
                                <td align="center" width="185" height="41" background="@imageFolderUrl/button.png">
                                    <a href="@Model.RootUrl" style="text-decoration: none; border: 0px; color: rgb(255, 255, 255);">
                                        <font style="font-size: 20px; font-family: Verdana,Arial,Helvetica,sans-serif;">
                                            合作夥伴
                                        </font>
                                    </a><br />
                                </td>
                                <td width="19">&nbsp;</td>
                            </tr>
                            <tr>
                                <td colspan="3" height="30">&nbsp;</td>
                            </tr>
                            <tr>
                                <td colspan="2" align="right" bgcolor="#b6b6b6" height="25">
                                    <font style="font-size: 11px; color: #333333; font-family: Verdana,Arial,Helvetica,sans-serif;">
                                        © 版權所有2007-2008 Pacific Sea Inves
                                    </font>
                                </td>
                                <td width="5" bgcolor="#b6b6b6"></td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td heght="20">&nbsp;</td>
                </tr>
                <tr>
                    <td align="center" height="40" background="@imageFolderUrl/note.png">
                        <font style="font-size: 11px; color: rgb(255, 255, 255); font-family: Verdana,Arial,Helvetica,sans-serif;">
                            此郵件為系統郵件，請不要直接回复。
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>