<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.ImageRootUrl/bgMain.jpg">
            <table width="599" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="88" background="@Model.ImageRootUrl/banner_@(Model.Language).jpg"></td>
                </tr>
                <tr height="3">
                    <td height="3" bgcolor="#ff0000"></td>
                </tr>
                <tr>
                    <td>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="482" height="31" background="@Model.ImageRootUrl/header.png">
                                    &nbsp;&nbsp;
                                    <strong style="color: rgb(255, 255, 255);">
                                        <font style="font-size: 9px; font-family: Verdana,Arial,Helvetica,sans-serif; text-transform: uppercase;">
                                            Payment Request Notification&nbsp;
                                        </font>
                                    </strong>
                                </td>
                                <td bgcolor="#f9f9f9" width="117">&nbsp;</td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td bgcolor="#ffffff">
                        <br />
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="15">&nbsp;</td>
                                <td>
                                    <font style="font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>Dear @Model.FirstName</strong><br /><br />

                                        Request reference number is @Model.TransId, dated @Model.Date .<br /><br />

                                        Your payment request amount of $@Model.Amount has been cancelled.<br /><br />

                                        This is a system auto generated email, please do not reply to this email directly.<br />
                                        Do not hesitate to contact us if you have any questions or comments at <a href="mailto:@Model.MailContact">@Model.MailContact</a>.<br /><br />

                                        Have a great day!<br /><br />

                                        Best regards,<br /><br />

                                        The team at 12Bet Affiliates
                                    </font>
                                </td>
                                <td width="15">&nbsp;</td>
                            </tr>
                        </table>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="400">&nbsp;</td>
                                <td align="center" width="185" height="41" background="@Model.ImageRootUrl/button.png">
                                    <a href="@Model.RootUrl" style="text-decoration: none; border: 0px; color: rgb(255, 255, 255);">
                                        <font style="font-size: 20px; font-family: Verdana,Arial,Helvetica,sans-serif;">
                                            Affiliate
                                        </font>
                                    </a><br />
                                </td>
                                <td width="19">&nbsp;</td>
                            </tr>
                            <tr>
                                <td colspan="3" height="30">&nbsp;</td>
                            </tr>
                            <tr>
                                <td colspan="2" align="right" bgcolor="#b6b6b6" height="25">
                                    <font style="font-size: 11px; color: #333333; font-family: Verdana,Arial,Helvetica,sans-serif;">
                                        © Copyright 2009 Pacific Sea Invests.
                                    </font>
                                </td>
                                <td width="5" bgcolor="#b6b6b6"></td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td heght="20">&nbsp;</td>
                </tr>
                <tr>
                    <td align="center" height="40" background="@Model.ImageRootUrl/note.png">
                        <font style="font-size: 11px; color: rgb(255, 255, 255); font-family: Verdana,Arial,Helvetica,sans-serif;">
                            This is a system auto generated email, please do not reply to this email directly.
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>