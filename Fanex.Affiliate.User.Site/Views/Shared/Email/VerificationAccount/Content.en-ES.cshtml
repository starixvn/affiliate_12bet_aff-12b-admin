@model Fanex.Affiliate.User.Core.MetalModels.Email.RecoverPasswordEmailParam
@{
    var userInfo = Model.User;
    var recoverUrl = Model.RootDomain + "Password/RecoverPassword?uid=" + userInfo.AffId + "&vid=" + Model.Code;
}
<div>
Dear @userInfo.FirstName,<br /><br />

Here is the verification code you need to login to account @userInfo.UserName:<br />
@Model.Code<br/>

This email was generated because of many consecutive failed logins from a web or mobile device located at <a href='@recoverUrl'>@recoverUrl</a><br />
The verification code is required to complete the login. The code will be expired after 15 minutes.<br />
If you are not attempting to login then please change the password and consider changing your email password as well to ensure your account security.<br /><br />

If you are unable to access your account then <a href='@recoverUrl'>use this forgot password link</a> for assistance obtaining a new password.<br /><br />

Best regards,<br /><br />

The 12Bet Affiliate team<br />

<a href="http://affiliate.12ying.com">http://affiliate.12ying.com</a>
</div>
