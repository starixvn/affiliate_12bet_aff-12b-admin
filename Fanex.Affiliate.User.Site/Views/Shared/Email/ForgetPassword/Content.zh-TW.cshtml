@{
    var recoverUrl = Model.RecoverPwdURL + "?uid=" + Model.CustId + "&vid=" + Model.ValidationCode;
}
<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.ImageRootUrl/bgMain.jpg">
            <table width="599" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="88" background="@Model.ImageRootUrl/banner_@(Model.Language).jpg"></td>
                </tr>
                <tr height="3">
                    <td height="3" bgcolor="#ff0000"></td>
                </tr>
                <tr>
                    <td>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="482" height="31" background="@Model.ImageRootUrl/header.png">
