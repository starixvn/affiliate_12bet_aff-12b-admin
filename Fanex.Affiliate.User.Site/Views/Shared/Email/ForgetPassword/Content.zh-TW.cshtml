                                        誠摯的<br />
                                        12BET合作夥伴團隊<br />
                                        <a href="mailto:@Model.MailContact">@Model.MailContact</a>
                                    </font>
                                </td>
                                <td width="15">&nbsp;</td>
                            </tr>
                        </table>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="400">&nbsp;</td>
