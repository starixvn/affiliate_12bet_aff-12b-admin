@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = "12BET Affiliate Program | Contact Us";
}

@model Fanex.Affiliate.User.Core.DTO.UserInfo
@{
    var name = Model != null ? $"{Model?.FirstName} {Model?.LastName}" : string.Empty;
    var affiliate = Model?.UserName;
    var email = Model?.Email;
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/contact-us.css")
}

@section scripts{
    <script>
        var resourceLanguage = {
            generalError: '@Error.General'
        }
    </script>
    @Html.InlineScripts("~/www/build/js/contactus.js")
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.ContactUs</span>
    </div>

    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-3">
                <div class="date-time">
                    <div class="img-support">
                        <img class="img-responsive" src="~/www/build/styles/Images/contact-us/Support_girl.png" />
                    </div>
                    <div class="date-time-info">
                        <p>Monday - Saturday</p>
                        <p>09:00 am - 06:00 pm (GMT +8)</p>
                    </div>
                </div>
            </div>

            <div class="col-sm-9">
                <div class="row">
                    <div class="col-sm-6">
                        <div class="languages-item">
                            <div class="single-flag">
                                <img src="~/www/build/styles/Images/contact-us/english_lang.png" />
                            </div>
                            <div class="info">
                                <p class="language">English Support</p>
                                <a class="skype-info" href="mailto:aff12b_eng@hotmail.com">
                                    <img class="skype-icon" src="~/www/build/styles/Images/contact-us/skype_icon.png" />
                                    <span>aff12b_eng@hotmail.com</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="languages-item">
                            <div class="single-flag">
                                <img src="~/www/build/styles/Images/contact-us/China_lang.png" />
                            </div>
                            <div class="info">
                                <p class="language">China Support</p>
                                <a class="skype-info" href="#">
                                    <img class="skype-icon" src="~/www/build/styles/Images/contact-us/skype_icon.png" />
                                    <span>18064120343</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-6">
                        <div class="languages-item">
                            <div class="single-flag">
                                <img src="~/www/build/styles/Images/contact-us/indonesian_lang.png" />
                            </div>
                            <div class="info">
                                <p class="language">Indonesia Support</p>
                                <a class="skype-info" href="#">
                                    <img class="skype-icon" src="~/www/build/styles/Images/contact-us/skype_icon.png" />
                                    <span>live:aff.12betindo</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="languages-item">
                            <div class="single-flag">
                                <img src="~/www/build/styles/Images/contact-us/thailand_lang.png" />
                            </div>
                            <div class="info">
                                <p class="language">Thailand Support</p>
                                <a class="skype-info" href="mailto:csd12bthai_affiliate@hotmail.com">
                                    <img class="skype-icon" src="~/www/build/styles/Images/contact-us/skype_icon.png" />
                                    <span>csd12bthai_affiliate@hotmail.com</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-6">
                        <div class="languages-item">
                            <div class="single-flag">
                                <img src="~/www/build/styles/Images/contact-us/vietnam_lang.png" />
                            </div>
                            <div class="info">
                                <p class="language">Vietnam Support</p>
                                <a class="skype-info" href="mailto:aff12b_viet@yahoo.com">
                                    <img class="skype-icon" src="~/www/build/styles/Images/contact-us/skype_icon.png" />
                                    <span>aff12b_viet@yahoo.com</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="languages-item">
                            <div class="single-flag">
                                <img src="~/www/build/styles/Images/contact-us/india_lang.png" />
                            </div>
                            <div class="info">
                                <p class="language">Indian Support</p>
                                <a class="skype-info" href="#">
                                    <img class="skype-icon" src="~/www/build/styles/Images/contact-us/skype_icon.png" />
                                    <span>aff12csdindia</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="contact-form">
        <div class="alert alert-success" role="alert" id="messageSuccess" style="display: none;">
            @Html.Raw(Lang.MessageSentReview.Replace("{br}", "<br>"))
        </div>

        <div class="alert alert-danger" role="alert" id="messageError" style="display: none"></div>

        <div id="mainContent">
            <p class="intro">Please direct any comments or questions to <a href="mailto:affiliate@12csd.com">affiliate@12csd.com</a>, or using the form below.</p>
            <form id="contactForm" class="form">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <div class="group group-small">
                        <label class="require" for="Sender">@Lang.Name</label>
                        <input class="field" type="text" name="Sender" id="Sender" value="@name" />
                        <div class="validation-input">
                            <span class="help-block hide">@Lang.NameIsInvalid</span>
                        </div>
                    </div>
                    <div class="group group-small">
                        <label for="Affiliate">@Lang.Affiliate</label>
                        <input class="field" type="text" name="Affiliate" id="Affiliate" value="@affiliate" />
                    </div>
                </div>
                <div class="form-group">
                    <div class="group group-small">
                        <label class="require" for="Subject">@Lang.Subject</label>
                        <input class="field" type="text" name="Subject" id="Subject" />
                        <div class="validation-input">
                            <span class="help-block hide">@Lang.SubjectIsInvalid</span>
                        </div>
                    </div>
                    <div class="group group-small">
                        <label class="require" for="Email">@Lang.Email1</label>
                        <input class="field emailInput" type="text" name="Email" id="Email" value="@email" />
                        <div class="validation-input">
                            <span class="help-block hide">@Lang.EmailAddressIsInvalid</span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="group group-full">
                        <label class="require" for="Content">@Lang.Comment</label>
                        <textarea class="field" name="Content" id="Content"></textarea>
                        <div class="validation-input">
                            <span class="help-block hide">@Lang.CommentsIsInvalid</span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="group group-small captcha">
                        <label class="require" for="Captcha">@Lang.Validation</label>
                        <input class="field" type="text" name="Captcha" id="Captcha" autocomplete="off" />
                        <div class="validation-input">
                            <span class="help-block hide">@Lang.ErrmsgEntryValidCode</span>
                        </div>
                    </div>
                    <div class="validation-value"><img src="@Url.Action("CaptchaImage", "Home")" alt="captcha" /></div>
                </div>

                <div class="form-group">
                    <div class="group">
                        <label></label>
                        <button class="btn btn-submit" type="submit">@Lang.Submit</button>
                        <button class="btn btn-submit" type="button" id="btnReset">@Lang.Reset</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>