<div class="content">
    <div class="page-title">
        <span class="text">@Lang.CommissionStructure</span>
    </div>

    <div class="info-group">
        <div class="img-ads text-center">
            <picture>
                <img src="~/www/build/styles/Images/ads-1/ads-1_644.jpg"
                     sizes="(max-width: 644px) 100vw, 644px"
                     srcset="~/www/build/styles/Images/ads-1/ads-1_200.jpg 200w,
                     ~/www/build/styles/Images/ads-1/ads-1_392.jpg 392w,
                     ~/www/build/styles/Images/ads-1/ads-1_559.jpg 559w,
                     ~/www/build/styles/Images/ads-1/ads-1_644.jpg 644w"                   
                     alt="Commission Structure">
            </picture>
        </div>

        <p class="text">
            @Html.Raw(Lang.AsAOneTwoBetAffiliates)
        </p>
    </div>

    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.RevenueShareModel</span>
        </div>
        <p class="text">
            @Html.Raw(Lang.TheRevenueShareModelIsSplit)
        </p>
        <p class="text">
            @Lang.OneTwoBetOffersARevenueShareModel
        </p>

        <div class="table table-responsive">
            <table>
                <thead>
                    <tr>
                        <th width="20%">@Lang.RevenueShare</th>
                        <th width="8%">@Lang.Tier</th>
                        <th width="20%">@Lang.NetWinLoss</th>
                        <th width="20%">@Lang.QualifyingMem</th>
                        <th width="20%">@Lang.Comm</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td rowspan="3" class="text-center">
                            <p>@Lang.AllProducts</p>
                            <p><a class="more-detail" href="@Url.Action("Index", "Product")">> @Lang.MoreDetailProduct</a></p>
                        </td>
                        <td class="text-center">1</td>
                        <td class="text-center">$1 - $2,999</td>
                        <td class="text-center">6 - 10</td>
                        <td class="text-center">20%</td>
                    </tr>
                    <tr>
                        <td class="text-center">2</td>
                        <td class="text-center">$3,000.00 - $45,000</td>
                        <td class="text-center">11 - 50</td>
                        <td class="text-center">30%</td>
                    </tr>
                    <tr>
                        <td class="text-center">3</td>
                        <td class="text-center">$45,000+</td>
                        <td class="text-center">51+</td>
                        <td class="text-center">40%</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p class="text" style="margin-top: 15px;">
            @Lang.ForThePurposesOfTheTable
        </p>
    </div>

    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.NegativeBalance</span>
        </div>
        <p class="text">
            @Lang.AnyNegativeBalance
        </p>
    </div>

    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.CommissionPayment</span>
        </div>
        <p class="text">
            @Lang.YouCanRequestPayout
        </p>

        <p class="text">@Lang.WeOfferSeveralMethods</p>
        <p>@Lang.ThroughYourOneTwoBetPlayerAccount</p>
        <p>@Lang.TwoDotMoneybookers *</p>
        <p>@Lang.ThreeDotNeteller *</p>
        <p>@Lang.FourDotWireTransfer *</p>

        <p class="text">
            @Html.Raw(Lang.AffilatesAreOnlyAllowed)
        </p>
    </div>

    @RazorHelper.RenderMovingTopButton()
</div>
