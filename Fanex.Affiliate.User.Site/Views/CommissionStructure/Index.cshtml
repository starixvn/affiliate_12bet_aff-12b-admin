@{
    ViewBag.Title = Lang.CommissionStructure;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}
@model string
@{ 
    var viewName = "~/Views/CommissionStructure/_Content." + Model + ".cshtml";
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.CommissionStructure</span>
    </div>

    <div class="img-ads text-center">
        <picture>
            <img src="~/www/build/styles/Images/ads-1/ads-1_644.jpg"
                 sizes="(max-width: 644px) 100vw, 644px"
                 srcset="~/www/build/styles/Images/ads-1/ads-1_200.jpg 200w,
                     ~/www/build/styles/Images/ads-1/ads-1_392.jpg 392w,
                     ~/www/build/styles/Images/ads-1/ads-1_559.jpg 559w,
                     ~/www/build/styles/Images/ads-1/ads-1_644.jpg 644w"
                 alt="Commission Structure">
        </picture>
    </div>
    @{ Html.RenderPartial(viewName); }
    @RazorHelper.RenderMovingTopButton()
</div>