@{
    ViewBag.Title = Lang.Product;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@model bool

@{ 
    var isAuthenticated = Model;
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/products.css")
}

<div class="content">
    @{ Html.RenderAction("Content", "Product"); }

    @if (!isAuthenticated)
    {
        <div class="col-sm-offset-4 col-sm-5 signup-block">
            <a href="@Url.Action("Index", "SignUp")" class="btn btn-link btn-block nounderline">@Lang.SignUpAffiliateProgramNow</a>
        </div>
    }
</div>

