@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@model string

@{
    var email = Model;  
    if (string.IsNullOrEmpty(email))
    {
        <h4 class="text-danger">Username is incorrect!</h4>
    }
    else
    {
        @section styles{
            @Html.InlineStyles("~/www/build/styles/css/verification-account.css")
        }

        @section scripts{
            <script src="@Url.RenderLink("~/www/build/js/validation.js")"></script>
            @Html.InlineScripts("~/www/build/js/pages/verification-account.js")
        }
        <div class="content verification-account" id="verification-account">
            <br />
            <p>Dear Customer,</p>
            <p>Due to many recent failed logins, please verify one more security step.</p>
            <p>A 6-digits verification code has been sent to your email address <strong>@email.</strong></p>
            <p>Please enter your username, password and the veritication code below to log in.</p>
            <br />
            <form id="verificationAccountForm">
                <div class="form-group row">
                    <label for="Usename" class="col-sm-2 control-label require">Username</label>
                    <div class="col-sm-4 col-lg-3">
                        <input type="text" class="form-control" data-val="true" data-val-required="Username is required" id="Usename" name="Usename" />
                        <span class="field-validation-valid help-block" data-valmsg-for="Usename" data-valmsg-replace="true"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label for="Password" class="col-sm-2 control-label require">Password</label>
                    <div class="col-sm-4 col-lg-3">
                        <input type="password" class="form-control" data-val="true" data-val-required="Password is required" id="Password" name="Password" autocomplete="off" />
                        <span class="field-validation-valid help-block" data-valmsg-for="Password" data-valmsg-replace="true"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label for="Code" class="col-sm-2 control-label require">Verification Code</label>
                    <div class="col-sm-4 col-lg-3">
                        <input type="text" class="form-control" data-val="true" data-val-required="Verification Code is required" id="Code" name="Code" />
                        <span class="field-validation-valid help-block" data-valmsg-for="Code" data-valmsg-replace="true"></span>
                    </div>
                    <button type="button" class="btn btn-resend" id="btn-resend">RESEND CODE</button>
                </div>

                <div class="form-group row">
                    <label for="Captcha" class="col-sm-2 control-label require">Captcha</label>
                    <div class="col-sm-4 col-lg-3">
                        <input type="text" class="form-control" data-val="true" data-val-required="Captcha is required" id="Captcha" name="Captcha" />
                        <span class="field-validation-valid help-block" data-valmsg-for="Captcha" data-valmsg-replace="true"></span>
                    </div>
                    <div class="validation-value">
                        <img style="cursor:pointer" id="captchaVerificationAccount" src="@Url.Content("~/VerificationAccount/CaptchaImage?_v=" + DateTime.Now.ToLongTimeString())" alt="captcha" />
                    </div>
                </div>
                <br />
                <div class="form-group row">
                    <div class="col-sm-offset-2 col-sm-10">
                        <button type="button" class="btn btn-login" id="btn-login">login</button>
                    </div>
                </div>
            </form>
        </div>
    }
}