@{
    ViewBag.Title = Lang.Faqs;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/faq.css")
}

@model string
@{ 
    var contentView = "~/Views/Faq/_Content." + Model + ".cshtml";
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.Faqs</span>
    </div>

    <div class="faq-banner">
        <div class="banner-content">
            <img class="img-responsive" src="~/www/build/styles/Images/FAQ_banner.png" alt="faq" style="margin: auto" />
        </div>
    </div>

    @{ Html.RenderPartial(contentView); }

    @RazorHelper.RenderMovingTopButton()
</div>