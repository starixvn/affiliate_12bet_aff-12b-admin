@{
    var selectedHotNews = ViewBag.SelectedHotNews as string ?? string.Empty;
    var isImportant = (bool)ViewBag.IsImportant;
    if (!string.IsNullOrEmpty(selectedHotNews))
    {
        if (isImportant)
        {
            <a href="javascript:;" style="color: #ff0000">@HttpUtility.HtmlDecode(selectedHotNews)</a>
        }
        else
        {
            @HttpUtility.HtmlDecode(selectedHotNews)
        }
    }
}