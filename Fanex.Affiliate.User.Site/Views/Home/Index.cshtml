@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = "Home Page";
}

@model Fanex.Affiliate.User.Core.ViewModels.HomeViewModel

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/home.css")" rel="stylesheet" />
}

@section scripts{
    <script src="@Url.RenderLink("~/www/build/js/home.js")"></script>
}

<div class="content home-page">
    <div id="mainBanner" class="carousel slide banner-center" data-ride="carousel">
        <div class="carousel-inner" role="listbox">
            <div class="item active">
                <img src="~/www/build/styles/Images/slider-1.png" alt="...">
                <div class="caption">
                    <div class="caption-big bounceInDown">
                        ROAD TO <br />  WORLD CUP 2018
                    </div>
                    <div class="caption-small bounceInUp">
                        BOOST YOUR AFFILIATE REVENUE TO WIN FREE TICKET TO RUSSIA
                    </div>
                    <a href="@Url.Action("Index", "Promotion")" class="btn btn-more zoomInRight">More details</a>
                </div>
            </div>

            <div class="item">
                <img src="~/www/build/styles/Images/slider-1.png" alt="...">
                <div class="caption">
                    <div class="caption-big bounceInDown">
                        ROAD TO <br />  WORLD CUP 2018
                    </div>
                    <div class="caption-small bounceInUp">
                        BOOST YOUR AFFILIATE REVENUE TO WIN FREE TICKET TO RUSSIA
                    </div>
                    <a href="@Url.Action("Index", "Promotion")" class="btn btn-more zoomInRight">More details</a>
                </div>
            </div>
        </div>
        <a class="left carousel-control" href="#mainBanner" role="button" data-slide="prev">
            <span class="mdi mdi-chevron-left" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="right carousel-control" href="#mainBanner" role="button" data-slide="next">
            <span class="mdi mdi-chevron-right" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>
    <div class="news">
        <div class="card">
            <div class="card-content">
                <h4 class="card-title">
                    <span class="icon"><img src="~/www/build/styles/Images/icon-1.png" /></span>
                    <span class="text">Apply 12BET Affiliate</span>
                </h4>
                <a href="@Url.Action("Index", "SignUp")" class="nounderline">
                    <div class="img-content">
                        <img class="img" src="~/www/build/styles/Images/advertise.png" />
                    </div>
                    <div class="text-content">
                        As affiliates, you will earn commission on every player you referred to 12BET  over the course of the player's account life. Your online system will be  serving  you 24/7 for your usage.
                    </div>
                </a>
            </div>
        </div>
        <div class="card">
            <div class="card-content">
                <h4 class="card-title">
                    <span class="icon"><img src="~/www/build/styles/Images/icon-2.png" /></span>
                    <span class="text">Monthly Offers</span>
                </h4>
                <div class="offers-content">
                    <span class="text-italic-big">Road to</span>
                    <span class="text-big">World Cup 2018</span>
                    <span class="date"><span class="text-uppercase">Russia</span> 14 Jun - 15 July</span>
                    <span class="text-small">Boost up affiliate revenue to win free ticket and accomodation</span>
                    <a href="@Url.Action("Index", "Promotion")" class="btn btn-join">Join Now!</a>
                </div>
                <div class="text-content text-uppercase">
                    Contact us to participate the offer!
                </div>
            </div>
        </div>
        <div class="card" id="affiliateNews">
            <div class="card-content">
                <h4 class="card-title">
                    <span class="icon"><img src="~/www/build/styles/Images/icon-3.png" /></span>
                    <span class="text">12BET Affiliate News</span>
                </h4>
                <div class="text-content">
                    <ul class="news-content">
                        <li>
                            @{
                                var mediaUrl = Url.Action("Index", "UserPanel") + "/#MediaGallery";
                                var attributeString = Model.IsAuthenticated ? "href=" + mediaUrl : "href=javascript:; id=loginLink";
                            }
                            <a class="nounderline" @(attributeString)>
                                <span class="news-title">NEW BANNER IS AVAILABLE <span class="text-red">NEW!</span></span>
                                <span>You can now log in your affiliate account to get new banner - January 2018 version!</span>
                            </a>
                        </li>
                        <li>
                            <a href="javascript:;" class="nounderline">
                                <span class="news-title">PREPARE FOR WORLD CUP 2018 <span class="text-red">NEW!</span></span>
                                <span>Get your website ready for up coming World Cup 2018, contact affiliate team for your best promoting plan today! </span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade login-dialog" tabindex="-1" role="dialog" id="loginDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-banner">
                <img src="~/www/build/styles/Images/logo.png" />
                <h1 class="logo-text">AFFILIATE PROGRAM</h1>
            </div>

            <div class="modal-main-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h3 class="modal-title">AFFILIATE LOGIN</h3>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h3 class="title-left">Not Affiliate Member Yet?</h3>
                            <p>Sign up to affiliate program and earn up to 40% monthly commission!</p>
                            <a href="@Url.Action("Index", "Signup")" role="button" class="btn btn-submit btn-block text-uppercase">JOIN NOW!</a>
                            <a href="@Url.Action("Index", "Promotion")" class="link-login-popup">> Get to know 12BET affiliate program</a>
                        </div>

                        <div class="col-md-6 login-side" id="dialogUserInput">
                            <h3 class="title-right">Welcome back!</h3>
                            <div class="input-group">
                                <input type="text" id="dialogtxtUsername" class="form-control" placeholder="@Lang.Username" />
                            </div>
                            <div class="input-group">
                                <input type="password" id="dialogtxtPassword" class="form-control" placeholder="@Lang.Password" />
                            </div>
                            <div class="input-group">
                                <input type="text" id="dialogtxtValidation" class="form-control captcha-input" placeholder="Validation" />
                                <div class="validation-value"><img src="" alt="captcha" id="loginDialogcaptchaImg" /></div>
                            </div>

                            <button type="button" id="btnDialogLogin" class="btn btn-submit btn-block text-uppercase">@Lang.Login</button>
                            <a href="@Url.Action("Index", "Password")" class="link-login-popup">> Forgot Login Details ?</a>
                        </div>
                    </div>
                </div>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->