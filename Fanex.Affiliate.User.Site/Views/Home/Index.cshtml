@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = Lang.Home;
}

@model Fanex.Affiliate.User.Core.ViewModels.HomeViewModel

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/home.css")" rel="stylesheet" />
}

@section scripts{
}

<div class="content home-page">
    <div id="mainBanner" class="carousel slide banner-center" data-ride="carousel">
        <div class="carousel-inner" role="listbox">
            <div class="item active">
                <a class="nounderline banner-signup" href="@Url.Action("Index", "Signup")">
                    <div class="upto">
                        @Html.Raw(@Lang.UpTo)
                        <span class="value">40%</span>
                    </div>
                    <div class="text-border">
                        @Html.Raw(@Lang.MonthlyComission)
                        @Html.Raw(@Lang.OnSportandCasino)
                        <p class="text-yellow">@Lang.YouAreNotAffiliateYet</p>
                    </div>
                    <span class="btn">@Lang.SignUpAffiliatesNow</span>
                </a>
            </div>

            <div class="item">
                <a class="nounderline get-banner @(Model.IsAuthenticated ? string.Empty : "loginLink")" href="@Model.BannerLink">
                    <div class="text-1">
                        <p>@Lang.OptimizeYourWebsite</p>
                        <p>@Lang.AndSocialChannels</p>
                        <p>@Lang.ThroughSoccerSeason2018</p>
                    </div>
                    <div class="text-2">
                        <p>@Lang.Update12BetBannersfromYourMediaGallery</p>
                        <p>@Lang.AndPostPromotionsInYourWebsite</p>
                        <p>@Lang.ToBeatTheBestCommission</p>
                    </div>
                    <span class="btn">@Lang.GetBannerNow</span>
                </a>
            </div>
        </div>
        <a class="left carousel-control" href="#mainBanner" role="button" data-slide="prev">
            <span class="chevron left" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="right carousel-control" href="#mainBanner" role="button" data-slide="next">
            <span class="chevron right" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>
    <div class="news">
        <div class="item-wrapper first">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">
                        <span class="icon"><img src="~/www/build/styles/Images/icon-1.png" alt="icon-1" /></span>
                        <span class="text">@Lang.ApplyOneTwoBetAffiliate</span>
                    </h4>
                    <a href="@Model.SignUpLink" class="nounderline">
                        <div class="img-content">
                            @{
                                var advFileName = Url.Content("~/www/build/styles/Images/apply12bet/3step." + Model.Language);
                            }
                            <picture>
                                <source srcset="@(advFileName + ".webp")" type="image/webp" />
                                <source srcset="@(advFileName + ".png")" type="image/jpeg" />
                                <img class="img-item img-responsive" src="@(advFileName + ".png")" alt="ads" />
                            </picture>
                        </div>
                        <p class="text-content">
                            @Lang.AsAOneTwoBetYouWillEarnCommission
                        </p>
                    </a>
                </div>
            </div>
        </div>

        <div class="item-wrapper">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">
                        <span class="icon"><img src="~/www/build/styles/Images/icon-2.png" alt="icon-2" /></span>
                        <span class="text">@Lang.WhatNewInAffiliate</span>
                    </h4>
                    <div class="card-body">
                        <a href="@Url.Action("Index", "ContactUs")" class="img-content adv-contact">
                            <p class="text-1">@Lang.CannotGetEnough</p>
                            <p class="text-2">@Lang.YourCurrentCommision</p>
                            <span class="line"></span>
                            <p class="text-3">@Lang.ContactYourAffilliateSupportTeam</p>
                            <span class="btn">@Lang.ContactNow</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="item-wrapper last">
            <div class="card" id="affiliateNews">
                <div class="card-content">
                    <h4 class="card-title">
                        <span class="icon"><img src="~/www/build/styles/Images/icon-3.png" alt="icon-3" /></span>
                        <span class="text">@Lang.OneTwoBetAffiliateNews</span>
                    </h4>
                    <div class="text-content">
                        <ul class="news-content">
                            <li>
                                <a class="nounderline @(Model.IsAuthenticated ? string.Empty : "loginLink")" href="@Model.BannerLink">
                                    <span class="news-title">@Lang.NewBannerIsNowAvailable <span class="text-red" style="text-decoration:underline;">@Lang.NewWithExclamationPoint</span></span>
                                    <span>@Lang.YouCanNowLogInYourAffiliateAccount </span>
                                </a>
                            </li>
                            <li>
                                <a href="@Model.Promotion12BetLink" target="_blank" class="nounderline">
                                    <span class="news-title">@Lang.WhatNewInOneTwoBetPromotion <span class="text-red" style="text-decoration:underline;">@Lang.NewWithExclamationPoint</span></span>
                                    <span>@Lang.GetToKnowHotPromotion</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
