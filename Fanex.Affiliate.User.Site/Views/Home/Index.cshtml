                                ~/www/build/styles/Images/slide-2/slide-2_kb17xl_c_scale,w_833.png 833w,
                                ~/www/build/styles/Images/slide-2/slide-2_kb17xl_c_scale,w_892.png 892w,
                                ~/www/build/styles/Images/slide-2/slide-2_kb17xl_c_scale,w_951.png 951w,
                                ~/www/build/styles/Images/slide-2/slide-2_kb17xl_c_scale,w_1006.png 1006w,
                                ~/www/build/styles/Images/slide-2/slide-2_kb17xl_c_scale,w_1060.png 1060w,
                                ~/www/build/styles/Images/slide-2/slide-2_kb17xl_c_scale,w_1112.png 1112w,
                                ~/www/build/styles/Images/slide-2/slide-2_kb17xl_c_scale,w_1163.png 1163w,
                                ~/www/build/styles/Images/slide-2/slide-2_kb17xl_c_scale,w_1212.png 1212w,
                                ~/www/build/styles/Images/slide-2/slide-2_kb17xl_c_scale,w_1262.png 1262w,
