        </div>
        <a class="left carousel-control" href="#mainBanner" role="button" data-slide="prev">
            <span class="chevron left" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="right carousel-control" href="#mainBanner" role="button" data-slide="next">
            <span class="chevron right" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>
    <div class="news">
        <div class="item-wrapper first">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">
                        <span class="icon"><img src="~/www/build/styles/Images/icon-1.png" alt="icon-1" /></span>
                        <span class="text">Apply 12BET Affiliate</span>
                    </h4>
                    <a href="@Model.SignUpLink" class="nounderline">
                        <div class="img-content">                            
                            <picture>
                                <source srcset="~/www/build/styles/Images/advertise.webp" type="image/webp" />
                                <source srcset="~/www/build/styles/Images/advertise.png" type="image/jpeg" />
                                <img class="img-item img-responsive" src="~/www/build/styles/Images/advertise.png" alt="ads" />
                            </picture>
                        </div>
                        <p class="text-content">
                            As affiliates, you will earn commission on every player you referred to 12BET  over the course of the player's account life. Your online system will be  serving  you 24/7 for your usage.
                        </p>
                    </a>
                </div>
            </div>
        </div>

        <div class="item-wrapper">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">
                        <span class="icon"><img src="~/www/build/styles/Images/icon-2.png" alt="icon-2" /></span>
                        <span class="text">What's New in Affiliate</span>
                    </h4>
                    <div class="card-body">
                        <a href="@Url.Action("Index", "ContactUs")" class="img-content">                            
                            <picture>
                                <source srcset="~/www/build/styles/Images/adv_contact.webp" type="image/webp" />
                                <source srcset="~/www/build/styles/Images/adv_contact.jpg" type="image/jpeg" />
                                <img class="img-item img-responsive" src="~/www/build/styles/Images/adv_contact.jpg" alt="contact" />
                            </picture>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="item-wrapper last">
            <div class="card" id="affiliateNews">
                <div class="card-content">
                    <h4 class="card-title">
                        <span class="icon"><img src="~/www/build/styles/Images/icon-3.png" alt="icon-3" /></span>
                        <span class="text">12BET Affiliate News</span>
                    </h4>
                    <div class="text-content">
                        <ul class="news-content">
                            <li>
                                <a class="nounderline @(Model.IsAuthenticated ? string.Empty : "loginLink")" href="@Model.BannerLink">
                                    <span class="news-title">New  banner is now available! <span class="text-red" style="text-decoration:underline;">NEW!</span></span>
                                    <span>You can now log in your affiliate account to  get new banners to promote in your website. </span>
                                </a>
                            </li>
                            <li>
                                <a href="@Model.Promotion12BetLink" target="_blank" class="nounderline">
                                    <span class="news-title">What's New in 12BET Promotion ! <span class="text-red" style="text-decoration:underline;">NEW!</span></span>
                                    <span>Get to know hot promotions this month. Post them in your websites and social channels to gain more customers and commission!</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
