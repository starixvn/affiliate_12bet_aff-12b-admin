                             srcset="~/www/build/styles/Images/slide-2/slide-2_kb17xl_c_scale,w_375.png 375w,
                                ~/www/build/styles/Images/slide-2/slide-2_kb17xl_c_scale,w_470.png 470w,
                                ~/www/build/styles/Images/slide-2/slide-2_kb17xl_c_scale,w_554.png 554w,
