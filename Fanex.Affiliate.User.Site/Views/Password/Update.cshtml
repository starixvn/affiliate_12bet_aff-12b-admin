@{
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

@{
    const string ResultKey = "UpdatePasswordResult";
    var result = TempData[ResultKey] as Fanex.Affiliate.User.Core.DTO.ResultInfo;
    var hasResult = result != null;
    var messageResult = hasResult ? Html.Raw(new HtmlString(result.Message)) : new HtmlString(string.Empty);
    var isSuccessful = hasResult && result.IsOk;
}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/password.css")" rel="stylesheet" />
}

<div style="padding-bottom: 30px;">
    <div class="page-title">
        <span class="text">@Lang.ChangePass</span>
    </div>

    <div>
        <p class="alert @(isSuccessful ? "alert-success" : "alert-danger")" id="changePassResult" role="alert" style="visibility: @(hasResult ? "visible" : "hidden")">
            @messageResult
        </p>

        @using (Html.BeginForm("Update", "Password", FormMethod.Post, new { @id = "updatePassword", @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.OldPass</label>
                <div class="col-sm-3">
                    <input type="password" name="OldPassword" class="form-control" id="OldPassword" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.NewPass</label>
                <div class="col-sm-3">
                    <input type="password" name="NewPassword" class="form-control" id="NewPassword" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.RePass</label>
                <div class="col-sm-3">
                    <input type="password" name="ConfirmNewPassword" class="form-control" id="ConfirmNewPassword" />
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-offset-3 col-sm-5">
                    <button type="submit" class="btn btn-submit">@Lang.Submit</button>
                    <button type="button" class="btn btn-submit">@Lang.Cancel</button>
                </div>
            </div>
        }
    </div>
</div>
