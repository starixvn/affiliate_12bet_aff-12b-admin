@{
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

@{
    var hasResultMessage = TempData["ResultMessage"] != null;
    var messageResult = hasResultMessage ? Html.Raw(new HtmlString(TempData["ResultMessage"] as string)) : new HtmlString(string.Empty);
}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/password.css")" rel="stylesheet" />
}

<div>
    <div class="page-title">
        <span class="text">@Lang.ChangePass</span>
    </div>

    <div>
        <p class="alert alert-danger" id="changePassResult" role="alert" style="visibility: @(hasResultMessage ? "visible" : "hidden")">
            @messageResult
        </p>

        @using (Html.BeginForm("Update", "Password", FormMethod.Post, new { @id = "updatePassword", @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.OldPass</label>
                <div class="col-sm-3">
                    <input type="text" name="OldPassword" class="form-control" id="OldPassword" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.NewPass</label>
                <div class="col-sm-3">
                    <input type="text" name="NewPassword" class="form-control" id="NewPassword" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.RePass</label>
                <div class="col-sm-3">
                    <input type="text" name="ConfirmNewPassword" class="form-control" id="ConfirmNewPassword" />
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-offset-3 col-sm-5">
                    <button type="submit" class="btn btn-submit">@Lang.Submit</button>
                    <button type="button" class="btn btn-submit">@Lang.Cancel</button>
                </div>
            </div>
        }
    </div>
</div>
