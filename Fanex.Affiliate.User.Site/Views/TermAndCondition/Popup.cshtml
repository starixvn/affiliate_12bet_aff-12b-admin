@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Lang.TermAndCondition</title>
    <link href="~/www/build/styles/css/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.RenderLink("~/www/build/styles/css/main.css")" rel="stylesheet" />
</head>
<body>
    <div class="main-container">
        <div class="main">
            <div class="banner-side banner-left">
                <img src="~/www/build/styles/Images/bgLeft.jpg" alt="aff background" />
            </div>

            <div class="page-container">
                @{ Html.RenderAction("Content", "TermAndCondition"); }
            </div>
            
            <div class="banner-side banner-right">
                <img src="~/www/build/styles/Images/bgRight.jpg" alt="aff background" />
            </div>
        </div>
    </div>
</body>
</html>

