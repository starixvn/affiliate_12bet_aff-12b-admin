@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Lang.TermAndCondition</title>
    <link href="~/www/build/styles/css/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.RenderLink("~/www/build/styles/css/main.css")" rel="stylesheet" />
</head>
<body>
    <div class="main-container">
        <div class="main">
            <div class="banner-left">
                <img src="@Url.Content("~/www/build/styles/Images/banner-red.png")">
            </div>
            @{ Html.RenderAction("Content", "TermAndCondition"); }
            <div class="banner-right">
                <img src="@Url.Content("~/www/build/styles/Images/banner-blue.png")">
            </div>
        </div>
    </div>
</body>
</html>

