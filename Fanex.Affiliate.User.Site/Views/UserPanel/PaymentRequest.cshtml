@{
    Layout = null;
}
@using Fanex.Affiliate.User.Core.Constants;

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.PaymentViewModel
@{
    var paymentResult = TempData[TempDataKey.PaymentResult] as Fanex.Affiliate.User.Core.DTO.ResultInfo;
    var hasPaymentResult = paymentResult != null;
    var paymentSuccessfully = hasPaymentResult && paymentResult.IsOk;

    var hasData = Model.PaymentList != null && Model.PaymentList.Any();
    var paymentMethod = Model.PreferredPayment.Replace("Wire", Lang.BankTransfer);

    var canRequest = Model.IsValidAmount && Model.IsValidDate && Model.PendingPayment == null;
    var errorMessage = hasPaymentResult ? paymentResult.Message : GetErrorMessage();

    @functions {
        string GetErrorMessage()
        {
            string method = Model.PreferredPayment.Replace("Wire", Lang.BankTransfer);
            if (!method.MatchWith("Player"))
            {
                return Error.PaymentMethodInvalid.Replace("{0}", method)
                            .Replace("{1}", Url.Action("Index", "UserPanel") + "/#MyAccount");
            }

            if (!Model.IsValidAmount)
            {
                return Error.PaymentBalanceInvalid;
            }

            if (!Model.IsValidDate)
            {
                return Error.PaymentPayoutTimeInvalid;
            }

            if(Model.PendingPayment != null)
            {
                return Lang.Err3001;
            }

            return string.Empty;
        }

        static string ConvertStatus(string status)
        {
            switch (status.ToLower())
            {
                case PaymentStatus.Pending:
                    return Lang.Proccessing;
                case PaymentStatus.Completed:
                    return Lang.Approved;
                case PaymentStatus.Cancelled:
                    return Lang.Cancelled;
                case PaymentStatus.Approved:
                    return Lang.Approved;
                case PaymentStatus.Rejected:
                    return Lang.Rejected;
                default:
                    return Lang.Unknown;
            }
        }
    }
}

@Html.InlineStyles("~/www/build/styles/css/payment-request.css")

<div class="page-title">
    <span class="text">@Lang.PaymentRequest</span>
</div>

<div class="info-group">
    <div class="title">
        <span class="text">@Lang.PaymentInfor</span>
    </div>
    <div class="payment-info">
        <div id="errorMessage">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="alert alert-@(paymentSuccessfully ? "success" : "danger")" role="alert">@Html.Raw(errorMessage)</p>
            }
        </div>

        @using (Html.BeginForm("CreatePaymentRequest", "UserPanel", FormMethod.Post, new { @id = "requestPayoutForm", @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.BalForward</label>
                <div class="col-sm-3">
                    <p class="form-control-static">@Model.BalBroughtForward.ToStringMoneyWithSymbol()</p>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.MinWithdraw</label>
                <div class="col-sm-3">
                    <p class="form-control-static">@Model.MinAmount.ToStringMoneyWithSymbol()</p>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.RequestAmt</label>
                <div class="col-sm-3">
                    <input type="text" class="form-control" name="Amount" id="Amount" @(canRequest ? string.Empty : "disabled") autocomplete="off" />
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-offset-3 col-sm-5">
                    @if (canRequest)
                    {
                        <button id="btnRequestPayout" type="button" class="btn btn-submit">@Lang.RequestPayout</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-submit disabled" disabled>@Lang.RequestPayout</button>
                    }
                </div>
            </div>

            @Html.HiddenFor(p => p.BalBroughtForward)
            @Html.HiddenFor(p => p.MinAmount)
        }
    </div>
</div>

@if (Model.PendingPayment != null)
{
    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.PendingRequest</span>
        </div>

        @using (Html.BeginForm("CancelPaymentRequest", "UserPanel", FormMethod.Post, new { @id = "cancelPaymentForm" }))
        {
            @Html.AntiForgeryToken()
            <div class="table payment-history">
                <table>
                    <thead>
                        <tr>
                            <th width="20%">@Lang.DateRequest</th>
                            <th width="20%">@Lang.RequestAmount</th>
                            <th width="20%">@Lang.Status</th>
                            <th width="20%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-center">@Model.PendingPayment.TransDate.ToString("MM/dd/yyyy hh:mm:ss tt")</td>
                            <td class="text-right">@Model.PendingPayment.Amount.ToStringMoneyWithSymbol()</td>
                            <td class="text-center">@ConvertStatus(Model.PendingPayment.Status)</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-submit" id="cancelPaymentRequest" data-transid="@Model.PendingPayment.TransId">@Lang.CancelRequest</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <input type="hidden" name="TransId" id="TransId" value="@Model.PendingPayment.TransId" />
            <input type="hidden" name="Amount" id="Amount" value="@Convert.ToDouble(Model.PendingPayment.Amount)" />
            <input type="hidden" name="RequestDate" id="RequestDate" value="@Model.PendingPayment.TransDate.ToString("MM/dd/yyyy")" />
        }
    </div>
}

<div class="info-group">
    <div class="title">
        <span class="text">@Lang.RecentPayment</span>
    </div>

    <div class="payment-history table">
        <table>
            <thead>
                <tr>
                    <th width="10%">@Lang.RefNo</th>
                    <th width="10%">@Lang.DateRequest</th>
                    <th width="10%">@Lang.RequestAmount</th>
                    <th width="10%">@Lang.PaymentMethod</th>
                    <th width="10%">@Lang.CompletedDate</th>
                    <th width="10%">@Lang.Status</th>
                    <th width="20%">@Lang.Description</th>
                </tr>
            </thead>
            <tbody>
                @{
                    if (hasData)
                    {
                        foreach (var item in Model.PaymentList)
                        {
                            <tr>
                                <td class="text-center">@item.TransId</td>
                                <td class="text-center">@item.TransDate.ToString("MM/dd/yyyy")</td>
                                <td class="text-right">@item.Amount.ToStringMoneyWithSymbol()</td>
                                <td class="text-center">@paymentMethod</td>
                                <td class="text-center">@item.CompletedDate.ToString("MM/dd/yyyy")</td>
                                <td class="text-center text-bold">@ConvertStatus(item.Status)</td>
                                <td>@item.AffDesc</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>

        @if (!hasData)
        {
            <p class="text-center">@Lang.NoInfo</p>
        }
    </div>
</div>

<script type="text/javascript">
    var resourceLang = {
        invalidRange: '@($"{Lang.AmtErr} {Model.MinAmount.ToStringMoneyWithSymbol()} {Lang.And} {Model.BalBroughtForward.ToStringMoneyWithSymbol()}")',
        invalidAmount: '@Error.PaymentAmountInvalid'
    }
</script>

<script src="@Url.RenderLink("~/www/build/js/payment-request.js")"></script>