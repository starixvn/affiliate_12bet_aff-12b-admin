@{
    Layout = null;
}

<link href="~/www/build/styles/css/payment-request.css" rel="stylesheet" />

<div class="page-title">
    <span class="text">@Lang.PaymentRequest</span>
</div>

<div class="info-group">
    <div class="title">
        <span class="text">@Lang.PaymentInfor</span>
    </div>
    <div class="payment-info">
        <p class="alert alert-success" id="message" role="alert">Well done! You successfully read this important alert message.</p>

        <form class="form-horizontal">
            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.BalForward</label>
                <div class="col-sm-3">
                    <p class="form-control-static">$5,000.00</p>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.MinWithdraw</label>
                <div class="col-sm-3">
                    <p class="form-control-static">$100.00</p>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.RequestAmt</label>
                <div class="col-sm-3">
                    <input type="text" class="form-control" id="requestAmount" />
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-offset-3 col-sm-5">
                    <button type="button" class="btn btn-submit">@Lang.RequestPayout</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="info-group">
    <div class="title">
        <span class="text">@Lang.RecentPayment</span>
    </div>

    <div class="payment-history table">
        <table>
            <thead>
                <tr>
                    <th>@Lang.RefNo</th>
                    <th>@Lang.DateRequest</th>
                    <th>@Lang.RequestAmount</th>
                    <th>@Lang.PaymentMethod</th>
                    <th>@Lang.CompletedDate</th>
                    <th>@Lang.Status</th>
                    <th>@Lang.Description</th>
                </tr>
            </thead>
            <tbody>
