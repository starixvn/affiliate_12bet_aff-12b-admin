@model IEnumerable<Fanex.Affiliate.User.Core.DTO.UserPanel.StatementHistory>

<div class="table">
    <table>
        <thead>
            <tr>
                <th width="5%"></th>
                <th>@Lang.Date</th>
                <th>@Lang.Type</th>
                <th>@Lang.Amount</th>
                <th>@Lang.Status</th>
                <th>@Lang.Description</th>
            </tr>
        </thead>
        <tbody>
            @{
                var index = (int)ViewBag.StartRowNumber;

                foreach (var item in Model)
                {
                    <tr>
                        <td>@index</td>
                        <td class="text-bold">@item.DateString</td>
                        <td>@item.TransTypeString</td>
                        <td class="text-right">
                            @if (item.IsLink)
                            {
                                <a class="amountItem" data-transid="@item.TransId" href="javascript:;">@item.Amount.ToStringMoneyWithSymbol()</a>
                            }
                            else
                            {
                                @item.Amount.ToStringMoneyWithSymbol()
                            }
                        </td>
                        <td class="text-center">@item.DisplayStatus</td>
                        <td>@item.Description</td>
                    </tr>

                    index++;
                }
            }
        </tbody>
    </table>
</div>

<input type="hidden" id="TotalItem" value="@ViewBag.TotalItem" />

