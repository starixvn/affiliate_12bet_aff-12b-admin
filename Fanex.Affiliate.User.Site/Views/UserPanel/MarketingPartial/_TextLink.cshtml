@{
    Layout = null;
}

@model IDictionary<string, string>

<div class="form-horizontal">
    @foreach (var item in Model)
    {
        <div class="form-group">
            <label class="col-sm-2 control-label">@item.Key</label>
            <div class="col-sm-4">
                <p class="form-control-static">
                    <a href="#">@item.Value</a>
                </p>
            </div>
        </div>
    }
</div>