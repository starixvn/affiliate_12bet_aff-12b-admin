@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.LinkFormViewModel

<div class="info-group">
    <div class="title">
        <span class="text">@Lang.TextLink</span>
    </div>

    <div class="link-container">
        <div class="form-horizontal">
            <div class="form-group">
                <label class="col-sm-2 control-label">@Lang.AvailableDomains</label>
                <div class="col-sm-4">
                    @if (Model.DomainList != null && Model.DomainList.Any())
                    {
                        <select class="form-control" id="Domain">
                            @foreach (var item in Model.DomainList)
                            {
                                <option value="@item.DomainId">@item.DomainName</option>
                            }
                        </select>
                    }
                    else
                    {
                        <p class="form-control-static">@Lang.NoInfo</p>
                    }
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-2 control-label">@Lang.LinkTo</label>
                <div class="col-sm-4">
                    <select class="form-control" id="MemberSitePage">
                        @foreach (var item in Model.MemberSitePageList)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-sm-1">
                    <button type="button" class="btn btn-submit">@Lang.GenerateLink</button>
                </div>
            </div>
        </div>
    </div>
</div>
