@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Statistics.TrackingStatisticsViewModel

<table style="table-layout: fixed">
    <thead>
        <tr>
            <th width="10%"></th>
            <th width="30%">@Lang.Month</th>
            <th width="30%">@Lang.TotalClick</th>
            <th width="30%">@Lang.UniqueClick</th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model.TrackingStatisticsList != null && Model.TrackingStatisticsList.Any())
            {
                var index = 1;
                foreach (var item in Model.TrackingStatisticsList)
                {
                    <tr>
                        <td class="text-center">@index</td>
                        <td class="text-center">
                            @if (Model.IsDetail)
                            {
                                @item.Date.ToString("MM-dd-yyyy")
                            }
                            else
                            {
                                <a href="javascript:;" data-date="@item.Date.ToString("MM/dd/yyyy")" class="statisticsItem">@item.Month</a>
                            }
                        </td>
                        <td class="text-right">@item.TotalClick.ToStringNumber()</td>
                        <td class="text-center">@item.UniqueClick.ToStringNumber()</td>
                    </tr>

                    index++;
                }
            }
            else
            {
                <tr>
                    <td class="text-center" colspan="4">@Lang.NoInfo</td>
                </tr>
            }
        }
    </tbody>
</table>

