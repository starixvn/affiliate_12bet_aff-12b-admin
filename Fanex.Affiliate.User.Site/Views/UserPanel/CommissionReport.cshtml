@{
    Layout = null;
    var currentYear = DateTime.Now.Year;
}

@Html.InlineStyles("~/www/build/styles/css/pages/commissionreport.css")

<div class="page-title">
    <span class="text">@Lang.CommissionReport</span>
</div>
<div class="info-group">
    <div class="panel custom-panel">
        <div class="panel-body">
            <form class="form-inline form-filter">
                <div class="form-group">
                    <label>@Lang.Year</label>
                    <select class="form-control" id="year">

                        @for (var i = 2009; i <= currentYear; i++)
                        {
                            var temp = i == currentYear ? "selected='selected'" : string.Empty;
                            <option @temp value="@i">@i</option>
                        }
                    </select>
                    <button type="button" style="margin-left:3px;" class="btn btn-submit" id="btnSubmit">@Lang.Submit</button>
                </div>
            </form>
        </div>
    </div>


    <div class="report-container">

    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/pages/commission-report.js")"></script>