@using Fanex.Affiliate.User.Core.Extensions

@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.DTO.UserPanel.AccountOverviewStatistics
@{ 
    var statistics = Model;
}

@section styles{

}

<div class="page-title">
    <span class="text">@Lang.AccOverview</span>
</div>

<div class="info-group">
    <div class="title">
        <span class="text">@(Lang.Statistic + " " + Lang.For) January - 2018</span>
        <div class="day-filter">
            <div class="form-group day-filter">
                <div class="input-group date" id="datetimepicker1">
                    <input type="text" class="field" />
                    <span class="input-group-addon icon-calendar mdi mdi-calendar">
                    </span>
                </div>
            </div>
            <button class="btn btn-submit" type="button">@Lang.Submit</button>
        </div>
    </div>
    <div class="info">
        <p class="item">
            <span class="text">@Lang.NewSignup:</span>
            <span class="value">@statistics.NewSignup.ToStringNumber()</span>
        </p>
        <p class="item">
            <span class="text">@Lang.TotalActive:</span>
            <span class="value">@statistics.TotalActivePlayer.ToStringNumber()</span>
        </p>
        <p class="item">
            <span class="text">@Lang.Tqacsbc:</span>
            <span class="value">@statistics.TotalQualifiedActivePlayer.ToStringNumber()</span>
        </p>
        <p class="item">
            <span class="text">@Lang.TotalDeposit:</span>
            <span class="value">@statistics.TotalDeposit.ToStringMoneyWithSymbol()</span>
        </p>
        <p class="item">
            <span class="text">@Lang.Turnover:</span>
            <span class="value">@statistics.Turnover.ToStringMoneyWithSymbol()</span>
        </p>
    </div>
</div>

<div class="info-group">
    <div class="title">
        <span class="text">@(Lang.Statistic + " " + Lang.UpToNow)</span>
    </div>
    <div class="info">
        <p class="item">
            <span class="text">@Lang.TotalPlay:</span>
            <span class="value">@statistics.TotalPlayerUpToNow.ToStringNumber()</span>
        </p>
        <p class="item">
            <span class="text">@Lang.Turnover:</span>
            <span class="value">@statistics.TurnoverUpToNow.ToStringMoneyWithSymbol()</span>
        </p>
        <p class="item">
            <span class="text">@Lang.TotalDeposit:</span>
            <span class="value">@statistics.TotalDepositUpToNow.ToStringMoneyWithSymbol()</span>
        </p>
        <p class="item">
            <span class="text">@Lang.BalForward:</span>
            <span class="value">@statistics.BalanceBroughtForward.ToStringMoneyWithSymbol()</span>
        </p>
    </div>
</div>

<div class="info-group">
    <div class="title">
        <span class="text">@Lang.CurrentCommissiSetting</span>
    </div>
    <div class="table table-medium">
        <table>
            <thead>
                <tr>
                    <th>@Lang.Sport</th>
                    <th>@Lang.Tier</th>
                    <th class="text-uppercase">@Lang.NetWinLoss</th>
                    <th>@Lang.QualifyingMem</th>
                    <th>@Lang.Comm</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="bg-sportsbook" rowspan="3">Sportsbook</td>
                    <td>1</td>
                    <td class="text-right">$1.00 - $2,99.99</td>
                    <td class="text-right">6 - 10</td>
                    <td class="text-right">20%</td>
                </tr>
                <tr>
                    <td>2</td>
                    <td class="text-right">$3,000.00 - $45,000.99</td>
                    <td class="text-right">11 - 50</td>
                    <td class="text-right">30%</td>
                </tr>
                <tr>
                    <td>3</td>
                    <td class="text-right">$3,000.00 - $45,000.99</td>
                    <td class="text-right">11 - 50</td>
                    <td class="text-right">30%</td>
                </tr>
                <tr>
                    <td class="bg-casino" rowspan="3">Casino</td>
                    <td>1</td>
                    <td class="text-right">$1.00 - $2,99.99</td>
                    <td class="text-right">6 - 10</td>
                    <td class="text-right">20%</td>
                </tr>
                <tr>
                    <td>2</td>
                    <td class="text-right">$3,000.00 - $45,000.99</td>
                    <td class="text-right">11 - 50</td>
                    <td class="text-right">30%</td>
                </tr>
                <tr>
                    <td>3</td>
                    <td class="text-right">$3,000.00 - $45,000.99</td>
                    <td class="text-right">11 - 50</td>
                    <td class="text-right">30%</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>