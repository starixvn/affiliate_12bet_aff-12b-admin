@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.MarketingViewModel

<div class="form-group">
    <label class="col-sm-2 control-label">@Lang.Category</label>
    <div class="col-sm-4">
        <select class="form-control">
            @foreach (var item in Model.CategoryList)
            {
                <option value="@item.Value">@item.Text</option>
            }
        </select>
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">@Lang.Language</label>
    <div class="col-sm-4">
        <select class="form-control">
            @foreach (var item in Model.LanguageList)
            {
                <option value="@item.Value">@item.Text</option>
            }
        </select>
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">@Lang.Currency</label>
    <div class="col-sm-4">
        <select class="form-control">
            @foreach (var item in Model.CurrencyList)
            {
                <option value="@item.Value">@item.Text</option>
            }
        </select>
    </div>
</div>

