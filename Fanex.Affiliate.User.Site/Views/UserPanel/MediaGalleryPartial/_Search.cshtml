@{
    var isBannerView = Model;
}

<div class="info-group">
    <div class="title">
        <span class="text">@Lang.Search</span>
    </div>

    <div class="search-container">
        <form class="form-horizontal">
            <div class="form-group">
                <label class="col-sm-2 control-label">@Lang.Category</label>
                <div class="col-sm-4">
                    <select class="form-control">
                        <option>Casino</option>
                        <option>Number Game</option>
                        <option>Sportsbook</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-2 control-label">@Lang.Language</label>
                <div class="col-sm-4">
                    <select class="form-control">
                        <option>English</option>
                        <option>Indonesia</option>
                        <option>Tiếng Việt</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-2 control-label">@Lang.Currency</label>
                <div class="col-sm-4">
                    <select class="form-control">
                        <option>EUR</option>
                        <option>USD</option>
                        <option>UUS</option>
                    </select>
                </div>
            </div>

            @if (isBannerView)
            {
                <div class="form-group">
                    <label class="col-sm-2 control-label">@Lang.Type</label>
                    <div class="col-sm-4">
                        <select class="form-control">
                            <option>Flash</option>
                            <option>Image</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-2 control-label">@Lang.Size</label>
                    <div class="col-sm-4">
                        <select class="form-control">
                            <option>80x80</option>
                            <option>80x160</option>
                        </select>
                    </div>
                </div>
            }

            <div class="form-group">
                <label class="col-sm-2 control-label">@Lang.Device</label>
                <div class="col-sm-4">
                    <select class="form-control">
                        <option>PC/Laptop</option>
                        <option>Mobile</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-offset-2 col-sm-5">
                    <button type="button" class="btn btn-submit">@Lang.Search</button>
                </div>
            </div>
        </form>
    </div>
</div>
