@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.MarketingViewModel

@Html.InlineStyles("~/www/build/styles/css/media-gallery.css")

<div class="page-title">
    <span class="text">@Lang.Media</span>
</div>

<div id="searchForm">
    @{ Html.RenderPartial("~/Views/UserPanel/MarketingPartial/_Search.cshtml", Model.SearchForm); }
</div>

<div id="linkForm">
    @{ Html.RenderPartial("~/Views/UserPanel/MarketingPartial/_Link.cshtml", Model.LinkForm); }
</div>

<div id="textLinkList">
    @{ Html.RenderPartial("~/Views/UserPanel/MarketingPartial/_TextLink.cshtml", Model.TextLinkList); }
</div>

<div id="bannerList">
    @{ Html.RenderPartial("~/Views/UserPanel/MarketingPartial/_BannerList.cshtml", Model.BannerList); }
</div>