@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.AccountInformationViewModel

@Html.InlineStyles("~/www/build/styles/css/my-account.css")

<div class="account-information" id="accountInfoForm">
    <div class="page-title">
        <span class="text">@Lang.MyAcc</span>
    </div>

    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.AccInfo</span>
        </div>

        <div class="form-horizontal">
            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.Username</label>
                <div class="col-sm-4">
                    <p class="form-control-static">@Model.UserName</p>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.Password</label>
                <div class="col-sm-4">
                    <p class="form-control-static"><a href="@Url.Action("Update", "Password")">@Lang.Change</a></p>
                </div>
            </div>
        </div>
    </div>

    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.ContactInfo</span>
        </div>

        <div class="form-horizontal">
            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.Gender</label>
                <div class="col-sm-4">
                    <label class="radio-inline">
                        <input type="radio" name="Gender" id="male" value="male" @(Model.Gender ? "checked" : string.Empty) disabled /> @Lang.Male
                    </label>
                    <label class="radio-inline">
                        <input type="radio" name="Gender" id="female" value="female" @(!Model.Gender ? "checked" : string.Empty) disabled /> @Lang.Female
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.Address</label>
                <div class="col-sm-4">
                    <p class="form-control-static">@Model.Address</p>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.City</label>
                <div class="col-sm-4">
                    <p class="form-control-static">@Model.City</p>
                </div>
            </div>

            @if (Model.IsRenderState)
            {
                <div class="form-group">
                    <label class="col-sm-3 control-label">@Lang.State</label>
                    <div class="col-sm-4">
                        <p class="form-control-static">@Model.State</p>
                    </div>
                </div>
            }

            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.PostCode</label>
                <div class="col-sm-4">
                    <p class="form-control-static">@Model.Postal</p>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.Country</label>
                <div class="col-sm-4">
                    <p class="form-control-static">@Model.Country</p>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.Email</label>
                <div class="col-sm-4">
                    <p class="form-control-static">@Model.Email</p>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 require control-label">@Lang.ContactNumber</label>
                <div class="col-sm-4">
                    <input id="txtContactNumber" class="form-control" type="text" value="@Model.Phone" />
                </div>
                <div class="col-sm-offset-3 col-sm-9">
                    <span class="help-block hide">@Lang.errContactNumberEmpty</span>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 require control-label">@Lang.Mobile</label>
                <div class="col-sm-4">
                    <input id="txtMobile" class="form-control" type="text" value="@Model.MobilePhone" />
                </div>
                <div class="col-sm-offset-3 col-sm-9">
                    <span class="help-block hide">@Lang.errMobileNumberEmpty</span>
                </div>
            </div>
        </div>
    </div>

    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.WebsiteInformat</span>
        </div>

        <div class="form-horizontal">
            <div class="form-group">
                <div class="col-sm-4">
                    <label class="radio-inline">
                        <input type="radio" name="HasWebSite" id="hasWebSite" value="1" @(string.IsNullOrEmpty(Model.SiteUrl) ? string.Empty : "checked") /> @Lang.OwnWebsite
                    </label>
                </div>
            </div>

            <div id="websiteInfo">
                <div class="form-group">
                    <label class="col-sm-3 control-label require">@Lang.WebsiteURL</label>
                    <div class="col-sm-4">
                        <input id="txtSiteUrl" class="form-control" type="text" value="@Model.SiteUrl" @(string.IsNullOrEmpty(Model.SiteUrl) ? "disabled" : string.Empty) />
                    </div>
                    <div class="col-sm-1">
                        <button type="button" id="btnAddUrl" class="btn btn-submit" @(string.IsNullOrEmpty(Model.SiteUrl) ? "disabled" : string.Empty)>@Lang.AddUrl</button>
                    </div>

                    <div class="col-sm-offset-3 col-sm-9">
                        <span class="help-block hide">@Lang.WebsiteURLIsRequired</span>
                    </div>
                </div>

                @if (Model.MoreWebsiteUrlList.Any())
                {
                    var index = 2;
                    foreach (var item in Model.MoreWebsiteUrlList)
                    {
                            <div class="form-group websiteInput" style="display: @(string.IsNullOrEmpty(Model.SiteUrl) ? "none" : "block")">
                                <label class="col-sm-3 control-label require moreWebsiteLabel">@Lang.WebsiteURL @(index)</label>
                                <div class="col-sm-4">
                                    <input class="form-control urlInput" type="text" value="@item" />
                                </div>
                                <div class="col-sm-1">
                                    <button type="button" class="btn btn-submit btnDeleteUrl">@Lang.Del</button>
                                </div>
                                <div class="col-sm-offset-3 col-sm-9">
                                    <span class="help-block hide">@Lang.WebsiteUrli.Replace("{i}", index.ToString())</span>
                                </div>
                            </div>

                            index++;
                    }
                }
            </div>

            <div class="form-group">
                <div class="col-sm-4">
                    <label class="radio-inline">
                        <input type="radio" name="HasWebSite" id="hasNoWebSite" value="0" @(string.IsNullOrEmpty(Model.SiteUrl) ? "checked" : string.Empty)> @Lang.NoWebsite
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label require">@Lang.DescWebsite</label>
                <div class="col-sm-4">
                    <textarea id="txtNoSiteDesc" class="form-control" rows="5" @(string.IsNullOrEmpty(Model.SiteUrl) ? string.Empty : "disabled")>@Model.NoSiteDesc</textarea>
                </div>
                <div class="col-sm-offset-3 col-sm-9">
                    <span class="help-block hide">@Lang.DescWebsite</span>
                </div>
            </div>
        </div>
    </div>

    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.Preference</span>
        </div>
        <div class="form-horizontal">
            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.Language</label>
                <div class="col-sm-4">
                    <p class="form-control-static">@Model.LanguageName</p>
                </div>
            </div>
        </div>
    </div>

    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.PaymentInfor</span>
        </div>
        <div class="form-horizontal">
            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.PaymentMethod</label>
                <div class="col-sm-4">
                    <label class="radio-inline">
                        <input type="radio" checked /> @Lang._12BETPlayerAcc
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label @(string.IsNullOrEmpty(Model.PlayerUsername) ? "require" : string.Empty)">@Lang.Username</label>
                <div class="col-sm-4">
                    @if (string.IsNullOrEmpty(Model.PlayerUsername))
                    {
                        <input id="txtPlayerUserName" class="form-control" type="text" value="" />
                    }
                    else
                    {
                        <p class="form-control-static">@Model.PlayerUsername</p>
                    }
                </div>
                <div class="col-sm-offset-3 col-sm-9">
                    <span class="help-block hide">@Lang.BETUserNameIsRequired</span>
                </div>
            </div>

            <div class="col-sm-offset-3 button-block">
                <button id="btnMyAccountSubmit" class="btn btn-submit" type="button">@Lang.Submit</button>
                <button id="btnCancel" class="btn btn-submit" type="button">@Lang.Cancel</button>
            </div>
        </div>
    </div>
</div>

<script>
    var LangResource = {
        websiteUrl: '@Lang.WebsiteURL',
        deleteUrl: '@Lang.Del',
        requireSiteUrl: '@Lang.WebsiteURLIsRequired',
        requiredMoreWebSiteUrl: '@Lang.WebsiteUrli',
        updateSuccessfully: '@Lang.UpdateAccSuccess'
    }
</script>

@Html.InlineScripts("~/www/build/js/myaccount.js")