@{
    Layout = null;
}

<div class="page-title">
    <span class="text">@Lang.MyAcc</span>
</div>

<div class="info-group">
    <div class="title">
        <span class="text">@Lang.AccInfo</span>
    </div>

    <div class="form-horizontal">
        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.Username</label>
            <div class="col-sm-4">
                <p class="form-control-static">12BETAFF001</p>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.Password</label>
            <div class="col-sm-4">
                <p class="form-control-static"><a href="javascript:;">Change</a></p>
            </div>
        </div>
    </div>
</div>

<div class="info-group">
    <div class="title">
        <span class="text">@Lang.ContactInfo</span>
    </div>

    <div class="form-horizontal">
        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.Gender</label>
            <div class="col-sm-4">
                <label class="radio-inline">
                    <input type="radio" name="Gender" id="male" value="male"> @Lang.Male
                </label>
                <label class="radio-inline">
                    <input type="radio" name="Gender" id="female" value="female"> @Lang.Female
                </label>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.Address</label>
            <div class="col-sm-4">
                <p class="form-control-static">123, SMS</p>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.City</label>
            <div class="col-sm-4">
                <p class="form-control-static">Ho Chi Minh</p>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.PostCode</label>
            <div class="col-sm-4">
                <p class="form-control-static">123456</p>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.Country</label>
            <div class="col-sm-4">
                <p class="form-control-static">Việt Nam</p>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.Email</label>
            <div class="col-sm-4">
                <p class="form-control-static">walter.tran@starixsoft.com</p>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.ContactNumber</label>
            <div class="col-sm-4">
                <input class="form-control" type="text" value="123456" />
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">MSN</label>
            <div class="col-sm-4">
                <input class="form-control" type="text" value="987456" />
            </div>
        </div>
    </div>
</div>

<div class="info-group">
    <div class="title">
        <span class="text">@Lang.WebsiteInformat</span>
    </div>

    <div class="form-horizontal">
        <div class="form-group">
            <div class="col-sm-4">
                <label class="radio-inline">
                    <input type="radio" name="HasWebSite" id="hasWebSite"> @Lang.OwnWebsite
                </label>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.WebsiteURL</label>
            <div class="col-sm-4">
                <input class="form-control" type="text" value="http://10.19.10.46:5005/xook.html" />
            </div>
            <div class="col-sm-1">
                <button type="button" class="btn btn-submit">@Lang.AddUrl</button>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.WebsiteURL 2</label>
            <div class="col-sm-4">
                <input class="form-control" type="text" value="http://10.19.10.46:5005/xook.html0W45pz4p" />
            </div>
            <div class="col-sm-1">
                <button type="button" class="btn btn-submit">@Lang.Del</button>
            </div>
        </div>

        <div class="form-group">
            <div class="col-sm-4">
                <label class="radio-inline">
                    <input type="radio" name="HasWebSite" id="hasNoWebSite"> @Lang.NoWebsite
                </label>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.DescWebsite</label>
            <div class="col-sm-4">
                <textarea class="form-control" rows="5"></textarea>
            </div>
        </div>
    </div>
</div>

<div class="info-group">
    <div class="title">
        <span class="text">@Lang.Preference</span>
    </div>
    <div class="form-horizontal">
        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.Language</label>
            <div class="col-sm-4">
                <p class="form-control-static">Republic of India</p>
            </div>
        </div>
    </div>
</div>

<div class="info-group">
    <div class="title">
        <span class="text">@Lang.PaymentInfor</span>
    </div>
    <div class="form-horizontal">
        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.PaymentMethod</label>
            <div class="col-sm-4">
                <label class="radio-inline">
                    <input type="radio" checked /> @Lang._12BETPlayerAcc
                </label>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.Username</label>
            <div class="col-sm-4">
                <p class="form-control-static">qatest01 (@Lang.NonDeposit)</p>
            </div>
        </div>

        <div class="col-sm-offset-3">
            <button class="btn btn-submit" type="button">Submit</button>
            <button class="btn btn-submit" type="button">Cancel</button>
        </div>
    </div>
</div>