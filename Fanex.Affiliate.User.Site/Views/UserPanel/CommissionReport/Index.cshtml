@{
    Layout = null;
    var currentYear = DateTime.Now.Year;
}

@Html.InlineStyles("~/www/build/styles/css/pages/commissionreport.css")

<div class="page-title">
    <span class="text">@Lang.CommissionReport</span>
</div>
<div class="info-group">
    <div class="panel custom-panel">
        <div class="panel-body">
            <form class="form-inline form-filter">
                <div class="form-group">
                    <label>@Lang.Year</label>
                    <select class="form-control" id="year">

                        @for (var i = 2009; i <= currentYear; i++)
                        {
                            var temp = i == currentYear ? "selected='selected'" : string.Empty;
                            <option @temp value="@i">@i</option>
                        }
                    </select>
                    <button type="button" style="margin-left:3px;" class="btn btn-submit" id="btnSubmit">@Lang.Submit</button>
                </div>
            </form>
        </div>
    </div>


    <div class="report-container">
        <div class="table">
            <table style="table-layout: fixed" id="dataTable">
                <thead>
                    <tr>
                        <th class="th" width="3%">#</th>
                        <th class="th" data-name="Month" width="27%">@Lang.Month</th>
                        <th class="th" data-name="TurnOver" width="11%">@Lang.Turnover</th>
                        <th class="th" data-name="WinLoss" width="11%">@Lang.GrossWinLoss</th>
                        <th class="th" data-name="PlatformFee" width="8%">@Lang.PlatformFee</th>
                        <th class="th" data-name="OperationalFee" width="8%">@Lang.OperationalFee</th>
                        <th class="th" data-name="BankingFee" width="8%">@Lang.BankingFees</th>
                        <th class="th" data-name="Bonus" width="8%">@Lang.Bonus</th>
                        <th class="th" data-name="CommissionRate" width="8%">@Lang.CommRate</th>
                        <th class="th" data-name="Commission" width="8%">@Lang.Comm</th>

                    </tr>
                </thead>
                <tbody id="reportData">                  
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    var langResource = {
        noInfo: '@Lang.NoInfo'
    }
</script>

<script src="@Url.RenderLink("~/www/build/js/pages/commission-report.js")"></script>