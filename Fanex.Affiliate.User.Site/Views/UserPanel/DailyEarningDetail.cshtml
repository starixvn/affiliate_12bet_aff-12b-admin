@{
    Layout = null;

    var lastDateOfMonth = new DateTime(Model.SelectedDate.Year, Model.SelectedDate.Month + 1, 1).AddDays(-1);
}
<link href="@Url.RenderLink("~/www/build/styles/css/dailyearning-detail.css")" rel="stylesheet" />

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.DailyEarningDetailViewModel

<div class="page-title">
    <span class="text">@Lang.DailyEarningDetail</span>
</div>

<div>
    <div class="breadcrumb-container">
        <ol class="breadcrumb" id="dailyEarningBreadcrumb">
            <li><a href="@(Url.Action("Index", "UserPanel") + "/#StatementHistory")">@Lang.StatementHistory</a></li>
            <li>
                <a href="@(Url.Action("Index", "UserPanel") + "/#DailyEarning?monthDate=" + HttpUtility.UrlEncode(lastDateOfMonth.ToString("MM/dd/yyyy")))">
                    @Model.SelectedDate.ToString("MMMM yyyy")
                </a>
            </li>
        </ol>
    </div>

    <form class="form-inline form-filter">
        <div class="form-group">
            <label class="w100">@Lang.SelectDate:</label>
            <div id="datePicker" class="date-wrapper">
                <input readonly id="MonthDate" class="form-control" type="text" value="@Model.SelectedDate.ToString("MM/dd/yyyy")" />
                <span class="glyphicon glyphicon-calendar"></span>
            </div>
        </div>
        @if (Model.SportTypeList != null && Model.SportTypeList.Count() > 1)
        {
            <div class="form-group">
                <label class="w100">@Lang.SportType:</label>
                <select class="form-control" id="SportType">
                    <option value="0">@Lang.All</option>
                    @foreach (var item in Model.SportTypeList)
                    {
                        <option value="@item.SportId" @(item.SportId == Model.SelectedSportType ? "selected" : string.Empty)>@item.SportName</option>
                    }
                </select>
            </div>
        }
        <button type="button" class="btn btn-submit" id="btnEarningDetailSubmit">@Lang.Submit</button>
    </form>

    <div class="table" id="dailyEarningDetailContent">
        @{ Html.RenderPartial("~/Views/UserPanel/StatementHistoryPartial/_DailyEarningDetailContent.cshtml", Model); }
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/daily-earning-detail.js")"></script>
