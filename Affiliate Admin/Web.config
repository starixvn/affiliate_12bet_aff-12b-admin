      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <system.serviceModel>
    <behaviors>
      <endpointBehaviors>
        <behavior name="GroupSettingAspNetAjaxBehavior">
          <enableWebScript/>
        </behavior>
      </endpointBehaviors>
    </behaviors>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true"/>
    <services>
      <service name="GroupSetting">
        <endpoint address="" behaviorConfiguration="GroupSettingAspNetAjaxBehavior" binding="webHttpBinding" contract="GroupSetting"/>
      </service>
    </services>
  </system.serviceModel>
</configuration>
