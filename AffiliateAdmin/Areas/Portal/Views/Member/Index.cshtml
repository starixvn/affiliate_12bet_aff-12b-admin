@{
    Layout = "~/Areas/Portal/Views/Shared/_Layout.cshtml";
}
@model IEnumerable<Fanex.Affiliate.Admin.Core.DTO.SubMenu>

@{
    var queryString = Request.QueryString.ToString();
    var defaultRelativeUrl = "~/UserInfo/MemberListAll.aspx?" + queryString;
}

<div class="sub-menu-container">
    <div class="d-inline-block">
        <img src="~/Areas/Portal/www/dist/imgs/i_member.png" />
    </div>
    <div class="d-inline-block">
        @{
            Html.RenderPartial("~/Areas/Portal/Views/Shared/_SubMenu.cshtml", Model);
        }
    </div>
</div>

<div class="mainFrameWrapper">
    <iframe frameborder="0" name="mainFrame" id="mainFrame" src="@Url.Content(defaultRelativeUrl)"></iframe>
</div>