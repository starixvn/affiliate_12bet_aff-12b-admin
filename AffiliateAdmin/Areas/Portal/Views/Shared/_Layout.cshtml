<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="~/Areas/Portal/www/dist/style/bootstrap.css" rel="stylesheet" />
    <link href="~/Areas/Portal/www/dist/style/portalmain.css" rel="stylesheet" />
    <link href="~/Areas/Portal/www/dist/style/layout.css" rel="stylesheet" />
    <title>Affiliate Admin</title>
</head>
<body>
    <div class="body-container">
        <header class="header">
            @{ Html.RenderPartial("~/Areas/Portal/Views/Shared/_Header.cshtml"); }
        </header>
        <div class="main-menu-container">
            @{ Html.RenderPartial("~/Areas/Portal/Views/Shared/_MainMenu.cshtml"); }
        </div>
        <div class="main-container">
            @RenderBody()
        </div>

        <footer class="footer" style="position: fixed; bottom: 0; left: 0; right: 0; height: 25px; text-align: right;">
            <span style="padding: 5px 15px; font-size: 11px; font-family: Arial, Helvetica, sans-serif">&copy; Copyright @DateTime.Now.Year Pacific Sea Invests</span>
        </footer>
    </div>
    <script src="~/Areas/Portal/www/dist/jquery-3.3.1.min.js"></script>
    <script src="~/Areas/Portal/www/dist/pagelayout.min.js"></script>
</body>
</html>