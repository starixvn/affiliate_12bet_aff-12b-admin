
@model IEnumerable<Fanex.Affiliate.Admin.Core.DTO.SubMenu>
<ul class="nav">
    @{ var isFirst = true; }
    @foreach (var item in Model)
    {
        <li class="nav-item">
            <a class="nav-link @(isFirst? "active" : string.Empty)" href="@item.Url" target="mainFrame">@item.Name</a>
        </li>

        isFirst = false;
    }
</ul>