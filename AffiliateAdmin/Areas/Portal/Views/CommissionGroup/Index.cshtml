@{
    Layout = "~/Areas/Portal/Views/Shared/_SinglePageLayout.cshtml";
}
@model Fanex.Affiliate.Admin.Core.ViewModels.CommissionGroupViewModel

@section styles{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/commission-group.css")" rel="stylesheet" />
}

@section scripts{
    <script type="text/javascript">
        window.initialState = {
            productList: @Html.Raw(Json.Encode(Model.ProductList)),
            deductionList: @Html.Raw(Json.Encode(Model.DeductionList))
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/commission-group.js")"></script>
}

<div id="root"></div>