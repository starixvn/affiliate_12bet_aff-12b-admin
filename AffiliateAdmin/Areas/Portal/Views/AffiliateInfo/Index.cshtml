@{
    Layout = "~/Areas/Portal/Views/Shared/_SinglePageLayout.cshtml";
}

@model Fanex.Affiliate.Admin.Core.ViewModels.Affiliate.AffiliateInfoViewModel

@section styles{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/affiliate-info.css")" rel="stylesheet"/>
}

@section scripts{
    <script type="text/javascript">
        window.initialState = {
            commGroupList: @Html.Raw(Json.Encode(Model.CommGroupList)),
            languageList: @Html.Raw(Json.Encode(Model.LanguageList)),
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/affiliate-info.js")"></script>
}

<div id="root"></div>

