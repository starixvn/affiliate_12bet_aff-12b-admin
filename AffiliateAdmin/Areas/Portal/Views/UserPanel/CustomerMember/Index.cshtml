@{
    Layout = "~/Areas/Portal/Views/Shared/_UserPanelLayout.cshtml";
}

@using Fanex.Affiliate.Admin.Core.Constants
@model Fanex.Affiliate.Admin.Core.ViewModels.UserPanel.CustomerMemberViewModel

@section styles{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/user-panel/customer-member.css")" rel="stylesheet" />
}

@section scripts{
    <script type="text/javascript">
        window.initialState = {
            today: '@DateTime.Now.ToString("MM/dd/yyyy")',
            canViewMemberEmail: @Model.CanViewMemberEmail.ToString().ToLowerInvariant()
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/userpanel/customer-member.js")"></script>
}

@section menu{
    @{
        var menuList = UserPanelConstant.UserPanelMenuList;
        menuList.ElementAt(6).IsActive = true;
        Html.RenderPartial("~/Areas/Portal/Views/Shared/_UserPanelMenu.cshtml", menuList);
    }
}

<div id="root"></div>

