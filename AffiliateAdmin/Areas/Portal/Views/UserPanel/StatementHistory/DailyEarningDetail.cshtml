@{
    Layout = "~/Areas/Portal/Views/Shared/_UserPanelLayout.cshtml";
}
@using Fanex.Affiliate.Admin.Core.Constants

@model Fanex.Affiliate.Admin.Core.ViewModels.UserPanel.DailyEarningViewModel

@{
    var monthDateString = Model.Param.MonthDate.ToString("MM/dd/yyyy");
    var queryString = "AffId=" + Model.Param.AffId + "&MonthDate=" + monthDateString + "&ProductId=" + Model.Param.ProductId;
}

@section styles{
}

@section scripts{
    <script type="text/javascript">
        window.initialState = {
            productList: @Html.Raw(Json.Encode(Model.ProductList)),
            param: {AffId: @Model.Param.AffId, ProductId: @Model.Param.ProductId, MonthDate: '@monthDateString'}
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/userpanel/daily-earning-detail.js")"></script>
}

@section menu{
    @{
        var menuList = UserPanelConstant.UserPanelMenuList;
        menuList.ElementAt(0).IsActive = true;
        Html.RenderPartial("~/Areas/Portal/Views/Shared/_UserPanelMenu.cshtml", menuList);
    }
}

<div class="breadcrumb-container">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Content("~/UserInfo/EarningsHistory.aspx")">Statement History</a></li>
        <li class="breadcrumb-item">
            <a href="@Url.Content("~/Portal/UserPanel/StatementHistory/DailyEarning?" + queryString)">@Model.Param.MonthDate.ToString("MMMM yyyy")</a>
        </li>
        <li class="breadcrumb-item active">@Model.Param.MonthDate.ToString("dd MMMM yyyy")</li>
    </ol>
</div>

<div id="root"></div>