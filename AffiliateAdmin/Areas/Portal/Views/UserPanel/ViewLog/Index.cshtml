
@{
    Layout = "~/Areas/Portal/Views/Shared/_UserPanelLayout.cshtml";
}

@using Fanex.Affiliate.Admin.Core.Constants
@using Fanex.Affiliate.Admin.Core.ViewModels.UserPanel
@model Fanex.Affiliate.Admin.Core.MetaModels.UserPanel.AffiliateLinkParam
@section styles{
    <script type="text/javascript">
        window.initialState = {
            today: '@DateTime.Now.ToString("MM/dd/yyyy")',
            param: { AffId: @Model.AffId }
        }
    </script>
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/user-panel/view-log.css")" rel="stylesheet" />
}

@section scripts{
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/userpanel/view-log.js")"></script>
}

@section menu{
    @{
        var usePanelMenu = new UserPanelMenuViewModel
        {
            SubMenuList = UserPanelConstant.UserPanelMenuList,
            AffiliateLinkParam = Model
        };
        usePanelMenu.SubMenuList.ElementAt(7).IsActive = true;
        Html.RenderPartial("~/Areas/Portal/Views/Shared/_UserPanelMenu.cshtml", usePanelMenu);
    }
}

<div id="root"></div>

