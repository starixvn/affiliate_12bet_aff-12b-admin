@{
    Layout = "~/Areas/Portal/Views/Shared/_UserPanelLayout.cshtml";
}

@using Fanex.Affiliate.Admin.Core.Constants

@section styles{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/user-panel/member.css")" rel="stylesheet" />
}

@section scripts{
    <script type="text/javascript">
        window.initialState = {
            currentDate: '@DateTime.Now.ToString("MM/dd/yyyy")'
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/userpanel/member.js")"></script>
}

@section menu{
    @{
        var menuList = UserPanelConstant.UserPanelMenuList;
        menuList.ElementAt(6).IsActive = true;
        Html.RenderPartial("~/Areas/Portal/Views/Shared/_UserPanelMenu.cshtml", menuList);
    }
}

<div id="root"></div>

