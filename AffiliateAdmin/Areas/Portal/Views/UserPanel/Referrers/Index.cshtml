
@{
    Layout = "~/Areas/Portal/Views/Shared/_SinglePageLayout.cshtml";
    var fromDate = Model.FromDate.IsEmpty() ? "" + DateTime.Now.Month + "/01/" + DateTime.Now.Year + "" : Model.FromDate;
    var toDate = Model.ToDate.IsEmpty() ? DateTime.Now.ToString("MM/dd/yyyy") : Model.ToDate;
}

@section styles{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/user-panel/referrers.css")" rel="stylesheet" />
}
@model Fanex.Affiliate.Admin.Core.MetaModels.UserPanel.ReferrersParam
@section scripts{
    <script type="text/javascript">
        window.initialState = {
            fromDate: '@fromDate',
            toDate: '@toDate',
            deviceType: @Model.DeviceType,
            param: {
                AffId: @Model.AffId,
                FromDate: '@fromDate',
                ToDate: '@toDate'
            }
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/userpanel/referrers.js")"></script>
}

<div id="root"></div>

